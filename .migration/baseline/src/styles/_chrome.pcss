/*
 * Site chrome, measured from the source render by `wpmig dev-chrome`.
 *
 * Generated — edit the source site or the migrator, not this file.
 *
 * These are the *source's* values, not the target's design decisions. The
 * header and footer components read them with their own fallbacks, so a token
 * that is absent here (because the source had no such element) leaves the
 * component's own styling in place rather than blanking it.
 */

:root {
  --chrome-container-max: 1300px;
  --chrome-container-pad: 0px;
  --chrome-dropdown-icon-color: rgb(27, 49, 94);
  --chrome-dropdown-icon-gap: 0px;
  --chrome-dropdown-icon-size: 15px;
  --chrome-dropdown-item-color: rgb(27, 49, 94);
  --chrome-dropdown-item-font: "Helvetica";
  --chrome-dropdown-item-pad-x: 0px;
  --chrome-dropdown-item-pad-y: 0px;
  --chrome-dropdown-item-size: 16px;
  --chrome-dropdown-item-weight: 400;
  --chrome-dropdown-min-width: 0px;
  --chrome-dropdown-offset: 0px;
  --chrome-dropdown-pad-y: 0px;
  --chrome-dropdown-radius: 0px;
  --chrome-dropdown-width: 350px;
  --chrome-footer-color: rgb(0, 0, 0);
  --chrome-footer-link-color: rgb(0, 0, 0);
  --chrome-footer-link-font: "Helvetica";
  --chrome-footer-link-gap: 0px;
  --chrome-footer-link-size: 16px;
  --chrome-footer-link-weight: 400;
  --chrome-footer-logo-width: 149px;
  --chrome-footer-pad-block: 0px;
  --chrome-header-logo-pad-right: 0px;
  --chrome-header-logo-width: 390px;
  --chrome-header-pad-bottom: 0px;
  --chrome-header-pad-top: 0px;
  --chrome-header-phone-color: rgb(255, 255, 255);
  --chrome-header-phone-font: "Helvetica";
  --chrome-header-phone-size: 16px;
  --chrome-header-phone-weight: 400;
  --chrome-header-row-pad-bottom: 0px;
  --chrome-header-row-pad-top: 0px;
  --chrome-nav-height: 165px;
  --chrome-nav-link-color: rgb(27, 49, 94);
  --chrome-nav-link-font: "Helvetica";
  --chrome-nav-link-pad-x: 0px;
  --chrome-nav-link-pad-y: 0px;
  --chrome-nav-link-size: 16px;
  --chrome-nav-link-weight: 400;
  --chrome-nav-phone-color: rgb(255, 255, 255);
  --chrome-nav-phone-font: "Helvetica";
  --chrome-nav-phone-size: 16px;
  --chrome-nav-phone-weight: 400;
}

@media (min-width: 768px) {
  :root {
    --chrome-dropdown-item-font: "PT Sans";
    --chrome-dropdown-width: 728px;
    --chrome-footer-link-font: "PT Sans";
    --chrome-footer-logo-width: 142px;
    --chrome-header-logo-width: 768px;
    --chrome-header-phone-font: "PT Sans";
    --chrome-nav-height: 254px;
    --chrome-nav-link-font: "PT Sans";
    --chrome-nav-phone-font: "PT Sans";
  }
}

@media (min-width: 992px) {
  :root {
    --chrome-container-pad: 15px;
    --chrome-dropdown-bg: rgb(255, 255, 255);
    --chrome-dropdown-item-pad-x: 10px;
    --chrome-dropdown-item-size: 13px;
    --chrome-dropdown-item-weight: 700;
    --chrome-dropdown-shadow: rgba(0, 0, 0, 0.2) 0px 4px 8px 0px, rgba(0, 0, 0, 0.19) 0px 6px 20px 0px;
    --chrome-dropdown-width: 212px;
    --chrome-header-logo-width: 776px;
    --chrome-nav-height: 316px;
    --chrome-nav-link-color: rgb(255, 255, 255);
    --chrome-nav-link-pad-x: 7.5px;
    --chrome-nav-link-size: 13px;
    --chrome-nav-link-transform: uppercase;
    --chrome-nav-link-weight: 700;
  }
}

@media (min-width: 1440px) {
  :root {
    --chrome-dropdown-item-pad-x: 15px;
    --chrome-dropdown-item-size: 16px;
    --chrome-dropdown-width: 272px;
    --chrome-nav-link-pad-x: 15px;
    --chrome-nav-link-size: 16px;
  }
}
