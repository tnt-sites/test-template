/* mig:generated v=0.1.0 gen=wpmig-chrome hash=4287f9383b8855e8 */

/*
 * Site chrome, measured from the source render by `wpmig dev-chrome`.
 *
 * Generated — edit the source site or the migrator, not this file.
 *
 * These are the *source's* values, not the target's design decisions. The
 * header and footer components read them with their own fallbacks, so a token
 * that is absent here (because the source had no such element) leaves the
 * component's own styling in place rather than blanking it.
 */

:root {
  --chrome-copyright-align: center;
  --chrome-copyright-color: rgb(0, 0, 0);
  --chrome-copyright-font: "Source Sans Pro", sans-serif;
  --chrome-copyright-pad-block: 0px;
  --chrome-copyright-size: 11.2px;
  --chrome-copyright-weight: 400;
  --chrome-dropdown-bg: rgb(186, 151, 100);
  --chrome-dropdown-item-color: rgb(255, 255, 255);
  --chrome-dropdown-item-font: "Source Sans Pro", sans-serif;
  --chrome-dropdown-item-pad-x: 15px;
  --chrome-dropdown-item-pad-y: 0px;
  --chrome-dropdown-item-size: 13px;
  --chrome-dropdown-item-weight: 500;
  --chrome-dropdown-min-width: 100px;
  --chrome-dropdown-offset: 0px;
  --chrome-dropdown-pad-y: 0px;
  --chrome-dropdown-radius: 0px;
  --chrome-dropdown-shadow: rgba(0, 0, 0, 0.14) 0px 2px 2px 0px, rgba(0, 0, 0, 0.12) 0px 1px 5px 0px, rgba(0, 0, 0, 0.2) 0px 3px 1px -2px;
  --chrome-dropdown-width: 100%;
  --chrome-footer-bg: rgb(255, 255, 255);
  --chrome-footer-color: rgb(0, 0, 0);
  --chrome-footer-column-font: "Source Sans Pro", sans-serif;
  --chrome-footer-link-color: rgb(0, 0, 0);
  --chrome-footer-link-font: "Source Sans Pro", sans-serif;
  --chrome-footer-link-gap: 0px;
  --chrome-footer-link-size: 16px;
  --chrome-footer-link-weight: 300;
  --chrome-footer-logo-width: 300px;
  --chrome-footer-pad-block: 19.5px;
  --chrome-nav-phone-color: rgb(255, 255, 255);
  --chrome-nav-phone-font: "Montserrat", sans-serif;
  --chrome-nav-phone-size: 14px;
  --chrome-nav-phone-weight: 300;
}

@media (min-width: 768px) {
  :root {
    --chrome-footer-pad-block: 38.39px;
  }
}

@media (min-width: 992px) {
  :root {
    --chrome-copyright-align: start;
    --chrome-copyright-size: 11.6px;
    --chrome-footer-pad-block: 49.59px;
    --chrome-nav-phone-size: 14.5px;
  }
}

@media (min-width: 1440px) {
  :root {
    --chrome-copyright-size: 12px;
    --chrome-dropdown-item-pad-x: 16px;
    --chrome-dropdown-item-pad-y: 14px;
    --chrome-dropdown-width: 1440px;
    --chrome-footer-pad-block: 72px;
    --chrome-nav-phone-size: 15px;
  }
}
