{
  "name": "@cloudcannon/site-migrator",
  "version": "0.1.0",
  "description": "Migrates a static HTML/CSS/JS site onto a CloudCannon Astro component template. Copy into a repo, run, delete.",
  "type": "module",
  "private": true,
  "bin": {
    "mig": "./bin/mig.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "citty": "^0.1.6",
    "culori": "^4.0.1",
    "fast-xml-parser": "^5.10.1",
    "mime": "^4.0.6",
    "node-diff3": "^3.1.2",
    "parse5": "^7.2.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "postcss-safe-parser": "^7.0.1",
    "postcss-selector-parser": "^7.0.0",
    "postcss-value-parser": "^4.2.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "files": [
    "bin",
    "src",
    "presets",
    "README.md"
  ]
}
