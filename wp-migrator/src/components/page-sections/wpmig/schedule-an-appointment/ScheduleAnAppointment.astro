---
/**
 * Schedule An Appointment — migrated from about-us [11] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
import Button from "@core-elements/button/Button.astro";
const {
  heading = "",
  buttonText = "",
  buttonLink = "",
  secondaryButtonText = "",
  secondaryButtonLink = "",
  headingColor = "#1b2e38",
  buttonBackgroundColor = "#5bb781",
  buttonTextColor = "#ffffff",
  buttonBackgroundColor2 = "#3b6278",
  buttonTextHoverColor = "#1b2e38",
  id,
  _component,
  ...rest
} = Astro.props;
---
<section class="schedule-an-appointment" id={id || undefined} style={`--hd:${headingColor};--btnbg:${buttonBackgroundColor};--btntx:${buttonTextColor};--c4:${buttonBackgroundColor2};--c5:${buttonTextHoverColor}`} {...rest}>
  <div class="saa-box">
    <div class="saa-box2">
      <div class="saa-decor" aria-hidden="true"></div>
    </div>
    <div class="saa-box3">
      <h2 class="saa-heading">{heading}</h2>
    </div>
    <div class="saa-box4">
      <div class="saa-box5">
        {buttonText && <Button variant="primary" size="md" width="none" borderRadius="default" borderWidth="none" class="saa-btn" text={buttonText} link={buttonLink || "#"} />}
      </div>
    </div>
    <div class="saa-box6">
      <div class="saa-box7">
        <div class="saa-box8">
          {secondaryButtonText && <Button variant="primary" size="md" width="none" borderRadius="default" borderWidth="none" class="saa-btn2" text={secondaryButtonText} link={secondaryButtonLink || "#"} />}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .schedule-an-appointment {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
    margin-left: auto;
    margin-right: auto;
    margin-top: 30px;
    max-width: 360px;
    position: relative;
    text-align: left;
  }

  .saa-box {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    padding: 10px;
    position: relative;
  }

  .saa-box2 {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    max-width: 100%;
    padding-bottom: 15px;
    padding-top: 15px;
  }

  .saa-decor {
    border-top: 1px solid #e8e8e8;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    max-width: 100%;
    min-height: 1px;
  }

  .saa-box3 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
  }

  .saa-heading {
    box-sizing: border-box;
    font-family: Montserrat, sans-serif;
    font-size: 32px;
    font-weight: 300;
    line-height: 41.6px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .saa-box4 {
    box-sizing: border-box;
    flex: 0 0 100%;
    margin-bottom: 20px;
    max-width: 100%;
    position: relative;
  }

  .saa-box5 {
    box-sizing: border-box;
  }

  :global(.saa-btn) {
    background-color: var(--btnbg);
    border-radius: 3px;
    box-sizing: border-box;
    color: var(--btntx);
    display: inline-block;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 15px;
    margin: 0px;
    padding: 12px 24px;
    text-align: center;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  :global(.saa-btn) :global(.label-text) {
    white-space: nowrap;
  }

  .saa-box6 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    position: relative;
  }

  .saa-box7 {
    box-sizing: border-box;
    transition: all 0.3s ease;
  }

  .saa-box8 {
    box-sizing: border-box;
  }

  :global(.saa-btn2) {
    background-color: var(--c4);
    border-radius: 3px;
    box-sizing: border-box;
    color: var(--btntx);
    display: inline-block;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 15px;
    margin: 0px;
    padding: 12px 24px;
    text-align: center;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  :global(.saa-btn2) :global(.label-text) {
    white-space: nowrap;
  }

  :global(.saa-btn):hover {
    background-color: rgba(0, 0, 0, 0);
    border-top-color: #1b2e38;
    color: var(--c5);
  }

  :global(.saa-btn2):hover {
    background-color: rgba(0, 0, 0, 0);
    border-top-color: #1b2e38;
    color: var(--c5);
  }

  @media (min-width: 768px) {
    .schedule-an-appointment {
      max-width: 690px;
    }

    .saa-heading {
      line-height: 32px;
    }

    .saa-box6 {
      display: none;
      flex: 0 1 auto;
      max-width: none;
    }

    .saa-box7 {
      display: none;
    }

    .saa-box8 {
      display: none;
    }

    :global(.saa-btn2) {
      background-color: #3b6278;
      color: #ffffff;
      display: none;
      white-space: normal;
    }
  }

  @media (min-width: 1440px) {
    .schedule-an-appointment {
      max-width: 1110px;
    }
  }

/* wpmig:corrections:begin */
  .saa-box7 {
    background-color: rgb(59, 98, 120);
    color: rgb(255, 255, 255);
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    line-height: 15px;
    text-align: center;
  }
  :global(.saa-btn) {
    align-items: normal;
    justify-content: normal;
  }
  @media (min-width: 768px) {
    :global(.saa-btn) {
      align-items: normal;
      justify-content: normal;
    }
  }
  @media (min-width: 1440px) {
    :global(.saa-btn) {
      align-items: normal;
      justify-content: normal;
    }
  }
/* wpmig:corrections:end */
</style>
