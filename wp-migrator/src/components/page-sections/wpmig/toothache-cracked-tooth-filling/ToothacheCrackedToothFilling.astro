---
/**
 * Toothache Cracked Tooth Filling — migrated from lp/dental-emergency [3] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
import Button from "@core-elements/button/Button.astro";
const {
  heading = "",
  text = "",
  buttonText = "",
  buttonLink = "",
  image = "",
  imageAlt = "",
  headingColor = "#3b6278",
  textColor = "#3b6278",
  buttonBackgroundColor = "#5bb781",
  buttonTextColor = "#ffffff",
  buttonTextHoverColor = "#1b2e38",
  hoverColor = "#5bb781",
  hoverBackgroundColor = "#ffffff",
  id,
  _component,
  ...rest
} = Astro.props;
---

<section
  class="toothache-cracked-tooth-filling"
  id={id || undefined}
  style={`--hd:${headingColor};--tx:${textColor};--btnbg:${buttonBackgroundColor};--btntx:${buttonTextColor};--c5:${buttonTextHoverColor};--c6:${hoverColor};--c7:${hoverBackgroundColor}`}
  {...rest}
>
  <section class="tctf-box">
    <div class="tctf-box2">
      <div class="tctf-box3">
        <div class="tctf-box4">
          <div class="tctf-box5">
            <h2 class="tctf-heading" set:html={heading} />
          </div>
        </div>
        <div class="tctf-box6">
          {text && <p class="tctf-text">{text}</p>}
        </div>
        <div class="tctf-box7">
          {
            buttonText && (
              <Button
                variant="primary"
                size="md"
                width="none"
                borderRadius="none"
                borderWidth="xs"
                class="tctf-btn"
                text={buttonText}
                link={buttonLink || "#"}
              />
            )
          }
        </div>
      </div>
      <div class="tctf-box8">
        <div class="tctf-box9">
          <div class="tctf-box10">
            {
              image && (
                <img
                  class="tctf-media"
                  src={image}
                  alt={imageAlt || ""}
                  loading="lazy"
                  width="650"
                  height="575"
                />
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
