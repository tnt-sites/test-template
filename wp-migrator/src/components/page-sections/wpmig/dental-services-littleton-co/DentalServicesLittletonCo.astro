---
/**
 * Dental Services Littleton Co — migrated from dental-services [0] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  backgroundImage = "/wp-content/themes/ColumbineCreek/img/texture-bg-blue.jpg",
  headingColor = "#1b2e38",
  id,
  _component,
  ...rest
} = Astro.props;
---

<div
  class="dental-services-littleton-co"
  id={id || undefined}
  style={`--hd:${headingColor}${backgroundImage ? `;--bgimg:url('${backgroundImage}')` : ""}`}
  {...rest}
>
  <div class="dslc-box">
    <h1 class="dslc-heading">{heading}</h1>
  </div>
</div>
<style>
  .dental-services-littleton-co {
    align-items: center;
    background-image: var(--bgimg, none);
    background-position: 50% 50%;
    background-size: cover;
    box-sizing: border-box;
    color: #1b2e38;
    display: flex;
    font-family: Montserrat, sans-serif;
    justify-content: center;
    line-height: 24px;
    min-height: 150px;
    text-align: center;
  }

  .dslc-box {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
  }

  .dslc-heading {
    box-sizing: border-box;
    font-size: 40px;
    font-weight: 300;
    line-height: 48px;
    margin-bottom: 8px;
    margin-top: 0px;
  }

  @media (min-width: 768px) {
    .dental-services-littleton-co {
      justify-content: flex-start;
    }

    .dslc-box {
      flex: 0 0 93.75%;
      margin-left: 24px;
      margin-right: 24px;
      max-width: 93.75%;
    }
  }

  @media (min-width: 1440px) {
    .dental-services-littleton-co {
      text-align: left;
    }

    .dslc-box {
      flex: 0 0 80%;
      margin-left: 150px;
      margin-right: 150px;
      max-width: 80%;
    }
  }
</style>
