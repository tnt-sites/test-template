---
/**
 * Home Beam Dental — migrated from beam-dental-dentist [1] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  text = "",
  textColor = "#1b2e38",
  id,
  _component,
  ...rest
} = Astro.props;
---
<div class="home-beam-dental" id={id || undefined} style={`--tx:${textColor}`} {...rest}>
  {text && <div class="hbd-text" set:html={text} />}
</div>
<style>
  .home-beam-dental {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
    padding-left: 15px;
    padding-right: 15px;
    text-align: left;
  }

  .hbd-text {
    box-sizing: border-box;
    font-size: 14px;
    line-height: 21px;
    padding-top: 10px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .home-beam-dental {
      margin-left: auto;
      margin-right: auto;
      max-width: 720px;
    }
  }

  @media (min-width: 1440px) {
    .home-beam-dental {
      max-width: 1140px;
    }

    .hbd-text {
      padding-top: 20px;
      text-align: left;
    }
  }
</style>
