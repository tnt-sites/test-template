 * Payment Options C — migrated from payment-options/dental-insurance [0] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  subheading = "",
  backgroundImage = "/wp-content/themes/ColumbineCreek/img/texture-bg-blue.jpg",
  headingColor = "#1b2e38",
  id,
  _component,
  ...rest
} = Astro.props;
---
<div class="payment-options-c" id={id || undefined} style={`--hd:${headingColor}${backgroundImage ? `;--bgimg:url('${backgroundImage}')` : ""}`} {...rest}>
  <div class="poc-box">
    <h3 class="poc-heading">{heading}</h3>
    {subheading && <h1 class="poc-heading2">{subheading}</h1>}
  </div>
</div>
<style>
  .payment-options-c {
    align-items: center;
    background-image: var(--bgimg, none);
    background-position: 50% 50%;
    background-size: cover;
    box-sizing: border-box;
    color: #1b2e38;
    display: flex;
    font-family: Montserrat, sans-serif;
    justify-content: center;
    line-height: 24px;
    min-height: 150px;
    text-align: center;
  }

  .poc-box {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
  }

  .poc-heading {
    box-sizing: border-box;
    font-family: Roboto, sans-serif;
    font-weight: 300;
    line-height: 19.2px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .poc-heading2 {
    box-sizing: border-box;
    font-size: 40px;
    font-weight: 300;
    line-height: 48px;
    margin-bottom: 8px;
    margin-top: 0px;
  }

  @media (min-width: 768px) {
    .payment-options-c {
      justify-content: flex-start;
    }

    .poc-box {
      flex: 0 0 93.75%;
      margin-left: 24px;
      margin-right: 24px;
      max-width: 93.75%;
    }
  }

  @media (min-width: 1440px) {
    .payment-options-c {
      text-align: left;
    }

    .poc-box {
      flex: 0 0 80%;
      margin-left: 150px;
      margin-right: 150px;
      max-width: 80%;
    }
  }

