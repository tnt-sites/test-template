<style>
  .new-patients-f {
    align-items: center;
    background-image: var(--bgimg, none);
    background-position: 50% 50%;
    background-size: cover;
    box-sizing: border-box;
    color: #1b2e38;
    display: flex;
    font-family: Montserrat, sans-serif;
    justify-content: center;
    line-height: 24px;
    min-height: 150px;
    text-align: center;
  }

  .npf-box {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
  }

  .npf-heading {
    box-sizing: border-box;
    font-family: Roboto, sans-serif;
    font-weight: 300;
    line-height: 19.2px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .npf-heading2 {
    box-sizing: border-box;
    font-size: 40px;
    font-weight: 300;
    line-height: 48px;
    margin-bottom: 8px;
    margin-top: 0px;
  }

  @media (min-width: 768px) {
    .new-patients-f {
      justify-content: flex-start;
    }

    .npf-box {
      flex: 0 0 93.75%;
      margin-left: 24px;
      margin-right: 24px;
      max-width: 93.75%;
    }
  }

  @media (min-width: 1440px) {
    .new-patients-f {
      text-align: left;
    }

    .npf-box {
      flex: 0 0 80%;
      margin-left: 150px;
      margin-right: 150px;
      max-width: 80%;
    }
  }

