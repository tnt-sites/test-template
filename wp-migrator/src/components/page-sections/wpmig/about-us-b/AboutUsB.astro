---
/**
 * About Us B — migrated from about-us/meet-the-doctors [0] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  subheading = "",
  backgroundImage = "/wp-content/themes/ColumbineCreek/img/texture-bg-blue.jpg",
  headingColor = "#1b2e38",
  id,
  _component,
  ...rest
} = Astro.props;
---

<div
  class="about-us-b"
  id={id || undefined}
  style={`--hd:${headingColor}${backgroundImage ? `;--bgimg:url('${backgroundImage}')` : ""}`}
  {...rest}
>
  <div class="aub-box">
    <h3 class="aub-heading">{heading}</h3>
    {subheading && <h1 class="aub-heading2">{subheading}</h1>}
  </div>
</div>
<style>
  .about-us-b {
    align-items: center;
    background-image: var(--bgimg, none);
    background-position: 50% 50%;
    background-size: cover;
    box-sizing: border-box;
    color: #1b2e38;
    display: flex;
    font-family: Montserrat, sans-serif;
    justify-content: center;
    line-height: 24px;
    min-height: 150px;
    text-align: center;
  }

  .aub-box {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
  }

  .aub-heading {
    box-sizing: border-box;
    font-family: Roboto, sans-serif;
    font-weight: 300;
    line-height: 19.2px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .aub-heading2 {
    box-sizing: border-box;
    font-size: 40px;
    font-weight: 300;
    line-height: 48px;
    margin-bottom: 8px;
    margin-top: 0px;
  }

  @media (min-width: 768px) {
    .about-us-b {
      justify-content: flex-start;
    }

    .aub-box {
      flex: 0 0 93.75%;
      margin-left: 24px;
      margin-right: 24px;
      max-width: 93.75%;
    }
  }

  @media (min-width: 1440px) {
    .about-us-b {
      text-align: left;
    }

    .aub-box {
      flex: 0 0 80%;
      margin-left: 150px;
      margin-right: 150px;
      max-width: 80%;
    }
  }

  /* wpmig:corrections:begin */
  .aub-heading6 {
    line-height: 24px;
  }
  .aub-heading {
    font-size: 16px;
  }
  @media (min-width: 768px) {
    .aub-btn {
      align-items: normal;
      justify-content: normal;
      text-align: left;
    }

    .aub-btn2 {
