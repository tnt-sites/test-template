---
/**
 * Same Day Appointments — migrated from lp/dental-emergency [2] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
import Button from "@core-elements/button/Button.astro";
const {
  heading = "",
  image = "",
  imageAlt = "",
  text = "",
  buttonText = "",
  buttonLink = "",
  headingColor = "#3b6278",
  textColor = "#3b6278",
  buttonBackgroundColor = "#5bb781",
  buttonTextColor = "#ffffff",
  id,
  _component,
  ...rest
} = Astro.props;
---

<section
  class="same-day-appointments"
  id={id || undefined}
  style={`--hd:${headingColor};--tx:${textColor};--btnbg:${buttonBackgroundColor};--btntx:${buttonTextColor}`}
  {...rest}
>
  <section class="sda-box">
    <div class="sda-box2">
      <div class="sda-box3">
        <div class="sda-decor" aria-hidden="true"></div>
      </div>
      <div class="sda-box4">
        <div class="sda-box5">
          <div class="sda-box6">
            {
              image && (
                <img
                  class="sda-media"
                  src={image}
                  alt={imageAlt || ""}
                  loading="lazy"
                  width="650"
                  height="575"
                />
              )
            }
          </div>
        </div>
        <div class="sda-box7">
          <div class="sda-box8">
            <h2 class="sda-heading" set:html={heading} />
          </div>
        </div>
        <div class="sda-box9">
          <div class="sda-box10">
            {text && <p class="sda-text">{text}</p>}
          </div>
        </div>
        <div class="sda-box11">
          {
            buttonText && (
              <Button
                variant="primary"
                size="md"
                width="none"
                borderRadius="none"
                borderWidth="xs"
                class="sda-btn"
                text={buttonText}
                link={buttonLink || "#"}
              />
            )
          }
        </div>
      </div>
    </div>
  </section>
</section>
