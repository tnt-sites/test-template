---
/**
 * One icon-plus-heading cell, used by the Why, Doctors and Financing sections.
 *
 * Reproduces at build time what the legacy location-page.js did on DOMContentLoaded:
 * look the icon key up in the SVG map and prepend a `.svg-container`, tagged
 * `no-fill` for the stroke-drawn icons.
 *
 * When `modalId` is set the cell becomes an anchor that opens that dialog; the
 * parent section is responsible for rendering the matching <Modal>.
 */
import { LOCATION_ICON_NO_FILL, getLocationIcon } from "../icons";

const {
  icon = "",
  heading = "",
  modalId = null,
  editable = true,
  class: className,
  _component,
  ...rest
} = Astro.props;

const svg = getLocationIcon(icon);
const isNoFill = LOCATION_ICON_NO_FILL.has(icon);

if (!_component && !svg && !heading) return;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

// The icon key stays on the element as a class. It carries no styling now, but
// makes diffing a rendered page against the legacy markup straightforward.
const Tag = modalId ? "a" : "div";
const triggerAttributes = modalId ? { href: `#${modalId}`, role: "button" } : {};

const headingAttributes = editable
  ? { "data-editable": "text", "data-prop": "heading" }
  : {};
---

<Tag class:list={["location-icon", icon, className]} {...triggerAttributes} {...htmlAttributes}>
  {
    svg && (
      <div class:list={["svg-container", isNoFill && "no-fill"]} set:html={svg} />
    )
  }
  <h3 {...headingAttributes}>{heading}</h3>
</Tag>

<style lang="pcss" is:global>
  @layer page-sections {
    .location-page-section .location-icon {
      align-content: start;
      display: grid;
      flex: 0 1 33.33%;
      gap: 10px 0;
      margin: 0 auto;
      padding: 0;

      svg {
        display: flex;
        height: 100px;
        justify-content: center;
        margin: 0 auto;
        max-width: 100%;
        width: 110px;
      }

      .svg-container {
        &:not(.no-fill) svg path {
          fill: var(--svg-color);
          stroke: none;
        }

        &.no-fill svg {
          fill: transparent;
          stroke: var(--svg-color);

          path {
            fill: none;
          }
        }
      }

      h3 {
        color: var(--svg-h3-color);
        line-height: 1.25;
        padding: 0 10px;
      }
    }

    /* Icon grids drop from three columns to two, then one. */
    @media screen and (max-width: 850px) {
      .location-page-section .location-icon {
        flex: 0 1 50%;
      }
    }

    @media screen and (max-width: 490px) {
      .location-page-section .location-icon {
        flex: 0 1 100%;
      }
    }
  }
</style>
