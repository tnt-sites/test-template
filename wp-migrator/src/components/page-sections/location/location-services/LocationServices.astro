---
/**
 * "Why are you looking for dental care near ___?" — intro copy over a grid of
 * service cards, each opening a modal with more detail.
 */
import LocationModal from "../LocationModal.astro";
import LocationSection from "../LocationSection.astro";
import { hasText, modalIdFor, renderMarkdown } from "../utils";
import LocationService from "./LocationService.astro";

const {
  id = "",
  heading = "",
  intro = "",
  services = [],
  editable = true,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const items = Array.isArray(services) ? services : [];

if (!_component && !hasText(heading) && items.length === 0) return;

const introHtml = renderMarkdown(intro);
const modalIds = items.map((item, index) => modalIdFor(item, index, id || "services"));

const editableAttributes = (prop: string, type = "text") =>
  editable ? { "data-editable": type, "data-prop": prop } : {};
---

<LocationSection id={id} class:list={["location-services", className]} {...htmlAttributes}>
  {heading && <h2 {...editableAttributes("heading")}>{heading}</h2>}
  {
    introHtml && (
      <div class="wrap" {...editableAttributes("intro", "markdown")}>
        <Fragment set:html={introHtml} />
      </div>
    )
  }
  {
    items.length > 0 && (
      <div
        class="service-icons-container"
        data-editable={editable ? "array" : undefined}
        data-prop={editable ? "services" : undefined}
        data-component-key="_component"
        data-id-key="_component"
      >
        {items.map((item: any, index: number) => (
          <editable-array-item data-component="page-sections/location/location-services/location-service">
            <LocationService {...item} modalId={modalIds[index]} editable={editable} />
          </editable-array-item>
        ))}
      </div>
    )
  }
</LocationSection>

{
  items.map((item: any, index: number) =>
    modalIds[index] ? (
      <LocationModal
        id={modalIds[index]}
        heading={item.modalHeading || item.heading}
        content={item.modalContent}
      />
    ) : null
  )
}

<style lang="pcss" is:global>
  @layer page-sections {
    .location-page-section.location-services {
      padding: 60px 10px 80px;

      h2{ color: var(--location-services-h2-color);}

      .service-icons-container {
        display: flex;
        flex-wrap: wrap;
        gap: 50px 20px;
        justify-content: center;
        margin: 0 auto;
        max-wdith: 1200px;
        padding: 25px 0 80px;

        > editable-array-item,
        > .service {
          display: flex;
          flex: 0 1 300px;
          justify-content: space-around;
          max-width: 100%;
        }

        .service {
          margin: 0 auto;
          max-width: 100%;
          padding: 0;
          transition: 0.4s all;
          width: 100%;

          figure {
            margin: 0;
            padding: 0;

            img {
              margin: 0 auto;
              max-width: 100%;
              padding: 0;
              width: 100%;
            }
          }

          h3 {
            color: var(--image-modal-h3-color);
            display: grid;
            font-size: var(--service-h3-image-font);
            margin: 10px 0 0;

            small {
              color: var(--image-modal-h3-color);
              display: block;
              padding: 0 0 3px;
            }
          }

          &:hover {
            transform: scale(1.05);
            transition: 0.4s all;

            h3,
            h3 small {
              color: var(--image-modal-h3-color-hover);
            }
          }
        }
      }
    }

    @media screen and (max-width: 1024px) {
      .location-page-section.location-services
        .service-icons-container
        .service
        h3 {
        font-size: var(--service-h3-image-font-tablet);
      }
    }

    @media screen and (max-width: 767px) {
      .location-page-section.location-services
        .service-icons-container
        .service
        h3 {
        font-size: var(--service-h3-image-font-mobile);
      }
    }
  }
</style>
