---
/** "Why patients near ___ choose us" — a heading over a grid of icon callouts. */
import LocationIcon from "../location-icon/LocationIcon.astro";
import LocationModal from "../LocationModal.astro";
import LocationSection from "../LocationSection.astro";
import { hasText, modalIdFor } from "../utils";

const {
  id = "",
  heading = "",
  icons = [],
  editable = true,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const items = Array.isArray(icons) ? icons : [];

if (!_component && !hasText(heading) && items.length === 0) return;

// One id per item, shared by the trigger and its dialog so they can't drift.
const modalIds = items.map((item, index) => modalIdFor(item, index, id || "why"));

const editableAttributes = (prop: string) =>
  editable ? { "data-editable": "text", "data-prop": prop } : {};
---

<LocationSection id={id} class:list={["location-why", className]} {...htmlAttributes}>
  {heading && <h2 {...editableAttributes("heading")}>{heading}</h2>}
  {
    items.length > 0 && (
      <div
        class="why-icons-container"
        data-editable={editable ? "array" : undefined}
        data-prop={editable ? "icons" : undefined}
        data-component-key="_component"
        data-id-key="_component"
      >
        {items.map((item: any, index: number) => (
          <editable-array-item data-component="page-sections/location/location-icon">
            <LocationIcon {...item} modalId={modalIds[index]} editable={editable} />
          </editable-array-item>
        ))}
      </div>
    )
  }
</LocationSection>

{
  items.map((item: any, index: number) =>
    modalIds[index] ? (
      <LocationModal
        id={modalIds[index]}
        heading={item.modalHeading || item.heading}
        content={item.modalContent}
      />
    ) : null
  )
}

<style lang="pcss" is:global>
  @layer page-sections {
    .location-page-section.location-why {
      padding: 60px 10px;

      .why-icons-container {
        display: flex;
        flex-wrap: wrap;
        gap: 50px 0;
        justify-content: center;
        margin: 25px auto 0;
        max-width: 1200px;

        > editable-array-item,
        > .location-icon {
          display: block;
          flex: 0 1 33.33%;
        }

        .location-icon {
          width: 100%;
          margin-bottom: 30px;
        }

        .location-icon h3 {
          font-size: var(--why-h3-icon-font);
        }
      }
    }

    @media screen and (max-width: 1024px) {
      .location-page-section.location-why
        .why-icons-container
        .location-icon
        h3 {
        font-size: var(--why-h3-icon-font-tablet);
      }
    }

    @media screen and (max-width: 767px) {
      .location-page-section.location-why
        .why-icons-container
        .location-icon
        h3 {
        font-size: var(--why-h3-icon-font-mobile);
      }
    }
  }
</style>
