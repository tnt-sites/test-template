---
/** Page H1 plus its supporting headline, sitting directly under the banner. */
import LocationSection from "../LocationSection.astro";
import { hasText } from "../utils";

const {
  id = "",
  heading = "",
  subheading = "",
  editable = true,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!_component && !hasText(heading) && !hasText(subheading)) return;

const editableAttributes = (prop: string) =>
  editable ? { "data-editable": "text", "data-prop": prop } : {};
---

<LocationSection id={id} class:list={["location-title", className]} {...htmlAttributes}>
  <div class="container">
    {heading && <h1 {...editableAttributes("heading")}>{heading}</h1>}
    {subheading && <h2 {...editableAttributes("subheading")}>{subheading}</h2>}
  </div>
</LocationSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .location-page-section.location-title {
      padding: 20px 10px 0;

      .container {
        h1 {
          color: var(--intro-h1-color);
          font-size: var(--intro-h1-font);
          margin-bottom: 20px;
          text-align: center;
          text-transform: uppercase;
        }

        h2 {
          color: var(--intro-h2-color);
          font-size: var(--intro-h2-font);
          line-height: 1.1;
        }
      }
    }

    @media screen and (max-width: 1024px) {
      .location-page-section.location-title .container {
        h1 {
          font-size: var(--intro-h1-font-tablet);
        }

        h2 {
          font-size: var(--intro-h2-font-tablet);
        }
      }
    }

    @media screen and (max-width: 767px) {
      .location-page-section.location-title .container {
        h1 {
          font-size: var(--intro-h1-font-mobile);
        }

        h2 {
          font-size: var(--intro-h2-font-mobile);
        }
      }
    }
  }
</style>
