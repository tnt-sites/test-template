---
/**
 * "How we make dentistry affordable" — intro copy over icon callouts that each
 * open a modal explaining a payment option.
 */
import LocationIcon from "../location-icon/LocationIcon.astro";
import LocationModal from "../LocationModal.astro";
import LocationSection from "../LocationSection.astro";
import { hasText, modalIdFor, renderMarkdown } from "../utils";

const {
  id = "",
  heading = "",
  intro = "",
  icons = [],
  editable = true,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const items = Array.isArray(icons) ? icons : [];

if (!_component && !hasText(heading) && items.length === 0) return;

const introHtml = renderMarkdown(intro);
const modalIds = items.map((item, index) => modalIdFor(item, index, id || "financing"));

const editableAttributes = (prop: string, type = "text") =>
  editable ? { "data-editable": type, "data-prop": prop } : {};
---

<LocationSection
  id={id}
  class:list={["location-financing", className]}
  {...htmlAttributes}
>
  {heading && <h2 {...editableAttributes("heading")}>{heading}</h2>}
  {
    introHtml && (
      <div class="wrap" {...editableAttributes("intro", "markdown")}>
        <Fragment set:html={introHtml} />
      </div>
    )
  }
  {
    items.length > 0 && (
      <div
        class="financing-icons-container"
        data-editable={editable ? "array" : undefined}
        data-prop={editable ? "icons" : undefined}
        data-component-key="_component"
        data-id-key="_component"
      >
        {items.map((item: any, index: number) => (
          <editable-array-item data-component="page-sections/location/location-icon">
            <LocationIcon {...item} modalId={modalIds[index]} editable={editable} />
          </editable-array-item>
        ))}
      </div>
    )
  }
</LocationSection>

{
  items.map((item: any, index: number) =>
    modalIds[index] ? (
      <LocationModal
        id={modalIds[index]}
        heading={item.modalHeading || item.heading}
        content={item.modalContent}
      />
    ) : null
  )
}

<style lang="pcss" is:global>
  @layer page-sections {
    .location-page-section.location-financing {
      margin: 0 auto;
      padding: 60px 10px;

      .financing-icons-container {
        display: flex;
        flex-wrap: wrap;
        gap: 40px 0;
        justify-content: space-around;
        margin: 0 auto;
        max-width: 1200px;
        padding: 25px 0 0;

        /* Block, not flex: a flex wrapper would re-apply .location-icon's own
           `flex: 0 1 33.33%` and collapse the cell to the icon's width. */
        > editable-array-item,
        > .location-icon {
          flex: 0 1 250px;
        }

        .location-icon {
          gap: 5px 0;
          margin: 0;
          width: 100%;

          h3 {
            color: var(--svg-modal-h3-color);
            font-size: var(--financing-h3-icon-font);
          }

          &:hover h3 {
            color: var(--svg-modal-h3-color-hover);
          }
        }
      }
    }

    @media screen and (max-width: 1024px) {
      .location-page-section.location-financing
        .financing-icons-container
        .location-icon
        h3 {
        font-size: var(--financing-h3-icon-font-tablet);
      }
    }

    @media screen and (max-width: 767px) {
      .location-page-section.location-financing
        .financing-icons-container
        .location-icon {
        flex: 0 1 50%;

        h3 {
          font-size: var(--financing-h3-icon-font-mobile);
        }
      }
    }

    @media screen and (max-width: 490px) {
      .location-page-section.location-financing
        .financing-icons-container
        .location-icon {
        flex: 0 1 100%;
      }
    }
  }
</style>
