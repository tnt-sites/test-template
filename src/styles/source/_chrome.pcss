/* mig:generated v=0.1.0 gen=chrome hash=d766f11b0f8638cb */
/* Header and footer styling ported from the source site.
   Colours, type and band backgrounds only — the template keeps its own
   layout and dropdown behaviour. */
@layer source-bridge {
  /* headerLayout */
  .main-nav .hd-content {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    max-width: 1350px;
  }

  /* headerBackground */
  .main-nav {
    background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0));
  }

  /* navLink */
  .main-nav nav > ul > li > a {
    color: var(--color-text, #292929);
    font-family: aktiv-grotesk-extended, sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 19.2px;
  }

  /* logo */
  .main-nav picture img, .main-nav img {
    width: 153.281px;
    height: auto;
    max-width: 100%;
  }

  /* headerPhone */
  .main-nav a[href^='tel:'] {
    color: var(--color-bg, #ffffff);
    background-color: var(--color-text, #292929);
    font-family: aktiv-grotesk-extended, sans-serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 26px;
  }

  /* footerBackground */
  footer {
    background-color: var(--color-bg, #ffffff);
    color: var(--src-color1, #000000);
  }

  /* footerLink */
  footer a {
    color: var(--src-color1, #000000);
    font-family: figtree, sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 20.4px;
  }

  /* footerText */
  footer p {
    color: var(--color-text, #292929);
    font-family: figtree, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 22.4px;
  }
}
