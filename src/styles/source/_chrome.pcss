/* mig:generated v=0.1.0 gen=chrome hash=794cb84eced58985 frozen=true */
/* Header and footer styling ported from the source site.
   Colours, type and band backgrounds only — the template keeps its own
   layout and dropdown behaviour. */
@layer source-bridge {
  /* headerLayout */
  .main-nav .hd-content {
    display: flex;
    flex-direction: row;
    align-items: normal;
    justify-content: normal;
    max-width: 1600px;
  }

  /* navLink */
  .main-nav nav > ul > li > a {
    color: var(--color-brand, #321c0e);
    font-family: Poppins, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 20px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* logo */
  .main-nav picture img, .main-nav img {
    width: 215px;
    height: auto;
    max-width: 100%;
  }

  /* headerPhone */
  .main-nav a[href^='tel:'] {
    color: var(--color-bg, #ffffff);
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 16px;
  }

  /* footerBackground */
  footer {
    color: var(--src-color4, #686868);
  }

  /* footerHeading */
  footer h2, footer h3 {
    color: var(--color-bg, #ffffff);
    font-family: Poppins, sans-serif;
    font-size: 40px;
    font-weight: 700;
    line-height: 50px;
  }

  /* footerLink */
  footer a {
    color: var(--color-brand-subtle, #bf9800);
    font-family: "Open Sans", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 26px;
  }

  /* footerText */
  footer p {
    color: var(--src-color4, #686868);
    font-family: "Open Sans", sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 26px;
  }

  /* ---------------------------------------------------------------------
     Hand-added after `mig qa` reported horizontal overflow at 1280/1440px
     (document 1465px). The ported header sizing — 18px uppercase Poppins nav
     links, a 215px logo and max-width:1600px — gives the header an intrinsic
     minimum of ~1436px. Flex items default to min-width:auto, so they cannot
     shrink below their content and the page grows a horizontal scrollbar:
     body is overflow-x:hidden but html is not, so scrollWidth propagates.

     The source's own header did not overflow because its layout differed.
     Rather than lose the ported desktop design, it is gated at the width where
     it actually fits and scaled down below that.
     --------------------------------------------------------------------- */
  @media (max-width: 1500px) {
    .main-nav nav > ul > li > a {
      font-size: 15px;
      letter-spacing: 0.2px;
    }
    .main-nav picture img,
    .main-nav img {
      width: 175px;
    }
    .main-nav .hd-content {
      column-gap: 0.75rem;
    }
  }

  /* A 1280px laptop still ran 9px over after the step above. */
  @media (max-width: 1300px) {
    .main-nav nav > ul > li > a {
      font-size: 14px;
      letter-spacing: 0;
    }
    .main-nav picture img,
    .main-nav img {
      width: 160px;
    }
  }
}
