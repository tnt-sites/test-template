/*
 * Source-site colour tokens.
 *
 * dev-extract measured the page background and body text as #000000 and links
 * as #ffffff — it sampled unset/transparent computed values rather than the
 * painted surface. These are the real values read off the source render.
 */
:where(:root) {
  --src-bg-page: #ffffff;
  --src-text: #333333;
  --src-heading: #1a1a1a;
  --src-link: #5c7f5e;
  --src-brand: #79a37b;
  --src-brand-secondary: #ba9764;
  --src-color1: #e6e6e6;
  --src-color2: #dcdcdc;
  --src-color3: #cccccc;
  --src-color4: #c3c3c3;
}
