/* Neutral ramp, lightly cooled toward the source site's teal brand hue.
   Overrides variables/_colors.pcss by source order, without editing it.
   (Regenerated by hand — the extract emitted an all-black ramp for this site.) */
:where(:root) {
  --gray-0: #ffffff;
  --gray-1: #f2f5f5;
  --gray-2: #e6eaeb;
  --gray-3: #d5dcdd;
  --gray-4: #bfc8c9;
  --gray-5: #a2adae;
  --gray-6: #869092;
  --gray-7: #6c7678;
  --gray-8: #545d5e;
  --gray-9: #3f4748;
  --gray-10: #2a3132;
  --gray-11: #161b1c;
  --gray-12: #000000;
}
