/*
 * Neutral ramp, very slightly warmed toward the site's gold accent.
 *
 * `wpmig dev-extract` wrote every step of this ramp as #000000 — it collapsed
 * the whole scale to black, which flattens borders, muted text and surfaces
 * across the site. These values restore a real ramp.
 */
:where(:root) {
  --gray-0: #ffffff;
  --gray-1: #f4f2ef;
  --gray-2: #e6e3de;
  --gray-3: #d2cec7;
  --gray-4: #b8b3ab;
  --gray-5: #9c968d;
  --gray-6: #837d74;
  --gray-7: #6b655d;
  --gray-8: #555049;
  --gray-9: #403c36;
  --gray-10: #2b2824;
  --gray-11: #171512;
  --gray-12: #000000;
}
