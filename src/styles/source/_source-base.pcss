/* mig:generated v=0.1.0 gen=tokens hash=47464c1e12e05c44 */
/* Global element styling ported from the source site.
   Typography and rhythm only — layout stays the template's. */
@layer source-base {
  main ul li:before {
    font-family: "fontello";
    font-weight: 400;
    margin: 0;
    font-style: normal;
  }

  body {
    color: #292929;
    font: 400 17px/1.2 figtree, sans-serif;
  }

  p {
    color: #292929;
    font: 400 17px/1.666 figtree, sans-serif;
    margin: 10px auto;
  }

  a {
    text-decoration: none;
    color: #2B8435;
  }

  a:hover {
    color: #930E19;
  }

  h2 {
    color: #292929;
    font: 400 46px/1.2 spirits-soft, serif;
    text-transform: uppercase;
  }

  h3 {
    color: #292929;
    font: 400 35px/1.1 spirits-soft, serif;
    text-transform: uppercase;
  }

  h4 {
    color: #292929;
    font: 400 22px/1 spirits-soft, serif;
    text-transform: uppercase;
  }

  main ul li:before {
    color: #2B8435;
    line-height: 1;
    font-size: 22px;
  }

  header li a {
    font-weight: 500;
    font-family: aktiv-grotesk-extended, sans-serif;
  }

  footer a {
    color: #000;
  }

  footer a:hover {
    color: #2B8435;
  }

  @media (min-width: 1025px) {
    nav ul li a {
      color: #fff;
    }

    nav ul li a:hover {
      color: #fff;
    }

    nav > ul > li > a {
      font-size: 16px;
      color: #292929;
    }

    nav > ul > li > a > button > i {
      color: #2B8435;
    }

    nav > ul > li:hover > a {
      color: #2B8435;
    }

    nav ul ul li > a {
      font-size: 14px;
      line-height: 1.3;
      text-transform: none;
    }

    nav ul ul li > a button i {
      color: #fff;
    }

    nav ul ul li:hover > a {
      color: #fff;
    }
  }
}
