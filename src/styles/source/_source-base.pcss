/* mig:generated v=0.1.0 gen=tokens hash=aec85c2d4f610242 */

/* Global element styling ported from the source site.
   Typography and rhythm only — layout stays the template's. */
@layer source-base {
  body {
    color: #333;
    font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji";
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: inherit;
    font-family: inherit;
    font-weight: 500;
    line-height: 1.2;
    margin-block: .5rem 1rem;
  }

  a {
    color: #c36;
    text-decoration: none;
  }

  a:active,
  a:hover {
    color: #336;
  }

  figcaption {
    color: #333;
    font-size: 16px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
  }

  @media print {
    a,
    a:visited {
      text-decoration: underline;
    }
  }
}
