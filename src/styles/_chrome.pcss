  --chrome-header-phone-color: rgb(59, 98, 120);
  --chrome-header-phone-font: "Montserrat", sans-serif;
  --chrome-header-phone-size: 18px;
  --chrome-header-phone-weight: 600;
  --chrome-header-row-pad-bottom: 10px;
  --chrome-header-row-pad-top: 10px;
  --chrome-nav-bg: rgb(255, 255, 255);
  --chrome-nav-border-bottom: 1px solid rgb(232, 232, 232);
  --chrome-nav-border-top: 1px solid rgb(198, 215, 221);
