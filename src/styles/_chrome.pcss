    --chrome-container-max: 960px;
    --chrome-dropdown-item-border: 1px solid rgb(232, 232, 232);
    --chrome-dropdown-item-size: 14px;
    --chrome-dropdown-shadow: rgba(0, 0, 0, 0.15) 9px 10px 5px -8px;
    --chrome-footer-logo-width: 210px;
    --chrome-header-aside-width: 25%;
    --chrome-header-logo-width: 200px;
    --chrome-nav-cta-pad-y: 8px;
    --chrome-nav-cta-size: 16px;
    --chrome-nav-height: 66px;
    --chrome-nav-link-pad-x: 5px;
    --chrome-nav-link-pad-y: 8px;
    --chrome-nav-link-size: 14px;
  }
}

@media (min-width: 1440px) {
  :root {
    --chrome-container-max: 1140px;
    --chrome-footer-logo-width: 255px;
    --chrome-nav-height: 42px;
    --chrome-nav-link-pad-x: 8px;
    --chrome-nav-link-size: 15px;
  }
}
