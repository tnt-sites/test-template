@layer base {
  :where(:root) {
    @keyframes grow-out {
      0% {
        opacity: 0.3;
        transform: translateY(-5%);
      }

      100% {
        opacity: 1;
        transform: translateY(0%);
      }
    }

    @keyframes grow-out-centered {
      0% {
        opacity: 0.3;
        transform: translateX(-50%) translateY(-5%);
      }

      100% {
        opacity: 1;
        transform: translateX(-50%) translateY(0%);
      }
    }

    @keyframes fade-in {
      0% {
        opacity: 0;
      }

      100% {
        opacity: 1;
      }
    }
  }
}

/*
 * Scroll reveal: add `data-reveal` (fade | fade-up | fade-right) to an element and
 * BaseLayout's observer adds `.is-revealed` as it scrolls into view. Elements are
 * only hidden once that script has set `.reveal-ready`, so content stays visible
 * without JS, in the CloudCannon editor, and with reduced motion.
 * Stagger siblings with `--reveal-delay`.
 */
@layer utils {
  .reveal-ready [data-reveal] {
    opacity: 0;
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal-ready [data-reveal="fade-up"] {
    transform: translateY(24px);
  }

  .reveal-ready [data-reveal="fade-right"] {
    transform: translateX(48px);
  }

  .reveal-ready [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
