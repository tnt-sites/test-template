:where(:root) {
  --gray-0: #f4f1ec;
  --gray-1: #e0ddd8;
  --gray-2: #cbc9c5;
  --gray-3: #b7b5b1;
  --gray-4: #a3a19d;
  --gray-5: #8e8d8a;
  --gray-6: #7a7976;
  --gray-7: #666462;
  --gray-8: #51504f;
  --gray-9: #3d3c3b;
  --gray-10: #292827;
  --gray-11: #141414;
  --gray-12: #000000;

  --blue-light: #e8f4fd;
  --blue-dark: #3b82f6;

  --green-light: #e8fce9;
  --green-dark: #10b981;

  --yellow-light: #fef9e7;
  --yellow-dark: #fbbf24;

  --orange-light: #fef3e7;
  --orange-dark: #f97316;

  --red-light: #fee8e8;
  --red-dark: #ef4444;

  --purple-light: #f3e8ff;
  --purple-dark: #a855f7;

  --pink-light: #fde8f2;
  --pink-dark: #ec4899;

  --cyan-light: #e8fffe;
  --cyan-dark: #06b6d4;
}
