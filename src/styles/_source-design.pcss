/*
 * Source-site design layer — ultimatesmiles.com
 *
 * Everything here is measured off the source render at 1440px (see
 * tools/wp-import and wp-migrator/measure.mjs), not invented. It maps the
 * source's type scale, colours and component styling onto the starter's
 * existing tokens so the starter's components keep working.
 *
 * Measured reference values:
 *   body      Source Sans Pro 15px/22.5 #000
 *   h1        Raleway 45px/49.5 weight 400
 *   h2        Raleway 37.5px/41.25 weight 300, UPPERCASE
 *   h3        Raleway 24px/26.4 weight 500
 *   nav link  Source Sans Pro 13px, 15px side padding, 64px line
 *   dropdown  bg #ba9764, white 13px/22 links, 14px/16px padding
 *   button    #ba9764 bg, white, Montserrat 15px/500, radius 30px, 0.5px tracking
 *   footer    72px top padding, Raleway 19.5px/500 headings, 16px/300 links
 */

:where(:root) {
  /*
   * Source content column: the section is 966px wide with 30px of padding, so
   * the text measures 906px. The starter's `xl` (1024px) plus its own padding
   * runs noticeably wider, which is why migrated pages read as edge-to-edge.
   */
  --content-width-xl: 966px;
  --content-width-lg: 906px;

  /* The source sets headings in Raleway and body copy in Source Sans. */
  --font-body: "Source Sans Pro", "Source Sans 3", sans-serif;
  --font-headings: Raleway, sans-serif;
  --font-accent: Montserrat, sans-serif;

  /* Source runs a lighter heading weight than the starter's 700. */
  --font-weight-normal: 400;
  --font-weight-semibold: 500;
  --font-weight-bold: 600;

  /* Body copy is 15-16px, not the starter's 16px/1.6. */
  --font-size-md: 1rem;
  --line-height-normal: 1.5;

  /* Heading ramp, from the measured sizes. */
  --font-size-heading-xs: 1.125rem; /* 18px */
  --font-size-heading-sm: 1.219rem; /* 19.5px — footer headings */
  --font-size-heading-md: 1.5rem; /* 24px  — h3 */
  --font-size-heading-lg: 1.75rem; /* 28px */
  --font-size-heading-xl: 2.344rem; /* 37.5px — h2 */
  --font-size-heading-2xl: 2.813rem; /* 45px   — h1 */
  --font-size-heading-3xl: 3.5rem;

  /* Brand palette. */
  --color-brand: #79a37b;
  --color-brand-secondary: #ba9764;
  --color-accent: #ba9764;
}

@layer base {
  body {
    color: var(--color-text);
    font-size: var(--font-size-md);
    line-height: 1.5;
  }

  /*
   * Two distinct scales on the source, and they must not be conflated:
   *
   *   homepage / landing   h1 45px/400, h2 37.5px/300 UPPERCASE, h3 24px/500
   *   interior content     h1 60px/200 (banner), h2 and h3 22.5px/400,
   *                        h4 26.25px/400, body 16.5px/300, links 15px
   *
   * The display sizes were measured on the homepage and previously applied
   * everywhere, which made every interior heading far too large and wrongly
   * uppercased.
   */
  :where(:root) {
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: var(--font-headings);
      font-weight: 400;
      letter-spacing: 0;
    }

    h1 {
      font-size: 2.813rem; /* 45px */
      font-weight: 400;
      line-height: 1.1;
    }

    h2 {
      font-size: 2.344rem; /* 37.5px */
      font-weight: 300;
      line-height: 1.1;
      text-transform: uppercase;
    }

    h3 {
      font-size: 1.5rem; /* 24px */
      font-weight: 500;
      line-height: 1.1;
    }

    h4,
    h5 {
      font-weight: 400;
    }
  }

  a {
    color: var(--color-link);
  }
}

@layer components {
  /* Buttons are gold pills with Montserrat caps. */
  .button,
  .btn,
  a.button {
    background-color: var(--color-brand-secondary);
    border-radius: 30px;
    color: #fff;
    font-family: var(--font-accent);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding-inline: 30px;
    text-transform: capitalize;
  }

  .button:hover,
  .btn:hover {
    background-color: #a8854f;
    color: #fff;
  }
}

@layer overrides {
  /* The source lays definition lists out in two columns (2 x 464px inside a
     929px row); ours stacked them into one narrow column. */
  .definition-list {
    display: grid;
    gap: var(--spacing-sm) var(--spacing-xl);
  }

  @media (min-width: 900px) {
    .definition-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Each term/definition pair is one grid cell. CloudCannon wraps them in
     <editable-array-item>, which is inline by default and collapses the grid. */
  .definition-list > editable-array-item,
  .definition-list > div {
    break-inside: avoid;
    display: block;
    /* DefinitionList.astro spans each item across the whole grid
       (grid-column: 1 / -1) and puts the term beside its text; the source
       stacks them, each the full width of its column. */
    grid-column: auto;
  }

  .definition-list dt {
    font-weight: 600;
  }

  .definition-list dd {
    margin-left: 0;
  }

  .definition-list > div,
  .definition-list .definition-list-item {
    break-inside: avoid;
  }

  /*
   * Call-outs on the source are a compact centred bubble (850px, 88% max,
   * 25px padding, 10px radius) - not a full-bleed band. The migrated version
   * paints the whole section green, so constrain the inner content instead.
   */
  .section[data-bg="accent"] > .inner-content,
  .bg-accent > .inner-content {
    margin-inline: auto;
    max-width: 88%;
  }

  /* The green definition/call-out panels need dark text, as on the source:
     #79a37b is light enough that white body copy is hard to read. */
  .section[style*="79a37b"],
  .bg-accent,
  [data-bg="accent"] {
    --color-text: #1a1a1a;
    --color-text-strong: #14290f;
  }

  /*
   * Header. The source renders the logo at 143x85 in a 114px-tall band: a
   * 50px top strip (address + gold CTA pills) over a 64px nav row. The
   * starter caps the logo at 1.8em, which shrinks it to a smudge.
   */
  .main-nav > .outer-content .hd-content > a > .image img,
  .main-nav .main-nav-logo img {
    height: auto !important;
    max-height: 85px;
    max-width: 200px;
    width: auto !important;
  }

  .main-nav {
    --chrome-nav-link-size: 13px;
  }

  /*
   * The starter sizes the header's button slot for a single search icon
   * (flex: 0 0 30px), so the source's two text CTAs overflow the viewport.
   * Let the group size to its content and wrap onto the address row.
   */
  .main-nav > .outer-content .hd-content .nav-end > .desktop-button-group.button-group {
    flex: 0 0 auto !important;
  }

  .main-nav > .outer-content .hd-content .nav-end {
    flex-wrap: wrap;
  }

  .main-nav .button-group {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /*
   * The source's header is a 50px top strip (address + CTA pills, inline)
   * over a 64px nav row. The starter stacks .hd-info, .hd-btns and .hd-nav
   * as three separate rows, so pull the first two onto one line.
   */
  @media (min-width: 1025px) {
    /*
     * Source header: logo on the left, and to its right a 50px strip holding
     * the address and the gold CTA pills, with the nav row beneath. The
     * starter stacks .hd-info / .hd-btns / .hd-nav as three separate rows.
     */
    .main-nav .hd-content {
      align-items: flex-start;
      display: flex;
      flex-wrap: nowrap;
      gap: var(--spacing-lg);
    }

    .main-nav .hd-content > .logo-link {
      flex: 0 0 auto;
    }

    /* Address + CTAs share the top strip. */
    .main-nav .hd-info {
      align-items: center;
      display: flex;
      gap: var(--spacing-md);
      justify-content: flex-end;
      order: 1;
    }

    .main-nav .hd-btns {
      margin-top: 0;
      order: 2;
    }

    .main-nav .hd-nav {
      order: 3;
      width: 100%;
    }

    .main-nav .hd-nav .nav-end {
      justify-content: flex-end;
      width: 100%;
    }

    /* The starter sets .hd-right to flex-column at a higher specificity
       (> .outer-content .hd-content .hd-right), so match it here. */
    .main-nav > .outer-content .hd-content .hd-right {
      display: grid;
      flex: 1 1 auto;
      margin-right: 0;
      grid-template-areas:
        "info btns"
        "nav  nav";
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .main-nav .hd-info {
      grid-area: info;
    }

    .main-nav .hd-btns {
      grid-area: btns;
    }

    .main-nav .hd-nav {
      grid-area: nav;
    }

    .main-nav .hd-info .phy {
      display: inline;
      font-size: 15px;
      letter-spacing: normal;
      text-transform: none;
    }

    .main-nav .hd-info .pho {
      font-size: 15px;
    }
  }

  /* Header CTAs are compact gold pills, not full-size buttons. */
  .main-nav .button-group .button {
    font-size: 0.875rem;
    padding-block: 0.5rem;
    padding-inline: 20px;
    white-space: nowrap;
  }

  /* Nav links are 13px with 15px of side padding on a 64px line. */
  .main-nav .nav-link,
  .main-nav a.nav-link {
    font-size: 13px;
    padding-inline: 15px;
  }

  /* The dropdown panel is a solid gold sheet with white 13px links. */
  .main-nav .dropdown-content,
  .main-nav [class*="dropdown"] > ul {
    background-color: var(--chrome-dropdown-bg, #ba9764);
  }

  .main-nav .dropdown-content a {
    color: var(--chrome-dropdown-item-color, #fff);
    font-size: var(--chrome-dropdown-item-size, 13px);
    font-weight: var(--chrome-dropdown-item-weight, 500);
    padding: 14px 16px;
  }

  /* Footer: 72px top padding, Raleway headings, light 16px links. */
  footer {
    padding-top: var(--chrome-footer-pad-block, 72px);
  }

  footer h1,
  footer h2,
  footer h3,
  footer h4,
  footer h5 {
    font-family: var(--chrome-footer-column-font, Raleway, sans-serif);
    font-size: var(--font-size-heading-sm);
    font-weight: 500;
    text-transform: none;
  }

  footer a {
    font-size: var(--chrome-footer-link-size, 16px);
    font-weight: var(--chrome-footer-link-weight, 300);
  }

  footer .footer-logo img,
  footer img[alt*="North County"] {
    max-width: var(--chrome-footer-logo-width, 300px);
  }
}

@layer overrides {
  /*
   * Source decoration, all measured off the render:
   *   h2/h3 rule   906px x 1px, 12px margins, under every content heading
   *   bullets      square markers, no disc dots
   *   sidebar      #e6e6e6 panels, 30px padding
   *   call-out     850px (88% max), 10px radius, 20px ::after tail
   *   sections     30px vertical margins between content blocks
   */

  /* Decorative rule under content headings. */
  .cws-main .section h2,
  .cws-main .section h3,
  .content-with-sidebar h2,
  .content-with-sidebar h3 {
    border-bottom: 1px solid var(--color-border, #d2cec7);
    margin-bottom: 12px;
    padding-bottom: 12px;
  }

  /*
   * Lists. Measured on the source: square markers in the TEXT colour, no
   * padding-left, an 18px margin. The starter's `main ul` rule (_base.pcss)
   * sets `display: block` with a Fontello glyph in `li::before`, which
   * suppresses real markers and adds 24px of padding, so that is unwound too.
   *
   * The List component renders <ul class="list"> and CloudCannon wraps each
   * <li> in <editable-array-item>, so `ul > li` alone never matches.
   */
  main ul.list,
  main .cws-main ul,
  main .cws-side ul {
    list-style: none;
    margin: 10px 0;
    /* The starter sets overflow:hidden here (it needs it for its absolutely
       positioned ::before glyph). With list-style-position:outside that clips
       the real marker, so the bullets vanish entirely. */
    overflow: visible;
    padding-left: 0;
  }

  main ul.list > editable-array-item {
    display: contents;
  }

  main ul.list li,
  main .cws-main ul li,
  main .cws-side ul li {
    display: list-item;
    list-style-position: outside;
    list-style-type: square;
    margin: 0 0 6px 18px;
    overflow: visible;
    padding-left: 0;
  }

  main ul.list li::before,
  main .cws-main ul li::before,
  main .cws-side ul li::before {
    content: none;
  }

  main ul.list li::marker,
  main .cws-main ul li::marker,
  main .cws-side ul li::marker {
    color: var(--color-text);
  }

  /* The Q&A blocks are plain linked lines on the source — no markers at all. */
  main .faq-card ul li {
    list-style-type: none;
    margin-left: 0;
  }

  /* Vertical rhythm between content blocks. */
  .cws-main > * > .section + .section,
  .cws-main .section + .section {
    margin-top: 30px;
  }

  /* Sidebar panels sit on grey with generous padding. */
  .cws-side .section {
    background-color: #e6e6e6;
    margin-bottom: 30px;
    padding: 30px;
  }

  .cws-side h2,
  .cws-side h3,
  .cws-side h4,
  .cws-side h5 {
    border-bottom: 1px solid #c9c5be;
    font-size: 1.219rem;
    margin-bottom: 12px;
    padding-bottom: 10px;
    text-transform: none;
  }

  .cws-side ul > li {
    list-style-type: square;
    margin-left: 1.1em;
  }

  /* Call-outs: a narrow green bubble with a tail, not a full-bleed band. */
  .callout-bubble {
    background-color: var(--color-brand, #79a37b);
    border-radius: 10px;
    margin: 30px auto;
    max-width: min(850px, 88%);
    padding: 25px;
    position: relative;
  }

  .callout-bubble::after {
    border: 20px solid transparent;
    border-top-color: var(--color-brand, #79a37b);
    content: "";
    height: 0;
    left: 48px;
    position: absolute;
    top: 100%;
    width: 0;
  }

  .callout-bubble p:last-child {
    margin-bottom: 0;
  }
}

@layer overrides {
  /*
   * Interior page content scale, measured on /vista-ca/ pages. Body copy is
   * 16.5px/300 at 1.5 line-height; content headings are 22.5px/400 and are NOT
   * uppercase - only the homepage's display h2 is.
   */
  .cws-main,
  .content-with-sidebar {
    font-size: 1.031rem; /* 16.5px */
  }

  .cws-main p,
  .content-with-sidebar p,
  .pb-intro p,
  .section p {
    font-size: 1.031rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .cws-main li,
  .cws-side li {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.3;
  }

  .cws-main h2,
  .content-with-sidebar h2 {
    font-size: 1.406rem; /* 22.5px */
    font-weight: 400;
    line-height: 1.1;
    text-transform: none;
  }

  .cws-main h3,
  .content-with-sidebar h3 {
    font-size: 1.406rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .cws-main h4,
  .content-with-sidebar h4 {
    font-size: 1.641rem; /* 26.25px */
    font-weight: 400;
    line-height: 1.1;
  }

  .cws-main h5,
  .cws-side h5,
  .content-with-sidebar h5 {
    font-size: 1.406rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .cws-main a,
  .cws-side a {
    font-size: inherit;
  }

  /* Definition lists: 18px/400 terms over 16px/300 text. */
  .definition-list dt {
    font-size: 1.125rem;
    font-weight: 400;
  }

  .definition-list dd {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
  }
}

@layer overrides {
  /*
   * Interior content sections are grey cards on a white page — #e6e6e6 with
   * 40px/30px padding, a 2px radius and 30px vertical margins. (I originally
   * read this the other way round, as white cards on grey.)
   */
  .cws-main > * > .section,
  .cws-main .section {
    border-radius: 2px;
  }

  /* The FAQ and the link panels sit a shade darker, as on the source. */
  .cws-main .faq-card,
  .cws-main .links-card {
    background-color: #dcdcdc;
  }

  /* Definition panel: dark text on the green, terms italic. */
  /* Term sits ABOVE its definition, both full column width. Measured: dt 18px/400
     at y=3477, dd 16px/300 at y=3504, same x, 442px wide. Not italic. */
  .definition-list dt {
    color: #111;
    font-size: 1.125rem;
    font-style: normal;
    font-weight: 400;
    margin-top: 16px;
  }

  .definition-list dd {
    color: #1a1a1a;
    margin-bottom: 20px;
  }

  /* The sidebar search button is a compact pill, not full width. */
  .sidebar-search .ss-form {
    align-items: center;
    grid-template-columns: 1fr auto;
  }
}

@layer overrides {
  /*
   * Links. Every link on the source is the body colour, never a brand colour.
   * In running content they are underlined; in the sidebar rails they are not,
   * and pick up an underline on hover.
   *
   * Scoped to the components rather than the page wrapper so the rules survive
   * regeneration, and specific enough to beat the starter's own `a` rule.
   */
  main .section p a,
  main .section li a,
  main .section .text a,
  main ul.list li a,
  main .callout-bubble a,
  main .cws-main a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  main .section p a:hover,
  main .section li a:hover,
  main ul.list li a:hover,
  main .cws-main a:hover {
    color: var(--color-text-strong);
  }

  /* Sidebar rails: no underline until hover. */
  main .cws-side a,
  main .cws-side li a,
  main .cws-side ul.list li a {
    color: var(--color-text);
    text-decoration: none;
  }

  main .cws-side a:hover,
  main .cws-side li a:hover,
  main .cws-side ul.list li a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Back-to-top and breadcrumbs sit under the content column, not centred
     beneath content plus sidebar. */
  main .page-footer-nav .pfn-inner {
    margin-inline: 0;
    max-width: none;
  }
}

@layer overrides {
  /*
   * The starter's reset sets -webkit-font-smoothing: antialiased, which renders
   * noticeably thinner than the source. The source leaves smoothing at `auto`
   * (subpixel on macOS), which is why the migrated text read as too light even
   * though every computed font-weight matched.
   */
  html,
  body {
    -moz-osx-font-smoothing: auto;
    -webkit-font-smoothing: auto;
  }
}

@layer overrides {
  /*
   * Definition list — final word, measured on the source.
   *
   * The term is wrapped in <dfn> on the source, which renders ITALIC by UA
   * default. My earlier pass measured the <dt> (normal) and concluded there
   * was no italic, then removed it; the italic lives one level in.
   *
   *   dl   16px vertical margins
   *   dt   18px/400 italic
   *   dd   16px/300, 20px bottom margin
   *   each pair below the first row carries a 1px rule above it
   */
  main .definition-list {
    margin-block: 16px;
  }

  main .definition-list dt {
    color: #111;
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 400;
    margin-bottom: 0;
    margin-top: 16px;
  }

  main .definition-list dd {
    color: #1a1a1a;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
    margin-bottom: 20px;
    margin-left: 0;
  }

  /* The source draws .divider.divider-solid above each pair after the first
     row; with a two-column grid that is every item from the third on. */
  main .definition-list > editable-array-item:nth-child(n + 3),
  main .definition-list > div:nth-child(n + 3) {
    border-top: 1px solid rgb(0 0 0 / 18%);
    padding-top: 10px;
  }

  /* Vertical separation between every coloured block in the content column. */
  main .cws-main > editable-array > editable-array-item + editable-array-item > .section,
  main .cws-main > editable-array > editable-array-item > .section {
    margin-block: 30px;
  }
}
