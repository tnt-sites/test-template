/* Light theme (fallback defaults only).
 *
 * The --color-brand*, --color-text-on-brand, --color-link*, and --font-* variables
 * below are overridden at runtime by src/layouts/BaseLayout.astro, which reads
 * src/data/branding.json — edited via the CloudCannon CMS color/font pickers
 * (see cloudcannon.config.yml). Editing the values here only changes what renders
 * when branding.json has no value set for that field; to change live branding,
 * edit branding.json / the CMS fields instead.
 */
:root,
[data-theme="default"] {
  color-scheme: light;

  --color-brand: red;
  --color-brand-secondary: blue;
  --color-brand-muted: green;
  --color-brand-subtle: var(--gray-7);
  --color-brand-on: var(--gray-0);

  --color-text: var(--gray-10);
  --color-text-strong: var(--gray-12);
  --color-text-muted: var(--gray-8);
  --color-text-on-muted: var(--gray-12);
  --color-text-on-brand: var(--gray-0);
  /* The brand secondary is a light lime; white on it is ~1.8:1, so text
     sitting on it uses a dark ink instead of --color-text-on-brand. */
  --color-text-on-brand-secondary: var(--gray-12);
  /* ...and the reverse: the lime is unreadable as text on a light ground, so
     text tinted with the brand secondary uses this darkened green instead. */
  --color-text-brand-secondary: #417b1e;
  --color-text-inverse: var(--gray-0);
  --color-link: blue;
  --color-link-hover: darkblue;
  --color-star: #febb21;
  --color-social-facebook: var(--blue-dark);
  --color-social-google: var(--red-dark);
  --color-social-instagram: var(--pink-dark);
  --color-social-twitter: var(--blue-dark);
  --color-social-tiktok: var(--gray-12);
  --color-social-yelp: var(--red-dark);
  --color-social-bluesky: var(--cyan-dark);
  --color-social-youtube: var(--red-dark);

  --color-bg: var(--gray-0);
  --color-bg-surface: var(--gray-1);
  --color-bg-muted: var(--gray-2);
  --color-bg-accent: #d5fdff;
  --color-bg-highlight: #fff9d6;
  --color-bg-brand: var(--color-brand);
  --color-bg-brand-secondary: var(--color-brand-secondary);
  --color-bg-brand-muted: var(--color-brand-muted);
  --color-bg-inverse: var(--gray-12);
  --color-bg-dark: #2c363c;
  --color-bg-black: #000;

  --color-border: var(--gray-4);
  --color-border-inputs: var(--gray-7);
  --color-border-strong: var(--gray-10);
  --color-border-subtle: var(--gray-1);

  --color-state-hover: rgba(0, 0, 0, 0.04);
  --color-state-active: rgba(0, 0, 0, 0.08);
  --color-overlay: rgba(0, 0, 0, 0.5);

  --color-focus-ring: rgba(0, 87, 255, 0.4);
  --color-error: #f00;
}

/* mig:begin source-theme */
:root,
[data-theme="default"] {
  --color-bg: #ffffff;
  --color-text: #414b4d;
  --color-text-strong: #1b2e38;
  --color-link: #177982;
}
/* mig:end source-theme */
