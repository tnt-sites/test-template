---
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import PepPage from "@layouts/PepPage.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export interface Props {
  page: CollectionEntry<"pep-pages">;
}

export async function getStaticPaths() {
  const pages = await getCollection("pep-pages");

  return pages.map((page: CollectionEntry<"pep-pages">) => {
    const slug = page.id.replace(/index$/, "");

    if (slug.length === 0) return { params: { slug: undefined }, props: { page } };
    return { params: { slug }, props: { page } };
  });
}

const { page } = Astro.props as Props;
const { Content } = await render(page);

// If a parentLandingPage is set, inherit its landingMainNav / landingFooter.
const parentId = page.data.parentLandingPage;
let parentPage: CollectionEntry<"pep-pages"> | undefined;
if (parentId) {
  const allPages = await getCollection("pep-pages");
  const normalizedParentId = parentId.toLowerCase();
  parentPage = allPages.find(
    (p: CollectionEntry<"pep-pages">) => p.id.toLowerCase() === normalizedParentId
  );
}

const frontmatter = parentPage
  ? {
      ...page.data,
      landingMainNav: parentPage.data.landingMainNav ?? page.data.landingMainNav,
      landingFooter: parentPage.data.landingFooter ?? page.data.landingFooter,
      head_scripts: parentPage.data.head_scripts ?? page.data.head_scripts,
      footer_scripts: parentPage.data.footer_scripts ?? page.data.footer_scripts,
    }
  : page.data;
---

<PepPage frontmatter={frontmatter} mainNav={mainNavData} footer={footerData}>
  <Content />
</PepPage>
