---
// Standalone preview of an inline-SVG, CSS-animated version of the
// Component 82 (why-1) artwork — a Pac-Man style icon "eating" a
// trail of dots on a continuous loop.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Why-1 Animation Demo</title>
  </head>
  <body>
    <main class="demo-page">
      <h1>Why-1 Animation Demo</h1>

      <div class="demo-block">
        <svg
          class="pac-loader"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 92.32 73.364"
          role="img"
          aria-label="Loading animation"
        >
          <path
            class="pac-body"
            d="M36.682,2.9A33.775,33.775,0,0,1,66.5,20.788L38.564,34.02,33.05,36.632l5.509,2.623,27.949,13.31A33.787,33.787,0,1,1,36.682,2.9m0-2.9a36.682,36.682,0,1,0,33.7,51.2L39.8,36.639l30.57-14.479A36.69,36.69,0,0,0,36.682,0"
            fill="#fdee3b"
          />
          <circle class="pac-eye" cx="36.04" cy="12.73" r="4.565" fill="#f7f4f4" />

          <g class="dots">
            <circle class="dot" style="--i: 0;" cx="87.754" cy="31.745" r="4.565" fill="#f7f4f4" />
            <circle class="dot" style="--i: 1;" cx="87.754" cy="31.745" r="4.565" fill="#f7f4f4" />
            <circle class="dot" style="--i: 2;" cx="87.754" cy="31.745" r="4.565" fill="#f7f4f4" />
            <circle class="dot" style="--i: 3;" cx="87.754" cy="31.745" r="4.565" fill="#f7f4f4" />
          </g>
        </svg>
      </div>
    </main>
  </body>
</html>

<style>
  .demo-page {
    align-items: center;
    background: #f5f7fa;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-height: 100vh;
    padding: 3rem 1rem;
  }

  .demo-block {
    background: #111827;
    border-radius: 12px;
    padding: 3rem;
  }

  .pac-loader {
    width: 200px;
  }

  .dot {
    animation: dot-travel 2.4s linear infinite;
    animation-delay: calc(var(--i) * -0.6s);
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes dot-travel {
    0% {
      opacity: 1;
      transform: translateX(0);
    }
    25% {
      opacity: 1;
      transform: translateX(-15.15px);
    }
    50% {
      opacity: 0.5;
      transform: translateX(-30.45px);
    }
    75%,
    100% {
      opacity: 0;
      transform: translateX(-45.45px);
    }
  }
</style>
