---
import StructuredData from "@components/utils/StructuredData.astro";
import brandingData from "@data/branding.json";
import seoData from "@data/seo.json";
import Modal from "@page-sections/info-blocks/modal/Modal.astro";
import "@styles/global.css";
import "@styles/style.pcss";
import { SEO } from "astro-seo";

export interface Props {
  title: string;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  contentSections?: any;
  siteInfo?: any;
  modals?: any[];
  globalModals?: any[];
  global_modals?: any[];
  headScripts?: string[];
  head_scripts?: string[];
  footerScripts?: string[];
  footer_scripts?: string[];
  extraFontLinks?: string[];
}

const props = Astro.props;
const formattedTitle = seoData.titleFormat.replace("{title}", props.title);

// --- Branding: single source of truth for live theme colors/fonts ---
// Values below come from src/data/branding.json, editable via the CloudCannon CMS
// color/font pickers (see cloudcannon.config.yml). They're emitted as a `:root,
// [data-theme="default"] { ... }` stylesheet rule (matching _default.pcss's own
// selector) rather than an inline style on <html>, because any nested section
// with an explicit `data-theme="default"` (e.g. a CustomSection's colorScheme
// prop) gets its OWN copy of these custom properties from _default.pcss — an
// element's own declaration always wins over an inherited one, so an inline
// style on <html> alone can't reach through to override it. `!important` makes
// sure this rule wins regardless of stylesheet ordering. [data-theme="contrast"]
// sections are deliberately left alone — they use neutral grays, not brand hues.
// To change live branding, edit branding.json / the CMS fields — not _default.pcss.
// --- Branding: core color fields mapped to their CSS custom properties ---
const sanitizeCssValue = (value: string) => value.split(/[<>{}]|;/)[0].trim();

const brandingColorVars: Record<string, string> = {
  colorBrand: "--color-brand",
  colorBrandSecondary: "--color-brand-secondary",
  colorBrandTertiary: "--color-brand-muted",
  colorBrandSubtle: "--color-brand-subtle",
  colorBrandOn: "--color-brand-on",
  colorTextOnBrand: "--color-text-on-brand",
  colorLink: "--color-link",
  colorLinkHover: "--color-link-hover",
};
const brandingColorsCss = Object.entries(brandingColorVars)
  .map(([key, variable]) => {
    const value = (brandingData as any)[key];
    return typeof value === "string" && value.trim()
      ? `${variable}: ${sanitizeCssValue(value)} !important;`
      : "";
  })
  .filter(Boolean)
  .join(" ");

// --- Branding: extraColors runtime overrides (arbitrary user-defined CSS vars) ---
const brandingExtraColors = Array.isArray(brandingData.extraColors) ? brandingData.extraColors : [];
const extraColorsCss = (brandingExtraColors as any[])
  .filter((e: any) => e?.variable?.trim() && e?.value?.trim())
  .map((e: any) => `${sanitizeCssValue(e.variable)}: ${sanitizeCssValue(e.value)} !important;`)
  .join(" ");

// --- Branding: font family fields mapped to their CSS custom properties ---
const brandingFontVars: Record<string, string | undefined> = {
  "--font-body": brandingData.bodyFont?.fontFamily,
  "--font-headings": brandingData.headingsFont?.fontFamily,
  "--font-sans": brandingData.bodyFont?.fontFamily,
  "--font-serif": brandingData.headingsFont?.fontFamily,
};
const brandingFontsCss = Object.entries(brandingFontVars)
  .map(([variable, value]) =>
    typeof value === "string" && value.trim() ? `${variable}: ${sanitizeCssValue(value)} !important;` : ""
  )
  .filter(Boolean)
  .join(" ");

const brandingCss = [brandingColorsCss, extraColorsCss, brandingFontsCss].filter(Boolean).join(" ");
const brandingCssRule = brandingCss ? `:root, [data-theme="default"] { ${brandingCss} }` : "";

// --- Branding: font link URLs ---
const legacyBrandingFontUrls = [
  brandingData.bodyFont?.linkUrl?.trim() ?? "",
  brandingData.headingsFont?.linkUrl?.trim() ?? "",
  ...(((brandingData.extraFonts as any[]) ?? []) as any[])
    .map((f: any) => (typeof f === "string" ? f : (f?.linkUrl ?? "")))
    .filter(Boolean),
];
const brandingFontUrls = Array.isArray(brandingData.fontLinks)
  ? brandingData.fontLinks
      .map((url: any) => (typeof url === "string" ? url.trim() : ""))
      .filter(Boolean)
  : legacyBrandingFontUrls;
const allBrandingFontUrls = [...new Set(brandingFontUrls.filter(Boolean))];

const pageExtraFontLinks = Array.isArray(props.extraFontLinks)
  ? (props.extraFontLinks as string[]).filter(Boolean)
  : [];
const pageDescription = props.description || seoData.description;
const pageImage = props.image || seoData.logoSource;

const getScriptArray = (value: unknown): string[] =>
  Array.isArray(value)
    ? value.filter(
        (script): script is string => typeof script === "string" && script.trim().length > 0
      )
    : [];

const uniqueScripts = (scripts: string[]) => Array.from(new Set(scripts));
const getModalArray = (value: unknown): Record<string, any>[] =>
  Array.isArray(value)
    ? value.filter((item): item is Record<string, any> => !!item && typeof item === "object")
    : [];

const pageHeadScripts = uniqueScripts([
  ...getScriptArray(props.headScripts),
  ...getScriptArray(props.head_scripts),
  ...getScriptArray(props.contentSections?.headScripts),
  ...getScriptArray(props.contentSections?.head_scripts),
]);
const siteInfoHeadScripts = uniqueScripts([
  ...getScriptArray(props.siteInfo?.headScripts),
  ...getScriptArray(props.siteInfo?.head_scripts),
]);
const headScripts = pageHeadScripts.length > 0 ? pageHeadScripts : siteInfoHeadScripts;

const pageFooterScripts = uniqueScripts([
  ...getScriptArray(props.footerScripts),
  ...getScriptArray(props.footer_scripts),
  ...getScriptArray(props.contentSections?.footerScripts),
  ...getScriptArray(props.contentSections?.footer_scripts),
]);
const siteInfoFooterScripts = uniqueScripts([
  ...getScriptArray(props.siteInfo?.footerScripts),
  ...getScriptArray(props.siteInfo?.footer_scripts),
]);
const footerScripts = pageFooterScripts.length > 0 ? pageFooterScripts : siteInfoFooterScripts;

const globalModals = [
  ...getModalArray(props.modals),
  ...getModalArray(props.globalModals),
  ...getModalArray(props.global_modals),
  ...getModalArray(props.siteInfo?.modals),
  ...getModalArray(props.siteInfo?.globalModals),
  ...getModalArray(props.siteInfo?.global_modals),
].filter((modal) => typeof modal.id === "string" && modal.id.trim().length > 0);
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline>
      @layer reset, base, source-base, components, page-sections, source-bridge, utils, overrides;
    </style>
    <style is:inline set:html={brandingCssRule || "/* no branding overrides set */"}></style>

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
      }
    </script>

    <SEO
      title={formattedTitle}
      description={pageDescription}
      openGraph={{
        basic: {
          title: formattedTitle,
          type: "website",
          image: pageImage,
        },
        optional: {
          description: pageDescription,
        },
      }}
      extend={{
        link: [
          {
            rel: "canonical",
            href: props.canonical || Astro.url.href,
          },
        ],
      }}
    />

    <StructuredData site={seoData} />

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link href="https://tntwebsites.com/tnticons/css/fontello.css" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {allBrandingFontUrls.map((url) => <link href={url} rel="stylesheet" />)}
    {pageExtraFontLinks.map((url) => <link href={url} rel="stylesheet" />)}
    <slot name="head" />
    {headScripts.map((script: string) => <script is:inline set:html={script} />)}
  </head>
  <body>
    <Fragment>
      <slot />
    </Fragment>
    {
      globalModals.map((modal, index) => (
        <Modal
          id={modal.id.trim().replace(/^#/, "")}
          closeLabel={modal.closeLabel}
          showCloseButton={modal.showCloseButton}
          class={modal.class}
          contentSections={modal.contentSections}
          propName={`siteInfo.modals.${index}.contentSections`}
        />
      ))
    }
    <script>
      import "@choctawnationofoklahoma/lite-vimeo";
      import "@justinribeiro/lite-youtube";
    </script>
    {footerScripts.map((script: string) => <script is:inline set:html={script} />)}
  </body>
</html>
