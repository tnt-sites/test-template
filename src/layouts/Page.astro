---
import FixedTabs from "@components/navigation/fixed-tabs/FixedTabs.astro";
import Footer from "@components/navigation/footer/Footer.astro";
import MainNavigation from "@components/navigation/main-nav/MainNav.astro";
import ReadyBar from "@components/navigation/ready-bar/ReadyBar.astro";
import Components from "@components/utils/renderBlock.astro";
import fixedTabsData from "@data/fixedTabs.json";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import siteInfoData from "@data/siteInfo.json";
import Layout from "@layouts/BaseLayout.astro";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    pageSections?: any[];
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  mainNav?: Record<string, any>;
  footer?: Record<string, any>;
  siteInfo?: Record<string, any>;
  fixedTabs?: Record<string, any>;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  mainNav = mainNavData,
  footer = footerData,
  siteInfo = siteInfoData,
  fixedTabs = fixedTabsData,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const pageSections = frontmatter?.pageSections;
const hasPageSections = pageSections && pageSections.length > 0;
const hasSlotContent = Astro.slots.has("default");
const fixedTabItems = Array.isArray(fixedTabs?.tabs) ? fixedTabs.tabs : [];
const hasActiveFixedTabs = fixedTabItems.some((tab: any) => tab?.enabled !== false);
const footerSocials = (siteInfo as any)?.socials || (footer as any)?.socials || [];
const footerOffices =
  Array.isArray((footer as any)?.offices) && (footer as any).offices.length > 0
    ? (footer as any).offices
    : (siteInfo as any)?.offices;
const navOffices =
  Array.isArray((mainNav as any)?.offices) && (mainNav as any).offices.length > 0
    ? (mainNav as any).offices
    : (siteInfo as any)?.offices;
const footerSiteName = (footer as any)?.siteName || (siteInfo as any)?.siteName;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
  siteInfo={siteInfo}
>
  <MainNavigation {...mainNav} offices={navOffices} socials={footerSocials} />
  <main data-pagefind-body>
    {
      hasPageSections ? (
        <Components contentSections={pageSections} propName="pageSections" />
      ) : hasSlotContent ? (
        <slot />
      ) : null
    }
  </main>
  <ReadyBar {...((siteInfo as any)?.readyBar ?? {})} />
  <Footer
    {...footer}
    siteName={footerSiteName}
    offices={footerOffices}
    socials={footerSocials}
    data-fixed-tabs-active={hasActiveFixedTabs ? "true" : undefined}
  />
  <FixedTabs {...fixedTabs} />
</Layout>

<style lang="pcss" is:global>
  /* ----------------------------------------------------------------------
     Header clearance for first sections that have no hero behind them.

     `.main-nav` is `position: fixed` and overlays the page, matching the
     source. The sections written to sit under it carry their own clearance
     already — `#banner` (homepage) and `#interior-banner` start their content
     220px+ down — but a plain first section starts at y=0 and its heading
     landed behind the nav pill.

     This is the source's own answer to the same case:
     `.banner-no-img #interior-banner { padding: 200px 20px 60px }`, dropping
     to 120px at its 1024px breakpoint. Listed by component class rather than
     applied to every first section so the image heroes keep their own
     spacing; the second selector covers a render without the CloudCannon
     editing wrappers.

     The trailing `:is(#interior-banner, .custom-section)` is a specificity
     bump, not a filter. Two of these pages carry `id="interior-banner"` from
     the source, which pulls in `InteriorBanner`'s id-scoped `padding: 0`, and
     (1,0,0) beats any number of classes. An id inside the `:is()` lifts this
     rule to (1,x,x) so it wins; the `.custom-section` branch keeps it matching
     the sections that do not carry that id.
     ---------------------------------------------------------------------- */
  main
    > editable-array
    > editable-array-item:first-child
    > .custom-section:is(.hero-center, .sitemap):is(#interior-banner, .custom-section),
  main
    > .custom-section:is(.hero-center, .sitemap):is(#interior-banner, .custom-section):first-child {
    padding-top: 200px;
  }

  @media (max-width: 1024px) {
    main
      > editable-array
      > editable-array-item:first-child
      > .custom-section:is(.hero-center, .sitemap):is(#interior-banner, .custom-section),
    main
      > .custom-section:is(.hero-center, .sitemap):is(#interior-banner, .custom-section):first-child {
      padding-top: 120px;
    }
  }
</style>
