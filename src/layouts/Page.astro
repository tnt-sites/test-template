---
import FixedTabs from "@components/navigation/fixed-tabs/FixedTabs.astro";
import Footer from "@components/navigation/footer/Footer.astro";
// Artisan's own header reproduces the source site's two-bar design; the
// starter's MainNav renders a different layout that `mig chrome` can only
// recolour, never restructure.
import ArtisanHeader from "@components/navigation/artisan-header/ArtisanHeader.astro";
import Components from "@components/utils/renderBlock.astro";
import fixedTabsData from "@data/fixedTabs.json";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import siteInfoData from "@data/siteInfo.json";
import Layout from "@layouts/BaseLayout.astro";

type Props = {
  frontmatter?: {
    title: string;
    description?: string;
    keywords?: string[];
    image?: string;
    canonical?: string;
    pageSections?: any[];
  };
  title?: string;
  description?: string;
  keywords?: string[];
  image?: string;
  canonical?: string;
  mainNav?: Record<string, any>;
  footer?: Record<string, any>;
  siteInfo?: Record<string, any>;
  fixedTabs?: Record<string, any>;
};

const {
  frontmatter,
  title: titleProp,
  description: descriptionProp,
  keywords: keywordsProp,
  image: imageProp,
  canonical: canonicalProp,
  mainNav = mainNavData,
  footer = footerData,
  siteInfo = siteInfoData,
  fixedTabs = fixedTabsData,
} = Astro.props as Props;

const title = frontmatter?.title ?? titleProp ?? "";
const description = frontmatter?.description ?? descriptionProp;
const keywords = frontmatter?.keywords ?? keywordsProp;
const image = frontmatter?.image ?? imageProp;
const canonical = frontmatter?.canonical ?? canonicalProp;
const pageSections = frontmatter?.pageSections;
const hasPageSections = pageSections && pageSections.length > 0;
const hasSlotContent = Astro.slots.has("default");
const fixedTabItems = Array.isArray(fixedTabs?.tabs) ? fixedTabs.tabs : [];
const hasActiveFixedTabs = fixedTabItems.some((tab: any) => tab?.enabled !== false);
const footerSocials = (siteInfo as any)?.socials || (footer as any)?.socials || [];
const footerOffices =
  Array.isArray((footer as any)?.offices) && (footer as any).offices.length > 0
    ? (footer as any).offices
    : (siteInfo as any)?.offices;
const navOffices =
  Array.isArray((mainNav as any)?.offices) && (mainNav as any).offices.length > 0
    ? (mainNav as any).offices
    : (siteInfo as any)?.offices;
const footerSiteName = (footer as any)?.siteName || (siteInfo as any)?.siteName;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  image={image}
  canonical={canonical}
  siteInfo={siteInfo}
>
  <ArtisanHeader {...mainNav} offices={navOffices} socials={footerSocials} />
  <main data-pagefind-body>
    {
      hasPageSections ? (
        <Components contentSections={pageSections} propName="pageSections" />
      ) : hasSlotContent ? (
        <slot />
      ) : null
    }
  </main>
  <Footer
    {...footer}
    siteName={footerSiteName}
    offices={footerOffices}
    socials={footerSocials}
    data-fixed-tabs-active={hasActiveFixedTabs ? "true" : undefined}
  />
  <FixedTabs {...fixedTabs} />
</Layout>
