<style>
  .if-youre-experiencing-dental {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    left: -15px;
    line-height: 24px;
    padding-top: 30px;
    position: relative;
    right: 15px;
    text-align: left;
  }

  .iyed-box {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    padding: 10px;
    position: relative;
  }

  .iyed-box2 {
    box-sizing: border-box;
