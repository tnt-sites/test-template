---
/**
 * Paperless Check In — migrated from lp/new-patient [2] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
import Button from "@core-elements/button/Button.astro";
const {
  heading = "",
  image = "",
  imageAlt = "",
  text = "",
  buttonText = "",
  buttonLink = "",
  headingColor = "#3b6278",
  textColor = "#3b6278",
  buttonBackgroundColor = "#5bb781",
  buttonTextColor = "#ffffff",
  id,
  _component,
  ...rest
} = Astro.props;
---
<section class="paperless-check-in" id={id || undefined} style={`--hd:${headingColor};--tx:${textColor};--btnbg:${buttonBackgroundColor};--btntx:${buttonTextColor}`} {...rest}>
  <section class="pci-box">
    <div class="pci-box2">
      <div class="pci-box3">
        <div class="pci-decor" aria-hidden="true"></div>
      </div>
      <div class="pci-box4">
        <div class="pci-box5">
          <div class="pci-box6">
            {image && <img class="pci-media" src={image} alt={imageAlt || ""} loading="lazy" width="650" height="575" />}
          </div>
        </div>
        <div class="pci-box7">
          <div class="pci-box8">
            <h2 class="pci-heading" set:html={heading} />
          </div>
        </div>
        <div class="pci-box9">
          <div class="pci-box10">
            {text && <p class="pci-text">{text}</p>}
          </div>
        </div>
        <div class="pci-box11">
          {buttonText && <Button variant="primary" size="md" width="none" borderRadius="none" borderWidth="xs" class="pci-btn" text={buttonText} link={buttonLink || "#"} />}
        </div>
      </div>
    </div>
  </section>
</section>
<style>
