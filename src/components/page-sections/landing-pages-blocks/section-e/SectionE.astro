    color: rgb(4, 4, 4);
    font-family: "Open Sans Condensed", sans-serif;
    font-size: 32px;
    line-height: 32px;
  }
  .se-heading {
    color: rgb(27, 46, 56);
    font-size: 19.2px;
    font-weight: 300;
    line-height: 28.8px;
  }
  .se-text {
    font-family: Roboto, sans-serif;
    font-size: 16px;
    font-weight: 400;
