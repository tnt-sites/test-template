  heading = "",
  image = "",
  imageAlt = "",
  text = "",
  buttonText = "",
  buttonLink = "",
  headingColor = "#3b6278",
  textColor = "#3b6278",
  buttonBackgroundColor = "#3a8358",
  buttonTextColor = "#ffffff",
  buttonTextHoverColor = "#1b2e38",
  hoverColor = "#ffffff",
  id,
  _component,
  ...rest
} = Astro.props;
---
<section class="a-top-rated-dental" id={id || undefined} style={`--hd:${headingColor};--tx:${textColor};--btnbg:${buttonBackgroundColor};--btntx:${buttonTextColor};--c5:${buttonTextHoverColor};--c6:${hoverColor}`} {...rest}>
  <section class="atrd-box">
    <div class="atrd-box2">
      <div class="atrd-box3">
        <div class="atrd-box4">
          <div class="atrd-box5">
            {image && <img class="atrd-media" src={image} alt={imageAlt || ""} loading="lazy" width="650" height="400" />}
          </div>
        </div>
      </div>
      <div class="atrd-box6">
        <div class="atrd-box7">
          <div class="atrd-box8">
            <h2 class="atrd-heading" set:html={heading} />
          </div>
        </div>
        <div class="atrd-box9">
          <div class="atrd-box10">
            {text && <p class="atrd-text">{text}</p>}
          </div>
        </div>
        <div class="atrd-box11">
          {buttonText && <Button variant="primary" size="md" width="none" borderRadius="none" borderWidth="xs" class="atrd-btn" text={buttonText} link={buttonLink || "#"} />}
        </div>
      </div>
    </div>
  </section>
