---
import Button from "@core-elements/button/Button.astro";
import Image from "@core-elements/image/Image.astro";
import LiineForm from "@page-sections/forms/liine-form/LiineFormEmbed.astro";
import Text from "@core-elements/text/Text.astro";

/*
 * Interior page banner, as measured on the source at 1440px: three equal 480px
 * columns — service photo, then the H1 with its intro, then the appointment
 * form. The H1 is 60px/200 with the location as a 24px sub-line beneath it,
 * both in the body colour (not the brand colour).
 */
const {
  heading = "",
  location = "",
  intro = "",
  imageSource = "",
  imageAlt = "",
  formId = "251056297507965",
  formTitle = "North County Cosmetic and Implant Dentistry - Request an Appointment Form",
  formHeading = "Request An Appointment",
  formHeight = 420,
  buttonText = "",
  buttonLink = "",
  ctaImage = "",
  ctaImageAlt = "",
  ctaLink = "",
  id = "",
  class: className,
  _component,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

// `intro` may be a single string or an array of paragraphs; the source runs up
// to six in the banner column and each is its own <p>.
const introParagraphs = (Array.isArray(intro) ? intro : [intro])
  .map((p: any) => (typeof p === "string" ? p.trim() : ""))
  .filter(Boolean);
---

<section class:list={["page-banner", className]} {...htmlAttributes}>
  <div class="pb-grid">
    <div class="pb-media">
      {imageSource && <Image source={imageSource} alt={imageAlt || heading} editable={false} />}
    </div>

    <div class="pb-body">
      <h1 class="pb-title">
        <span class="pb-name" data-prop="heading">{heading}</span>
        {location && <span class="pb-location" data-prop="location">{location}</span>}
      </h1>
      {
        introParagraphs.length > 0 && (
          <div class="pb-intro" data-prop="intro">
            {introParagraphs.map((p: string) => (
              <Text alignX="start" text={p} editable={false} />
            ))}
          </div>
        )
      }
      {
        ctaImage && (
          <a class="pb-cta-image" href={ctaLink || "#"} target="_blank" rel="noopener">
            <Image source={ctaImage} alt={ctaImageAlt || "Apply now"} editable={false} />
          </a>
        )
      }
      {
        buttonText && buttonLink && (
          <Button text={buttonText} link={buttonLink} variant="primary" size="md" borderRadius="2xl" editable={false} />
        )
      }
    </div>

    <div class="pb-form">
      {
        formId && (
          <div class="pb-form-card">
            <div class="pb-form-title">{formHeading}</div>
            <LiineForm formId={formId} title={formTitle} height={formHeight} />
          </div>
        )
      }
    </div>
  </div>
</section>

<style lang="pcss">
  .page-banner {
    background-color: var(--color-bg);
  }

  .pb-grid {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }

  @media (min-width: 993px) {
    .pb-grid {
      align-items: center;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pb-media {
    /* the source keeps the photo at 550px and centres it against a taller
       text column rather than stretching it */
    align-self: center;
  }

  .pb-cta-image {
    display: inline-block;
    margin-top: var(--spacing-md);
    max-width: 260px;
  }

  .pb-cta-image :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  .pb-intro :global(p) + :global(p) {
    margin-top: 0.85em;
  }

  .pb-media :global(img) {
    display: block;
    height: 550px;
    object-fit: cover;
    width: 100%;
  }

  .pb-body {
    /* the grid centres the columns, so no top padding is needed */
    padding-block: 0 var(--spacing-xl);
    padding-left: 50px;
    padding-right: 20px;
  }

  /* The global h1 rule sets the homepage's 45px/400 display size; the banner
     H1 on interior pages is 60px/200 with a 24px location sub-line. */
  h1.pb-title {
    font-size: 3.75rem;
    font-weight: 200;
    line-height: 1.1;
    margin: 0 0 var(--spacing-sm);
    text-transform: none;
  }

  .pb-name {
    display: block;
    font-size: clamp(2rem, 4.2vw, 3.75rem); /* 60px at 1440 */
    font-weight: 200;
    hyphens: none;
    line-height: 1.1;
    overflow-wrap: normal;
    text-wrap: pretty;
  }

  .pb-location {
    /* The source is inconsistent here - dental-anesthesia renders the location
       in gold, most others in black. Gold everywhere, per the brief. */
    color: var(--color-brand-secondary, #ba9764);
    display: block;
    font-size: 1.5rem; /* 24px, measured */
    font-weight: 200;
    line-height: 1.2;
    margin-top: 0.15em;
  }

  .pb-intro :global(p) {
    margin-block: 0.5em;
  }

  .pb-form {
    /* source: a 330px form card starting at x=1050 inside the 480px column */
    padding-block: 20px var(--spacing-xl);
    padding-left: 90px;
    padding-right: 60px;
  }

  .pb-form-card {
    /* source: a 535px card — a 66px title bar over a 469px inner wrapper that
       pads the 420px iframe by 22px above and 27px below. */
    background-color: #f7f7f7;
    box-shadow: 0 1px 5px rgb(0 0 0 / 12%);
    padding-bottom: 27px;
  }

  .pb-form-card :global(iframe) {
    margin-top: 22px;
  }

  .pb-form-title {
    background-color: #dcdcdc;
    font-family: var(--font-headings);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.5;
    padding: 15px;
    text-align: center;
    white-space: nowrap;
  }
</style>
