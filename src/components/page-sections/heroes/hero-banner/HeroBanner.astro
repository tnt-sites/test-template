---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  eyebrow = "",
  heading = "",
  subtext = "",
  imageSource = "",
  imageAlt = "",
  buttonSections = [],
  colorScheme = "inherit",
  backgroundColor = "brand",
  backgroundColorHex = "",
  backgroundGradient = "",
  backgroundImage,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const {
  source: titleImageSource = "",
  alt: titleImageAlt = "",
  positionVertical = "top",
  positionHorizontal = "center",
} = backgroundImage || {};

const hasImage = typeof imageSource === "string" && imageSource.trim() !== "";
const textAlign = hasImage ? "start" : "center";

const titleStyle = [
  backgroundGradient ? `--section-bg-gradient: ${backgroundGradient}` : "",
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
]
  .filter(Boolean)
  .join("; ");
---

<CustomSection
  paddingHorizontal="none"
  paddingVertical="none"
  colorScheme={colorScheme}
  class:list={["hero-banner", className]}
  {...htmlAttributes}
>
  <div
    class:list={["hero-banner-title", backgroundColor && `bg-${backgroundColor}`]}
    style={titleStyle || undefined}
  >
    <Image
      class="hero-banner-title-bg"
      source={titleImageSource}
      alt={titleImageAlt}
      editable={false}
      data-prop-src="backgroundImage.source"
      data-prop-alt="backgroundImage.alt"
      data-editable="image"
      positionVertical={positionVertical}
      positionHorizontal={positionHorizontal}
      background={true}
    />
    <div class="hero-banner-title-inner">
      <Heading level="h1" class="eyebrow" data-prop="eyebrow" text={eyebrow} />
      <Heading
        level="h2"
        size="2xl"
        class="hero-banner-heading"
        data-prop="heading"
        text={heading}
      />
    </div>
  </div>

  <div class:list={["hero-banner-content", !hasImage && "no-image"]}>
    {
      hasImage && (
        <div class="hero-banner-image">
          <Image
            source={imageSource}
            alt={imageAlt}
            editable={true}
            data-prop-src="imageSource"
            data-prop-alt="imageAlt"
            data-editable="image"
            priority={true}
          />
        </div>
      )
    }
    <div class="hero-banner-text">
      <Text class="subtext" data-prop="subtext" text={subtext} alignX={textAlign} />
      <ButtonGroup class="buttons-container" buttonSections={buttonSections} alignX={textAlign} />
    </div>
  </div>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .hero-banner-title {
      background-image: var(--section-bg-gradient, url("/images/banner-bg.svg"));
      background-position: 90% 0;
      background-repeat: no-repeat;
      padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-6xl);
      position: relative;
      text-align: center;

      &.bg-base {
        background-color: var(--color-bg);
      }

      &.bg-surface {
        background-color: var(--color-bg-surface);
      }

      &.bg-brand {
        background-color: var(--color-bg-brand);
      }

      &.bg-brand-secondary {
        background-color: var(--color-bg-brand-secondary);
      }

      &.bg-accent {
        background-color: var(--color-bg-accent);
      }

      &.bg-highlight {
        background-color: var(--color-bg-highlight);
      }

      &.bg-dark {
        background-color: var(--color-bg-dark);
      }

      &.bg-black {
        background-color: var(--color-bg-black);
      }

      .hero-banner-title-bg {
        z-index: var(--layer-1);
      }
    }

    .hero-banner-title-inner {
      margin-inline: auto;
      max-width: var(--content-width-lg);
      position: relative;
      z-index: var(--layer-2);

      .eyebrow,
      .hero-banner-heading {
        color: var(--color-text-on-brand);
        text-align: center;
      }

      .eyebrow {
        font-weight: 300;
        margin-top: 0;
      }

      .hero-banner-heading {
        font-weight: 300;
        margin: 0 auto;
      }
    }

    .hero-banner-content {
      align-items: flex-start;
      display: flex;
      gap: var(--spacing-2xl);
      justify-content: center;
      margin-inline: auto;
      max-width: var(--content-width-2xl);
      padding: 0 var(--spacing-lg) var(--spacing-3xl);
      position: relative;
      z-index: var(--layer-1);

      &.no-image {
        justify-content: center;
      }
    }

    .hero-banner-image {
      flex: 0 1 500px;
      margin-top: -80px;
      position: relative;
      z-index: var(--layer-2);
    }

    .hero-banner-text {
      flex: 1 1 380px;
      max-width: 540px;
      padding-top: var(--spacing-xl);

      .hero-banner-content.no-image & {
        margin-inline: auto;
        max-width: 960px;
        padding-top: 0;
        text-align: center;

        /* Overlapping callout card, echoing the image overlap above when there's no image */
        .subtext {
          margin-top: 0;

          p {
            font-size: 1.6rem;
            margin-inline: auto;
            max-width: 940px;
          }

          p:first-of-type {
            background-color: #d0c8b7;
            font-size: 1.2rem;
            margin: -100px auto 40px;
            max-width: 100%;
            padding: 40px 90px;
          }
        }
      }
    }

    @media (max-width: 1024px) {
      .hero-banner-content {
        align-items: center;
        flex-direction: column;
        gap: var(--spacing-lg);
        padding-bottom: var(--spacing-2xl);
        text-align: center;
      }

      .hero-banner-image {
        flex: none;
        margin-inline: auto;
        width: 100%;
      }

      .hero-banner-text {
        flex: none;
        max-width: var(--content-width-md);
        padding-top: 0;
        text-align: center;

        .buttons-container {
          justify-content: center;
        }

        .hero-banner-content.no-image & .subtext p:first-of-type {
          padding: 40px 30px;
        }
      }
    }

    @media (max-width: 500px) {
      .hero-banner-title {
        background-position: -150% 0;
      }
    }
  }
</style>
