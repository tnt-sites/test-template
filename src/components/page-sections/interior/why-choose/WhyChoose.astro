---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";

const { heading = "", items = [], class: className, _component, ...htmlAttributes } = Astro.props;
---

<CustomSection class:list={["why-choose", className]} paddingVertical="none" {...htmlAttributes}>
  <div class="wrap block text-center">
    <Heading level="h2" class="title" data-prop="heading" text={heading} />
    <ul class="no-check block lg:flex justify-center items-start">
      {
        items.map((item: any) => (
          <li>
            <span class="check">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </span>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</CustomSection>

<style>
  :global(.why-choose) {
    background: linear-gradient(#b4c5d6, var(--color-band) 145px);
  }

  :global(.why-choose) .wrap {
    margin: 0 auto;
    max-width: 1200px;
    padding: 95px 20px;
  }

  :global(.why-choose) :global(.title) {
    color: var(--color-brand);
    font-size: 40px;
    font-weight: 200;
    line-height: 45px;
    margin: 0 auto;
    max-width: 820px;
    text-align: inherit;
  }

  :global(.why-choose) ul {
    list-style: none;
    margin: 60px 0 0;
    padding: 0;
  }

  :global(.why-choose) li {
    margin: 0 auto 40px;
    max-width: 355px;
    text-align: center;
  }

  :global(.why-choose) .check {
    align-items: center;
    background-color: #124985;
    border-radius: 50%;
    color: #fff;
    display: inline-flex;
    font-size: 30px;
    height: 55px;
    justify-content: center;
    width: 55px;
  }

  :global(.why-choose) p {
    color: var(--color-brand-secondary);
    font-family: var(--font-ui);
    font-size: 24px;
    line-height: 35px;
    margin: 20px 0 0;
    text-transform: uppercase;
  }

  @media (min-width: 1025px) {
    :global(.why-choose) :global(.title) {
      font-size: 59px;
      line-height: 62px;
    }

    :global(.why-choose) li {
      flex: 0 1 355px;
      margin: 0 20px;
    }
  }


  /* Bold check from Final.xd */
  :global(.why-choose) .check svg {
    fill: none;
    height: 28px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 3.5;
    width: 28px;
  }
</style>
