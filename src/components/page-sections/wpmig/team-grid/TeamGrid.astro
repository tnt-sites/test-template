---
/**
 * TeamGrid — portrait, name and bio per team member (migrated from meet-the-team [3] by wp-migrator).
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `cards`.
 */
const {
  cards = [],
  titleColor = "",
  titleColorHex = "#177982",
  textColor = "#000000",
  textColorHex = "",
  id,
  _component,
  ...rest
} = Astro.props;
const titleColorValue = titleColorHex || titleColor || "#177982";
const textColorValue = textColorHex || textColor || "#000000";
const list = Array.isArray(cards) ? cards.filter(Boolean) : [];
---
<div class="team-grid" style={`--tt:${titleColorValue};--tx:${textColorValue}`}>
  {list.map((c) => (
    <div class="mpk-box">
      <figure class="mpk-box2">
        {c.image && <img class="mpk-media" src={c.image} alt={c.imageAlt || ""} loading="lazy" width="600" height="800" />}
      </figure>
      <h2 class="mpk-heading">{c.title}</h2>
      {c.text && <div class="mpk-body" set:html={c.text} />}
    </div>
  ))}
</div>
<style>
  /* Cards share one column width and every portrait is cropped to the same
     3:4 frame, so the photos line up whatever their source proportions. Card
     height follows the bio — the migrated fixed heights (1181px / 1238px) were
     what left the large blank gaps under the shorter bios. */
  .team-grid {
    box-sizing: border-box;
    display: grid;
    font-family: "PT Sans", sans-serif;
    gap: 40px 32px;
    grid-template-columns: 1fr;
    line-height: 24px;
    margin: 0 auto 60px;
    max-width: 1300px;
    padding-inline: 15px;
    text-align: center;
  }

  .mpk-box {
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 400px;
    width: 100%;
  }

  .mpk-box2 {
    aspect-ratio: 3 / 4;
    background-color: #111111;
    margin: 0;
    overflow: hidden;
  }

  .mpk-media {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    width: 100%;
  }

  .mpk-heading {
    box-sizing: border-box;
    color: var(--tt);
    font-size: 24px;
    font-weight: 400;
    line-height: 33.6px;
    margin-bottom: 15px;
    margin-top: 24px;
    text-transform: capitalize;
  }

  .mpk-heading::after {
    background-color: #177982;
    content: "";
    display: block;
    height: 1px;
    margin: 15px auto 0;
    width: 100%;
  }

  .mpk-body :global(p) {
    color: var(--tx);
    margin: 0 0 16px;
  }

  .mpk-body :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .mpk-body :global(p) {
      font-size: 18px;
      line-height: 27px;
    }
  }
</style>
