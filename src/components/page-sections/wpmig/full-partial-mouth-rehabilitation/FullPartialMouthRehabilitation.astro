---
/**
 * Full Partial Mouth Rehabilitation — migrated from full-partial-mouth-rehabilitation [0] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  backgroundColor = "#321c0e",
  headingColor = "#ffffff",
  id,
  _component,
  ...rest
} = Astro.props;
---
<section class="full-partial-mouth-rehabilitation" id={id || undefined} style={`--bg:${backgroundColor};--hd:${headingColor}`} {...rest}>
  <div class="fpmr-decor" aria-hidden="true"></div>
  <div class="fpmr-box">
    <h2 class="fpmr-heading" set:html={heading} />
  </div>
</section>
<style>
  .full-partial-mouth-rehabilitation {
    background-color: var(--bg);
    box-sizing: border-box;
    color: #686868;
    font-family: "Open Sans", sans-serif;
    font-size: 18px;
    line-height: 26px;
    padding: 35px 15px;
    position: relative;
  }

  .fpmr-decor {
    background-color: #321c0e;
    background-image: url("/wp-content/uploads/2020/08/brown-wood-texture-and-backgroun-1-1.jpg");
    background-position: 50% 0%;
    background-size: cover;
    bottom: 0px;
    box-sizing: border-box;
    left: 0px;
    mix-blend-mode: lighten;
    opacity: 0.15;
    position: absolute;
    right: 0px;
    top: 0px;
  }

  .fpmr-box {
    box-sizing: border-box;
    text-align: center;
  }

  .fpmr-heading {
    box-sizing: border-box;
    color: var(--hd);
    font-family: Poppins, sans-serif;
    font-size: 30px;
    line-height: 40px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  @media (min-width: 1440px) {
    .full-partial-mouth-rehabilitation {
      padding: 75px 25px;
    }

    .fpmr-box {
      margin-left: auto;
      margin-right: auto;
      max-width: 1200px;
    }

    .fpmr-heading {
      font-size: 40px;
      line-height: 50px;
    }
  }

/* wpmig:corrections:begin */
  .fpmr-heading {
    font-weight: 700;
  }
/* wpmig:corrections:end */
</style>
