      font-size: 50px;
      line-height: 50px;
    }

    .cbr-grid {
      flex-wrap: nowrap;
    }

    .cbr-box6 {
      flex: 0 0 40%;
      max-width: 40%;
    }
  }

  @media (min-width: 1440px) {
    .cbr-box {
      max-width: min(100%, 1440px);
    }

    .cbr-heading {
      font-size: 70px;
      line-height: 70px;
    }

    .cbr-box6 {
      flex: 0 0 20%;
      max-width: 20%;
    }
  }
</style>
