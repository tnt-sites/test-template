  heading = "",
  subheading = "",
  text = "",
  buttonText = "",
  buttonLink = "",
  secondaryButtonText = "",
  secondaryButtonLink = "",
  backgroundImage = "/wp-content/uploads/2020/09/shutterstock_279778787x2.jpg",
  headingColor = "rgba(255, 255, 255, 0.98)",
  textColor = "#ffffff",
  buttonBackgroundColor = "var(--color-brand-secondary)",
  buttonTextColor = "#ffffff",
  buttonBackgroundHoverColor = "#c3a527",
  buttonBackgroundHoverColor2 = "#c5a628",
  id,
  _component,
  ...rest
} = Astro.props;
---
<section class="look-your-very-best" id={id || undefined} style={`--hd:${headingColor};--tx:${textColor};--btnbg:${buttonBackgroundColor};--btntx:${buttonTextColor};--c5:${buttonBackgroundHoverColor};--c6:${buttonBackgroundHoverColor2}${backgroundImage ? `;--bgimg:url('${backgroundImage}')` : ""}`} {...rest}>
  <div class="lyvb-decor" aria-hidden="true"></div>
  <div class="lyvb-box">
    <div class="lyvb-box2">
      <div class="lyvb-box3">
        <div class="lyvb-box4">
          <h2 class="lyvb-heading">{heading}</h2>
        </div>
        <div class="lyvb-box5">
          <div class="lyvb-box6">
            {subheading && <h2 class="lyvb-heading2">{subheading}</h2>}
          </div>
        </div>
        <div class="lyvb-box7">
          <div class="lyvb-box8">
            {text && <p class="lyvb-text">{text}</p>}
          </div>
        </div>
        <div class="lyvb-box9">
          {buttonText && <Button variant="primary" size="md" width="none" borderRadius="none" borderWidth="xs" class="lyvb-btn" text={buttonText} link={buttonLink || "#"} />}
        </div>
        <div class="lyvb-box10">
          <div class="lyvb-box11">
            {secondaryButtonText && <Button variant="primary" size="md" width="none" borderRadius="none" borderWidth="xs" class="lyvb-btn2" text={secondaryButtonText} link={secondaryButtonLink || "#"} />}
