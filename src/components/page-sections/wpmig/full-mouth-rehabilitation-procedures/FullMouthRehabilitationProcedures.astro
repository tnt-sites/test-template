---
/**
 * Full Mouth Rehabilitation Procedures — migrated from full-partial-mouth-rehabilitation [14] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `images`.
 */
const {
  heading = "",
  text = "",
  images = [],
  backgroundColor = "#321c0e",
  headingColor = "#ffffff",
  textColor = "#ffffff",
  id,
  _component,
  ...rest
} = Astro.props;
const list = Array.isArray(images) ? images.filter(Boolean) : [];
---
<section class="full-mouth-rehabilitation-procedures" id={id || undefined} style={`--bg:${backgroundColor};--hd:${headingColor};--tx:${textColor}`} {...rest}>
  <div class="fmrp-decor" aria-hidden="true"></div>
  <div class="fmrp-box">
    <div class="fmrp-box2">
      <div class="fmrp-box3">
        <div class="fmrp-box4">
          <h2 class="fmrp-heading">{heading}</h2>
        </div>
      </div>
      <div class="fmrp-box5">
        <div class="fmrp-box6">
          {text && <p class="fmrp-text">{text}</p>}
        </div>
      </div>
    </div>
    <div class="fmrp-grid">
      {list.map((it) => (
        <div class="fmrp-box7">
          <div class="fmrp-box8">
            <figure class="fmrp-box9">
              {it.image && <img class="fmrp-media" src={it.image} alt={it.imageAlt || ""} loading="lazy" width="267" height="200" />}
            </figure>
            <div class="fmrp-box10">
              {it.text && <div class="fmrp-body" set:html={it.text} />}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  /* Wood-textured band inside the 1200px column. The migrated version capped
     the band at 298px below 768px while still forcing three columns, which
     broke the mobile layout; columns now step 1 → 2 → 3 with the viewport. */
  .full-mouth-rehabilitation-procedures {
    background-color: var(--bg);
    box-sizing: border-box;
    color: #ffffff;
    font-family: "Open Sans", sans-serif;
    margin: 0 max(clamp(1rem, 3vw, 2.5rem), (100% - 1200px) / 2) 100px;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2.5rem) clamp(2rem, 5vw, 4rem);
    position: relative;
  }

  .fmrp-decor {
    background-color: #321c0e;
    background-image: url("/wp-content/uploads/2020/08/brown-wood-texture-and-backgroun-1.jpg");
    background-position: 50% 0%;
    background-size: cover;
    inset: 0;
    mix-blend-mode: lighten;
    opacity: 0.15;
    position: absolute;
  }

  .fmrp-box {
    position: relative;
  }

  .fmrp-box2 {
    margin: 0 auto 2.5rem;
    max-width: 1000px;
    text-align: center;
  }

  .fmrp-heading {
    color: var(--hd);
    font-family: Poppins, sans-serif;
    font-size: clamp(1.75rem, 3vw, 40px);
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 1rem;
  }

  .fmrp-text {
    color: var(--tx);
    font-size: 18px;
    line-height: 26px;
    margin: 0;
  }

  .fmrp-grid {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .fmrp-box8 {
    text-align: center;
  }

  .fmrp-box9 {
    margin: 0 auto 1.25rem;
    max-width: 267px;
  }

  .fmrp-media {
    display: block;
    height: auto;
    width: 100%;
  }

  .fmrp-body :global(h4) {
    color: var(--tx);
    font-family: Poppins, sans-serif;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .fmrp-body :global(p) {
    color: var(--tx);
    font-family: "Open Sans", sans-serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 26px;
    margin: 0;
  }

  @media (max-width: 1023px) {
    .fmrp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .fmrp-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
