---
/**
 * Video Accordion — the New Patients "Educational Dental Videos" library.
 *
 * The source organizes a set of ProSites patient-education videos into an
 * Elementor nested-accordion, one panel per topic. Each video loads its poster
 * up front and streams from the ProSites CDN only when played. Rebuilt here as
 * a native <details> accordion so it works without the theme's JS.
 */
const {
  heading = "",
  subheading = "",
  categories = [],
  headingColor = "var(--color-brand)",
  // Closed and open are two different bars in the source, and painting them
  // both with the accent made every topic read as though it were open. These
  // are the measured values: a pale ground with dark text until a panel is
  // opened, brand blue and white once it is.
  barColor = "#f4f8f7",
  barTextColor = "#1f2124",
  accentColor = "var(--color-brand)",
  accentTextColor = "#ffffff",
  // The source has no chevron at all — the colour change between the closed
  // bar and the open one is the whole affordance.
  showIcon = false,
  id = "",
  _component,
  ...rest
} = Astro.props;
const list = Array.isArray(categories) ? categories.filter((c) => c && (c.title || (c.videos && c.videos.length))) : [];
---
<section
  class="video-accordion"
  id={id || undefined}
  style={`--hd:${headingColor};--accent:${accentColor};--accent-text:${accentTextColor};--bar:${barColor};--bar-text:${barTextColor}`}
  {...rest}
>
  <div class="va-inner">
    {heading && <h2 class="va-heading">{heading}</h2>}
    {subheading && <p class="va-sub">{subheading}</p>}
    <div class="va-list">
      {list.map((cat, i) => (
        <details class="va-item" open={i === 0}>
          <summary class="va-summary">
            <span>{cat.title}</span>
            {showIcon && (
              <span class="va-chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            )}
          </summary>
          <div class="va-panel">
            <div class="va-grid">
              {(cat.videos || []).filter(Boolean).map((v) => (
                <div class="va-video" data-video>
                  {/* Caption first: the source labels each clip above it. */}
                  {v.title && <p class="va-title">{v.title}</p>}
                  <button class="va-play" type="button" aria-label={`Play ${v.title || cat.title + " video"}`}>
                    <img src={v.poster} alt={v.title || ""} loading="lazy" />
                    <span class="va-play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                    </span>
                  </button>
                  <template>
                    <video controls preload="none" playsinline poster={v.poster} src={v.src}></video>
                  </template>
                </div>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .video-accordion {
    box-sizing: border-box;
    padding: 60px 20px;
    width: 100%;
  }

  .va-inner {
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 1000px;
  }

  .va-heading {
    color: var(--hd);
    font-family: "Playfair Display", serif;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 0.3em;
    text-align: center;
  }

  .va-sub {
    color: #333;
    font-family: Lato, sans-serif;
    margin: 0 auto 2rem;
    max-width: 680px;
    text-align: center;
  }

  .va-item {
    margin-bottom: 10px;
  }

  .va-summary {
    align-items: center;
    background-color: var(--bar);
    color: var(--bar-text);
    cursor: pointer;
    display: flex;
    font-size: 18px;
    font-weight: 400;
    gap: 10px;
    justify-content: space-between;
    list-style: none;
    padding: 15px;
  }

  .va-item[open] > .va-summary {
    background-color: var(--accent);
    color: var(--accent-text);
  }

  .va-summary::-webkit-details-marker {
    display: none;
  }

  .va-chev {
    display: inline-flex;
    transition: transform 0.25s ease;
  }

  .va-item[open] .va-chev {
    transform: rotate(180deg);
  }

  .va-panel {
    border: 1px solid #d5d8dc;
    padding: 10px;
  }

  .va-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  .va-video {
    box-sizing: border-box;
  }

  .va-play {
    background: #000;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    display: block;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 100%;
  }

  .va-play img,
  .va-video :global(video) {
    aspect-ratio: 16 / 9;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .va-video :global(video) {
    border-radius: 6px;
  }

  .va-play-icon {
    align-items: center;
    background: color-mix(in srgb, var(--accent) 85%, transparent);
    border-radius: 50%;
    color: #fff;
    display: flex;
    height: 56px;
    justify-content: center;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.2s;
    width: 56px;
  }

  .va-play:hover .va-play-icon {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .va-title {
    color: #333;
    font-family: Lato, sans-serif;
    font-size: 1rem;
    margin: 0 0 8px;
    text-align: center;
  }
</style>
<script>
  function boot() {
    document.querySelectorAll<HTMLElement>("[data-video]").forEach((wrap) => {
      const btn = wrap.querySelector<HTMLButtonElement>(".va-play");
      const tpl = wrap.querySelector<HTMLTemplateElement>("template");
      if (!btn || !tpl) return;
      btn.addEventListener("click", () => {
        const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLVideoElement | undefined;
        if (!node) return;
        btn.replaceWith(node);
        node.play?.().catch(() => {});
      });
    });
  }
  if (document.readyState !== "loading") boot();
  else document.addEventListener("DOMContentLoaded", boot);
</script>
