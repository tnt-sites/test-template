---
/**
 * We Can Fix These — migrated from full-partial-mouth-rehabilitation [2] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `items`.
 */
import Icon from "@core-elements/icon/Icon.astro";
const {
  eyebrow = "",
  heading = "",
  items = [],
  backgroundColor = "#fbfbfb",
  eyebrowColor = "var(--color-brand-secondary)",
  headingColor = "#321c0e",
  titleColor = "#666666",
  id,
  _component,
  ...rest
} = Astro.props;
const list = Array.isArray(items) ? items.filter(Boolean) : [];
---
<section class="we-can-fix-these" id={id || undefined} style={`--bg:${backgroundColor};--eb:${eyebrowColor};--hd:${headingColor};--tt:${titleColor}`} {...rest}>
  <div class="wcft-box">
    <div class="wcft-box2">
      <div class="wcft-box3">
        {eyebrow && <h6 class="wcft-heading">{eyebrow}</h6>}
      </div>
    </div>
    <div class="wcft-box4">
      <div class="wcft-box5">
        <h2 class="wcft-heading2">{heading}</h2>
      </div>
    </div>
    <div class="wcft-box6">
      <div class="wcft-grid">
        {list.map((it) => (
          <div class="wcft-box7">
            <span class="wcft-box8">
              <span class="wcft-decor" aria-hidden="true"><Icon name="check-circle-duo" /></span>
            </span>
            <div class="wcft-box9">
              <h3 class="wcft-heading3">{it.title}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .we-can-fix-these {
    background-color: var(--bg);
