/* wpmig:corrections:begin */
  :global(.asir-btn) {
    align-items: normal;
    font-weight: 300;
    justify-content: normal;
    line-height: 26px;
  }
  .asir-text {
    color: rgb(255, 255, 255);
  }
  .asir-box3 {
    font-size: 16px;
  }
  .asir-box4 {
    font-size: 16px;
  }
/* wpmig:corrections:end */
</style>
