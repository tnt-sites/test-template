          {items2List.map((it) => (
            <li class="cgs-box17">
              <div class="cgs-text7">{it.text}</div>
            </li>
          ))}
        </ol>
        {text8 && <p class="cgs-text13" set:html={text8} />}
      </div>
      <div class="cgs-box23">
