    padding-top: 10px;
  }

  .ac-box7 {
    box-sizing: border-box;
  }

  .ac-spacer {
    box-sizing: border-box;
    height: 371px;
    min-height: 371px;
  }

  .ac-box8 {
    align-self: center;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 14.8px;
