---
/**
 * Appointment CTA — migrated from  [4] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
import Button from "@core-elements/button/Button.astro";
const {
  eyebrow = "",
  heading = "",
  text = "",
  image = "",
  buttonText = "",
  buttonLink = "",
  backgroundColor = "#ffffff",
  eyebrowColor = "#117d6f",
  headingColor = "#000000",
  textColor = "#000000",
  buttonTextColor = "#000000",
  hoverColor = "#000000",
  id,
  _component,
  ...rest
} = Astro.props;
---
<div class="appointment-cta" id={id || undefined} style={`--bg:${backgroundColor};--eb:${eyebrowColor};--hd:${headingColor};--tx:${textColor};--btntx:${buttonTextColor};--c6:${hoverColor}`} {...rest}>
  <div class="ac-box">
    <div class="ac-box2">
      <div class="ac-box3">
        <div class="ac-box4" style={image ? `background-image:url("${image}")` : undefined}>
          <div class="ac-box5">
            <div class="ac-box6">
              <div class="ac-box7">
                <div class="ac-spacer" aria-hidden="true"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="ac-box8">
          <div class="ac-box9">
            {eyebrow && <p class="ac-text">{eyebrow}</p>}
          </div>
          <div class="ac-box10">
            <div class="ac-box11">
              <div class="ac-decor" aria-hidden="true"></div>
            </div>
          </div>
          <div class="ac-box12">
            <h2 class="ac-heading" set:html={heading} />
          </div>
          <div class="ac-box13">
            {text && <div class="ac-body" set:html={text} />}
          </div>
          <div class="ac-box14">
            <div class="ac-box15">
              {buttonText && <Button variant="tertiary" size="md" width="none" borderRadius="default" borderWidth="xs" uppercase class="ac-btn" text={buttonText} link={buttonLink || "#"} />}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .appointment-cta {
    background-color: var(--bg);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    line-height: 24px;
    max-width: 100%;
    position: relative;
  }

  .ac-box {
    align-items: stretch;
    box-sizing: border-box;
    display: flex;
    flex-grow: 1;
    flex-wrap: wrap;
    gap: 10px;
    max-width: min(100%, 767px);
    padding-top: 50px;
  }

  .ac-box2 {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-direction: row-reverse;
    flex-wrap: wrap-reverse;
    gap: 20px;
    max-width: 100%;
    padding: 10px;
    position: relative;
  }

  .ac-box3 {
    align-items: stretch;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 0px;
    margin-top: 15px;
    max-width: 100%;
    position: relative;
  }

  .ac-box4 {
    background-position: 50% 100%;
    background-repeat: no-repeat;
    background-size: cover;
    border-radius: 6px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    position: relative;
  }

  .ac-box5 {
    border: 1px solid #ffffff;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    margin-bottom: -90px;
    padding-left: 10px;
    padding-right: 10px;
    position: relative;
  }

  .ac-box5::before {
    border-radius: 0px;
    bottom: -1px;
    content: "";
    left: -1px;
    opacity: 0.5;
    position: absolute;
    right: -1px;
    top: -1px;
  }

  .ac-box6 {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-wrap: wrap;
    gap: 20px;
