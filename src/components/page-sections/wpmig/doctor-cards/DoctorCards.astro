      padding: 30px;
    }

    .dc-box5 {
      flex-wrap: nowrap;
      max-width: min(100%, 1024px);
    }

    .dc-spacer {
      height: 408px;
      min-height: 408px;
    }

    :global(.dc-btn) {
      padding: 10px 30px;
    }

    .dc-box9 {
      padding-top: 20px;
    }
  }

  @media (min-width: 1440px) {
    .dc-grid {
      margin-left: auto;
      margin-right: auto;
      max-width: min(100%, 1140px);
    }

    .dc-box2 {
      flex: 0 0 33.33%;
      max-width: 33.33%;
    }

    .dc-box5 {
      max-width: min(100%, 1140px);
    }

    .dc-spacer {
      height: 349px;
