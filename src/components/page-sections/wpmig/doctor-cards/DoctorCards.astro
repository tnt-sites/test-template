---
/**
 * Doctor Cards — migrated from  [6] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `items`.
 */
import Button from "@core-elements/button/Button.astro";
import { backgroundImageCss } from "@core-elements/image/backgroundImageCss";
const {
  items = [],
  textColor = "#000000",
  textColorHex = "",
  titleColor = "#000000",
  titleColorHex = "",
  hoverColor = "#ffffff",
  hoverColorHex = "",
  hoverBackgroundColor = "#000000",
  hoverBackgroundColorHex = "",
  hoverColor2 = "",
  hoverColor2Hex = "#e087ed",
  hoverBackgroundColor2 = "#ffffff",
  hoverBackgroundColor2Hex = "",
  id,
  _component,
  ...rest
} = Astro.props;
// Palette selection, hex override, or the shade measured at migration time.
const textColorValue = textColorHex || textColor || "#000000";
const titleColorValue = titleColorHex || titleColor || "#000000";
const hoverColorValue = hoverColorHex || hoverColor || "#ffffff";
const hoverBackgroundColorValue = hoverBackgroundColorHex || hoverBackgroundColor || "rgba(0, 0, 0, 0.44)";
const hoverColor2Value = hoverColor2Hex || hoverColor2 || "#e087ed";
const hoverBackgroundColor2Value = hoverBackgroundColor2Hex || hoverBackgroundColor2 || "#ffffff";
const list = Array.isArray(items) ? items.filter(Boolean) : [];
/* The portrait is painted with `background-image` on the tile itself rather
   than an <img>, so it goes through backgroundImageCss/`.bg-layers` — the same
   optimiser the Image component uses. Position matches the old `50% 0%`. */
const cards = await Promise.all(
  list.map(async (it) => ({
    ...it,
    bg: await backgroundImageCss({
      source: it.image,
      positionVertical: "top",
      positionHorizontal: "center",
    }),
  }))
);
---
<section class="doctor-cards" id={id || undefined} style={`--tx:${textColorValue};--tt:${titleColorValue};--c3:${hoverColorValue};--c4:${hoverBackgroundColorValue};--c5:${hoverColor2Value};--c6:${hoverBackgroundColor2Value}`} {...rest}>
  <div class="dc-box">
    <div class="dc-grid">
      {cards.map((it, index) => (
        <div class="dc-box2">
          <div class="dc-box3 bg-layers" style={it.bg.style || undefined}>
            <div class="dc-box4">
              <div class="dc-box5">
                <div class="dc-box6">
                  <div class="dc-spacer" aria-hidden="true"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="dc-box7">
            <div class="dc-box8">
              {it.buttonText && <Button variant="primary" size="md" width="none" borderRadius="default" borderWidth="none" class="dc-btn" text={it.buttonText} link={it.buttonLink || "#"} data-prop={`items.${index}.buttonText`} />}
            </div>
          </div>
          <div class="dc-box9">
            <h2 class="dc-heading">{it.title}</h2>
          </div>
          <div class="dc-box10">
            <p class="dc-text">{it.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .doctor-cards {
    box-sizing: border-box;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    line-height: 24px;
    position: relative;
  }

  .doctor-cards :global(svg) {
    display: block;
    flex-shrink: 0;
    height: 15px;
    width: 15px;
  }

  .dc-box {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    max-width: 100%;
    padding-left: 10px;
    padding-right: 10px;
    position: relative;
  }

  .dc-box :global(svg) {
    display: block;
    flex-shrink: 0;
    height: 15px;
    width: 15px;
  }

  .dc-grid {
    box-sizing: border-box;
    column-gap: 0px;
    display: flex;
    flex-grow: 1;
    flex-wrap: wrap;
    max-width: min(100%, 767px);
    padding-bottom: 10px;
    padding-top: 10px;
    row-gap: 20px;
  }

  .dc-grid :global(svg) {
    display: block;
    flex-shrink: 0;
    height: 15px;
    width: 15px;
  }

  .dc-box2 {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 20px;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
    position: relative;
  }

  .dc-box2 :global(svg) {
    display: block;
    flex-shrink: 0;
    height: 15px;
    width: 15px;
  }

  .dc-box3 {
    align-self: stretch;
    border-radius: 6px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .dc-box4 {
    border: 1px solid #ffffff;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    margin-bottom: -90px;
    padding-left: 10px;
    padding-right: 10px;
    pointer-events: none;
    position: relative;
  }

  .dc-box4::before {
    border-radius: 0px;
    bottom: -1px;
    content: "";
    left: -1px;
    opacity: 0.5;
    position: absolute;
    right: -1px;
    top: -1px;
  }

  .dc-box5 {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: space-evenly;
    max-width: min(100%, 767px);
    padding-bottom: 10px;
    padding-top: 10px;
  }

  .dc-box6 {
    box-sizing: border-box;
  }

  .dc-spacer {
    box-sizing: border-box;
    height: 330px;
    min-height: 330px;
  }

  .dc-box7 {
    box-sizing: border-box;
    text-align: left;
  }

  .dc-box7 :global(svg) {
    display: block;
