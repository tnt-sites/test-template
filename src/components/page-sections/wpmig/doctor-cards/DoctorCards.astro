    letter-spacing: 0.7px;
    line-height: 15px;
    margin: 0px;
    padding: 8px 17px 8px 10px;
    text-align: center;
    text-transform: uppercase;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  :global(.dc-btn) :global(.label-text) {
    white-space: nowrap;
  }

  :global(.dc-btn) :global(svg) {
    display: block;
    flex-shrink: 0;
    height: 15px;
    width: 15px;
  }

  .dc-box9 {
    box-sizing: border-box;
    margin-top: -7px;
    transition: all 0.3s ease;
  }

  .dc-heading {
    box-sizing: border-box;
    font-family: Lato, sans-serif;
    font-size: 19px;
    font-weight: 300;
    line-height: 19px;
    margin-bottom: 0px;
    margin-top: 0px;
    text-transform: uppercase;
  }

  .dc-box10 {
    box-sizing: border-box;
    margin-bottom: -15px;
  }

  .dc-text {
    box-sizing: border-box;
    margin-bottom: 15px;
    margin-top: 0px;
  }

  :global(.dc-btn):hover {
    background-color: rgba(0, 0, 0, 0);
    border-top-color: #000000;
    letter-spacing: normal;
  }

  :global(.dc-btn):hover .dc-box9 {
    border-top-color: #ffffff;
    color: var(--c3);
    letter-spacing: 1.4px;
  }

  @media (min-width: 768px) {
    .dc-grid {
      max-width: min(100%, 1024px);
    }

    .dc-box2 {
      flex: 0 0 47.99%;
      flex-wrap: nowrap;
