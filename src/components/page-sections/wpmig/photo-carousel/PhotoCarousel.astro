---
/**
 * Media Prose B — migrated from our-practice [2] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `items` — the office-tour slides.
 */
const {
  heading = "",
  text = "",
  text2 = "",
  text3 = "",
  image = "",
  imageAlt = "",
  subheading = "",
  text4 = "",
  items = [],
  autoPlay = true,
  interval = 5000,
  backgroundColor = "var(--color-brand)",
  backgroundColorHex = "",
  headingColor = "#ffffff",
  headingColorHex = "",
  textColor = "#ffffff",
  textColorHex = "",
  id,
  _component,
  ...rest
} = Astro.props;
const backgroundColorValue = backgroundColorHex || backgroundColor || "var(--color-brand)";
const headingColorValue = headingColorHex || headingColor || "#ffffff";
const textColorValue = textColorHex || textColor || "#ffffff";
/**
 * The source's office-tour slideshow was a Swiper whose slides JavaScript
 * injected, so the snapshot captured an empty shell — five spacer divs and two
 * arrow icons with no paths. `items` carries the photos instead and the gallery
 * below is a real one: one slide at a time, arrows, dots, and a swipe.
 */
const itemsList = (Array.isArray(items) ? items : [])
  .filter((it) => it && (it.image || it.source))
  .map((it) => ({ image: it.image || it.source, imageAlt: it.imageAlt || it.alt || "" }));
---
<div class="media-prose-b" id={id || undefined} style={`--bg:${backgroundColorValue};--hd:${headingColorValue};--tx:${textColorValue}`} {...rest}>
  <div class="mpb-box">
    <div class="mpb-box2">
      <div class="mpb-box3">
        <div class="mpb-box4">
          <h2 class="mpb-heading">{heading}</h2>
        </div>
        <div class="mpb-box5">
          {text && <div class="mpb-text">{text}</div>}
        </div>
        <div class="mpb-box6">
          {text2 && <div class="mpb-text2">{text2}</div>}
        </div>
        <div class="mpb-box7">
          {text3 && <div class="mpb-text3">{text3}</div>}
        </div>
      </div>
      <div class="mpb-box8">
        <div class="mpb-box9">
          {image && <img class="mpb-media" src={image} alt={imageAlt || ""} loading="lazy" width="800" height="533" />}
        </div>
      </div>
    </div>
    <div class="mpb-box10">
      <div class="mpb-box11">
        {itemsList.length > 0 && (
          <div
            class="mpb-gallery"
            data-carousel
            data-autoplay={String(autoPlay) !== "false" ? "true" : "false"}
            data-interval={interval}
            role="region"
            aria-roledescription="carousel"
            aria-label={`${subheading || heading || "Gallery"} slideshow`}
          >
            <div class="mpb-frame">
              <div class="mpb-track">
                {itemsList.map((it, i) => (
                  <div
                    class="mpb-slide"
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`Slide ${i + 1} of ${itemsList.length}`}
                  >
                    <img src={it.image} alt={it.imageAlt} loading="lazy" draggable="false" />
                  </div>
                ))}
              </div>
              <button class="mpb-arrow mpb-prev" type="button" aria-label="Previous slide">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
              </button>
              <button class="mpb-arrow mpb-next" type="button" aria-label="Next slide">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
              </button>
            </div>
            <div class="mpb-dots" role="tablist" aria-label="Choose slide" />
          </div>
        )}
      </div>
      <div class="mpb-box28">
        <div class="mpb-box29">
          {subheading && <h2 class="mpb-heading2">{subheading}</h2>}
        </div>
        <div class="mpb-box30">
          {text4 && <div class="mpb-body" set:html={text4} />}
        </div>
      </div>
    </div>
  </div>
</div>
