  /* ---- Office-tour gallery ---- */
  .mpb-frame {
    border-radius: 8px;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    position: relative;
  }

  .mpb-track {
