    text-align: center;
  }

  .pbw-heading {
    box-sizing: border-box;
    color: var(--hd);
    font-family: "Playfair Display", sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 28px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .pbw-box4 {
