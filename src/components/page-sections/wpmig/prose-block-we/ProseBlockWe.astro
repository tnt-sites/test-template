 */
import Button from "@core-elements/button/Button.astro";
const {
  heading = "",
  subheading = "",
  text = "",
  text2 = "",
  items = [],
  headingColor = "#ffffff",
  headingColorHex = "",
  textColor = "#ffffff",
  textColorHex = "",
  textHoverColor = "",
  textHoverColorHex = "#bee6fe",
  hoverBackgroundColor = "",
  hoverBackgroundColorHex = "#7ecefc",
  hoverColor = "#000000",
  hoverColorHex = "",
  id,
  _component,
  ...rest
} = Astro.props;
const headingColorValue = headingColorHex || headingColor || "#ffffff";
const textColorValue = textColorHex || textColor || "#ffffff";
const textHoverColorValue = textHoverColorHex || textHoverColor || "#bee6fe";
const hoverBackgroundColorValue = hoverBackgroundColorHex || hoverBackgroundColor || "#7ecefc";
const hoverColorValue = hoverColorHex || hoverColor || "#000000";
const list = Array.isArray(items) ? items.filter(Boolean) : [];
---
<div class="prose-block-we" id={id || undefined} style={`--hd:${headingColorValue};--tx:${textColorValue};--c3:${textHoverColorValue};--c4:${hoverBackgroundColorValue};--c5:${hoverColorValue}`} {...rest}>
  <div class="pbw-box">
    <div class="pbw-box2">
      <div class="pbw-box3">
        <h2 class="pbw-heading">{heading}</h2>
      </div>
      <div class="pbw-box4">
        {subheading && <h3 class="pbw-heading2">{subheading}</h3>}
      </div>
      <div class="pbw-box5">
        <div class="pbw-box6">
          {text && <p class="pbw-text">{text}</p>}
        </div>
      </div>
      <div class="pbw-grid">
        {list.map((it) => (
          <div class="pbw-box7">
            {it.buttonText && <Button variant="primary" size="md" width="none" borderRadius="default" borderWidth="none" class="pbw-btn" editable={false} text={it.buttonText} link={it.buttonLink || "#"} />}
          </div>
        ))}
      </div>
    </div>
    <div class="pbw-box9">
      {text2 && <div class="pbw-text2">{text2}</div>}
    </div>
  </div>
</div>
<style>
  .prose-block-we {
    box-sizing: border-box;
    color: #333333;
    display: flex;
    flex-direction: column;
    font-family: Lato, sans-serif;
