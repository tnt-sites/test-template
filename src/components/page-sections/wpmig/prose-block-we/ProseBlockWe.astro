    font-size: 22px;
    font-style: italic;
    font-weight: 700;
    line-height: 22px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .pbw-box5 {
    box-sizing: border-box;
    color: #ffffff;
    max-width: 100%;
    position: relative;
    text-align: center;
  }

  .pbw-box6 {
    box-sizing: border-box;
  }

