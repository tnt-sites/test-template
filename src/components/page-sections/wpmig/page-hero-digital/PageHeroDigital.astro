---
/**
 * Page Hero Digital — migrated from digital-x-rays [0] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  backgroundImage = "/wp-content/uploads/2024/10/5027-Group-of-4-drs-T2-scaled.jpg",
  backgroundColor = "var(--color-brand)",
  backgroundColorHex = "",
  headingColor = "var(--color-brand)",
  headingColorHex = "",
  id,
  _component,
  ...rest
} = Astro.props;
// Under a photo the colour is never seen, but it is what contrast checkers
// (WAVE) and a failed image load measure the heading against, and the brand
// heading on a brand ground measures 1:1. So a photo gets a dark ground.
const backgroundColorValue = backgroundImage
  ? "#1a1a1a"
  : backgroundColorHex || backgroundColor || "var(--color-brand)";
const headingColorValue = headingColorHex || headingColor || "var(--color-brand)";
---
<div class="page-hero-digital" id={id || undefined} style={`--bg:${backgroundColorValue};--hd:${headingColorValue}${backgroundImage ? `;--bgimg:url('${backgroundImage}')` : ""}`} {...rest}>
  <div class="phd-box">
    <div class="phd-box2">
      <h1 class="phd-heading">{heading}</h1>
    </div>
  </div>
</div>
<style>
  .page-hero-digital {
    background-color: var(--bg);
    background-image: var(--bgimg, none);
    background-position: 50% 0%;
    background-repeat: no-repeat;
    background-size: cover;
    box-sizing: border-box;
    color: #333333;
    display: flex;
    flex-direction: column;
    font-family: Lato, sans-serif;
    font-size: 18px;
    line-height: 27px;
    max-width: 100%;
    min-height: 450px;
    position: relative;
  }

  .phd-box {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: flex-end;
    max-width: min(100%, 767px);
    min-height: 450px;
    padding-bottom: 50px;
    padding-top: 180px;
  }

  .phd-box2 {
    box-sizing: border-box;
    text-align: center;
  }

  .phd-heading {
    box-sizing: border-box;
    color: var(--hd);
    font-family: "Playfair Display", sans-serif;
    font-size: 40px;
    font-weight: 700;
    line-height: 40px;
    margin-bottom: 0px;
    margin-top: 0px;
    text-shadow: #ffffff 5px 5px 10px;
  }

  @media (min-width: 768px) {
    .phd-box {
      flex-wrap: nowrap;
      max-width: min(100%, 1024px);
    }

    .phd-heading {
      font-size: 50px;
      line-height: 50px;
    }
  }

  @media (min-width: 1440px) {
    .phd-box {
      max-width: min(100%, 1440px);
    }

    .phd-heading {
      font-size: 70px;
      line-height: 70px;
    }
  }
</style>
