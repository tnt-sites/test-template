---
/**
 * Office Intro — migrated from  [11] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  subheading = "",
  text = "",
  headingColor = "#117d6f",
  textColor = "#000000",
  id,
  _component,
  ...rest
} = Astro.props;
---
<div class="office-intro" id={id || undefined} style={`--hd:${headingColor};--tx:${textColor}`} {...rest}>
  <div class="oi-box">
    <div class="oi-box2">
      <div class="oi-box3">
        <h2 class="oi-heading" set:html={heading} />
      </div>
    </div>
    <div class="oi-box4">
      <div class="oi-box5">
        <div class="oi-decor" aria-hidden="true"></div>
      </div>
    </div>
    <div class="oi-box6">
      {subheading && <h3 class="oi-heading2" set:html={subheading} />}
    </div>
    <div class="oi-box7">
      {text && <p class="oi-text" set:html={text} />}
    </div>
  </div>
</div>
<style>
  .office-intro {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    line-height: 24px;
    max-width: 100%;
    position: relative;
  }

  .oi-box {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-wrap: wrap;
    gap: 20px;
    max-width: min(100%, 767px);
    min-height: 259px;
    padding: 50px 20px 10px;
  }

  .oi-box2 {
    box-sizing: border-box;
    max-width: 100%;
    position: relative;
    text-align: center;
  }

  .oi-box3 {
    box-sizing: border-box;
    margin-bottom: -17px;
  }

  .oi-heading {
    box-sizing: border-box;
    color: var(--hd);
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 2.1px;
    line-height: 15px;
    margin-bottom: 0px;
    margin-top: 0px;
    text-transform: uppercase;
  }

  .oi-box4 {
    box-sizing: border-box;
    max-width: 100%;
    position: relative;
  }

  .oi-box5 {
    box-sizing: border-box;
    display: flex;
    padding-bottom: 2px;
    padding-top: 2px;
    text-align: center;
  }

  .oi-decor {
    border-top: 1px solid #e087ed;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 17.95%;
    margin-left: 159.9px;
    margin-right: 159.9px;
    max-width: 17.95%;
    min-height: 1px;
  }

  .oi-box6 {
    box-sizing: border-box;
    margin-top: -12px;
    text-align: center;
  }

  .oi-heading2 {
    box-sizing: border-box;
    color: var(--tx);
    font-family: Lato, sans-serif;
    font-size: 26px;
    font-weight: 300;
    line-height: 26px;
    margin-bottom: 0px;
    margin-top: 0px;
    text-transform: uppercase;
  }

  .oi-box7 {
    box-sizing: border-box;
    margin-bottom: -10px;
    margin-top: -2px;
    text-align: center;
  }

  .oi-text {
    box-sizing: border-box;
    color: var(--tx);
    font-size: 15px;
    line-height: 24px;
    margin-bottom: 15px;
    margin-top: 0px;
  }

  @media (min-width: 768px) {
    .oi-box {
      flex-wrap: nowrap;
      max-width: min(100%, 1024px);
      min-height: 227px;
    }

    .oi-decor {
      flex: 0 0 17.97%;
      margin-left: 314.9px;
      margin-right: 314.9px;
      max-width: 17.97%;
    }

    .oi-heading2 {
      font-size: 34px;
      line-height: 34px;
    }
  }

  @media (min-width: 1440px) {
    .oi-box {
      margin-left: 150px;
      margin-right: 150px;
      max-width: min(100%, 1140px);
      min-height: 193px;
    }

    .oi-decor {
      flex: 0 0 17.98%;
      margin-left: 467.4px;
      margin-right: 467.4px;
      max-width: 17.98%;
    }
  }
</style>
