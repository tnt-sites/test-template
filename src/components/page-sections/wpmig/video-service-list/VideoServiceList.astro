---
/**
 * Video Service List — "Lounge Bar Service" (migrated from index.html, rebuilt by
 * hand). Left: a poster panel with a play button that opens the section video
 * in a modal <dialog>. Right: eyebrow, heading, intro, and a list of services,
 * each with its icon.
 */
import Icon from "@core-elements/icon/Icon.astro";
import whitening from "./icons/whitening.svg?raw";
import detox from "./icons/detox.svg?raw";
import chaser from "./icons/chaser.svg?raw";
import happyhour from "./icons/happyhour.svg?raw";

const ICONS: Record<string, string> = { whitening, detox, chaser, happyhour };

const {
  eyebrow = "",
  heading = "",
  text4 = "",
  videoSource = "",
  poster = "",
  services = [],
  backgroundColor = "#ffffff",
  eyebrowColor = "#117d6f",
  headingColor = "#000000",
  textColor = "#000000",
  id,
  _component,
  // legacy migrated props, intentionally ignored
  text,
  text2,
  text3,
  subheading,
  text5,
  heading2,
  text6,
  heading3,
  text7,
  heading4,
  text8,
  textColor2,
  textColor3,
  hoverColor,
  ...rest
} = Astro.props;

const list = Array.isArray(services) ? services.filter(Boolean) : [];
const uid = `vsl-${(id && String(id)) || Math.random().toString(36).slice(2, 8)}`;
---
<section
  class="video-service-list"
  id={id || undefined}
  style={`--bg:${backgroundColor};--eb:${eyebrowColor};--hd:${headingColor};--tx:${textColor}`}
  {...rest}
>
  <div class="vsl-inner">
    <div class="vsl-media">
      {poster && <img class="vsl-poster" src={poster} alt="" loading="lazy" />}
      {
        videoSource && (
          <button type="button" class="vsl-play" data-vsl-open={uid} aria-label="Play video">
            <span class="vsl-play-icon" aria-hidden="true"><Icon name="play-circle" /></span>
          </button>
        )
      }
    </div>

    <div class="vsl-content">
      {eyebrow && <p class="vsl-eyebrow">{eyebrow}</p>}
      {heading && <h2 class="vsl-heading" set:html={heading} />}
      {text4 && <p class="vsl-intro">{text4}</p>}

      <div class="vsl-services">
        {
          list.map((s: any) => (
            <div class="vsl-service">
              {s.icon && ICONS[s.icon] && (
                <span class="vsl-icon" aria-hidden="true" set:html={ICONS[s.icon]} />
              )}
              <div class="vsl-service-body">
                {s.title && <h3 class="vsl-service-title" set:html={s.title} />}
                {s.text && <div class="vsl-service-text" set:html={s.text} />}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    videoSource && (
      <dialog class="vsl-modal" id={uid} aria-label={heading || "Video"}>
        <button type="button" class="vsl-modal-close" data-vsl-close aria-label="Close video">
          <Icon name="x-mark" size="none" />
        </button>
        <video class="vsl-video" src={videoSource} controls playsinline preload="none"></video>
      </dialog>
    )
  }
</section>

{
  videoSource && (
    <script is:inline define:vars={{ uid }}>
      (() => {
        const dialog = document.getElementById(uid);
        if (!(dialog instanceof HTMLDialogElement)) return;
        const video = dialog.querySelector("video");
        const opener = document.querySelector(`[data-vsl-open="${uid}"]`);
        const open = () => {
          if (typeof dialog.showModal === "function") dialog.showModal();
          else dialog.setAttribute("open", "");
        };
        const stop = () => {
          if (video) {
            video.pause();
            try { video.currentTime = 0; } catch (e) {}
          }
        };
        opener?.addEventListener("click", open);
        dialog.addEventListener("close", stop);
        dialog.querySelector("[data-vsl-close]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
      })();
    </script>
  )
}

<style>
  .video-service-list {
    background-color: var(--bg);
    box-sizing: border-box;
    font-family: Montserrat, sans-serif;
    font-size: 15px;
    line-height: 24px;
  }

  .vsl-inner {
    box-sizing: border-box;
    display: grid;
    gap: 40px;
    margin-inline: auto;
    max-width: 1140px;
    padding: 60px 24px;
  }

  .vsl-media {
    align-items: center;
    border-radius: 8px;
    display: flex;
    justify-content: center;
    min-height: 280px;
    overflow: hidden;
    position: relative;
  }

  .vsl-poster {
    display: block;
    height: 100%;
    inset: 0;
    object-fit: cover;
    position: absolute;
    width: 100%;
  }

  .vsl-play {
    background: transparent;
    border: 0;
    color: #fff;
    cursor: pointer;
    line-height: 0;
    padding: 0;
    position: relative;
    transition: transform 0.3s ease, color 0.3s ease;
    z-index: 1;
  }

  .vsl-play:hover {
    color: #117d6f;
    transform: scale(1.08);
  }

  .vsl-play-icon :global(svg) {
    display: block;
    height: 82px;
    width: 82px;
  }

  .vsl-eyebrow {
    color: var(--eb);
    font-weight: 600;
    letter-spacing: 2.1px;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .vsl-heading {
    color: var(--hd);
    font-family: Lato, sans-serif;
    font-size: 30px;
    font-weight: 300;
    line-height: 1.1;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .vsl-intro {
    color: var(--tx);
    margin: 0 0 28px;
  }

  .vsl-services {
    display: grid;
    gap: 28px;
  }

  .vsl-service {
    align-items: center;
    display: flex;
    gap: 20px;
  }

  .vsl-icon {
    align-self: center;
    color: #117d6f;
    display: block;
    flex-shrink: 0;
    height: 88px;
    width: 88px;
  }

  .vsl-icon :global(svg) {
    display: block;
    fill: currentColor;
    height: 100%;
    width: 100%;
  }

  .vsl-icon :global(svg path),
  .vsl-icon :global(svg g) {
    fill: currentColor;
  }

  .vsl-service-body {
    border-left: 1px solid var(--color-border, rgb(0 0 0 / 12%));
    padding-left: 20px;
  }

  .vsl-service-title {
    color: var(--hd);
    font-family: Lato, sans-serif;
    font-size: 22px;
    font-weight: 300;
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  .vsl-service-text {
    color: var(--tx);
    font-size: 14px;
    line-height: 1.5;
  }

  .vsl-service-text :global(a) {
    color: var(--eb);
    text-decoration: underline;
  }

  .vsl-modal {
    background: #000;
    border: 0;
    border-radius: 10px;
    max-width: min(960px, calc(100vw - 2rem));
    padding: 0;
    width: 100%;
  }

  .vsl-modal::backdrop {
    background: rgb(0 0 0 / 70%);
  }

  .vsl-video {
    aspect-ratio: 16 / 9;
    display: block;
    height: auto;
    max-height: calc(100vh - 4rem);
    width: 100%;
  }

  .vsl-modal-close {
    align-items: center;
    background-color: #117d6f;
    border: 0;
    border-radius: 999px;
    color: #000;
    cursor: pointer;
    display: inline-flex;
    height: 2.25rem;
    justify-content: center;
    position: absolute;
    right: 8px;
    top: 8px;
    width: 2.25rem;
  }

  .vsl-modal-close :global(svg) {
    height: 1.1rem;
    width: 1.1rem;
  }

  @media (min-width: 768px) {
    .vsl-play-icon :global(svg) {
      height: 100px;
      width: 100px;
    }
  }

  @media (min-width: 1024px) {
    .vsl-inner {
      align-items: stretch;
      gap: 56px;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      padding: 80px 24px;
    }
    .vsl-media {
      min-height: 520px;
    }
  }
</style>
