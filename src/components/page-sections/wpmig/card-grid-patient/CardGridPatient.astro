    padding-right: 10px;
    position: relative;
  }

  .cgp-box {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    flex-wrap: wrap;
    gap: 20px;
    max-width: min(100%, 767px);
    padding-bottom: 20px;
    padding-top: 20px;
  }

  .cgp-box2 {
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
