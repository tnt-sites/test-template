 * Baked in: layout, spacing, typography. Props: text, images, links, colours.
 */
const {
  heading = "",
  text = "",
  text2 = "",
  subheading = "",
  text3 = "",
  heading2 = "",
  text4 = "",
  headingColor = "",
  headingColorHex = "var(--color-brand)",
  textColor = "#000000",
  textColorHex = "",
  textColor2 = "#ffffff",
  textColor2Hex = "",
  id,
  _component,
  ...rest
} = Astro.props;
const headingColorValue = headingColorHex || headingColor || "var(--color-brand)";
const textColorValue = textColorHex || textColor || "#000000";
const textColor2Value = textColor2Hex || textColor2 || "#ffffff";
---
<div class="card-grid-patient" id={id || undefined} style={`--hd:${headingColorValue};--tx:${textColorValue};--c3:${textColor2Value}`} {...rest}>
  <div class="cgp-box">
    <div class="cgp-box2">
      <div class="cgp-box3">
        <div class="cgp-box4">
          <h2 class="cgp-heading">{heading}</h2>
        </div>
        <div class="cgp-box5">
          {text && <div class="cgp-text">{text}</div>}
        </div>
        <div class="cgp-box6">
          {text2 && <div class="cgp-body" set:html={text2} />}
        </div>
      </div>
      <div class="cgp-box7">
        <div class="cgp-box8">
          {subheading && <h2 class="cgp-heading2">{subheading}</h2>}
        </div>
        <div class="cgp-box9">
          {text3 && <div class="cgp-text2">{text3}</div>}
        </div>
      </div>
      <div class="cgp-box10">
        <div class="cgp-box11">
          {heading2 && <h2 class="cgp-heading3">{heading2}</h2>}
        </div>
        <div class="cgp-box12">
          {text4 && <div class="cgp-body2" set:html={text4} />}
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .card-grid-patient {
