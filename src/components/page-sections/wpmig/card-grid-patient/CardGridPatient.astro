  }

  .cgp-text {
    box-sizing: border-box;
  }

  .cgp-box6 {
    box-sizing: border-box;
  }

  .cgp-body :global(ul) {
    box-sizing: border-box;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .cgp-box7 {
    background-color: #f4f8f7;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 112.12%;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 20px;
    max-width: 112.12%;
    padding: 25px;
    position: relative;
  }

  .cgp-box8 {
