---
import Heading from "@core-elements/heading/Heading.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import MeetLandingPerson from "./MeetLandingPerson.astro";

const {
  heading = "",
  doctors = [],
  providers = [],
  background = "white",
  id = "",
  class: className,
  editable = true,
  _component,
  // Older settings, no longer used by the redesigned section.
  variant,
  backgroundColor,
  backgroundImage,
  backgroundGradient,
  ...htmlAttributes
} = Astro.props;

const doctorItems =
  Array.isArray(doctors) && doctors.length > 0
    ? doctors
    : Array.isArray(providers)
      ? providers
      : [];

const normalizedDoctors = doctorItems.filter(
  (doctor: unknown) => !!doctor && typeof doctor === "object"
);

if (!_component && normalizedDoctors.length === 0) {
  return;
}

const doctorsArrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-component-key": "_component",
      "data-id-key": "_component",
      "data-prop": "doctors",
    }
  : {};
---

<section
  class:list={["meet-landing", sectionBackground(background), className]}
  id={id || undefined}
  {...htmlAttributes}
>
  {heading && <Heading level="h2" alignX="center" data-prop="heading" text={heading} />}
  <ul class="no-check flex flex-wrap justify-center" {...doctorsArrayDataAttributes}>
    {
      normalizedDoctors.map((doctor: any) => (
        <editable-array-item data-component="page-sections/people/meet-landing/meet-landing-person">
          <MeetLandingPerson {...doctor} editable={editable} />
        </editable-array-item>
      ))
    }
  </ul>
</section>

<style>
  .meet-landing {
    padding: 65px 25px;
  }

  .meet-landing :global(.heading) {
    margin: 0 0 50px;
  }

  .meet-landing ul {
    gap: 25px 15px;
    margin: 0 auto;
    max-width: 1230px;
    padding: 0;
  }

  /* One per row on phones and tablets, 2x2 on small desktops, four across on
     wide screens. */
  .meet-landing ul > :global(editable-array-item) {
    max-width: 300px;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .meet-landing {
      padding: 80px 25px;
    }

    .meet-landing ul {
      gap: 30px;
      max-width: 560px;
    }

    .meet-landing ul > :global(editable-array-item) {
      width: 265px;
    }
  }

  /* Room for all four in one row (4 x 265px + gaps + side padding). */
  @media (min-width: 1240px) {
    .meet-landing ul {
      max-width: 1230px;
    }
  }
</style>
