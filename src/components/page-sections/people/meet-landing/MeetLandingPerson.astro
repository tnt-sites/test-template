---
import Button from "@core-elements/button/Button.astro";
import Image from "@core-elements/image/Image.astro";

const {
  name = "Provider Name",
  credentials = "",
  buttonText = "",
  href = "#",
  imageSource = "",
  imageAlt = "",
  variant = "button",
  editable = true,
  _component,
  ...htmlAttributes
} = Astro.props;

const cleanText = (value: unknown, fallback = "") =>
  typeof value === "string" && value.trim().length > 0 ? value.trim() : fallback;

const safeVariant = variant === "name" ? "name" : "button";
const providerName = cleanText(name, "Provider Name");
const providerCredentials = cleanText(credentials);
const providerButtonText = cleanText(buttonText, `Meet ${providerName}`);
const providerHref = cleanText(href, "#");
const providerImage = cleanText(imageSource);
const providerImageAlt = cleanText(imageAlt, providerName);

if (!_component && providerName.length === 0 && providerImage.length === 0) {
  return;
}
---

<a href={providerHref} class:list={["meet-landing-person", `variant-${safeVariant}`]} {...htmlAttributes}>
  {
    providerImage && (
      <Image
        source={providerImage}
        alt={providerImageAlt}
        editable={editable}
        data-editable={editable ? "image" : undefined}
        data-prop-src={editable ? "imageSource" : undefined}
        data-prop-alt={editable ? "imageAlt" : undefined}
      />
    )
  }
  <h3 class="name" data-editable={editable ? "text" : undefined} data-prop={editable ? "name" : undefined}>
    {providerName}
    {providerCredentials && (
      <small data-editable={editable ? "text" : undefined} data-prop={editable ? "credentials" : undefined}>
        {providerCredentials}
      </small>
    )}
  </h3>
  {
    safeVariant === "button" && (
      <Button
        element="span"
        class="meet-landing-btn"
        text={providerButtonText}
        variant="primary"
        editable={editable}
        data-prop="buttonText"
      />
    )
  }
</a>
