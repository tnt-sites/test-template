---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";

const { heading = "", columns = [], class: className, _component, ...htmlAttributes } = Astro.props;
---

<CustomSection class:list={["index-affordable", className]} paddingVertical="none" {...htmlAttributes}>
  <div class="wrap block text-center">
    <Heading level="h2" class="title" data-prop="heading" text={heading} />
    <ul class="no-check block lg:flex justify-center items-start lg:text-left">
      {
        columns.map((column: any) => (
          <li>
            <h3>{column.title}</h3>
            <p>{column.text}</p>
            {column.link && (
              <a href={column.link} class="button variant-primary">
                {column.buttonText || "Learn More"}
              </a>
            )}
            {column.logos?.length > 0 && (
              <span class="logos">
                {column.logos.map((logo: any) => (
                  <Image
                    source={logo.imageSource}
                    alt={logo.imageAlt}
                    editable={false}
                    widths={[240, 480]}
                    style={logo.height ? `--logo-height: ${logo.height}px` : undefined}
                  />
                ))}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</CustomSection>

<style>
  /* Final.xd: 585px band with a #E7E7E7 to #F8F8F8 gradient across the top 146px */
  :global(.index-affordable) {
    background: linear-gradient(#e7e7e7, var(--color-bg-surface) 145px);
    background-color: var(--color-bg-surface);
  }

  :global(.index-affordable) .wrap {
    margin: 0 auto;
    max-width: 1400px;
    padding: 155px 20px 100px;
  }

  :global(.index-affordable) :global(.title) {
    color: var(--color-brand);
    font-size: 40px;
    font-weight: 200;
    line-height: 45px;
    margin: 0;
    text-align: inherit;
    text-transform: uppercase;
  }

  :global(.index-affordable) ul {
    list-style: none;
    margin: 50px 0 0;
    padding: 0;
  }

  :global(.index-affordable) li {
    margin: 0 auto 40px;
    max-width: 350px;
    text-align: center;
  }

  :global(.index-affordable) h3 {
    color: var(--color-brand-secondary);
    font-family: var(--font-ui);
    font-size: 21px;
    font-weight: 400;
    line-height: 28px;
    margin: 0;
  }

  :global(.index-affordable) p {
    font-size: 18px;
    line-height: 24px;
    margin: 15px 0 0;
  }

  /* Buttons and logos share one 55px row, 50px under the text */
  :global(.index-affordable) a,
  :global(.index-affordable) .logos {
    margin-top: 50px;
    min-height: 55px;
  }

  :global(.index-affordable) a {
    align-items: center;
    display: inline-flex;
    justify-content: center;
    min-width: 175px;
    padding: 0 30px;
    text-transform: uppercase;
  }

  :global(.index-affordable) .logos {
    align-items: center;
    display: flex;
    gap: 30px;
    justify-content: center;
  }

  :global(.index-affordable) .logos :global(.image) {
    margin: 0;
  }

  :global(.index-affordable) .logos :global(img) {
    height: var(--logo-height, 33px);
    max-width: none;
    width: auto;
  }

  @media (min-width: 1024px) {
    :global(.index-affordable) :global(.title) {
      font-size: 59px;
      line-height: 62px;
    }

    :global(.index-affordable) li {
      flex: 0 0 350px;
      margin: 0;
      text-align: left;
    }

    :global(.index-affordable) li + li {
      margin-left: 45px;
    }

    :global(.index-affordable) .logos {
      gap: 45px;
      justify-content: flex-start;
    }
  }
</style>
