---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import { Icon as AstroIcon } from "astro-icon/components";

interface ReviewItem {
  text: string;
  authorName: string;
  socialIcon?: string;
  reviewerImage?: string;
}

const {
  heading = "",
  reviews = [] as ReviewItem[],
  showQuoteIcon = false,
  buttonSections = [],
  backgroundColor = "base",
  id = "",
  backgroundImage,
  backgroundGradient = "",
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["index-reviews", className]}
  paddingHorizontal=""
  paddingVertical=""
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundImage={backgroundImage}
  backgroundGradient={backgroundGradient}
  {...htmlAttributes}
>
  <div class="reviews-container">
    {heading && <Heading level="h2" size="lg" alignX="start" text={heading} data-prop="heading" />}

    {
      reviews.length > 0 ? (
        <div class="reviews-wrap">
          {showQuoteIcon && <i class="icon-quote quote-icon" aria-hidden="true" />}
          <Carousel editable={false} class="index-reviews-carousel">
            {reviews.map((review: ReviewItem) => {
              return (
                <CarouselSlide>
                  <div class="review-slide">
                    <p class="review-text">{review.text}</p>
                    <div class="review-author">
                      {review.reviewerImage && (
                        <img
                          class="reviewer-img"
                          src={review.reviewerImage}
                          alt={review.authorName}
                        />
                      )}
                      {!review.reviewerImage && review.socialIcon && (
                        <AstroIcon name={review.socialIcon} class="social-icon" />
                      )}
                      <div class="author-details">
                        <span class="stars" aria-label="5 out of 5 stars">
                          ★★★★★
                        </span>
                        <span class="author-name">{review.authorName}</span>
                      </div>
                    </div>
                  </div>
                </CarouselSlide>
              );
            })}
            {buttonSections.length > 0 && (
              <ButtonGroup
                slot="controls-end"
                class="reviews-buttons"
                width="content"
                buttonSections={buttonSections}
                editable={editable}
              />
            )}
          </Carousel>
        </div>
      ) : (
        <p class="empty-state">No reviews added yet.</p>
      )
    }
  </div>
</CustomSection>

<style>
  .index-reviews{
    position: relative;
  }
  .index-reviews:after{content: ''; positon: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: .6; background-color: var(--color-bg-brand)}
  .reviews-container {
    padding: 100px 40px;
  }

  :global(.index-reviews .heading) {
    color: #fff;
    margin-bottom: 40px;
    max-width: 520px;
  }

  .reviews-wrap {
    position: relative;
  }

  .quote-icon {
    color: #fff;
    font-family: fontello, sans-serif;
    font-size: 40px;
    font-style: normal;
    left: 0;
    line-height: 1;
    position: absolute;
    top: 0;
  }

  :global(.index-reviews-carousel) {
    margin-top: 0;
  }

  :global(.index-reviews-carousel > .viewport) {
    padding-left: 50px;
  }

  .review-slide {
    text-align: left;
  }

  .review-text {
    color: #fff;
    font-size: 1.6rem;
    line-height: 1.4;
    margin: 0;
    max-width: 580px;
  }

  .review-author {
    margin-top: 30px;
    max-width: 520px;
  }

  .author-details {
    color: #fff;
    display: flex;
    gap: var(--spacing-xs);
    justify-content: space-between;
  }

  .reviewer-img {
    border-radius: var(--radius-full, 50%);
    flex-shrink: 0;
    height: 3.5rem;
    object-fit: cover;
    width: 3.5rem;
  }

  .social-icon {
    flex-shrink: 0;
    height: 2.5rem;
    width: 2.5rem;
  }

  :global(.social-icon[data-icon="social/google"]) {
    color: var(--color-social-google);
  }
  :global(.social-icon[data-icon="social/facebook"]) {
    color: var(--color-social-facebook);
  }
  :global(.social-icon[data-icon="social/yelp"]) {
    color: var(--color-social-yelp);
  }
  :global(.social-icon[data-icon="social/instagram"]) {
    color: var(--color-social-instagram);
  }
  :global(.social-icon[data-icon="social/x"]) {
    color: var(--color-social-twitter);
  }
  :global(.social-icon[data-icon="social/youtube"]) {
    color: var(--color-social-youtube);
  }
  :global(.social-icon[data-icon="social/tiktok"]) {
    color: var(--color-social-tiktok);
  }
  :global(.social-icon[data-icon="social/bluesky"]) {
    color: var(--color-social-bluesky);
  }

  .stars {
    font-size: 1.4rem;
    letter-spacing: 5px;
    order: 2;
  }

  .author-name {
    font-size: 1.4rem;
    font-weight: normal;
  }

  .empty-state {
    color: #fff;
    opacity: 0.6;
    padding: var(--spacing-2xl);
    text-align: left;
  }

  /* Controls: indicator dots pinned left, prev/next grouped right */
  :global(.index-reviews-carousel > .controls-wrapper) {
    justify-content: space-between;
    margin-bottom: 0;
    margin-top: 30px;
  }

  :global(.index-reviews-carousel > .controls-wrapper > .indicators) {
    flex: 1 1 auto;
    justify-content: flex-start;
    order: -1;
  }

  :global(.index-reviews-carousel > .controls-wrapper > .indicator) {
    background-color: transparent;
  }

  :global(.index-reviews-carousel .indicator) {
    background-color: transparent !important;
    border: 2px solid #fff;
    height: 14px;
    position: relative;
    transform: none !important;
    width: 14px;
  }

  :global(.index-reviews-carousel .indicator::before) {
    background-color: transparent;
    border-radius: 50%;
    content: "";
    inset: 2px;
    position: absolute;
  }

  :global(.index-reviews-carousel .indicator[data-selected="true"]::before) {
    background-color: #fff;
  }

  /* Replace the built-in prev/next arrows with the "Read More Reviews" /
     "Write a Review" buttons, in the same spot on the right of the row. */
  :global(.index-reviews-carousel > .controls-wrapper > .prev),
  :global(.index-reviews-carousel > .controls-wrapper > .next) {
    display: none;
  }

  :global(.index-reviews-carousel .reviews-buttons) {
    flex-shrink: 0;
    gap: 15px;
    margin-top: 0;
  }

  @media (max-width: 1000px) {
    .reviews-container {
      padding: 60px 30px;
    }

    .reviews-container {
      margin: 0 auto;
      max-width: 650px;
    }

    :global(.index-reviews-carousel > .controls-wrapper) {
      flex-direction: column;
      gap: 20px;
    }

    :global(.index-reviews-carousel > .controls-wrapper > .indicators) {
      flex: 0 0 auto;
      justify-content: center;
    }

    :global(.index-reviews-carousel .reviews-buttons) {
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .quote-icon {
      margin-bottom: 20px;
      position: relative;
    }

    :global(.index-reviews-carousel > .viewport) {
      padding-left: 0;
    }

    .review-text {
      font-size: 1.9rem;
    }
  }
</style>
