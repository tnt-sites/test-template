---
import Heading from "@core-elements/heading/Heading.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

interface ReviewItem {
  text: string;
  authorName: string;
}

const {
  heading = "",
  reviews = [] as ReviewItem[],
  buttonSections = [],
  background = "cream",
  id = "",
  class: className,
  editable = true,
  _component,
  // Older settings, no longer used.
  showQuoteIcon,
  backgroundColor,
  backgroundImage,
  backgroundGradient,
  ...htmlAttributes
} = Astro.props;

const normalizedReviews = Array.isArray(reviews)
  ? reviews.filter((review: any) => review && typeof review.text === "string" && review.text.trim())
  : [];
---

<section
  class:list={["index-reviews", sectionBackground(background), className]}
  id={id || undefined}
  {...htmlAttributes}
>
  {heading && <Heading level="h2" alignX="center" text={heading} data-prop="heading" />}

  {
    normalizedReviews.length > 0 && (
      <Carousel
        editable={false}
        label="Patient reviews"
        arrowsBeside
        arrowStyle="long"
        dotsPosition="bottom"
      >
        {normalizedReviews.map((review: ReviewItem) => (
          <CarouselSlide>
            <figure class="review block text-center">
              <blockquote>
                <p>{review.text}</p>
              </blockquote>
              {review.authorName && <figcaption>{review.authorName}</figcaption>}
            </figure>
          </CarouselSlide>
        ))}
        {buttonSections.length > 0 && (
          <div slot="controls" class="reviews-button">
            <ButtonGroup width="content" buttonSections={buttonSections} alignX="center" />
          </div>
        )}
      </Carousel>
    )
  }
</section>

<style>
  .index-reviews {
    padding: 60px 25px;
  }

  .index-reviews :global(.heading) {
    margin: 0 0 30px;
  }

  .index-reviews :global(.carousel) {
    margin: 0 auto;
    max-width: 1150px;
  }

  /* Shorter reviews sit in the middle of the tallest review's height. */
  .index-reviews :global(.track) {
    align-items: center;
  }

  .review {
    margin: 0 auto;
    max-width: 590px;
  }

  .review blockquote {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .review p {
    font-style: italic;
    margin: 0;
  }

  .review figcaption {
    font-weight: bold;
    margin-top: 25px;
  }

  /* The button is full width on phones and a fixed pill on desktop. */
  .reviews-button :global(:is(.button-group, editable-array, editable-array-item)) {
    display: block;
    margin: 0;
    width: 100%;
  }

  .reviews-button :global(.button) {
    font-size: 17px;
    letter-spacing: 0.08em;
    min-height: 50px;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .index-reviews {
      padding: 80px 25px;
    }

    .reviews-button :global(.button) {
      width: 355px;
    }
  }
</style>
