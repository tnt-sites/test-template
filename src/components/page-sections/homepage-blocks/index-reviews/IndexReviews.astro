---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";
import { Icon as AstroIcon } from "astro-icon/components";

interface ReviewItem {
  text: string;
  authorName: string;
  socialIcon?: string;
  reviewerImage?: string;
}

const {
  eyebrow = "",
  heading = "",
  reviews = [] as ReviewItem[],
  showQuoteIcon = false,
  buttonText = "",
  buttonHref = "",
  colorScheme = "default",
  backgroundColor = "base",
  id = "",
  backgroundImage,
  backgroundGradient = "",
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

// In peek mode the carousel is edge-to-edge with slides capped at 600px.
// Embla measures offsetWidth at init so max-width must be in CSS before init.
const classList = String(className ?? "").split(" ");
const isPeek = classList.includes("peek");

// In grid mode the carousel only applies below the desktop breakpoint; at
// desktop width all reviews unwrap into a static wrapped row of bordered
// boxes (see the media query in the style block below).
const isGrid = classList.includes("grid");
---

<CustomSection
  class:list={["index-reviews", className]}
  maxContentWidth={isPeek ? undefined : "2xl"}
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  backgroundImage={backgroundImage}
  backgroundGradient={backgroundGradient}
  {...htmlAttributes}
>
  {
    eyebrow && (
      <h2 class="eyebrow-line" data-editable="text" data-prop="eyebrow">
        {eyebrow}
      </h2>
    )
  }
  {heading && <Heading level="h3" size="lg" alignX="center" text={heading} data-prop="heading" />}

  {
    reviews.length > 0 ? (
      <Carousel
        editable={false}
        class="index-reviews-carousel"
        maxSlideWidth={isGrid ? 320 : isPeek ? 600 : 0}
        {...(isPeek ? { "data-no-contain-scroll": true, "data-slides-to-scroll": "1" } : {})}
      >
        {reviews.map((review: ReviewItem) => {
          const hasMeta = !!(review.reviewerImage || review.socialIcon);

          return (
            <CarouselSlide>
              <div class="review-slide">
                {showQuoteIcon && (
                  <span class="quote-badge">
                    <img src="/images/index-quote.png" alt="" />
                  </span>
                )}
                <p class="review-text">{review.text}</p>
                <div class:list={["review-author", { "has-meta": hasMeta }]}>
                  {review.reviewerImage && (
                    <img class="reviewer-img" src={review.reviewerImage} alt={review.authorName} />
                  )}
                  {!review.reviewerImage && review.socialIcon && (
                    <AstroIcon name={review.socialIcon} class="social-icon" />
                  )}
                  <div class="author-details">
                    <span class="stars" aria-label="5 out of 5 stars">
                      ★★★★★
                    </span>
                    <span class="author-name">{review.authorName}</span>
                  </div>
                </div>
              </div>
            </CarouselSlide>
          );
        })}
      </Carousel>
    ) : (
      <p class="empty-state">No reviews added yet.</p>
    )
  }

  {
    buttonText && (
      <div class="reviews-cta">
        <Button text={buttonText} link={buttonHref} variant="reverse" data-prop="buttonText" />
      </div>
    )
  }
</CustomSection>

<style>
  .eyebrow-line {
    color: var(--color-text);
    display: block;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2.4px;
    line-height: 1.17;
    margin: 10px auto;
    text-align: center;
    text-transform: uppercase;
  }

  :global(.index-reviews .heading) {
    font-size: clamp(2rem, 4vw, 54px);
    line-height: 0.98;
  }

  .review-slide {
    padding: var(--spacing-md);
    position: relative;
    text-align: center;
  }

  .quote-badge {
    background-color: var(--color-bg-black, #000);
    display: table;
    margin-top: -60px;
    padding: 4px;
    position: relative;
    z-index: 1;
  }

  .quote-badge img {
    display: block;
    margin: 0;
  }

  .review-text {
    font-size: clamp(1rem, 2.5vw, 1.375rem);
    line-height: 1.3;
    margin: 0 auto var(--spacing-md);
    max-width: 500px;
  }

  .review-author {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    justify-content: center;
    margin-bottom: var(--spacing-md);
  }

  .review-author.has-meta {
    flex-direction: row;
    gap: var(--spacing-sm);
    text-align: left;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .reviewer-img {
    flex-shrink: 0;
  }

  .social-icon {
    flex-shrink: 0;
    height: 2.5rem;
    width: 2.5rem;
  }

  :global(.social-icon[data-icon="social/google"]) {
    color: var(--color-social-google);
  }
  :global(.social-icon[data-icon="social/facebook"]) {
    color: var(--color-social-facebook);
  }
  :global(.social-icon[data-icon="social/yelp"]) {
    color: var(--color-social-yelp);
  }
  :global(.social-icon[data-icon="social/instagram"]) {
    color: var(--color-social-instagram);
  }
  :global(.social-icon[data-icon="social/x"]) {
    color: var(--color-social-twitter);
  }
  :global(.social-icon[data-icon="social/youtube"]) {
    color: var(--color-social-youtube);
  }
  :global(.social-icon[data-icon="social/tiktok"]) {
    color: var(--color-social-tiktok);
  }
  :global(.social-icon[data-icon="social/bluesky"]) {
    color: var(--color-social-bluesky);
  }

  .stars {
    color: var(--color-star, #febb21);
    font-size: 1.25rem;
    letter-spacing: 0.1em;
  }

  .author-name {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2.2px;
    line-height: 1.27;
    text-transform: uppercase;
  }

  .empty-state {
    opacity: 0.6;
    padding: var(--spacing-2xl);
    text-align: center;
  }

  .reviews-cta {
    margin-top: var(--spacing-lg);
    text-align: center;
  }

  /*
    PEEK LAYOUT 
    Toggle by adding class "peek" to IndexReviews in index.md:
      class: peek
   
    Shows adjacent slides peeking in from the sides at half opacity.
    Slide width is set at render time via slideWidthPercent (see isPeek above).
    The ClassNames plugin (embla-carousel-class-names) adds "is-snapped" to
    the selected slide, which drives the opacity.
   */

  /* Break carousel out of the padded content wrapper so it's truly full-width.
     The heading retains its padding via the parent. */
  :global(.index-reviews.peek .index-reviews-carousel) {
    margin-inline: calc(-1 * var(--spacing-lg));
    width: calc(100% + 2 * var(--spacing-lg));
  }

  :global(.index-reviews.peek) {
    overflow: hidden;
  }

  :global(.index-reviews.peek .index-reviews-carousel > .viewport) {
    overflow: visible;
  }

  :global(.index-reviews.peek .slide) {
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  :global(.index-reviews.peek .slide.is-snapped) {
    opacity: 1;
  }

  /*
    GRID LAYOUT
    Toggle by adding class "grid" to IndexReviews in index.md:
      class: grid

    The bordered-box look applies at every breakpoint (matching the
    reference). Below 1025px the boxes sit inside a normal swipeable
    carousel; at 1025px and up, all reviews unwrap into a static wrapped
    row instead and the arrows/dots are hidden.
   */
  :global(.index-reviews.grid .review-slide) {
    border: 1px solid var(--color-border-strong, #707070);
    min-height: 287.5px;
    padding: 27px;
    text-align: left;
  }

  :global(.index-reviews.grid .review-text) {
    font-size: 17px;
    line-height: 1.3;
    margin-inline: 0;
    min-height: 140px;
  }

  :global(.index-reviews.grid .review-author) {
    justify-content: flex-start;
  }

  /* The quote badge overlaps the top border via a negative margin, so the
     viewport can only clip horizontally (for the carousel's scroll) —
     clipping vertically too would cut the badge off. */
  :global(.index-reviews.grid .index-reviews-carousel > .viewport) {
    overflow: hidden visible;
  }

  @media (min-width: 1025px) {
    :global(.index-reviews.grid .index-reviews-carousel > .viewport > .track) {
      flex-wrap: wrap;
      justify-content: center;
      padding-top: 60px;
      transform: none !important;
    }

    :global(.index-reviews.grid .index-reviews-carousel .slide) {
      flex: 0 1 287.5px;
      max-width: none;
    }

    :global(.index-reviews.grid .index-reviews-carousel > .controls-wrapper) {
      display: none;
    }
  }
</style>
