---
// Ported from the source homepage's
// `<section id="financial" class="horizontal-accordion">` — a full-bleed photo
// with a blue panel overlapping its lower edge, holding a three-item accordion
// of payment options. Shares the accordion behaviour with #welcome; the click
// handler in HomeWelcome.astro binds both.
type Item = { heading?: string; text?: string; linkText?: string; linkHref?: string };

const {
  id = "financial",
  eyebrow = "",
  heading = "",
  imageDesktop = "",
  imageMobile = "",
  imageAlt = "",
  items = [] as Item[],
} = Astro.props;
---

<section id={id} class="horizontal-accordion">
  <figure>
    <picture>
      {imageDesktop && <source srcset={imageDesktop} media="(min-width: 701px)" />}
      {imageMobile && <source srcset={imageMobile} media="(max-width: 700px)" />}
      <img class="bg" src={imageDesktop} alt={imageAlt} />
    </picture>
  </figure>
  <div class="container">
    <article>
      {eyebrow && <h2 class="h1-small">{eyebrow}</h2>}
      {heading && <span class="h2">{heading}</span>}
    </article>
    <div class="flex">
      {
        items.map((item: Item) => (
          <div class="item">
            <h4>{item.heading}</h4>
            <div class="expand">
              <p>{item.text}</p>
              {item.linkText && (
                <a href={item.linkHref} class="arrow-btn">
                  {item.linkText}
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  #financial.horizontal-accordion {
    overflow: hidden;
    position: relative;
  }

  #financial figure {
    line-height: 0;
    margin: 0;
  }

  /* The source's global `img { max-width: 100%; display: block; margin: 0 auto }`,
     restated scoped. `width: 100%` is deliberately NOT set — the photo is
     1404px wide naturally and stretching it to the 1440px viewport made the
     section 17px too tall. */
  #financial img {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    min-height: 550px;
    object-fit: cover;
  }

  #financial .container {
    background-color: #9ecae1;
    border: 1px solid #000;
    border-bottom: none;
    inset: auto 0 0;
    margin: 0 auto;
    max-width: 900px;
    padding: 60px 20px 120px;
    position: absolute;
  }

  #financial article {
    text-align: center;
  }

  #financial article .h1-small,
  #financial article .h2 {
    background-color: #9ecae1;
    color: #292929;
  }

  /* Accordion shell — the source's `.horizontal-accordion` rules, restated
     scoped to this section. `position: absolute; inset: auto 0 0` is part of
     that rule: without it the accordion row joins the flow and the blue panel
     grows by its height. */
  #financial.horizontal-accordion .flex {
    align-items: flex-end;
    display: flex;
    inset: auto 0 0;
    position: absolute;
  }

  #financial.horizontal-accordion .item {
    background-color: #fff;
    border-bottom: 2px solid #000;
    border-left: 1px solid #000;
    border-right: 1px solid #000;
    border-top: 2px solid #000;
    cursor: pointer;
    padding: 0 20px;
    width: 33.3333%;
  }

  #financial .item:first-of-type {
    border-left: none;
  }

  #financial .item:last-of-type {
    border-right: none;
  }

  #financial.horizontal-accordion .item h4 {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 20px 0;
    position: relative;
  }

  #financial.horizontal-accordion .item h4::after {
    content: url("/assets/images/plus-icon.svg");
    line-height: 0;
    transition: 0.6s all;
  }

  #financial.horizontal-accordion .item .expand {
    height: 0;
    opacity: 0;
    overflow: hidden;
    transition: 0.3s all;
  }

  #financial .item p {
    line-height: 1.3;
  }

  #financial .item .expand p {
    font-size: 15px;
    margin: 0;
    padding-bottom: 10px;
  }

  #financial.horizontal-accordion .item.active h4::after {
    content: url("/assets/images/less-icon.svg");
    transform: rotate(180deg);
  }

  #financial.horizontal-accordion .item.active .expand {
    height: 130px;
    opacity: 1;
  }

  #financial .item .arrow-btn {
    align-items: center;
    color: #292929;
    display: flex;
    font-family: aktiv-grotesk-extended, sans-serif;
    font-size: 13px;
    font-weight: 500;
    gap: 10px;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
  }

  #financial .item .arrow-btn::after {
    align-items: center;
    background-color: #2b8435;
    border-radius: 50%;
    content: url("/assets/images/btn-arrow-small.svg");
    display: flex;
    flex: 0 1 28px;
    height: 28px;
    justify-content: center;
    line-height: 0;
    width: 28px;
  }

  #financial .item .arrow-btn:hover::after {
    background-color: #9ecae1;
  }

  @media (max-width: 1150px) {
    #financial.horizontal-accordion .item {
      padding: 0 15px;
    }

    #financial.horizontal-accordion .item h4 {
      font-size: 20px;
    }
  }

  @media (max-width: 1024px) {
    #financial img {
      min-height: unset;
    }

    #financial .container {
      background-color: unset;
      border: none;
      inset: unset;
      margin: 0 auto;
      max-width: 100%;
      padding: 0;
      position: relative;
    }

    #financial article {
      background-color: #9ecae1;
      border: 1px solid #000;
      padding: 60px 20px;
    }

    #financial.horizontal-accordion .item {
      border: 1px solid #000 !important;
      margin: 0 auto;
      max-width: 400px;
      width: 90% !important;
    }

    /* The negative top margin is the source's — it lifts the accordion column
       so its first item overlaps the bottom edge of the blue heading panel. */
    #financial.horizontal-accordion .flex {
      flex-direction: column;
      margin: -40px auto 0;
      position: relative;
    }
  }
</style>
