---
const { id = "", class: className, _component, ...rest } = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<div class:list={["index-divider", "hr-deco", className]} id={id || undefined} {...htmlAttributes}>
  <span></span>
  <img src="/images/deco.png" alt="Decorative vertical lines" />
  <span></span>
</div>

<style lang="pcss" is:global>
  @layer page-sections {
    .index-divider.hr-deco {
      align-items: center;
      display: flex;
      gap: 12px;
      margin: 0 auto;
      max-width: 1150px;
      padding-inline: var(--spacing-lg);

      span {
        background-color: var(--color-border);
        display: block;
        flex: 1;
        height: 1px;
      }
    }
  }
</style>
