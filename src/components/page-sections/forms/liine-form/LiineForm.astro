---
/**
 * Liine Form — embeds a Liine online-scheduling form (forms.liine.com) in an
 * iframe. Used on the Contact and Appointment Request pages and as a sidebar
 * rail on interior service pages. The live site injects this widget with
 * JavaScript, so it is not present in the static snapshot; the embed markup is
 * recovered from the WordPress export.
 */
const {
  formId = "252015254376958",
  heading = "",
  subtext = "",
  height = 800,
  backgroundColor = "base",
  layout = "section", // "section" (full width band) | "bare" (no band, for sidebars)
  id = "",
  _component,
  ...rest
} = Astro.props;

const numericHeight = typeof height === "string" ? parseInt(height, 10) || 800 : height;
const src = `https://forms.liine.com/${formId}`;
const bare = layout === "bare";
---
<section
  class:list={["liine-form", { "liine-form--bare": bare }]}
  data-bg={bare ? undefined : backgroundColor}
  id={id || undefined}
  {...rest}
>
  <div class="liine-inner">
    {heading && <h2 class="liine-heading" set:html={heading} />}
    {subtext && <div class="liine-subtext" set:html={subtext} />}
    <div class="liine-frame-wrap">
      <iframe
        class="liine-frame"
        title={heading || "Schedule an appointment"}
        src={src}
        style={`height:${numericHeight}px;`}
        allow="geolocation; microphone; camera; fullscreen; payment"
        allowtransparency="true"
        frameborder="0"
        scrolling="no"
        loading="lazy"></iframe>
    </div>
  </div>
</section>
<style>
  .liine-form {
    box-sizing: border-box;
    width: 100%;
    padding: 60px 20px;
  }

  .liine-form--bare {
    padding: 0;
  }

  .liine-inner {
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 900px;
    width: 100%;
  }

  .liine-form--bare .liine-inner {
    max-width: 100%;
  }

  .liine-heading {
    color: var(--color-brand, #047ac0);
    font-family: "Playfair Display", serif;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 0.5em;
    text-align: center;
  }

  .liine-form--bare .liine-heading {
    font-size: 1.35rem;
    text-align: left;
  }

  .liine-subtext {
    color: #333;
    font-family: Lato, sans-serif;
    margin: 0 auto 1.5em;
    max-width: 640px;
    text-align: center;
  }

  .liine-frame-wrap {
    box-sizing: border-box;
    width: 100%;
  }

  .liine-frame {
    border: none;
    display: block;
    max-width: 100%;
    min-width: 100%;
    width: 100%;
  }
</style>
