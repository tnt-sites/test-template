---
/**
 * A row of images, two per row from 768px up and stacked below it.
 */
const {
  images = [],
  id,
  _component,
  ...rest
} = Astro.props;
const list = Array.isArray(images) ? images.filter(Boolean) : [];
---
<section class="image-row" id={id || undefined} {...rest}>
  <div class="sd-grid">
    {list.map((it) => (
      <div class="sd-box">
        <div class="sd-box2">
          {it.image && <img class="sd-media" src={it.image} alt={it.imageAlt || ""} loading="lazy" width="650" height="753" />}
        </div>
      </div>
    ))}
  </div>
</section>
<style>
  .image-row {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
    margin-left: auto;
    margin-right: auto;
    max-width: 360px;
    position: relative;
    text-align: left;
  }

  .sd-grid {
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    max-width: 767px;
    position: relative;
  }

  .sd-box {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-wrap: wrap;
    max-width: 100%;
    padding: 10px;
    position: relative;
  }

  .sd-box2 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    text-align: center;
  }

  .sd-media {
    box-sizing: border-box;
    display: inline-block;
    width: 100%;
  }

  @media (min-width: 768px) {
    .image-row {
      max-width: 690px;
    }

    .sd-grid {
      max-width: 1024px;
    }

    .sd-box {
      flex: 0 0 50%;
      max-width: 50%;
    }
  }

  @media (min-width: 1440px) {
    .image-row {
      max-width: 1110px;
    }

    .sd-grid {
      flex-wrap: nowrap;
      max-width: 1140px;
    }
  }
</style>
