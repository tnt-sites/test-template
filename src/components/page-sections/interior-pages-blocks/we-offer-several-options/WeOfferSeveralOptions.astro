---
/**
 * We Offer Several Options — migrated from dental-services/cosmetic-dentistry [2] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `images`.
 *
 * Every option is a card in `images`. The migrated page carried its fifth
 * option (White Fillings) as a separate, differently sized card after the grid;
 * it now sits in the grid with the rest.
 */
import ServiceCardGrid from "@page-sections/shared-blocks/service-card-grid/ServiceCardGrid.astro";
const {
  text = "",
  subheading = "",
  text4 = "",
  images = [],
  textColor = "#1b2e38",
  textColor2 = "#c0394a",
  id,
  _component,
  ...rest
} = Astro.props;
const list = Array.isArray(images) ? images.filter(Boolean) : [];
---
<div class="we-offer-several-options" id={id || undefined} style={`--tx:${textColor};--c2:${textColor2}`} {...rest}>
  <div class="woso-box">
    <div class="woso-box2">
      <div class="woso-box3">
        <div class="woso-box4">
          <div class="woso-box5">
            {text && <div class="woso-body" set:html={text} />}
          </div>
        </div>
        <div class="woso-box6">
          {subheading && <p class="woso-heading">{subheading}</p>}
        </div>
        <ServiceCardGrid items={list} accentColor={`var(--c2)`} />
      </div>
      <div class="woso-box36">
        <div class="woso-box37">
          <div class="woso-box38">
            {text4 && <p class="woso-text11" set:html={text4} />}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .we-offer-several-options {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
