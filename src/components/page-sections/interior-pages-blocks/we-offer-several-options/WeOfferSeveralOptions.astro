    padding: 10px;
    position: relative;
  }

  .woso-box37 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    position: relative;
  }

  .woso-box38 {
    box-sizing: border-box;
  }

  .woso-text11 {
    box-sizing: border-box;
