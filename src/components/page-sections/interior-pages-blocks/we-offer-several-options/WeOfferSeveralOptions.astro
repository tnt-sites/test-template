    min-height: 376px;
  }

  .woso-body :global(p) {
    box-sizing: border-box;
    margin-top: 0px;
  }

  .woso-box6 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
  }

  .woso-heading {
    box-sizing: border-box;
