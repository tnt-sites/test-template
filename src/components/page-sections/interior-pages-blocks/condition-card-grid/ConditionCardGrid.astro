---
/**
 * Grid of dental-condition cards — a title, a sentence, and a "Learn More"
 * link per condition. Used by the dental-conditions index.
 *
 * Each `items` entry holds *two* cards, not one: the migrator captured the
 * source's two-up rows verbatim, so `title`/`text`/`buttonText` is the left
 * card and `text2`/`text3`/`buttonText2` the right one.
 */
import Button from "@core-elements/button/Button.astro";
const {
  items = [],
  titleColor = "#1b2e38",
  textColor = "#1b2e38",
  textColor2 = "#ffffff",
  hoverBackgroundColor = "#49ab71",
  hoverBackgroundColor2 = "#4bad73",
  hoverBackgroundColor3 = "#4eaf76",
  id,
  _component,
  ...rest
} = Astro.props;
const list = Array.isArray(items) ? items.filter(Boolean) : [];
---
<div class="condition-card-grid" id={id || undefined} style={`--tt:${titleColor};--tx:${textColor};--c3:${textColor2};--c4:${hoverBackgroundColor};--c5:${hoverBackgroundColor2};--c6:${hoverBackgroundColor3}`} {...rest}>
  <div class="bf-box">
    <section class="bf-box2">
      <div class="bf-grid">
        {list.map((it) => (
          <section class="bf-box3">
            <div class="bf-box4">
              <div class="bf-box5">
                <div class="bf-box6">
                  <h2 class="bf-heading">{it.title}</h2>
                </div>
                <div class="bf-box7">
                  <div class="bf-decor" aria-hidden="true"></div>
                </div>
                <div class="bf-box8">
                  <div class="bf-text">{it.text}</div>
                </div>
                <div class="bf-box9">
                  {it.buttonText && <Button variant="primary" size="md" width="none" borderRadius="default" borderWidth="none" class="bf-btn" text={it.buttonText} link={it.buttonLink || "#"} />}
                </div>
              </div>
              <div class="bf-box10">
                <div class="bf-box11">
                  <h2 class="bf-heading2">{it.text2}</h2>
                </div>
                <div class="bf-box12">
                  <div class="bf-decor2" aria-hidden="true"></div>
                </div>
                <div class="bf-box13">
                  <div class="bf-text2">{it.text3}</div>
                </div>
                <div class="bf-box14">
                  {it.buttonText2 && <Button variant="primary" size="md" width="none" borderRadius="default" borderWidth="none" class="bf-btn2" text={it.buttonText2} link={it.buttonLink2 || "#"} />}
                </div>
              </div>
            </div>
          </section>
        ))}
      </div>
    </section>
  </div>
</div>
<style>
  .condition-card-grid {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
    min-height: 2881px;
    padding-bottom: 30px;
    padding-top: 30px;
    text-align: left;
  }

  .bf-box {
    box-sizing: border-box;
    padding-left: 15px;
    padding-right: 15px;
  }

  .bf-box2 {
