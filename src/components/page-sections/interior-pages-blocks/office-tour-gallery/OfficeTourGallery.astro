---
/**
 * Office tour photo gallery — a grid of practice photos opening in a lightbox,
 * beside the About Us side menu.
 *
 * The 21 image paths are hardcoded in the markup below; the migrator did not
 * lift them into props, so the gallery cannot be edited in the CMS. The
 * theme's own `page-sections/features/office-tour` carousel takes a
 * `tourSlides` array and is the editable alternative if this page ever moves
 * off the migrated layout.
 */
import SideMenu from "@page-sections/shared-blocks/side-menu/SideMenu.astro";
import Lightbox from "@core-elements/lightbox/Lightbox.astro";
const {
  subheading = "",
  buttonText = "",
  buttonLink = "",
  secondaryButtonText = "",
  secondaryButtonLink = "",
  secondaryButtonText2 = "",
  secondaryButtonLink2 = "",
  secondaryButtonText3 = "",
  secondaryButtonLink3 = "",
  secondaryButtonText4 = "",
  secondaryButtonLink4 = "",
  secondaryButtonText5 = "",
  secondaryButtonLink5 = "",
  buttonTextColor = "#1b2e38",
  hoverBackgroundColor = "rgba(241, 241, 241, 0.58)",
  hoverBackgroundColor2 = "rgba(241, 241, 241, 0.68)",
  hoverColor = "#0e4174",
  hoverColor2 = "#0b457f",
  id,
  _component,
  ...rest
} = Astro.props;
---
<div class="office-tour-gallery" id={id || undefined} style={`--btntx:${buttonTextColor};--c2:${hoverBackgroundColor};--c3:${hoverBackgroundColor2};--c4:${hoverColor};--c5:${hoverColor2}`} {...rest}>
  <div class="auf-box">
    <div class="auf-box2">
      <SideMenu heading={subheading} links={[{ text: buttonText, link: buttonLink }, { text: secondaryButtonText, link: secondaryButtonLink }, { text: secondaryButtonText2, link: secondaryButtonLink2 }, { text: secondaryButtonText3, link: secondaryButtonLink3 }, { text: secondaryButtonText4, link: secondaryButtonLink4 }, { text: secondaryButtonText5, link: secondaryButtonLink5 }]} />
      <div class="auf-box5">
        <div class="auf-box6">
          <div class="auf-box7" data-lightbox>
            <a class="auf-box8" href="/wp-content/uploads/2024/01/img-dental-emergency-banner.jpg" data-caption="Office tour photo 1 of 21">
              <img src="/wp-content/uploads/2024/01/img-dental-emergency-banner.jpg" alt="Office tour photo 1 of 21" loading="eager" decoding="async" />
            </a>
