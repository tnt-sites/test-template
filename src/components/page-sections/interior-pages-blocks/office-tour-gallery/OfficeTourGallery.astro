  /*
   * Gallery layout — a deliberate change from the source.
   *
   * The original positions every tile absolutely from JavaScript (a masonry
   * script), so the captured CSS is a frozen set of offsets like
   * `bottom: 2323.7px` that only hold for one viewport width — below 1440 the
   * photos overlapped each other. These rules drop the offsets entirely and lay
   * the tiles out as a grid of uniform horizontal rectangles, which is what was
   * asked for and is also what survives a resize.
   *
   * Specificity beats the generated per-tile rules (`.auf-box7 > a` over
   * `.auf-box8`), so the offsets are overridden without editing 21 rules.
   */
  .auf-box7 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding-bottom: 0;
    position: static;
  }

  .auf-box7 > a {
    position: static;
    inset: auto;
    display: block;
    width: 100%;
    max-width: none;
    flex: none;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 4px;
    cursor: zoom-in;
  }

  /*
   * The photos are real <img> elements rather than the captured background
   * images. Seven of the twenty-one tiles were still lazy-loading when the page
   * was captured, so they had no background to capture and came through as
   * empty boxes — the URL was only ever on the anchor. Reading the image from
   * the anchor's own href fixes those, and lets the browser lazy-load the
   * gallery natively instead of fetching all twenty-one up front.
   */
  .auf-box7 > a > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    transition: transform 0.4s ease;
  }

  .auf-box7 > a:hover > img,
  .auf-box7 > a:focus-visible > img {
    transform: scale(1.04);
  }

  .auf-box7 > a:focus-visible {
    outline: 3px solid var(--color-brand, #3b6278);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .auf-box7 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .auf-box7 {
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .auf-box7 > a > img {
      transition: none;
    }

    .auf-box7 > a:hover > img,
    .auf-box7 > a:focus-visible > img {
      transform: none;
    }
  }

