---
/**
 * Services — migrated from dental-services [2] (auto) by wp-migrator.
 *
 * Baked in: layout, spacing, typography. Props: text, images, links, colours. Arrays: `sideMenuLinks`, `buttonSections`, `buttonSections2`, `items3`, `items4`, `items5`, `items6`, `items7`, `items8`.
 */
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import SideMenu from "@page-sections/shared-blocks/side-menu/SideMenu.astro";
const {
  eyebrow = "",
  heading = "",
  sideMenuLinks = [],
  buttonSections = [],
  buttonSections2 = [],
  sections = [],
  eyebrowColor = "#1b2e38",
  headingColor = "#1b2e38",
  buttonTextColor = "#1b2e38",
  textColor = "#1b2e38",
  buttonBackgroundColor = "#3a8358",
  buttonTextColor2 = "#ffffff",
  textColor2 = "#ffffff",
  hoverBackgroundColor = "#f1f1f1",
  hoverBackgroundColor2 = "#49ab71",
  hoverBackgroundColor3 = "#4eaf76",
  textHoverColor = "#064d96",
  hoverColor = "#09498c",
  id,
  _component,
  ...rest
} = Astro.props;

const toList = (value) => (Array.isArray(value) ? value.filter(Boolean) : []);

const sideMenuLinksList = toList(sideMenuLinks);
const buttonSectionsList = toList(buttonSections);
const buttonSections2List = toList(buttonSections2);

/* The source design ran each section's links as two desktop columns, filling the
   first before the second; below 768px `.se-section-lists` unwraps to one column
   and the split stops mattering. */
const splitColumns = (links) => {
  if (links.length === 0) return [];
  if (links.length === 1) return [links];
  const firstLength = Math.ceil(links.length / 2);
  return [links.slice(0, firstLength), links.slice(firstLength)];
};

const sectionsList = toList(sections).map((sec) => {
  const linksList = toList(sec.links);
  return {
    heading: sec.heading ?? "",
    text: sec.text ?? "",
    listHeading: sec.listHeading ?? "",
    linksList,
    linkColumns: splitColumns(linksList),
    buttonsList: toList(sec.buttons),
  };
});
---
<div class="services" id={id || undefined} style={`--eb:${eyebrowColor};--hd:${headingColor};--btntx:${buttonTextColor};--tx:${textColor};--btnbg:${buttonBackgroundColor};--c6:${buttonTextColor2};--c7:${textColor2};--c8:${hoverBackgroundColor};--c9:${hoverBackgroundColor2};--c10:${hoverBackgroundColor3};--c11:${textHoverColor};--c12:${hoverColor}`} {...rest}>
  <div class="se-box">
    <div class="se-box2">
      <SideMenu heading={eyebrow} links={sideMenuLinksList.map((it) => ({ text: it.buttonText, link: it.buttonLink }))} />
      <div class="se-box11">
        <div class="se-box12">
          <div class="se-box13">
            <div class="se-box14">
              <div class="se-box15">
                <h2 class="se-heading2">{heading}</h2>
              </div>
            </div>
          </div>
          <ButtonGroup buttonSections={buttonSectionsList} alignX="start" />
          <ButtonGroup buttonSections={buttonSections2List} propName="buttonSections2" alignX="start" />
          {sectionsList.map((sec, i) => (
            <Fragment>
              <div class="se-rule">
                <div class="se-rule-inner">
                  <div class="se-decor" aria-hidden="true" />
                </div>
              </div>
              <section class="se-section">
                <div class="se-section-inner">
                  <div class="se-section-head">
                    {sec.heading && <h3 class="se-section-heading">{sec.heading}</h3>}
                  </div>
                  <div class="se-section-body">
                    <div>
                      {sec.text && <p class="se-section-text" set:html={sec.text} />}
                    </div>
                  </div>
                  {sec.listHeading && (
                    <div class="se-section-subhead">
                      <h4 class="se-section-subheading">{sec.listHeading}</h4>
                    </div>
                  )}
                  {sec.linksList.length > 0 && (
                    <div class="se-section-lists">
                      {sec.linkColumns.map((col) => (
                        <div class="se-section-list-col">
                          <ul class="se-section-list">
                            {col.map((it) => (
                              <li class="se-section-list-item">
                                {it.buttonText && <a class="se-section-link" href={it.buttonLink || "#"}>{it.buttonText}</a>}
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  )}
                  <ButtonGroup buttonSections={sec.buttonsList} propName={`sections.${i}.buttons`} alignX="start" />
                </div>
              </section>
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .services {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
    padding-bottom: 30px;
    padding-top: 30px;
    text-align: left;
  }


  .se-box {
    box-sizing: border-box;
    padding-left: 15px;
    padding-right: 15px;
  }


  .se-box2 {
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    margin: 0 auto;
  }


  .se-box11 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
    position: relative;
  }


  .se-box12 {
    box-sizing: border-box;
  }


  .se-box13 {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    padding: 10px;
    position: relative;
  }

  .se-box14 {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    position: relative;
    text-align: center;
  }

  .se-box15 {
    box-sizing: border-box;
  }

  .se-heading2 {
    box-sizing: border-box;
    font-family: Montserrat, sans-serif;
    font-size: 32px;
    font-weight: 500;
    line-height: 32px;
    margin-bottom: 0px;
    margin-top: 0px;
  }













  .se-decor {
    border-top: 1px solid #e8e8e8;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    max-width: 100%;
    min-height: 1px;
  }















































































































































































































  /* Section rhythm: a hairline rule, then the section block. Values carried over
     from the migrated per-section rules, which were identical apart from their
     numbering. */
  .se-rule {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    padding: 10px;
    position: relative;
  }

  .se-rule-inner {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    max-width: 100%;
    padding-bottom: 15px;
    padding-top: 15px;
  }

  .se-section {
    box-sizing: border-box;
    margin-top: 20px;
    position: relative;
  }

  .se-section-inner {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    padding: 10px;
    position: relative;
  }

  .se-section-head,
  .se-section-subhead {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
  }

  .se-section-heading {
    box-sizing: border-box;
    font-family: Montserrat, sans-serif;
    font-size: 28px;
    line-height: 28px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  .se-section-body {
    box-sizing: border-box;
    flex: 0 0 100%;
    margin-bottom: 20px;
    max-width: 100%;
    position: relative;
  }

  .se-section-text {
    box-sizing: border-box;
    margin-top: 0px;
  }

  .se-section-subheading {
    box-sizing: border-box;
    font-family: Montserrat, sans-serif;
    font-size: 24px;
    line-height: 36px;
    margin-bottom: 0px;
    margin-top: 0px;
  }

  /* One column by default; the 768px rule opens it to the design's two. */
  .se-section-lists {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-wrap: wrap;
    max-width: 100%;
    position: relative;
  }

  .se-section-list-col {
    align-content: flex-start;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-wrap: wrap;
    max-width: 100%;
    padding: 0 10px;
    position: relative;
  }

  .se-section-list {
    box-sizing: border-box;
    flex: 0 0 100%;
    margin-bottom: 0px;
    margin-top: 0px;
    max-width: 100%;
    padding-left: 0px;
  }

  .se-section-list-item {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    padding-bottom: 12.5px;
    position: relative;
  }

  .se-section-link {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    font-family: Montserrat, sans-serif;
    max-width: 100%;
    transition: all 0.25s ease;
  }

  .se-section-link:hover {
    color: var(--c11);
  }

  @media (min-width: 768px) {
    .se-section-heading {
      font-weight: 400;
      text-align: left;
    }

    .se-section-subheading {
      line-height: 24px;
    }

    .se-section-list-col {
      flex: 0 0 50%;
      max-width: 50%;
      padding: 10px;
    }

    .se-box {
      margin-left: auto;
      margin-right: auto;
      max-width: 720px;
    }





    .se-box11 {
      flex: 0 0 66.67%;
      flex-shrink: 0;
      max-width: 66.67%;
    }

    .se-box14 {
      text-align: left;
    }

    .se-box15 {
      margin-bottom: 10px;
    }






































































  }

  @media (min-width: 1440px) {
    .se-box {
      margin-left: auto;
      margin-right: auto;
      max-width: 1140px;
    }



    .se-box11 {
      flex: 0 0 75%;
      max-width: 75%;
    }







































  }

/* wpmig:corrections:begin */
  .se-box2 {
