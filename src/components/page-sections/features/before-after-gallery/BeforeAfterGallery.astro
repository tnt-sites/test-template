---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "",
  pairs = [],
  beforeLabel = "Before",
  afterLabel = "After",
  backgroundColor = "base",
  id = "",
  class: className,
  _component,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["before-after-gallery", className]}
  maxContentWidth="xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  {...htmlAttributes}
>
  {heading && <Heading level="h2" size="lg" alignX="center" text={heading} data-prop="heading" />}

  <div class="ba-grid">
    {
      pairs.map((pair: any) => (
        <div class="ba-pair">
          <figure class="ba-item">
            <Image source={pair.beforeSource} alt={pair.beforeAlt || beforeLabel} editable={false} />
            <figcaption>{beforeLabel}</figcaption>
          </figure>
          <figure class="ba-item">
            <Image source={pair.afterSource} alt={pair.afterAlt || afterLabel} editable={false} />
            <figcaption>{afterLabel}</figcaption>
          </figure>
        </div>
      ))
    }
  </div>
</CustomSection>

<style lang="pcss">
  .ba-grid {
    display: grid;
    gap: var(--spacing-xl);
    margin-inline: auto;
    max-width: 48rem;
  }

  .ba-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }

  .ba-item {
    margin: 0;
  }

  .ba-item :global(img) {
    aspect-ratio: 3 / 2;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .ba-item figcaption {
    background: var(--color-bg-accent, #f1f1f1);
    font-size: var(--font-size-sm);
    margin-top: var(--spacing-2xs);
    padding: var(--spacing-2xs);
    text-align: center;
  }
</style>
