---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Component from "@components/utils/renderBlock.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";

const {
  heading = "",
  backgroundColor = "base",
  backgroundGradient = "",
  backgroundImage,
  tourSlides = [],
  slideNumbers = true,
  floatingArrows = false,
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const normalizedTourSlides = Array.isArray(tourSlides)
  ? tourSlides.filter((slide) => slide && typeof slide === "object")
  : [];

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

// Peek mode: add class="peek" in the CMS to show flanking slides at reduced opacity.
const isPeek = String(className ?? "")
  .split(" ")
  .includes("peek");
---

<CustomSection
  class:list={["office-tour", className, slideNumbers ? "slide-numbers" : "", floatingArrows ? "floating-arrows" : ""]}
  maxContentWidth={isPeek ? undefined : "2xl"}
  paddingHorizontal="none"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {
    heading && (
      <Heading level="h2" size="lg" alignX="center" data-prop="heading" text={heading} />
    )
  }

  <Carousel
    label={heading || "Office tour"}
    class="office-tour-carousel"
    maxSlideWidth={isPeek ? 800 : 0}
    autoPlay={false}
    autoScroll={false}
    data-prop="tourSlides"
    editable={editable}
    {...(isPeek ? { "data-no-contain-scroll": true, "data-slides-to-scroll": "1" } : {})}
  >
    {/* The source's own arrow glyph. arrow-left.svg actually points right — the
      source flips it for `#prev` rather than shipping two files. */}
    <img slot="prev-arrow" src="/assets/images/arrow-left.svg" alt="" width="38" height="17" />
    <img slot="next-arrow" src="/assets/images/arrow-left.svg" alt="" width="38" height="17" />
    {
      normalizedTourSlides.map((slide, index) => (
        <CarouselSlide aria-label={`Slide ${index + 1} of ${normalizedTourSlides.length}`}>
          <editable-array-item
            data-component={slide._component || "building-blocks/core-elements/image"}
          >
            <Component contentSections={[slide]} editable={false} />
          </editable-array-item>
        </CarouselSlide>
      ))
    }
  </Carousel>

  {
    slideNumbers && normalizedTourSlides.length > 0 && (
      <div id="carouselSlideNumber" class="carousel-slide-number">
        1 / {normalizedTourSlides.length}
      </div>
    )
  }
</CustomSection>



<style is:global>
  .office-tour {
    margin: 0 auto;
    padding: 0;
    position: relative;
  }

  .office-tour .carousel {
    position: relative;
  }

  /* The source's `.gallery` is a single 1000px relative box holding the images,
     the dots and the absolutely-positioned arrows, so all three share an edge.
     Capping the viewport alone left the arrows anchored to the section's wider
     content column. */
  .office-tour:not(.peek) .carousel {
    margin-inline: auto;
    max-width: 1000px;
  }

  /* PEEK LAYOUT — add class="peek" in the CMS */
  .office-tour.peek .office-tour-carousel {
    margin-inline: calc(-1 * var(--spacing-lg));
    width: calc(100% + 2 * var(--spacing-lg));
  }

  .office-tour.peek {
    overflow: hidden;
  }

  .office-tour.peek .office-tour-carousel > .viewport {
    overflow: visible;
  }

  .office-tour .viewport > .track {
    align-items: center;
  }

  /* The source's `.slick-gallery` is `text-align: center` and puts no width on
     its images, so each photo sits at its intrinsic size (675x450) inside the
     1000px gallery. The Image component's `width: 100%` upscales them to the
     full viewport instead, cropping differently at every breakpoint. */
  .office-tour .carousel .slide .image {
    text-align: center;
  }

  .office-tour .carousel .slide .image picture,
  .office-tour .carousel .slide .image img {
    display: inline-block;
    margin-inline: auto;
    max-width: 100%;
    width: auto;
  }

  .office-tour.peek .slide {
    margin: 0 20px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .office-tour.peek .slide.is-snapped {
    opacity: 1;
  }

  /* CONTROLS — ported from the source's `.slick-controls` / `.slick-arrow` /
     `.slick-dots` rules in styles.css. Unlayered on purpose: the base carousel
     styles live in `@layer components`, so an unlayered rule outranks them
     without needing extra specificity games.

     The source's dot spacing comes from two stacked margins — slick's own
     `.slick-dots li { margin: 0 5px }` plus the site's `span { margin: 0 5px }`
     — for 20px between dots, halved to 10px under 1024px. Restated as a `gap`
     since embla renders each dot as a single button. */
  .office-tour .carousel > .controls-wrapper {
    gap: 0;
    margin: 20px auto 0;
    max-width: 1000px;
  }

  .office-tour .carousel > .controls-wrapper > .indicators {
    gap: 20px;
    line-height: 1;
  }

  .office-tour .carousel > .controls-wrapper > .indicators > .indicator {
    background-color: transparent;
    border: 2px solid #000;
    height: 12px;
    transform: none;
    transition: 0.3s all;
    width: 12px;
  }

  .office-tour .carousel > .controls-wrapper > .indicators > .indicator[data-selected="true"] {
    background-color: #2b8435;
    border-color: #2b8435;
    transform: none;
  }

  /* The source centres its arrows on the image with `top: 57%` — a hand-tuned
     value that compensates for the dots row sitting inside the same relative
     box. Anchoring the button between `top: 0` and the top of the controls row
     instead centres it on the viewport exactly, whatever the image height.
     32px = the 20px controls margin plus the 12px dot. */
  .office-tour.floating-arrows .carousel > .controls-wrapper > .prev,
  .office-tour.floating-arrows .carousel > .controls-wrapper > .next {
    align-items: center;
    background-color: #fff;
    border: 1px solid #292929;
    border-radius: 30px;
    bottom: 32px;
    display: flex;
    flex: 0 0 96px;
    height: 56px;
    justify-content: center;
    margin-block: auto;
    padding: 0;
    position: absolute;
    top: 0;
    transition: 0.3s all;
    width: 96px;
    z-index: 5;
  }

  .office-tour.floating-arrows .carousel > .controls-wrapper > .prev:hover,
  .office-tour.floating-arrows .carousel > .controls-wrapper > .next:hover {
    background-color: #9ecae1;
  }

  .office-tour .carousel > .controls-wrapper > .prev img,
  .office-tour .carousel > .controls-wrapper > .next img {
    display: block;
    width: 38px;
  }

  .office-tour .carousel > .controls-wrapper > .prev img {
    transform: rotate(180deg);
  }

  .office-tour .carousel > .controls-wrapper > .prev {
    left: 0;
  }

  .office-tour .carousel > .controls-wrapper > .next {
    right: 0;
  }

  /* Under 1024px the source drops the arrows back into flow below the image,
     with the dots on their own row above them. */
  @media (max-width: 1024px) {
    .office-tour .carousel > .controls-wrapper {
      flex-wrap: wrap;
      gap: 15px;
      justify-content: center;
    }

    .office-tour.floating-arrows .carousel > .controls-wrapper > .prev,
    .office-tour.floating-arrows .carousel > .controls-wrapper > .next {
      inset: unset;
      margin-block: 0;
      position: relative;
    }

    .office-tour .carousel > .controls-wrapper > .indicators {
      flex: 0 1 100%;
      gap: 10px;
      order: 1;
    }

    .office-tour .carousel > .controls-wrapper > .indicators > .indicator {
      border-width: 1px;
      height: 10px;
      width: 10px;
    }

    .office-tour .carousel > .controls-wrapper > .prev {
      order: 2;
    }

    .office-tour .carousel > .controls-wrapper > .next {
      order: 3;
    }
  }

  /* Only hide the pager indicators if slideNumbers is true */
  .office-tour.slide-numbers .carousel > .controls-wrapper > .indicators {
    display: none;
  }

  /* Slide number overlay */
  .carousel-slide-number {
      display: table;
    font-size: 1.2rem;
      margin: 0;
    text-align: center;
  }
</style>

<!-- Only run the slide number script if slideNumbers is true -->
{slideNumbers && (
  <script is:inline type="module">
      const sections = document.querySelectorAll(".office-tour.slide-numbers");

      sections.forEach((section) => {
        const carousel = section.querySelector(".carousel");
        const counter = section.querySelector(".carousel-slide-number");
        const controlsWrapper = carousel?.querySelector(".controls-wrapper");

        if (!carousel || !counter || !controlsWrapper) return;

        const nextButton = controlsWrapper.querySelector(".next");
        if (nextButton && !controlsWrapper.contains(counter)) {
          controlsWrapper.insertBefore(counter, nextButton);
        } else if (!controlsWrapper.contains(counter)) {
          controlsWrapper.appendChild(counter);
        }

        const waitForIndicators = () => {
          const indicators = carousel.querySelectorAll(".indicator");
          if (indicators.length === 0) {
            requestAnimationFrame(waitForIndicators);
            return;
          }

          const updateCounter = () => {
            const currentIndicators = Array.from(carousel.querySelectorAll(".indicator"));
            const activeIndex = currentIndicators.findIndex(
              (dot) =>
                dot.getAttribute("aria-selected") === "true" ||
                dot.getAttribute("data-selected") === "true"
            );

            counter.textContent = `${(activeIndex >= 0 ? activeIndex : 0) + 1} / ${currentIndicators.length}`;
          };

          updateCounter();

          const observer = new MutationObserver(updateCounter);
          observer.observe(carousel, {
            subtree: true,
            attributes: true,
            attributeFilter: ["aria-selected", "data-selected"],
          });
        };

        waitForIndicators();
      });
  </script>
)}
