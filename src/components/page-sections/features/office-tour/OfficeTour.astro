---
import Heading from "@core-elements/heading/Heading.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";
import TourSlide from "./TourSlide.astro";

const {
  heading = "",
  tourSlides = [],
  background = "white",
  class: className,
  editable = true,
  _component,
  // Older settings, no longer used.
  backgroundColor,
  backgroundGradient,
  backgroundImage,
  slideNumbers,
  floatingArrows,
  ...htmlAttributes
} = Astro.props;

const slides = Array.isArray(tourSlides)
  ? tourSlides.filter((slide) => slide && typeof slide === "object")
  : [];
---

<section class:list={["office-tour", sectionBackground(background), className]} {...htmlAttributes}>
  {heading && <Heading level="h2" alignX="center" data-prop="heading" text={heading} />}

  <Carousel
    label={heading || "Office tour"}
    arrowsBeside
    arrowStyle="long"
    data-prop="tourSlides"
    editable={editable}
  >
    {
      slides.map((slide: any, index) => (
        <CarouselSlide aria-label={`Slide ${index + 1} of ${slides.length}`}>
          <editable-array-item data-component="page-sections/features/office-tour/tour-slide">
            <TourSlide {...slide} editable={editable} />
          </editable-array-item>
        </CarouselSlide>
      ))
    }
  </Carousel>
</section>

<style>
  .office-tour {
    padding: 60px 25px;
  }

  .office-tour :global(.heading) {
    margin: 0 0 35px;
  }

  .office-tour :global(.carousel) {
    margin: 0 auto;
    max-width: 1080px;
  }

  @media (min-width: 1024px) {
    .office-tour {
      padding: 80px 25px;
    }
  }
</style>
