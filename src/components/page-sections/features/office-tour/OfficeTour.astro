---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Component from "@components/utils/renderBlock.astro";
import Heading from "@core-elements/heading/Heading.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";

const {
  heading = "",
  backgroundColor = "base",
  backgroundGradient = "",
  backgroundImage,
  tourSlides = [],
  slideNumbers = true,
  floatingArrows = false,
  bottomEyebrow = "",
  bottomHeading = "",
  bottomText = "",
  bottomButtonSections = [],
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const normalizedTourSlides = Array.isArray(tourSlides)
  ? tourSlides.filter((slide) => slide && typeof slide === "object")
  : [];

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

// Peek mode: add class="peek" in the CMS to show flanking slides at reduced opacity.
const isPeek = String(className ?? "")
  .split(" ")
  .includes("peek");
---

<CustomSection
  class:list={["office-tour", className, slideNumbers ? "slide-numbers" : "", floatingArrows ? "floating-arrows" : ""]}
  maxContentWidth={isPeek ? undefined : "2xl"}
  paddingHorizontal="none"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {
    heading && (
      <Heading level="h3" size="lg" alignX="center" data-prop="heading" text={heading} />
    )
  }

  <Carousel
    label={heading || "Office tour"}
    class="office-tour-carousel"
    maxSlideWidth={isPeek ? 800 : 0}
    autoPlay={false}
    autoScroll={false}
    data-prop="tourSlides"
    editable={editable}
    {...(isPeek ? { "data-no-contain-scroll": true, "data-slides-to-scroll": "1" } : {})}
  >
    {
      normalizedTourSlides.map((slide, index) => (
        <CarouselSlide aria-label={`Slide ${index + 1} of ${normalizedTourSlides.length}`}>
          <editable-array-item
            data-component={slide._component || "building-blocks/core-elements/image"}
          >
            <Component contentSections={[slide]} editable={false} />
          </editable-array-item>
        </CarouselSlide>
      ))
    }
  </Carousel>

  {
    slideNumbers && normalizedTourSlides.length > 0 && (
      <div id="carouselSlideNumber" class="carousel-slide-number">
        1 / {normalizedTourSlides.length}
      </div>
    )
  }

  {
    (bottomEyebrow || bottomHeading || bottomText || bottomButtonSections.length > 0) && (
      <div class="office-tour-bottom">
        {bottomEyebrow && (
          <h2 class="eyebrow-line" data-editable="text" data-prop="bottomEyebrow">
            {bottomEyebrow}
          </h2>
        )}
        {bottomHeading && (
          <h3
            class="office-tour-bottom-heading"
            data-editable="text"
            data-prop="bottomHeading"
            set:html={bottomHeading}
          />
        )}
        {bottomText && (
          <p data-editable="text" data-prop="bottomText">
            {bottomText}
          </p>
        )}
        {bottomButtonSections.length > 0 && (
          <ButtonGroup buttonSections={bottomButtonSections} alignX="center" data-prop="bottomButtonSections" />
        )}
      </div>
    )
  }
</CustomSection>



<style is:global>
  .office-tour {
    margin: 0 auto;
    padding: 0;
    position: relative;
  }

  .office-tour .carousel {
    position: relative;
  }

  .office-tour:not(.peek) .carousel .viewport {
    margin: 0 auto;
    max-width: 1000px;
  }

  /* PEEK LAYOUT — add class="peek" in the CMS */
  .office-tour.peek .office-tour-carousel {
    margin-inline: calc(-1 * var(--spacing-lg));
    width: calc(100% + 2 * var(--spacing-lg));
  }

  .office-tour.peek {
    overflow: hidden;
  }

  .office-tour.peek .office-tour-carousel > .viewport {
    overflow: visible;
  }

  .office-tour .viewport > .track {
    align-items: center;
  }

  .office-tour.peek .slide {
    margin: 0 20px;
    opacity: 0.7;

    transform-origin: top center;
    transition:
      transform 0.4s ease,
      opacity 0.4s ease;

      img{
            transform: scale(0.7);
      }
  }

  .office-tour.peek .slide.is-snapped {
    opacity: 1;
    transform: scale(1);
    z-index: 5;

    img{transform: scale(1);}
  }

  .office-tour.floating-arrows .carousel > .controls-wrapper > .prev,
  .office-tour.floating-arrows .carousel > .controls-wrapper > .next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .office-tour .carousel > .controls-wrapper > .prev {
    left: 0.5rem;
  }

  .office-tour .carousel > .controls-wrapper > .next {
    right: 0.5rem;
  }

  /* Only hide the pager indicators if slideNumbers is true */
  .office-tour.slide-numbers .carousel > .controls-wrapper > .indicators {
    display: none;
  }

  /* Slick-style controls row (arrows + dots), matching legacy gallery/office-tour carousels */
  .office-tour .carousel > .controls-wrapper {
    gap: 0.5rem;
    margin: 10px auto;
    max-width: 1000px;
  }

  .office-tour .carousel > .controls-wrapper > .prev,
  .office-tour .carousel > .controls-wrapper > .next {
    color: #000;
    min-width: auto;
    opacity: 0.4;
    transition: 0.3s all;
    z-index: 5;
  }

  .office-tour .carousel > .controls-wrapper > .prev:hover,
  .office-tour .carousel > .controls-wrapper > .next:hover {
    color: #000;
    opacity: 1;
  }

  .office-tour .carousel > .controls-wrapper > .prev svg,
  .office-tour .carousel > .controls-wrapper > .next svg {
    height: 22px;
    width: 22px;
  }

  .office-tour .carousel > .controls-wrapper > .prev svg path,
  .office-tour .carousel > .controls-wrapper > .next svg path {
    fill: currentcolor;
  }

  .office-tour .carousel > .controls-wrapper > .indicators > .indicator {
    background-color: #00bbf2;
    opacity: 0.18;
    transition: opacity 0.3s ease;
  }

  .office-tour .carousel > .controls-wrapper > .indicators > .indicator[data-selected="true"] {
    opacity: 1;
    transform: none;
  }

  .office-tour-bottom {
    margin: 30px auto 0;
    max-width: 1000px;
    padding: 0 20px;
    text-align: center;

    .eyebrow-line {
      color: var(--color-text);
      display: block;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 2.4px;
      line-height: 1.17;
      margin: 10px auto;
      text-transform: uppercase;
    }
  }

  .office-tour-bottom-heading {
    color: var(--color-text-strong);
    font-family: var(--font-headings);
    font-size: clamp(2rem, 4vw, 54px);
    line-height: 0.98;
    margin: 0;
  }

  .office-tour-bottom p {
    color: var(--color-text);
    margin-top: var(--spacing-md);
  }

  .office-tour-bottom .button-group {
    justify-content: center;
    margin-top: var(--spacing-md);
  }

  /* Slide number overlay, matching legacy .pagingInfo */
  .carousel-slide-number {
    color: #000;
    display: table;
    font-family: reiher-headline, sans-serif;
    font-size: 30px;
    margin: 0;
    opacity: 0.4;
    text-align: center;
  }
</style>

<!-- Only run the slide number script if slideNumbers is true -->
{slideNumbers && (
  <script is:inline type="module">
      const sections = document.querySelectorAll(".office-tour.slide-numbers");

      sections.forEach((section) => {
        const carousel = section.querySelector(".carousel");
        const counter = section.querySelector(".carousel-slide-number");
        const controlsWrapper = carousel?.querySelector(".controls-wrapper");

        if (!carousel || !counter || !controlsWrapper) return;

        const nextButton = controlsWrapper.querySelector(".next");
        if (nextButton && !controlsWrapper.contains(counter)) {
          controlsWrapper.insertBefore(counter, nextButton);
        } else if (!controlsWrapper.contains(counter)) {
          controlsWrapper.appendChild(counter);
        }

        const waitForIndicators = () => {
          const indicators = carousel.querySelectorAll(".indicator");
          if (indicators.length === 0) {
            requestAnimationFrame(waitForIndicators);
            return;
          }

          const updateCounter = () => {
            const currentIndicators = Array.from(carousel.querySelectorAll(".indicator"));
            const activeIndex = currentIndicators.findIndex(
              (dot) =>
                dot.getAttribute("aria-selected") === "true" ||
                dot.getAttribute("data-selected") === "true"
            );

            counter.textContent = `${(activeIndex >= 0 ? activeIndex : 0) + 1} / ${currentIndicators.length}`;
          };

          updateCounter();

          const observer = new MutationObserver(updateCounter);
          observer.observe(carousel, {
            subtree: true,
            attributes: true,
            attributeFilter: ["aria-selected", "data-selected"],
          });
        };

        waitForIndicators();
      });
  </script>
)}
