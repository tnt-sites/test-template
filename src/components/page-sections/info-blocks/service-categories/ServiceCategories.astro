---
import { hasText } from "@page-sections/location/utils";

type ServiceLink = {
  label?: string;
  href?: string;
};

type ServiceCategory = {
  imageSource?: string;
  imageAlt?: string;
  title?: string;
  href?: string;
  cardColor?: string;
  links?: ServiceLink[];
};

const {
  services = [],
  class: className,
  editable = true,
  _component,
  ...htmlAttributes
} = Astro.props;

const CARD_COLORS: Record<string, string> = {
  blue: "#e9f2f9",
  green: "#e4e9d3",
  beige: "#eeece7",
};

const CARD_COLOR_SEQUENCE = ["blue", "green", "beige", "green", "beige", "blue"];

const cardColorFor = (category: ServiceCategory, index: number) => {
  const named = hasText(category.cardColor) ? category.cardColor.trim().toLowerCase() : "";

  return CARD_COLORS[named] ?? CARD_COLORS[CARD_COLOR_SEQUENCE[index % CARD_COLOR_SEQUENCE.length]];
};

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const titleHtmlFor = (title: string) =>
  escapeHtml(title.trim()).replace(/&lt;br\s*\/?&gt;/gi, "<br>");

const resolvedServices = (Array.isArray(services) ? services : [])
  .filter((category: ServiceCategory) => !!category && typeof category === "object")
  .map((category: ServiceCategory, index: number) => ({
    imageSource: hasText(category.imageSource) ? category.imageSource : "",
    imageAlt: hasText(category.imageAlt) ? category.imageAlt : "",
    titleHtml: hasText(category.title) ? titleHtmlFor(category.title) : "",
    href: hasText(category.href) ? category.href : "#",
    background: cardColorFor(category, index),
    links: (Array.isArray(category.links) ? category.links : []).filter((link: ServiceLink) =>
      hasText(link?.label)
    ),
  }))
  .filter((category) => category.titleHtml.length > 0 || category.links.length > 0);
---

{
  resolvedServices.length > 0 && (
    <div class:list={["service-categories", className]} {...htmlAttributes}>
      {resolvedServices.map((category, index: number) => (
        <div class="service-category">
          {category.imageSource && (
            <figure>
              <img src={category.imageSource} alt={category.imageAlt} />
            </figure>
          )}
          <article style={`--service-category-bg: ${category.background};`}>
            {category.titleHtml && (
              <h3>
                <a href={category.href} set:html={category.titleHtml} />
              </h3>
            )}
            {category.links.length > 0 && (
              <ul>
                {category.links.map((link: ServiceLink, linkIndex: number) => (
                  <li class="service-category-link">
                    <a
                      href={hasText(link.href) ? link.href : "#"}
                      data-editable={editable ? "text" : undefined}
                      data-prop={
                        editable ? `services.${index}.links.${linkIndex}.label` : undefined
                      }
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        </div>
      ))}
    </div>
  )
}

<style lang="pcss" is:global>
  .service-categories {
    align-items: stretch;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 20px;
    justify-content: center;
    margin: 150px auto 0;
    max-width: 1150px;
    padding: 0 10px 60px;
    position: relative;
  }

  .service-categories .service-category {
    max-width: 360px;
    width: 100%;
  }

  .service-categories article {
    background-color: var(--service-category-bg, #eeece7);
    border-radius: 15px;
    height: 460px;
    padding: 65px 20px 30px;
  }

  .service-categories figure {
    align-items: center;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 3px 6px 0 rgb(0 0 0 / 16%);
    display: flex;
    height: 105px;
    justify-content: center;
    margin: 0 auto -52px;
    position: relative;
    width: 105px;
  }

  /* Inner ring — a second, smaller shadowed circle inside the first. */
  .service-categories figure::before {
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 3px 6px 0 rgb(0 0 0 / 16%);
    content: "";
    height: 92px;
    inset: 50% auto auto 50%;
    position: absolute;
    transform: translate(-50%, -50%);
    width: 92px;
  }

  .service-categories figure img {
    position: relative;
    z-index: 2;
  }

  .service-categories h3 {
    margin-bottom: 15px;
    text-align: center;
  }

  .service-categories a {
    color: #32302f;
  }

  .service-categories a:hover {
    color: #a3c90d;
  }

  .service-categories ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    text-align: left;
  }

  .service-categories .service-category-link {
    display: block;
    line-height: 1.6;
    margin: 0 0 10px;
    padding-left: 30px;
    position: relative;
  }

  .service-categories .service-category-link::before {
    color: #a3c90d;
    content: "\e832";
    font-family: "fontello";
    font-size: 0.9em;
    font-style: normal;
    font-weight: 400;
    left: 0;
    position: absolute;
    top: 3px;
  }

  @media (max-width: 1024px) {
    .service-categories {
      margin-top: 50px;
    }
  }

  @media (max-width: 790px) {
    .service-categories {
      align-items: center;
      flex-direction: column;
    }

    .service-categories article {
      height: auto;
    }
  }
</style>
