---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Accordion from "@wrappers/accordion/Accordion.astro";

const {
  heading = "Frequently Asked Questions",
  items = [],
  label = "About FAQ",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  backgroundGradient = "",
  backgroundImage,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  {...htmlAttributes}
  class:list={["faq-section", className]}
  maxContentWidth="xl"
  paddingHorizontal="lg"
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
>
  <Heading level="h2" size="lg" alignX="center" text={heading} data-prop="heading" />
  <Accordion label={label} singleOpen={true} openFirst={false} items={items} />
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .faq-section {
      padding-block: 100px;
    }

    .faq-section .accordion {
      border-block: 1px solid rgba(112, 112, 112, 0.34);
      margin: var(--spacing-lg) auto 0;
      max-width: 1000px;
    }

    .faq-section editable-array-item + editable-array-item > .accordion-item {
      border-top: 1px solid rgba(112, 112, 112, 0.34);
    }

    .faq-section .accordion-item {
      border-bottom: none;

      > .accordion-item-title {
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        padding: 15px 0;

        &:hover {
          background-color: transparent;
          color: var(--color-bg-dark);
        }

        .accordion-item-icon {
          display: none;
        }

        &::after {
          background: url("/images/plus.png") no-repeat center / contain;
          content: "";
          flex-shrink: 0;
          height: 25px;
          width: 25px;
        }
      }

      &[open] > .accordion-item-title::after {
        background-image: url("/images/minus.png");
      }

      > .accordion-item-detail {
        padding-block: 0 10px;
        padding-inline: 0;
      }
    }
  }
</style>
