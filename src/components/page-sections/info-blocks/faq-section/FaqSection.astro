---
import Heading from "@core-elements/heading/Heading.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import Accordion from "@wrappers/accordion/Accordion.astro";

const {
  heading = "Frequently Asked Questions",
  items = [],
  label = "About FAQ",
  singleOpen = true,
  openFirst = false,
  background = "white",
  class: className,
  _component,
  // Older settings, no longer used by the redesigned section.
  headingLevel,
  headingSize,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical,
  colorScheme,
  backgroundColor,
  backgroundGradient,
  backgroundImage,
  ...htmlAttributes
} = Astro.props;
---

<section class:list={["faq-section", sectionBackground(background), className]} {...htmlAttributes}>
  <Heading level="h2" alignX="center" text={heading} data-prop="heading" />
  <Accordion label={label} singleOpen={singleOpen} openFirst={openFirst} items={items} />
</section>

<style>
  .faq-section {
    padding: 65px 25px;
  }

  .faq-section :global(.heading) {
    margin: 0 0 30px;
  }

  .faq-section :global(.accordion) {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin: 0 auto;
    max-width: 1150px;
  }

  @media (min-width: 1024px) {
    .faq-section {
      padding: 80px 25px;
    }

    .faq-section :global(.heading) {
      margin-bottom: 50px;
    }
  }

  /* Pill-shaped questions. These style the shared Accordion's markup, so they
     can't be utility classes on this page. */
  .faq-section :global(.accordion-item) {
    background-color: var(--color-bg);
    border: 1px solid #7e7e7e;
    border-radius: 30px;
  }

  .faq-section :global(.accordion-item-title) {
    color: var(--gray-12);
    font-size: 1.625rem;
    font-weight: var(--font-weight-normal);
    gap: 15px;
    line-height: 1.2;
    min-height: 60px;
    padding: 5px 10px 5px 55px;
  }

  .faq-section :global(.accordion-item-title:hover) {
    background-color: transparent;
  }

  .faq-section :global(.accordion-item-detail) {
    padding: 0 130px 30px 60px;
  }

  .faq-section :global(.accordion-item-detail p) {
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  /* Circle toggle: green while closed, navy once open or hovered. */
  .faq-section :global(.accordion-item-icon) {
    align-items: center;
    background-color: var(--color-brand);
    border-radius: 50%;
    color: var(--gray-0);
    display: flex;
    flex-shrink: 0;
    height: 45px;
    justify-content: center;
    transition:
      background-color var(--animation-normal) ease-out,
      transform var(--animation-normal) ease-out;
    width: 45px;
  }

  .faq-section :global(.accordion-item-icon svg) {
    height: 15px;
    width: 15px;
  }

  .faq-section :global(.accordion-item-title:hover .accordion-item-icon),
  .faq-section :global(.accordion-item[open] .accordion-item-icon) {
    background-color: var(--color-brand-secondary);
  }

  @media (max-width: 767px) {
    .faq-section :global(.accordion-item) {
      border-radius: 25px;
    }

    .faq-section :global(.accordion-item-title) {
      font-size: 1.25rem;
      padding-left: 25px;
    }

    .faq-section :global(.accordion-item-detail) {
      padding: 0 25px 25px;
    }
  }
</style>
