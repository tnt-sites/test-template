---
import Heading from "@core-elements/heading/Heading.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import WhyItem from "./WhyItem.astro";

const {
  heading = "",
  backgroundColor = "dark",
  items = [],
  class: className,
  editable = true,
  _component,
  // Older settings, no longer used.
  backgroundGradient,
  backgroundImage,
  ...htmlAttributes
} = Astro.props;

// The Why band keeps its original "Background Color" field; Dark is the design's navy.
const background = backgroundColor === "dark" || backgroundColor === "black" ? "navy" : "white";

const arrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-prop": "items",
      "data-component-key": "_component",
      "data-id-key": "_component",
    }
  : {};
---

<section class:list={["why", sectionBackground(background), className]} {...htmlAttributes}>
  <Heading level="h2" size="md" alignX="center" data-prop="heading" text={heading} />
  <ul
    class="no-check block lg:flex justify-center items-start"
    role="list"
    {...arrayDataAttributes}
  >
    {
      items.map((item: any) => (
        <editable-array-item data-component="page-sections/info-blocks/why/why-item">
          <WhyItem text={item.text} editable={editable} />
        </editable-array-item>
      ))
    }
  </ul>
</section>

<style>
  .why {
    padding: 30px 25px;
  }

  .why :global(.heading) {
    margin: 0 0 15px;
  }

  .why ul {
    margin: 0 auto;
    max-width: 1230px;
    padding: 0;
  }

  .why ul > :global(editable-array-item) {
    display: block;
    margin: 0 auto 25px;
    max-width: 340px;
  }

  @media (min-width: 1024px) {
    .why {
      padding: 25px 25px 50px;
    }

    .why ul > :global(editable-array-item) {
      flex: 1;
      margin: 0 15px;
    }
  }
</style>
