---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Text from "@core-elements/text/Text.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import Modal from "@page-sections/info-blocks/modal/Modal.astro";

const {
  heading = "",
  subtext = "",
  anchorName = "",
  emergencyItems = [],
  background = "white",
  showHeadingBar = true,
  backgroundGradient = "",
  backgroundImage,
  gridIndex,
  class: className,
  // Older setting, replaced by `background`.
  backgroundColor,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

const toSafeIndex = (value: unknown) => {
  if (typeof value === "number" && Number.isInteger(value) && value >= 0) return value;
  if (typeof value === "string" && /^\d+$/.test(value.trim())) return Number.parseInt(value, 10);
  return undefined;
};

const dataPropMatch =
  typeof htmlAttributes["data-prop"] === "string"
    ? htmlAttributes["data-prop"].match(/(?:^|\.)pageSections\.(\d+)(?:\.|$)/)
    : null;
const resolvedGridIndex = toSafeIndex(gridIndex) ?? toSafeIndex(dataPropMatch?.[1]) ?? 0;
const emergencyGridId = `emergency-grid-${resolvedGridIndex}`;

const emergencyIconNames = new Set([
  "toothache",
  "chipped-tooth",
  "cracked-tooth",
  "sensitivity-hot-cold",
  "knocked-out-tooth",
  "lost-filling-crown",
  "broken-denture",
  "loose-tooth",
  "gum-lip-tongue-injury",
  "jaw-pain-clenching",
  "stuck-between-teeth",
]);

const normalizeKey = (value: string) =>
  value
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const items = emergencyItems.map((item: any, index: number) => {
  const title = typeof item?.title === "string" ? item.title.trim() : "";
  const iconPresetRaw = typeof item?.iconPreset === "string" ? item.iconPreset.trim() : "";
  const contentSections = Array.isArray(item?.contentSections) ? item.contentSections : [];
  const normalizedIconPreset = normalizeKey(iconPresetRaw);
  const iconPreset = emergencyIconNames.has(normalizedIconPreset) ? normalizedIconPreset : "";

  return {
    title,
    iconPreset,
    contentSections,
    modalId: `${emergencyGridId}-modal-${index + 1}`,
  };
});

// Rendered icon heights in px. Each icon is sized to cover roughly the same area,
// so wide icons (dentures) and tall ones (toothache) read as the same size.
const iconHeights: Record<string, number> = {
  toothache: 88,
  "chipped-tooth": 70,
  "cracked-tooth": 73,
  "sensitivity-hot-cold": 73,
  "knocked-out-tooth": 75,
  "lost-filling-crown": 78,
  "broken-denture": 41,
  "loose-tooth": 63,
  "gum-lip-tongue-injury": 74,
  "jaw-pain-clenching": 56,
  "stuck-between-teeth": 40,
};

const hasModalItems = items.some((item: any) => item.contentSections.length > 0);
---

<section
  class:list={["emergency-grid", sectionBackground(background), className]}
  id={anchorName || undefined}
  {...htmlAttributes}
>
  <div class="block text-center">
    <Heading level="h2" data-prop="heading" text={heading} />
    {showHeadingBar && <hr class="heading-bar" />}
    <Text data-prop="subtext">{subtext}</Text>

    <ul
      class="no-check flex flex-wrap justify-center"
      data-editable="array"
      data-component-key="_component"
      data-id-key="_component"
      data-prop="emergencyItems"
    >
      {
        items.map((item: any) => {
          const iconName = item.iconPreset ? `emergency/${item.iconPreset}` : "emergency/toothache";
          // Items with pop-up content are buttons; the rest are plain labels.
          const Tag = item.contentSections.length > 0 ? "button" : "div";
          const buttonProps =
            Tag === "button"
              ? {
                  type: "button",
                  "data-modal-target": item.modalId,
                  "aria-haspopup": "dialog",
                  "aria-controls": item.modalId,
                }
              : {};

          return (
            <editable-array-item data-component="page-sections/info-blocks/emergency-grid/emergency-item">
              <li>
                <Tag class="item" {...buttonProps}>
                  <Icon
                    name={iconName}
                    size="none"
                    class="emergency-icon"
                    style={`--icon-height: ${iconHeights[item.iconPreset] ?? 70}px`}
                    aria-hidden="true"
                  />
                  <h3>{item.title}</h3>
                </Tag>
              </li>
            </editable-array-item>
          );
        })
      }
    </ul>
  </div>

  {
    hasModalItems &&
      items.map((item: any, index: number) =>
        item.contentSections.length === 0 ? null : (
          <Modal
            id={item.modalId}
            closeLabel={item.title ? `Close ${item.title}` : `Close Emergency Item ${index + 1}`}
            contentSections={item.contentSections}
            propName={`emergencyItems.${index}.contentSections`}
          />
        )
      )
  }
</section>

<style>
  .emergency-grid > div {
    margin: 0 auto;
    max-width: 1400px;
    padding: 65px 25px;
  }

  .emergency-grid :global(:is(.heading, .text)) {
    margin: 0;
    text-align: inherit;
  }

  .emergency-grid .heading-bar {
    margin: 20px auto 0;
    max-width: 575px;
  }

  .emergency-grid :global(.text) {
    font-size: 17px;
    margin: 20px auto 0;
    max-width: 770px;
  }

  .emergency-grid ul {
    margin: 20px 0 0;
    padding: 0;
  }

  .emergency-grid li {
    list-style: none;
    margin: 10px;
    padding: 5px;
    width: 180px;
  }

  .emergency-grid .item {
    background: transparent;
    border: 0;
    color: var(--color-text-strong);
    display: block;
    width: 100%;
  }

  .emergency-grid h3 {
    font-size: 22px;
    line-height: 1.1;
    margin: 5px auto;
  }

  .emergency-grid button.item:hover h3 {
    color: var(--color-brand);
  }

  /* Icons are sized per icon (see iconHeights) so they look evenly sized.
     The icon SVGs mark their green parts with .ic-color; everything else is navy. */
  .emergency-grid :global(.emergency-icon) {
    align-items: center;
    display: flex;
    height: 90px;
    justify-content: center;
  }

  .emergency-grid :global(.emergency-icon svg) {
    height: var(--icon-height, 70px);
    max-width: 95px;
    width: auto;
  }

  .emergency-grid :global(.emergency-icon .ic-color) {
    color: var(--color-brand);
    fill: var(--color-brand);
    stroke: var(--color-brand);
  }

  .emergency-grid
    :global(.emergency-icon :is(path, circle, ellipse, polygon, rect):not(.ic-color)) {
    fill: currentColor;
  }

  @media (min-width: 1024px) {
    .emergency-grid > div {
      padding: 100px 25px;
    }

    .emergency-grid :global(.text) {
      font-size: 19px;
    }
  }
</style>
