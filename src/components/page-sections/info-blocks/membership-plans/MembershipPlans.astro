---
import { hasText, renderMarkdown } from "@page-sections/location/utils";

type Plan = {
  name?: string;
  includesLabel?: string;
  items?: Array<string | { text?: string }>;
  priceCurrency?: string;
  priceAmount?: string;
  priceInterval?: string;
  savings?: string;
  buttonText?: string;
  buttonLink?: string;
};

type SignUpModal = {
  enabled?: boolean | string;
  id?: string;
  formAction?: string;
  fields?: Array<{
    type?: string;
    name?: string;
    placeholder?: string;
    required?: boolean | string;
    options?: Array<string | { value?: string; label?: string }>;
  }>;
  submitText?: string;
  subject?: string;
  redirect?: string;
};

const {
  heading = "Our Yearly Plans",
  plans = [],
  guidelinesHeading = "",
  guidelines = "",
  signUpModal,
  class: className,
  editable = true,
  _component,
  ...htmlAttributes
} = Astro.props;

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const withLineBreaks = (value: string) =>
  escapeHtml(value.trim()).replace(/&lt;br\s*\/?&gt;/gi, "<br>");

const resolvedPlans = (Array.isArray(plans) ? plans : [])
  .filter((plan: Plan) => !!plan && typeof plan === "object")
  .map((plan: Plan) => {
    const currency = hasText(plan.priceCurrency) ? plan.priceCurrency.trim() : "";
    const amount = hasText(plan.priceAmount) ? plan.priceAmount.trim() : "";
    const interval = hasText(plan.priceInterval) ? plan.priceInterval.trim() : "";

    return {
      name: hasText(plan.name) ? plan.name.trim() : "",
      includesLabel: hasText(plan.includesLabel) ? plan.includesLabel.trim() : "",
      items: (Array.isArray(plan.items) ? plan.items : [])
        .map((item) => (typeof item === "string" ? item : item?.text))
        .filter((text): text is string => hasText(text)),
      currency,
      amount,
      interval,
      savingsHtml: hasText(plan.savings) ? withLineBreaks(plan.savings) : "",
      buttonText: hasText(plan.buttonText) ? plan.buttonText.trim() : "",
      buttonLink: hasText(plan.buttonLink) ? plan.buttonLink.trim() : "",
      dataPrice: [currency + amount, interval].filter(Boolean).join(" / "),
    };
  })
  .filter((plan) => plan.name.length > 0 || plan.items.length > 0);

const guidelinesHtml = renderMarkdown(guidelines);
const hasGuidelines = hasText(guidelinesHeading) || guidelinesHtml.length > 0;
const hasModalButton = resolvedPlans.some((plan) => plan.buttonLink.startsWith("#"));

const isTrue = (value: unknown) =>
  typeof value === "string" ? value.trim().toLowerCase() === "true" : !!value;

const rawModal: SignUpModal =
  !!signUpModal && typeof signUpModal === "object" ? (signUpModal as SignUpModal) : {};

const modal = {
  enabled: isTrue(rawModal.enabled),
  id: (hasText(rawModal.id) ? rawModal.id.trim() : "offer-modal").replace(/^#/, ""),
  formAction: hasText(rawModal.formAction) ? rawModal.formAction.trim() : "",
  submitText: hasText(rawModal.submitText) ? rawModal.submitText.trim() : "Send",
  subject: hasText(rawModal.subject) ? rawModal.subject.trim() : "",
  redirect: hasText(rawModal.redirect) ? rawModal.redirect.trim() : "",
  fields: (Array.isArray(rawModal.fields) ? rawModal.fields : [])
    .filter((field) => !!field && typeof field === "object")
    .map((field) => {
      const type = hasText(field.type) ? field.type.trim().toLowerCase() : "text";

      return {
        type,
        isSelect: type === "select",
        isTextarea: type === "textarea",
        name: hasText(field.name) ? field.name.trim() : "",
        placeholder: hasText(field.placeholder) ? field.placeholder.trim() : "",
        required: isTrue(field.required),
        options: (Array.isArray(field.options) ? field.options : [])
          .map((option) =>
            typeof option === "string"
              ? { value: option.trim(), label: option.trim() }
              : {
                  value: hasText(option?.value) ? option.value.trim() : "",
                  label: hasText(option?.label) ? option.label.trim() : "",
                }
          )
          .map((option) => ({
            value: option.value || option.label,
            label: option.label || option.value,
          }))
          .filter((option) => option.label.length > 0),
      };
    })
    .filter((field) => field.name.length > 0),
};

const showModal = modal.enabled && modal.fields.length > 0;

const editableAttributes = (prop: string) =>
  editable ? { "data-editable": "text", "data-prop": prop } : {};
---

{
  (resolvedPlans.length > 0 || hasGuidelines) && (
    <div id="membership" class:list={[className]} {...htmlAttributes}>
      {hasText(heading) && <h2 {...editableAttributes("heading")}>{heading}</h2>}

      {resolvedPlans.length > 0 && (
        <div class="flex container align-start justify-between">
          {resolvedPlans.map((plan, index: number) => (
            <div>
              <div class="plan-card">
                {plan.name && <h3 {...editableAttributes(`plans.${index}.name`)}>{plan.name}</h3>}

                <div class="content">
                  {plan.includesLabel && (
                    <span
                      class="h1-small"
                      {...editableAttributes(`plans.${index}.includesLabel`)}
                    >
                      {plan.includesLabel}
                    </span>
                  )}
                  {plan.items.length > 0 && (
                    <ul>
                      {plan.items.map((text: string, itemIndex: number) => (
                        <li {...editableAttributes(`plans.${index}.items.${itemIndex}.text`)}>
                          {text}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                {plan.amount && (
                  <div class="price">
                    <span>
                      {plan.currency && <i>{plan.currency}</i>}
                      {plan.amount}
                    </span>
                    {plan.interval && <small>{plan.interval}</small>}
                  </div>
                )}

                {/* No `data-editable`: this renders `<br>` from the field
                    value, and inline text editing would write the collapsed
                    text back and lose the break. Edit it in the sidebar. */}
                {plan.savingsHtml && <span class="savings" set:html={plan.savingsHtml} />}
              </div>

              {plan.buttonText && (
                <a
                  href={plan.buttonLink || "#"}
                  class:list={["btn", plan.buttonLink.startsWith("#") && "modal"]}
                  data-title={plan.name || undefined}
                  data-price={plan.dataPrice || undefined}
                  {...editableAttributes(`plans.${index}.buttonText`)}
                >
                  {plan.buttonText}
                </a>
              )}
            </div>
          ))}
        </div>
      )}

      {hasGuidelines && (
        <article>
          {hasText(guidelinesHeading) && (
            <h4 {...editableAttributes("guidelinesHeading")}>{guidelinesHeading}</h4>
          )}
          {guidelinesHtml && (
            <div {...editableAttributes("guidelines")} set:html={guidelinesHtml} />
          )}
        </article>
      )}

      {showModal && (
        <dialog id={modal.id} class="modal-content simple" tabindex="-1">
          <div class="title h3" />
          <p class="description" />
          <form action={modal.formAction || undefined} class="forms" method="post">
            {modal.fields.map((field) =>
              field.isSelect ? (
                <select name={field.name} required={field.required}>
                  <option value="" disabled selected hidden>
                    {field.placeholder}
                  </option>
                  {field.options.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              ) : field.isTextarea ? (
                <textarea
                  name={field.name}
                  placeholder={field.placeholder}
                  required={field.required}
                />
              ) : (
                <input
                  type={field.type}
                  name={field.name}
                  placeholder={field.placeholder}
                  required={field.required}
                />
              )
            )}
            <input type="submit" name="submit" value={modal.submitText} class="btn" />
            <input type="hidden" name="_subject" value={modal.subject} />
            {modal.redirect && <input type="hidden" name="_redirect" value={modal.redirect} />}
          </form>
          <button type="button" class="modal-close" aria-label="Close" />
        </dialog>
      )}
    </div>
  )
}

<script>
  (() => {
    const section = document.getElementById("membership");
    if (!section) return;

    const triggers = section.querySelectorAll<HTMLAnchorElement>("a.btn[href^='#']");
    if (triggers.length === 0) return;

    const closeDialog = (dialog: HTMLDialogElement) => {
      if (dialog.open) dialog.close();
    };

    triggers.forEach((trigger) => {
      const dialog = document.querySelector<HTMLDialogElement>(
        `dialog${trigger.getAttribute("href")}`
      );
      if (!dialog) return;

      trigger.addEventListener("click", (event) => {
        event.preventDefault();

        const title = trigger.getAttribute("data-title") || "";
        const price = trigger.getAttribute("data-price") || "";

        const titleEl = dialog.querySelector(".title");
        if (titleEl) titleEl.textContent = title;

        const descriptionEl = dialog.querySelector(".description");
        if (descriptionEl) descriptionEl.textContent = price;

        /* So the submission says which plan it came from. */
        const subject = dialog.querySelector<HTMLInputElement>('input[name="_subject"]');
        if (subject) subject.value = title;

        if (!dialog.open) dialog.showModal();

        dialog.focus();
      });

      dialog.querySelectorAll(".modal-close").forEach((button) => {
        button.addEventListener("click", () => closeDialog(dialog));
      });

      /* Clicking the backdrop — the dialog itself is the only thing behind the
         content that can receive the event. */
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeDialog(dialog);
      });
    });
  })();
</script>

<style lang="pcss" is:global>
  #membership {
    padding: 160px 20px 60px;
  }

  #membership h2 {
    margin-bottom: 30px;
    text-align: center;
  }

  #membership .flex {
    display: flex;
  }

  #membership .align-start {
    align-items: flex-start;
  }

  #membership .justify-between {
    justify-content: space-between;
  }

  #membership .flex.container {
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
    margin: 0 auto;
    max-width: 1150px;
    width: 100%;
  }

  #membership .flex.container > div {
    max-width: 545px;
    width: 100%;
  }

  #membership .plan-card {
    background-image: url("/assets/images/green-bg-wave.webp");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    border-radius: 15px;
    margin: 0 auto;
    padding: 0 5px 10px;
    position: relative;
  }

  #membership .plan-card h3 {
    color: #fff;
    font-size: 47px;
    padding: 15px 10px;
    text-align: center;
  }

  #membership .plan-card .h1-small {
    text-align: center;
  }

  #membership .plan-card .content {
    background-color: #fff;
    border-radius: 15px;
    height: 390px;
    padding: 30px 20px 90px;
  }

  #membership .plan-card .content ul {
    list-style: none;
    margin: 0 auto;
    max-width: 400px;
    padding: 0;
    text-align: left;
  }

  #membership .plan-card .content ul li {
    display: block;
    line-height: 1.6;
    margin: 0 0 10px;
    padding-left: 30px;
    position: relative;
  }

  #membership .plan-card .content ul li::before {
    color: #118534;
    content: "\e832";
    font-family: "fontello";
    font-size: 0.9em;
    font-style: normal;
    font-weight: 400;
    left: 0;
    position: absolute;
    top: 3px;
  }

  /* The medallion straddles the panel's bottom edge: the symmetric negative
     margin pulls it up by half its height and lets the card close beneath it. */
  #membership .plan-card .price {
    align-items: center;
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 3px 6px rgb(0 0 0 / 15%);
    display: flex;
    flex-direction: column;
    height: 188px;
    justify-content: center;
    margin: -95px auto;
    position: relative;
    width: 188px;
  }

  /* Inner ring — a second shadowed disc inset inside the medallion. */
  #membership .plan-card .price::before {
    background-color: #fff;
    border-radius: 50%;
    box-shadow: 0 0 6px rgb(0 0 0 / 15%);
    content: "";
    inset: 10px;
    position: absolute;
  }

  #membership .plan-card .price span {
    align-items: flex-start;
    color: #32302f;
    display: flex;
    font-family: "canada-type-gibson", sans-serif;
    font-size: 57px;
    position: relative;
    z-index: 5;
  }

  /* The currency mark rides at the top of the figure, half its size. */
  #membership .plan-card .price span i {
    font-size: 25px;
    font-style: normal;
    padding-top: 5px;
    position: relative;
  }

  #membership .plan-card .price small {
    color: #32302f;
    font-size: 19px;
    position: relative;
    text-transform: uppercase;
    z-index: 5;
  }

  #membership .plan-card .savings {
    bottom: -55px;
    position: absolute;
    right: 15px;
  }

  /* Clears the medallion and the savings line, both of which hang below the
     card. Scoped to the card row rather than the whole section: the popup's
     own submit button is also inside `#membership`, and a bare `#membership
     .btn` would outrank `dialog.modal-content .btn` on the id and push it
     120px down the popup. */
  #membership .flex.container .btn {
    background-color: #32302f;
    border-radius: 50px;
    color: #fff;
    cursor: pointer;
    display: table;
    font: 500 18px/1 "jost", sans-serif;
    margin: 120px auto 0;
    min-width: 280px;
    padding: 22px 30px;
    position: relative;
    text-align: center;
    transition: 0.3s all;
    vertical-align: middle;
    z-index: 1;
  }

  #membership .flex.container .btn:hover {
    background-color: #a3c90d;
    color: #fff;
  }

  #membership article {
    margin: 0 auto;
    max-width: 1150px;
    padding: 50px 20px;
    text-align: center;
  }

  dialog.modal-content {
    animation: membership-modal-in 0.5s both;
    border: none;
    box-sizing: border-box;
    margin: auto;
    max-height: calc(100% - 65px);
    max-width: 92%;
    overflow-y: auto;
    padding: 30px;
    position: fixed;
    text-align: center;
    width: 600px;
  }

  dialog.modal-content::backdrop {
    background: rgb(0 0 0 / 50%);
    cursor: pointer;
  }

  @keyframes membership-modal-in {
    from {
      opacity: 0;
      transform: translate3d(0, 100%, 0);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  dialog.modal-content .title {
    font: 500 34px/1.1 "canada-type-gibson", sans-serif;
  }

  dialog.modal-content .description {
    margin: 10px auto;
  }

  dialog.modal-content.simple input:not([type="submit"]),
  dialog.modal-content.simple select,
  dialog.modal-content.simple textarea {
    background-color: #eee;
    border: 0;
    border-radius: 0;
    box-sizing: border-box;
    color: #32302f;
    font-size: 18px;
    height: 45px;
    line-height: 1;
    margin-bottom: 10px;
    max-width: 100%;
    padding: 0 11px;
    width: 100%;
  }

  dialog.modal-content.simple textarea {
    height: 130px;
    padding: 14px 11px;
  }

  dialog.modal-content.simple input:focus,
  dialog.modal-content.simple select:focus,
  dialog.modal-content.simple textarea:focus {
    background-color: #e7f0f6;
    color: #118534;
    outline: 0;
  }

  dialog.modal-content.simple ::placeholder {
    color: #32302f;
  }

  dialog.modal-content .btn {
    background-color: #32302f;
    border: 0;
    border-radius: 50px;
    color: #fff;
    cursor: pointer;
    display: table;
    font: 500 18px/1 "jost", sans-serif;
    margin: 20px auto 0;
    min-width: 280px;
    padding: 22px 30px;
    text-align: center;
    transition: 0.3s all;
  }

  dialog.modal-content .btn:hover {
    background-color: #a3c90d;
    color: #fff;
  }

  dialog.modal-content .modal-close {
    align-items: center;
    background-color: #fff;
    border: none;
    color: #32302f;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    height: 40px;
    justify-content: center;
    line-height: 0;
    padding-bottom: 4px;
    position: absolute;
    right: 5px;
    top: 5px;
    transition: 0.3s all;
    width: 40px;
  }

  dialog.modal-content .modal-close::before {
    content: "\00d7";
    font-size: 35px;
    line-height: 0;
  }

  dialog.modal-content .modal-close:hover {
    background-color: #000;
    color: #fff;
  }

  @media (max-width: 520px) {
    #membership .flex.container {
      gap: 40px;
    }

    #membership .plan-card .price {
      height: 160px;
      margin: -80px auto;
      width: 160px;
    }

    #membership .plan-card .price span {
      font-size: 48px;
    }

    #membership .plan-card .price small {
      font-size: 16px;
    }

    /* Below the card rather than beside it, so the break comes out. */
    #membership .plan-card .savings {
      font-size: 17px;
      inset: auto 0 -102px;
      text-align: center;
    }

    #membership .plan-card .savings br {
      display: none;
    }
  }
</style>
