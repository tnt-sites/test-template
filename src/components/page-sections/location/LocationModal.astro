---
/**
 * A location-page modal: the site's native <dialog> component wearing the
 * legacy location-page skin.
 *
 * Opening, closing, Escape, backdrop clicks and focus handling all come from
 * the shared Modal component's controller — this only supplies the heading,
 * the markdown body, and the styling.
 */
import Modal from "@page-sections/info-blocks/modal/Modal.astro";
import { renderMarkdown } from "./utils";

const { id, heading = "", content = "" } = Astro.props;

if (!id) return;

const body = renderMarkdown(content);
---

<Modal id={id} class="location-modal">
  {heading && <h3>{heading}</h3>}
  <Fragment set:html={body} />
</Modal>

<style lang="pcss" is:global>
  @layer page-sections {
    .modal.location-modal {
      --modal-background: #f5f5f5;
      --modal-h3-color: #000;
      --modal-content-color: #000;
      --modal-a-color: #000;
      --modal-a-color-hover: #000;

      background: var(--modal-background);
      border: none;
      border-radius: 10px;
      max-height: calc(95% - 40px);
      max-width: 1000px;
      overflow: auto;
      padding: 20px 20px 10px;
      width: calc(100% - 40px);

      &::backdrop {
        background: rgb(0 0 0 / 80%);
      }

      .modal-body {
        margin-top: 0;
      }

      h3 {
        color: var(--modal-h3-color);
        font-size: 36px;
        line-height: 1.25;
        margin: 0 auto 25px;
        max-width: calc(100% - 40px);
        text-align: center;

        small {
          color: var(--modal-h3-color);
          display: block;
          margin: 10px auto 0;
        }
      }

      *:not(h1):not(h2):not(h3):not(h4):not(h5):not(h6):not(a):not(button):not(input):not(select):not(textarea) {
        color: var(--modal-content-color);
      }

      a:not(.btn):not(.btn-alt) {
        color: var(--modal-a-color);

        &:hover {
          color: var(--modal-a-color-hover);
        }
      }

      ul,
      ol {
        margin-bottom: 0;
        overflow: visible; /* stops list markers being clipped at short viewports */
      }
    }

    @media screen and (max-width: 1024px) {
      .modal.location-modal h3 {
        font-size: 32px;
      }
    }

    @media screen and (max-width: 767px) {
      .modal.location-modal h3 {
        font-size: 28px;
      }
    }
  }
</style>
