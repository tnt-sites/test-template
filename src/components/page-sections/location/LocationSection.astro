---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { cssVars } from "./utils";

const {
  id = "",
  backgroundColor,
  textColor,
  accentColor,
  iconColor,
  backgroundImage,
  class: className,
  style: styleProp,
  ...htmlAttributes
} = Astro.props;

const paletteStyle = cssVars({
  "--background": backgroundColor,
  "--h2-color": textColor,
  "--site-a-color": textColor,
  "--site-a-color-hover": accentColor,
  "--intro-h1-color": textColor,
  "--intro-h2-color": textColor,
  "--image-h3-color": textColor,
  "--focus-color": textColor,
  "--location-services-h2-color": accentColor,
  "--svg-color": iconColor,
  "--svg-h3-color": textColor,
  "--alt-content-color": textColor,
  "--alt-a-color": textColor,
  "--alt-a-color-hover": accentColor,
  "--quotation-color": textColor,
  "--review-star-color": accentColor,
  "--review-content-color": textColor,
});
---

<CustomSection
  class:list={["location-page-section", className]}
  id={id || undefined}
  paddingHorizontal="none"
  paddingVertical="none"
  colorScheme="inherit"
  backgroundImage={backgroundImage}
  style={[paletteStyle, styleProp].filter(Boolean).join(" ") || undefined}
  {...htmlAttributes}
>
  <slot />
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .location-page-section {
      --background: #ffffff;
      --h2-color: #000000;
      --site-a-color: #000000;
      --site-a-color-hover: #000000;
      --intro-h1-color: #000000;
      --intro-h2-color: #000000;
      --image-h3-color: #000000;
      --focus-color: #000000;
      --location-services-h2-color: #000000;
      --svg-color: #000000;
      --svg-h3-color: #000000;
      --alt-content-color: #000000;
      --alt-a-color: #000000;
      --alt-a-color-hover: #000000;
      --quotation-color: #000000;
      --review-star-color: #000000;
      --review-content-color: #000000;

      /* Doctor & service card sizing */
      --doctor-images-container-width: 1400px;
      --doctor-image-width: 250px;
      --service-images-container-width: 1200px;
      --service-image-width: 325px;

      /* Cards that open a modal */
      --image-modal-h3-color: var(--site-a-color);
      --image-modal-h3-color-hover: var(--site-a-color-hover);
      --image-modal-h3-btn-color-hover: #fff;
      --svg-modal-h3-color: var(--alt-a-color);
      --svg-modal-h3-color-hover: var(--alt-a-color-hover);

      /* Font sizes — desktop */
      --intro-h1-font: 24px;
      --intro-h2-font: 54px;
      --h2-font: 54px;
      --why-h3-icon-font: 24px;
      --doctor-h3-image-font: 24px;
      --doctor-h3-icon-font: 22px;
      --quotation-font: 35px;
      --review-content-font: 20px;
      --service-h3-image-font: 22px;
      --financing-h3-icon-font: 22px;
      --faq-h3-font: 24px;
      --faq-icon-size: 24px;

      /* Font sizes — tablet, below 1025px */
      --intro-h1-font-tablet: 23px;
      --intro-h2-font-tablet: 48px;
      --h2-font-tablet: 48px;
      --why-h3-icon-font-tablet: 24px;
      --doctor-h3-image-font-tablet: 23px;
      --doctor-h3-icon-font-tablet: 22px;
      --review-content-font-tablet: 20px;
      --service-h3-image-font-tablet: 22px;
      --financing-h3-icon-font-tablet: 20px;
      --faq-h3-font-tablet: 22px;
      --faq-icon-size-tablet: 22px;

      /* Font sizes — mobile, below 768px */
      --intro-h1-font-mobile: 22px;
      --intro-h2-font-mobile: 42px;
      --h2-font-mobile: 42px;
      --why-h3-icon-font-mobile: 22px;
      --doctor-h3-image-font-mobile: 22px;
      --doctor-h3-icon-font-mobile: 20px;
      --review-content-font-mobile: 20px;
      --service-h3-image-font-mobile: 20px;
      --financing-h3-icon-font-mobile: 20px;
      --faq-h3-font-mobile: 21px;
      --faq-icon-size-mobile: 21px;

      margin: 0 auto;
      padding: 0;
      background: var(--background);
      background-size: cover;

      .container {
        display: block;
        margin: 0 auto;
        max-width: 1000px;
        padding: 20px 0;
        text-align: center;
        width: 100%;
      }

      .wrap {
        display: block;
        margin: 0 auto;
        max-width: 1050px;
        padding: 20px 0;
        text-align: center;
        width: 100%;
      }

      h2 {
        color: var(--h2-color);
        font-size: var(--h2-font);
        line-height: 1.15;
        margin: 0 auto !important; /* over-rides the site's h2 spacing */
        max-width: 1380px;
        padding: 0 0 20px;
        text-align: center;
      }

      h3 {
        margin: 0;
        padding: 0;
        text-align: center;
      }

      p {
        margin: 0;
        padding: 10px 0;
      }

      *:not(h1):not(h2):not(h3):not(h4):not(h5):not(h6):not(a):not(button):not(input):not(select):not(textarea) {
        color: var(--alt-content-color);
      }

      a:not(.btn):not(.btn-alt) {
        color: var(--site-a-color);

        &:hover {
          color: var(--site-a-color-hover);
        }
      }

      & :focus-visible {
        outline: 2px solid var(--focus-color) !important;
        outline-offset: 2px;
        transition: none;
      }

      & :focus:not(:focus-visible) {
        outline: none !important;
        transition: none;
      }
    }

    @media screen and (max-width: 1024px) {
      .location-page-section h2 {
        font-size: var(--h2-font-tablet);
      }
    }

    @media screen and (max-width: 767px) {
      .location-page-section h2 {
        font-size: var(--h2-font-mobile);
      }
    }
  }
</style>
