---
/**
 * One question/answer pair.
 *
 * Emits the `.faq-wrapper` / `.faq-toggle` / `.faq-content` structure that the
 * legacy jQuery used to build at runtime by wrapping siblings, so the styles
 * apply without any DOM surgery on load.
 */
import { hasText, renderMarkdown } from "../utils";

const {
  question = "",
  answer = "",
  editable = true,
  class: className,
  _component,
  ...rest
} = Astro.props;

if (!_component && !hasText(question)) return;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

const answerHtml = renderMarkdown(answer);
const editableAttributes = (prop: string, type = "text") =>
  editable ? { "data-editable": type, "data-prop": prop } : {};
---

<div class:list={["faq-wrapper", className]} {...htmlAttributes}>
  <button class="faq-toggle" type="button" aria-expanded="false">
    <h3 {...editableAttributes("question")}>{question}</h3>
  </button>
  <div class="faq-content" {...editableAttributes("answer", "markdown")}>
    <Fragment set:html={answerHtml} />
  </div>
</div>
