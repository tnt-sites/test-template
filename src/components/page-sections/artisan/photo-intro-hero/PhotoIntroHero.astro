---
/**
 * Full-bleed photo hero opening a page's real content, right after its plain
 * title banner — the source's "Have You Considered A Partial or Full Mouth
 * Restoration?" section and its identical siblings on new-smile-design and
 * services. Ported rather than forced into split-feature: the source pins the
 * photo top-right, fixes it in place while the page scrolls, and darkens it
 * with a corner-to-corner gradient rather than a flat scrim — none of which
 * split-feature's wood-texture-band recipe can express.
 *
 * Baked in: layout, photo treatment, gradient. Props: text, image, buttons,
 * colours.
 */
import Button from "@core-elements/button/Button.astro";
const {
  eyebrow = "", heading = "", text = "", image = "",
  buttonText = "", buttonLink = "",
  secondaryButtonText = "", secondaryButtonLink = "",
  eyebrowColor = "var(--color-brand-secondary)",
  headingColor = "#ffffff", textColor = "#ffffff",
  id, _component, ...rest
} = Astro.props;
---
<section class="a-photohero" id={id || undefined}
  style={`--eb:${eyebrowColor};--hd:${headingColor};--tx:${textColor}${image ? `;--img:url('${image}')` : ""}`} {...rest}>
  {image && <div class="ph-scrim" />}
  <div class="ph-inner">
    {eyebrow && <p class="ph-eyebrow">{eyebrow}</p>}
    {heading && <h2>{heading}</h2>}
    {text && <div class="ph-body" set:html={text} />}
    {(buttonText || secondaryButtonText) && (
      <div class="ph-buttons">
        {buttonText && <Button variant="primary" size="lg" link={buttonLink} text={buttonText} />}
        {secondaryButtonText && (
          <Button variant="secondary" size="lg" link={secondaryButtonLink} text={secondaryButtonText} iconName="arrow-down" />
        )}
      </div>
    )}
  </div>
</section>
<style>
  .a-photohero {
    background-image: var(--img, none);
    background-position: top right;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    min-height: 90vh;
    display: flex;
    align-items: center;
    position: relative;
  }
  .ph-scrim {
    background-image: linear-gradient(270deg, rgba(41, 41, 41, 0) 0%, rgba(41, 41, 41, 0.48) 100%);
    inset: 0;
    position: absolute;
  }
  .ph-inner {
    margin-inline: auto;
    max-width: 1200px;
    padding-block: 4rem;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
    position: relative;
    width: 100%;
  }
  .ph-eyebrow {
    color: var(--eb);
    font-family: "Open Sans", sans-serif;
    font-size: 18px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 0;
  }
  h2 { color: var(--hd); font-family: Poppins, sans-serif; font-size: clamp(2rem,4vw,65px); font-weight: 700; letter-spacing: -1px; line-height: 1.08; margin: 0.25rem 0 1rem; max-width: 720px; }
  .ph-body { color: var(--tx); font-family: "Open Sans", sans-serif; font-size: 18px; line-height: 26px; margin-bottom: 1.75rem; max-width: 560px; }
  .ph-body :global(p) { color: inherit; margin: 0 0 1rem; }
  .ph-buttons { display: flex; flex-wrap: wrap; gap: 1rem; }
  @media (max-width: 640px) { .a-photohero { background-attachment: scroll; min-height: 70vh; } }
</style>
