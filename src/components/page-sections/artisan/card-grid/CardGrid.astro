---
/**
 * Row of image cards, each linking somewhere — the source's
 * "Why Choose Us / Meet Our Team / Tour Our Office" row.
 *
 * Baked in: layout, type scale, image ratio. Props: colours. Array: `cards`.
 */
const {
  cards = [],
  backgroundColor = "transparent",
  titleColor = "#ffffff",
  textColor = "#333333",
  overlayColor = "rgba(50, 28, 14, 0.55)",
  id, _component, ...rest
} = Astro.props;
const list = Array.isArray(cards) ? cards.filter(Boolean) : [];
---
<section class="a-cardgrid" id={id || undefined}
  style={`--bg:${backgroundColor};--tc:${titleColor};--tx:${textColor};--ov:${overlayColor}`} {...rest}>
  <ul class="inner no-check">
    {list.map((c: any) => (
      <li>
        <a href={c.link || "#"}>
          <div class="media">
            {c.image && <img src={c.image} alt={c.title || ""} loading="lazy" />}
            <span class="cap">{c.title}</span>
          </div>
          {c.text && <p>{c.text}</p>}
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  .a-cardgrid { background: var(--bg); padding-block: 4rem; }
  .inner { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); list-style: none; margin-inline: auto; max-width: 1200px; padding-inline: clamp(1rem,3vw,2.5rem); }
  a { color: inherit; text-decoration: none; }
  .media { border-radius: 4px; overflow: hidden; position: relative; }
  .media img { aspect-ratio: 4 / 3; display: block; height: auto; object-fit: cover; width: 100%; }
  .cap { align-items: center; background: var(--ov); color: var(--tc); display: flex; font-family: Poppins, sans-serif; font-size: 22px; font-weight: 700; inset: 0; justify-content: center; position: absolute; text-align: center; }
  p { color: var(--tx); font-family: "Open Sans", sans-serif; font-size: 16px; line-height: 25px; margin: 1rem 0 0; }
  a:hover .cap { background: color-mix(in srgb, var(--ov) 70%, transparent); }
</style>
