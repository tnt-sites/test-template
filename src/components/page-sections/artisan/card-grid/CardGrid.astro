---
/**
 * Row of image cards, each linking somewhere — the source's
 * "Why Choose Us / Meet Our Team / Tour Our Office" row.
 *
 * Baked in: layout, type scale, image ratio. Props: colours. Array: `cards`.
 */
const {
  cards = [],
  backgroundColor = "#321c0e",
  backgroundImage = "",
  overlayOpacity = 0.15,
  titleColor = "#ffffff",
  textColor = "#ffffff",
  captionColor = "#d2b22e",
  id, _component, ...rest
} = Astro.props;
const list = Array.isArray(cards) ? cards.filter(Boolean) : [];
---
<section class="a-cardgrid" id={id || undefined}
  style={`--bg:${backgroundColor};--tc:${titleColor};--tx:${textColor};--cap:${captionColor};--woodopacity:${overlayOpacity}${backgroundImage ? `;--wood:url('${backgroundImage}')` : ""}`} {...rest}>
  <ul class="cg-inner no-check">
    {list.map((c: any) => (
      <li>
        <a href={c.link || "#"}>
          <div class="cg-media">
            {c.image && <img src={c.image} alt={c.title || ""} loading="lazy" />}
            <span class="cg-cap">{c.title}</span>
          </div>
          {c.text && <p>{c.text}</p>}
        </a>
      </li>
    ))}
  </ul>
</section>
<style>
  .a-cardgrid { background-color: var(--bg); padding-block: 4rem; position: relative; }

  /* Measured: the source lays #321c0e over the wood texture. */

  /* Source structure: the section is solid brand-brown, and the wood texture
     rides on the OVERLAY together with the same brown at opacity .15 and
     mix-blend-mode: lighten. Putting the texture on the section instead (which
     is what this did first) renders it far too light. */
  .a-cardgrid::before {
    background-color: var(--bg);
    background-image: var(--wood, none);
    background-position: top center;
    background-size: cover;
    content: "";
    inset: 0;
    mix-blend-mode: lighten;
    opacity: var(--woodopacity, 0.15);
    position: absolute;
  }
  .cg-inner {  display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); list-style: none; margin-inline: auto; max-width: 1200px; padding-inline: clamp(1rem,3vw,2.5rem); position: relative; }
  a { color: inherit; text-decoration: none; }
  .cg-media { border-radius: 4px; overflow: hidden; position: relative; }
  .cg-media img { aspect-ratio: 4 / 3; display: block; height: auto; object-fit: cover; width: 100%; }
  .cg-cap { background: var(--cap); bottom: 0; color: var(--tc); display: block; font-family: Poppins, sans-serif; font-size: 22px; font-weight: 700; left: 0; padding: 0.6rem 1rem; position: absolute; right: 0; text-align: center; }
  p { color: var(--tx); font-family: "Open Sans", sans-serif; font-size: 16px; line-height: 26px; margin: 1rem 0 0; text-align: center; }
  a:hover .cg-cap { filter: brightness(1.08); }
</style>
