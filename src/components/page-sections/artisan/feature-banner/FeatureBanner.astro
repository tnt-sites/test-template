---
/**
 * Full-bleed photo banner with an eyebrow, headline and a checklist —
 * the source's "About Us / Why Choose Us" band.
 *
 * Baked in: layout, scrim, type scale, tick marker. Props: text, image,
 * colours. Array: `items`.
 */
const {
  eyebrow = "", heading = "", items = [],
  image = "", overlayColor = "rgba(50, 28, 14, 0.72)",
  eyebrowColor = "#ffffff", headingColor = "#ffffff",
  textColor = "#ffffff", markerColor = "#d2b22e",
  panelColor = "rgba(50, 28, 14, 0.92)", panelWidth = "620px",
  minHeight = "520px",
  id, _component, ...rest
} = Astro.props;
const list = Array.isArray(items) ? items.filter(Boolean) : [];
---
<section class="a-banner" id={id || undefined}
  style={`--ov:${overlayColor};--eb:${eyebrowColor};--hd:${headingColor};--tx:${textColor};--mk:${markerColor};--minh:${minHeight};--panel:${panelColor};--panelw:${panelWidth}${image ? `;background-image:url('${image}')` : ""}`} {...rest}>
  <div class="fb-scrim"></div>
  <div class="fb-inner">
   <div class="fb-panel">
    {eyebrow && <p class="fb-eyebrow">{eyebrow}</p>}
    {heading && <h2>{heading}</h2>}
    {list.length > 0 && (
      <ul class="fb-items no-check">{list.map((i: any) => <li>{typeof i === "string" ? i : i.text}</li>)}</ul>
    )}
   </div>
  </div>
</section>
<style>
  .a-banner { background-position: center; background-size: cover; min-height: var(--minh); position: relative; }
  .fb-scrim { background: var(--ov); inset: 0; position: absolute; }
  .fb-inner { margin-inline: auto; max-width: 1200px; padding: 4rem clamp(1rem,3vw,2.5rem); position: relative; }
  .fb-panel { background: var(--panel); max-width: var(--panelw); padding: 3rem clamp(1.5rem,3vw,3rem); }
  .fb-eyebrow {
    color: var(--eb);
    font-family: "Open Sans", sans-serif;
    font-size: 18px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 0;
  }
  h2 { color: var(--hd); font-family: Poppins, sans-serif; font-size: clamp(1.75rem,3vw,40px); font-weight: 700; margin: 0.25rem 0 2rem; }
  .fb-items { color: var(--tx); columns: 1; display: block; font-family: "Open Sans", sans-serif; font-size: 18px; line-height: 34px; list-style: none; margin: 0; padding: 0; }
  .fb-items li { break-inside: avoid; padding-left: 1.75rem; position: relative; }
  .fb-items li::before { color: var(--mk); content: "\2713"; font-weight: 700; left: 0; position: absolute; }
  
</style>
