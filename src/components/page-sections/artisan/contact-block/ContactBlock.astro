---
/**
 * Contact details beside a message form — the source's "Send us a message".
 * The form is rebuilt with the starter's form builder; the backend is
 * deliberately unwired (see tools/extract-forms.mjs).
 *
 * Baked in: layout, type scale. Props: text, colours. Array: `details`.
 */
import Components from "@components/utils/renderBlock.astro";
const {
  heading = "", details = [], formBlocks = [], formAction = "/thank-you/",
  backgroundColor = "#ffffff", headingColor = "#321c0e",
  labelColor = "#321c0e", textColor = "#333333",
  id, _component, ...rest
} = Astro.props;
const list = Array.isArray(details) ? details.filter(Boolean) : [];
---
<section class="a-contact" id={id || undefined}
  style={`--bg:${backgroundColor};--hd:${headingColor};--lb:${labelColor};--tx:${textColor}`} {...rest}>
  <div class="cb-inner">
    <div class="cb-details">
      {list.map((d: any) => (
        <div class="cb-row">
          <p class="cb-label">{d.label}</p>
          {d.link ? <a href={d.link}>{d.value}</a> : <p class="cb-value">{d.value}</p>}
        </div>
      ))}
    </div>
    <div class="cb-formwrap">
      {heading && <h2>{heading}</h2>}
      <form action={formAction} method="get" class="a-form">
        {formBlocks.length > 0 && <Components contentSections={formBlocks} propName="formBlocks" editable={false} />}
      </form>
    </div>
  </div>
</section>
<style>
  .a-contact { background: var(--bg); padding-block: 4.5rem; }
  .cb-inner { display: grid; gap: 3.5rem; grid-template-columns: minmax(240px,1fr) 1.6fr; margin-inline: auto; max-width: 1200px; padding-inline: clamp(1rem,3vw,2.5rem); }
  h2 { color: var(--hd); font-family: Poppins, sans-serif; font-size: clamp(1.75rem,3vw,40px); font-weight: 700; margin: 0 0 1.5rem; }
  .cb-row + .cb-row { margin-top: 1.5rem; }
  .cb-label { color: var(--lb); font-family: Poppins, sans-serif; font-size: 18px; font-weight: 700; margin: 0 0 0.25rem; }
  .cb-value, .cb-details a { color: var(--tx); font-family: "Open Sans", sans-serif; font-size: 17px; line-height: 26px; margin: 0; text-decoration: none; }
  .cb-details a:hover { text-decoration: underline; }
  .a-form { display: grid; gap: 1rem; }
  @media (max-width: 860px) { .cb-inner { grid-template-columns: 1fr; } }
</style>
