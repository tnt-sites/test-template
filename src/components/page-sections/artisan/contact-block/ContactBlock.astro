---
/**
 * Contact details beside a message form — the source's "Send us a message".
 *
 * Two ways in for the form, because the source has two kinds: `formBlocks`
 * rebuilds it with the starter's form builder (the home page), and `formHtml`
 * renders the source's own hand-written `.tnt-form` markup lifted verbatim
 * (contact-us, where the same page also carries a 20-field appointment form
 * that only exists as lifted markup — one style of form per page beats two).
 * Either way the backend is unwired (see tools/extract-forms.mjs).
 *
 * The map is optional and, when it's the only thing set, renders on its own —
 * the source gives it a full-bleed section of its own above the details.
 *
 * Baked in: layout, type scale. Props: text, colours. Array: `details`.
 */
import Components from "@components/utils/renderBlock.astro";
const {
  detailsHeading = "", heading = "", details = [], formBlocks = [], formHtml = "",
  formAction = "/thank-you/",
  mapEmbedUrl = "", mapHeight = "360px",
  backgroundColor = "#ffffff", headingColor = "var(--color-brand)",
  labelColor = "var(--color-brand)", textColor = "#333333",
  headingSize = "", paddingBlock = "",
  id, _component, ...rest
} = Astro.props;
const list = Array.isArray(details) ? details.filter(Boolean) : [];
const blocks = Array.isArray(formBlocks) ? formBlocks : [];
const hasForm = blocks.length > 0 || Boolean(formHtml);
const hasInner = list.length > 0 || hasForm || Boolean(heading) || Boolean(detailsHeading);
---
<section class:list={["a-contact", { "map-only": !hasInner }]} id={id || undefined}
  style={`--bg:${backgroundColor};--hd:${headingColor};--lb:${labelColor};--tx:${textColor}${headingSize ? `;--hdsize:${headingSize}` : ""}${paddingBlock ? `;--pad:${paddingBlock}` : ""}`} {...rest}>
  {mapEmbedUrl && (
    <div class="cb-map" style={`--maph:${mapHeight}`}>
      <iframe src={mapEmbedUrl} title="Map to Artisan Dental" loading="lazy" referrerpolicy="no-referrer-when-downgrade" />
    </div>
  )}
  {hasInner && (
    <div class="cb-inner">
      <div class="cb-details">
        {detailsHeading && <h2>{detailsHeading}</h2>}
        {/* Label/value pairs, so a <dl>: as <p>s the bold labels read as
            unmarked headings. The label stays plain text — the value links to
            the same place, and two adjacent links to one URL is redundant. The
            icon is decorative and drawn in CSS, since a <dl> row may only
            hold <dt>/<dd>. */}
        <dl class="cb-list">
          {list.map((d: any) => (
            <div class:list={["cb-row", { "has-icon": d.icon }]} style={d.icon ? `--icon:url('${d.icon}')` : undefined}>
              <dt class="cb-label">{d.label}</dt>
              <dd>
                {d.link
                  ? <a class:list={["cb-value", { linked: d.valueIsLink }]} href={d.link}>{d.value}</a>
                  : <span class="cb-value">{d.value}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      {(heading || hasForm) && (
        <div class="cb-formwrap">
          {heading && <h2>{heading}</h2>}
          {formHtml
            ? <div class="cb-formhtml" set:html={formHtml} />
            : (
              <form action={formAction} method="get" class="a-form">
                {blocks.length > 0 && <Components contentSections={blocks} propName="formBlocks" editable={false} />}
              </form>
            )}
        </div>
      )}
    </div>
  )}
</section>
<style>
  .a-contact { background: var(--bg); padding-block: var(--pad, 0 4.5rem); }

  /* Nothing but the map: the source runs it edge to edge with no padding of
     its own, and an empty details/form grid below it just adds dead space. */
  .a-contact.map-only { padding-block: 0; }
  .a-contact.map-only .cb-map { margin-bottom: 0; }

  .cb-map { line-height: 0; margin-bottom: 3.5rem; }
  .cb-map iframe { border: 0; display: block; height: var(--maph); width: 100%; }
  /* MEASURED: 50/50 columns inside a 1200px container, on both the home page's
     band and contact-us'. */
  .cb-inner { display: grid; gap: 3.5rem; grid-template-columns: 1fr 1fr; margin-inline: auto; max-width: 1200px; padding-inline: clamp(1rem,3vw,2.5rem); }
  h2 { color: var(--hd); font-family: Poppins, sans-serif; font-size: var(--hdsize, clamp(1.75rem,3vw,40px)); font-weight: 700; line-height: 1.3; margin: 0 0 1.5rem; }

  /* An icon beside each row, and a hairline between them — the source builds
     these out of image-box widgets separated by divider widgets. */
  .cb-list { margin: 0; }
  .cb-row { column-gap: 20px; display: grid; grid-template-rows: auto 1fr; }
  .cb-row + .cb-row { border-top: 1px solid rgb(0 0 0 / 10%); margin-top: 15px; padding-top: 15px; }
  .cb-row.has-icon { grid-template-columns: 73px 1fr; }
  .cb-row.has-icon::before { aspect-ratio: 1; background: var(--icon) center / contain no-repeat; content: ""; grid-row: 1 / 3; }
  .cb-row.has-icon > * { grid-column: 2; }
  .cb-row dd { margin: 0; }
  .cb-label { color: var(--lb); font-family: Poppins, sans-serif; font-size: 18px; font-weight: 700; line-height: 28px; margin: 8px 0 5px; }
  .cb-value, .cb-details a.cb-value { color: var(--tx); display: block; font-family: "Open Sans", sans-serif; font-size: 18px; line-height: 26px; margin: 0; text-decoration: none; }
  .cb-details a:hover { text-decoration: underline; }

  /* The source links every row's label but only the phone number's value, and
     the theme paints that one link gold — which is why the phone reads
     differently from the address and email sitting above it. The source's
     #bf9800 fails contrast on white, so it takes the darkened --color-link. */
  .cb-value.linked, .cb-details a.cb-value.linked { color: var(--color-link); }
  .a-form { display: grid; gap: 1rem; }
  @media (max-width: 860px) { .cb-inner { grid-template-columns: 1fr; } }
</style>
