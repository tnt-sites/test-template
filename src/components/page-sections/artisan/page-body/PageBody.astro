---
/**
 * Interior page body: a section-nav sidebar beside the main content.
 *
 * This is the single most common interior layout on the source — 53 of 90
 * pages use it. `mig content` mapped it to the starter's cta-split-learn-more,
 * which is a marketing split, not a sidebar layout, so the section nav was lost
 * entirely and the copy reflowed full width.
 *
 * Measured: 300px sidebar / 900px main, sidebar heading Open Sans 20px 700 on a
 * brand bar, nav links Open Sans 16px #222.
 *
 * Baked in: layout and typography. Props: text, image, colours, and `boxed`
 * — the source sets nearly every interior page's copy in a light grey panel
 * with a thin border, so that's the default.
 * Arrays: `links`, so the section nav is editable.
 */
const {
  sidebarHeading = "",
  links = [],
  image = "",
  imageAlt = "",
  imageWidth = "",
  imageAlign = "left",
  body = "",
  backgroundColor = "transparent",
  headingBackground = "#321c0e",
  headingColor = "#ffffff",
  linkColor = "#222222",
  textColor = "#686868",
  reverse = false,
  boxed = true,
  boxBackgroundColor = "#f2f2f2",
  boxBorderColor = "#7a7a7a",
  id,
  _component,
  ...rest
} = Astro.props;

const list = Array.isArray(links) ? links.filter((l: any) => l?.name) : [];
const hasSidebar = Boolean(sidebarHeading) || list.length > 0;
---

<section
  class:list={["a-pagebody", { reverse, boxed }]}
  id={id || undefined}
  style={`--bg:${backgroundColor};--hbg:${headingBackground};--hc:${headingColor};--lc:${linkColor};--tx:${textColor};--boxbg:${boxBackgroundColor};--boxbd:${boxBorderColor}`}
  {...rest}
>
  <div class:list={["pb2-inner", { "no-sidebar": !hasSidebar }]}>
    {
      (sidebarHeading || list.length > 0) && (
        <aside class="pb2-side">
          {sidebarHeading && <h2>{sidebarHeading}</h2>}
          {list.length > 0 && (
            <ul class="no-check">
              {list.map((l: any) => (
                <li>
                  <a href={l.path || "#"} class:list={{ current: l.current }}>
                    {l.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </aside>
      )
    }
    <div class="pb2-main">
      {
        image && (
          <img
            class:list={["pb2-image", { centered: imageAlign === "center" }]}
            src={image}
            alt={imageAlt}
            loading="lazy"
            style={imageWidth ? `width:${imageWidth}` : undefined}
          />
        )
      }
      {body && <div class="pb2-prose" set:html={body} />}
      <slot />
    </div>
  </div>
</section>

<style>
  .a-pagebody {
    background: var(--bg);
    padding-block: 60px;
  }

  .pb2-inner {
    display: grid;
    gap: 3rem;
    grid-template-columns: 300px minmax(0, 1fr);
    margin-inline: auto;
    max-width: 1240px;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  .pb2-inner.no-sidebar {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Grey #f2f2f2 rather than the source's #eee: the brand gold only just
     clears 4.5:1 on #eee, and this keeps a little headroom. */
  .a-pagebody.boxed .pb2-main {
    background: var(--boxbg);
    border: 1px solid var(--boxbd);
    padding: clamp(1.25rem, 4vw, 3.5rem);
  }

  .a-pagebody.reverse .pb2-side {
    order: 2;
  }

  .pb2-side h2 {
    background: var(--hbg);
    color: var(--hc);
    font-family: "Open Sans", sans-serif;
    font-size: 20px;
    font-weight: 700;
    margin: 0;
    padding: 0.85rem 1.25rem;
  }

  .pb2-side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pb2-side li {
    border-bottom: 1px solid rgb(0 0 0 / 10%);
  }

  .pb2-side a {
    color: var(--lc);
    display: block;
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    line-height: 1.4;
    padding: 0.7rem 1.25rem;
    text-decoration: none;
  }

  .pb2-side a:hover,
  .pb2-side a.current {
    background: rgb(0 0 0 / 4%);
    color: var(--hbg);
    font-weight: 600;
  }

  .pb2-image {
    display: block;
    height: auto;
    margin-bottom: 1.75rem;
    max-width: 100%;
  }

  .pb2-image.centered {
    margin-inline: auto;
  }

  .pb2-prose {
    color: var(--tx);
    font-family: "Open Sans", sans-serif;
    font-size: 18px;
    line-height: 26px;
  }

  .pb2-prose :global(h2),
  .pb2-prose :global(h3) {
    color: var(--hbg);
    font-family: Poppins, sans-serif;
    font-weight: 700;
    margin: 1.75rem 0 0.75rem;
  }

  .pb2-prose :global(h2) {
    font-size: 30px;
  }

  .pb2-prose :global(h3) {
    font-size: 22px;
  }

  /* Migrated bodies lean on <h4> for sub-headings (Step 1, Comfort, …); the
     source sets them bold Poppins, not the thin body face they fell back to. */
  .pb2-prose :global(h4) {
    color: #222222;
    font-family: Poppins, sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.35;
    margin: 1.5rem 0 0.5rem;
  }

  .pb2-prose :global(p) {
    color: inherit;
    margin: 0 0 1.25rem;
  }

  /* Buttons excluded: this rule used to paint their labels brown on the gold
     button fill (3:1). */
  .pb2-prose :global(a:not(.button)) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .pb2-prose :global(a:not(.button):hover) {
    color: var(--color-link-hover);
  }

  .pb2-prose :global(.media-columns) {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr 1fr;
  }

  .pb2-prose :global(.media-columns h4) {
    margin-top: 0;
  }

  /* Small illustration + caption cards (e.g. the conditions Invisalign treats).
     The source images are only 160px wide, so they're held near that size rather
     than stretched to the column and blurred. */
  /* Lone body images sit centred in the column, as on the source. Floated
     WordPress images (alignleft/alignright) keep their float. */
  .pb2-prose :global(img:not(.alignleft):not(.alignright):not(.image-row img)) {
    display: block;
    margin-inline: auto;
  }

  /* Third-party video iframes (Spear, YouTube) at 16:9. */
  .pb2-prose :global(.video-embed) {
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    max-width: 640px;
  }

  .pb2-prose :global(.video-embed iframe) {
    border: 0;
    height: 100%;
    width: 100%;
  }

  /* A pair (or more) of images shown side by side, centred. */
  .pb2-prose :global(.image-row) {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    margin: 1.5rem 0;
  }

  .pb2-prose :global(.image-row img) {
    height: auto;
    max-width: min(320px, 100%);
  }

  .pb2-prose :global(.image-box-grid) {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2rem 0;
    text-align: center;
  }

  .pb2-prose :global(.image-box-grid figure) {
    margin: 0 0 0.75rem;
  }

  .pb2-prose :global(.image-box-grid img) {
    height: auto;
    margin-inline: auto;
    max-width: 160px;
    width: 100%;
  }

  .pb2-prose :global(.image-box-grid h4) {
    color: #222222;
    font-family: Poppins, sans-serif;
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  /* A dark wood-textured band for grouping a few call-to-action buttons,
     e.g. "Pay Now Directly" / "Care Credit" on the financial page. Same
     recipe as the logo-strip bands: solid brand-brown under the texture,
     blended at low opacity, rather than the raw photo at full brightness. */
  .pb2-prose :global(.wood-band) {
    background-color: #321c0e;
    border-radius: 4px;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin: 2rem 0;
    overflow: hidden;
    padding: 2.5rem 2rem;
    position: relative;
    text-align: center;
  }

  .pb2-prose :global(.wood-band::before) {
    background-color: #321c0e;
    background-image: url("/wp-content/uploads/2021/05/brown-wood-texture-and-backgroun-nw.jpg");
    background-position: top center;
    background-size: cover;
    content: "";
    inset: 0;
    mix-blend-mode: lighten;
    opacity: 0.15;
    position: absolute;
  }

  .pb2-prose :global(.wood-band > *) {
    position: relative;
  }

  .pb2-prose :global(.wood-band h4) {
    color: #fff;
    margin: 0 0 1.25rem;
  }

  .pb2-prose :global(.wood-band .button) {
    margin: 0;
  }

  @media (max-width: 700px) {
    .pb2-prose :global(.media-columns),
    .pb2-prose :global(.image-box-grid) {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .pb2-inner {
      grid-template-columns: 1fr;
    }

    .a-pagebody.reverse .pb2-side {
      order: 0;
    }
  }
</style>
