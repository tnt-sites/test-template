---
/**
 * Service Video — a responsive video embed with a "Video Transcript" toggle
 * that reveals the transcript beneath it. Migrated from the source's
 * `ekwa_service_video` blocks (Vimeo embeds + stored transcript).
 */
const {
  heading = "",
  embedUrl = "",
  videoTitle = "Video",
  transcript = "",
  transcriptButtonText = "Video Transcript",
  id,
  _component,
  ...rest
} = Astro.props;

const hasTranscript = typeof transcript === "string" && transcript.trim().length > 0;
// Give each instance a unique id so multiple videos on one page toggle independently.
const uid = `service-video-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="service-video" id={id || undefined} {...rest}>
  {heading && <h2 class="service-video-heading" set:html={heading} />}

  {
    embedUrl && (
      <div class="service-video-frame">
        <iframe
          src={embedUrl}
          title={videoTitle}
          loading="lazy"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        />
      </div>
    )
  }

  {
    hasTranscript && (
      <div class="service-video-transcript" data-service-video>
        <button
          type="button"
          class="service-video-toggle"
          aria-expanded="false"
          aria-controls={uid}
        >
          <span class="service-video-toggle-label">{transcriptButtonText}</span>
          <svg class="service-video-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="service-video-transcript-body" id={uid} hidden>
          <div class="service-video-transcript-text" set:html={transcript} />
        </div>
      </div>
    )
  }
</section>

<style lang="pcss" is:global>
  @layer page-sections {
    .service-video {
      width: 100%;
      max-width: var(--content-width-lg, 900px);
      margin-inline: auto;
      padding: var(--spacing-lg, 2rem) var(--spacing-md, 1rem);
      box-sizing: border-box;
    }

    .service-video-heading {
      text-align: center;
      color: var(--color-text-strong);
      margin-bottom: var(--spacing-md, 1rem);
    }

    .service-video-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md, 8px);
      overflow: hidden;
      background: #000;
    }

    .service-video-frame iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .service-video-transcript {
      margin-top: var(--spacing-md, 1rem);
      text-align: center;
    }

    .service-video-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      padding: var(--spacing-em-sm, 0.6em) var(--spacing-em-md, 1.2em);
      background-color: var(--color-bg-brand, #177982);
      color: var(--color-text-on-brand, #fff);
      border: 0;
      border-radius: var(--radius-full, 30px);
      font-weight: var(--font-weight-semibold, 600);
      cursor: pointer;
      transition: background-color var(--animation-normal, 0.2s) ease-in-out;
    }

    .service-video-toggle:hover,
    .service-video-toggle:focus-visible {
      background-color: var(--color-bg-brand-muted, #0f666e);
    }

    .service-video-toggle-icon {
      width: 1em;
      height: 1em;
      transition: transform var(--animation-normal, 0.2s) ease-in-out;
    }

    .service-video-toggle[aria-expanded="true"] .service-video-toggle-icon {
      transform: rotate(180deg);
    }

    .service-video-transcript-body {
      margin-top: var(--spacing-sm, 0.75rem);
    }

    .service-video-transcript-text {
      text-align: left;
      color: var(--color-text);
      line-height: 1.7;
    }

    .service-video-transcript-text p {
      margin-block: 0.75em;
    }
  }
</style>

<script>
  function initServiceVideoTranscripts() {
    document.querySelectorAll<HTMLElement>("[data-service-video]").forEach((wrap) => {
      if (wrap.dataset.svReady) return;
      wrap.dataset.svReady = "true";
      const toggle = wrap.querySelector<HTMLButtonElement>(".service-video-toggle");
      const body = wrap.querySelector<HTMLElement>(".service-video-transcript-body");
      if (!toggle || !body) return;
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", open ? "false" : "true");
        body.hidden = open;
      });
    });
  }

  initServiceVideoTranscripts();
  document.addEventListener("astro:page-load", initServiceVideoTranscripts);
</script>
