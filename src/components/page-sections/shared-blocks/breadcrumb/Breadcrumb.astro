---
/**
 * Breadcrumb — auto-populated from the current page's URL.
 *
 * The trail is derived, not authored: the current path is looked up in the main
 * navigation tree (`mainNav.json`) to recover its ancestor chain, so a flat URL
 * like `/dental-bridges/` still reads "Home › Restorative Dentistry › Dental
 * Bridges". Labels prefer the real page title from the `pages` collection, then
 * the nav label, then a humanized slug. Anything not found in the nav falls back
 * to a plain "Home › <Current>" trail, which is what the source site shows.
 *
 * Rendered automatically on interior pages — directly under the page banner when
 * a page has one (see PageBanner), otherwise by the layout above the content.
 * Nothing to place per page.
 */
import { getCollection, type CollectionEntry } from "astro:content";
import mainNavData from "@data/mainNav.json";

const { class: className, id, _component, ...rest } = Astro.props;

function humanize(segment: string): string {
  return segment
    .split("-")
    .map((word) => (word ? word[0].toUpperCase() + word.slice(1) : word))
    .join(" ");
}

function normalizePath(path: string): string {
  if (!path) return "/";
  let p = path.trim();
  if (!p.startsWith("/")) p = `/${p}`;
  if (!p.endsWith("/")) p = `${p}/`;
  return p;
}

// Title lookup from the pages collection, keyed by normalized path.
const pages = await getCollection("pages");
const titleByPath = new Map<string, string>();
for (const page of pages as CollectionEntry<"pages">[]) {
  const slug = page.id.replace(/index$/, "").replace(/\/$/, "");
  const path = slug.length === 0 ? "/" : `/${slug}/`;
  const title = (page.data as any)?.title;
  if (title) titleByPath.set(path, title);
}

// Walk the nav tree to find the ancestor chain leading to `target`.
type NavItem = { name: string; path: string; children?: NavItem[] };
function findTrail(items: NavItem[], target: string, acc: NavItem[] = []): NavItem[] | null {
  for (const item of items) {
    const here = [...acc, item];
    if (normalizePath(item.path) === target) return here;
    if (item.children && item.children.length) {
      const found = findTrail(item.children, target, here);
      if (found) return found;
    }
  }
  return null;
}

function getPathname(): string {
  if (Astro.url?.pathname) return Astro.url.pathname;
  try {
    return new URL(Astro.request.url).pathname;
  } catch {
    return "/";
  }
}

const current = normalizePath(getPathname());
const navTrail = findTrail((mainNavData as any).navData ?? [], current) ?? [];

type Crumb = { label: string; href: string; isLast: boolean };
let crumbs: Crumb[];

if (navTrail.length > 0) {
  crumbs = navTrail.map((item, i) => {
    const href = normalizePath(item.path);
    // Nav labels are the clean, human names ("Restorative Dentistry"); the page
    // title is often an SEO string ("Restorative Dentist Sandy, UT"), so prefer
    // the nav label here and only fall back to the title.
    return {
      label: item.name || titleByPath.get(href) || "",
      href,
      isLast: i === navTrail.length - 1,
    };
  });
} else {
  // Not in the nav — fall back to the plain URL trail.
  const segments = current.split("/").filter(Boolean);
  crumbs = segments.map((segment, i) => {
    const href = `/${segments.slice(0, i + 1).join("/")}/`;
    return {
      label: titleByPath.get(href) || humanize(segment),
      href,
      isLast: i === segments.length - 1,
    };
  });
}
---

<nav class:list={["breadcrumb", className]} id={id || undefined} aria-label="Breadcrumb" {...rest}>
  <ol class="breadcrumb-list">
    <li class="breadcrumb-item">
      <a href="/">Home</a>
    </li>
    {
      crumbs.map((crumb) => (
        <li class="breadcrumb-item">
          <span class="breadcrumb-sep" aria-hidden="true">
            &raquo;
          </span>
          {crumb.isLast ? (
            <span class="breadcrumb-current" aria-current="page">
              {crumb.label}
            </span>
          ) : (
            <a href={crumb.href}>{crumb.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style lang="pcss" is:global>
  @layer page-sections {
    /*
     * Centred trail: green links, blue current page, double-angle separators —
     * the source site's breadcrumb, sitting under the interior page banner.
     */
    .breadcrumb {
      box-sizing: border-box;
      margin-inline: auto;
      max-width: var(--content-width-2xl, 1300px);
      padding: var(--spacing-md, 1rem) var(--spacing-md, 1rem);
      width: 100%;
    }

    .breadcrumb-list {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--font-size-base, 1rem);
      gap: 0.35em;
      justify-content: center;
      line-height: 1.4;
      list-style: none;
      margin: 0;
      padding: 0;
      text-align: center;
    }

    .breadcrumb-item {
      align-items: center;
      display: inline-flex;
      gap: 0.35em;
    }

    .breadcrumb-item a {
      color: var(--color-text-brand-secondary, #417b1e);
      text-decoration: none;
      transition: color var(--animation-normal, 0.2s) ease-in-out;
    }

    .breadcrumb-item a:hover,
    .breadcrumb-item a:focus-visible {
      color: var(--color-brand, #177982);
      text-decoration: underline;
    }

    .breadcrumb-sep {
      color: var(--color-text-brand-secondary, #417b1e);
    }

    .breadcrumb-current {
      color: var(--color-brand, #177982);
      font-weight: var(--font-weight-semibold, 600);
    }
  }
</style>
