---
/**
 * Breadcrumb — auto-generated from the current page's URL path.
 *
 * Baked in: layout, spacing, typography. Props: colours.
 */
import { getCollection, type CollectionEntry } from "astro:content";

const { textColor = "#1b2e38", id, _component, ...rest } = Astro.props;

function humanize(segment: string): string {
  return segment
    .split("-")
    .map((word) => (word ? word[0].toUpperCase() + word.slice(1) : word))
    .join(" ");
}

const pages = await getCollection("pages");
const knownPaths = new Set(
  pages.map((page: CollectionEntry<"pages">) => {
    const slug = page.id.replace(/index$/, "");
    return slug.length === 0 ? "/" : `/${slug.replace(/\/$/, "")}/`;
  })
);

function getPathname(): string {
  if (Astro.url?.pathname) return Astro.url.pathname;
  const requestUrl = Astro.request?.url;
  if (requestUrl) {
    try {
      return new URL(requestUrl).pathname;
    } catch {
      return "";
    }
  }
  return "";
}

const segments = getPathname().split("/").filter(Boolean);

const crumbs = segments.map((segment, index) => {
  const href = `/${segments.slice(0, index + 1).join("/")}/`;
  const isLast = index === segments.length - 1;
  return {
    label: humanize(segment),
    href,
    isLink: !isLast && knownPaths.has(href),
  };
});
---
<div class="home-about-us" id={id || undefined} style={`--tx:${textColor}`} {...rest}>
  <div class="hau-text breadcrumb">
    <span><a title="Go to Home." href="/"><span>Home</span></a></span>
    {
      crumbs.map((crumb) => (
        <>
          {" "}&gt;{" "}
          {crumb.isLink ? (
            <span><a title={`Go to ${crumb.label}.`} href={crumb.href}><span>{crumb.label}</span></a></span>
          ) : (
            <span>{crumb.label}</span>
          )}
        </>
      ))
    }
  </div>
</div>
<style>
  .home-about-us {
    box-sizing: border-box;
    color: #1b2e38;
    font-family: Roboto, sans-serif;
    line-height: 24px;
    padding-left: 15px;
    padding-right: 15px;
    text-align: left;
  }

  .hau-text {
    box-sizing: border-box;
    font-size: 14px;
    line-height: 21px;
    padding-top: 10px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .home-about-us {
      margin-left: auto;
      margin-right: auto;
      max-width: 720px;
    }
  }

  @media (min-width: 1440px) {
    .home-about-us {
      max-width: 1140px;
    }

    .hau-text {
      padding-top: 20px;
      text-align: left;
    }
  }
</style>
