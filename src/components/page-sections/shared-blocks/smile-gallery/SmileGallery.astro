---
/**
 * Smile Gallery — a responsive grid of before/after photos. Each tile links to
 * its full-size image and the grid is marked `data-lightbox`, so the shared
 * <Lightbox /> opens the photo in an overlay on click (and, without JS, the
 * link still opens the image directly).
 */
import Lightbox from "@core-elements/lightbox/Lightbox.astro";

const {
  heading = "",
  subheading = "",
  images = [],
  id,
  _component,
  ...rest
} = Astro.props;

const items = Array.isArray(images) ? images.filter((i: any) => i?.image) : [];
---

<section class="smile-gallery" id={id || undefined} {...rest}>
  {heading && <h1 class="smile-gallery-heading" set:html={heading} />}
  {subheading && <p class="smile-gallery-sub" set:html={subheading} />}

  {
    items.length > 0 && (
      <div class="smile-gallery-grid" data-lightbox>
        {items.map((item: any) => (
          <a
            class="smile-gallery-tile"
            href={item.image}
            data-caption={item.alt || ""}
            aria-label={item.alt || "View smile gallery photo"}
          >
            <img src={item.image} alt={item.alt || ""} loading="lazy" />
          </a>
        ))}
      </div>
    )
  }

  <Lightbox />
</section>

<style lang="pcss" is:global>
  @layer page-sections {
    .smile-gallery {
      width: 100%;
      max-width: var(--content-width-2xl, 1300px);
      margin-inline: auto;
      padding: var(--spacing-lg, 2rem) var(--spacing-md, 1rem);
      box-sizing: border-box;
    }

    .smile-gallery-heading {
      text-align: center;
      color: var(--color-text-strong);
      margin-bottom: var(--spacing-xs, 0.5rem);
    }

    .smile-gallery-sub {
      text-align: center;
      color: var(--color-text-muted);
      margin-bottom: var(--spacing-lg, 2rem);
    }

    .smile-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr));
      gap: var(--spacing-lg, 1.5rem);
    }

    .smile-gallery-tile {
      display: block;
      overflow: hidden;
      border-radius: var(--radius-md, 8px);
      background: var(--color-bg-muted, #f1f5f5);
      box-shadow: 0 2px 10px rgb(0 0 0 / 8%);
      cursor: zoom-in;
      transition: transform var(--animation-normal, 0.2s) ease-in-out,
        box-shadow var(--animation-normal, 0.2s) ease-in-out;
    }

    .smile-gallery-tile:hover,
    .smile-gallery-tile:focus-visible {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgb(0 0 0 / 14%);
    }

    .smile-gallery-tile img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      aspect-ratio: 4 / 3;
    }
  }
</style>
