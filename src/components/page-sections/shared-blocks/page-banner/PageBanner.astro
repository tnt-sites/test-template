<style>
  .cosmetic-dentistry {
    align-items: center;
    background-image: var(--bgimg, none);
    background-position: 50% 50%;
    background-size: cover;
    box-sizing: border-box;
    color: #1b2e38;
    display: flex;
    font-family: Montserrat, sans-serif;
    justify-content: center;
    line-height: 24px;
    min-height: 150px;
    text-align: center;
  }

  .cd-box {
    box-sizing: border-box;
    flex: 0 0 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
  }

  .cd-eyebrow {
    box-sizing: border-box;
    font-family: Roboto, sans-serif;
    font-weight: 300;
    line-height: 19.2px;
    margin-bottom: 0px;
    margin-top: 0px;
