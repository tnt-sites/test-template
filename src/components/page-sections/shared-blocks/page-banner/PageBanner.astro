  headingColor = "#1b2e38",
  id,
  _component,
  ...rest
} = Astro.props;
---
<div class="cosmetic-dentistry" id={id || undefined} style={`--hd:${headingColor}${backgroundImage ? `;--bgimg:url('${backgroundImage}')` : ""}`} {...rest}>
  <div class="cd-box">
    {eyebrow && <h3 class="cd-eyebrow" set:html={eyebrow} />}
