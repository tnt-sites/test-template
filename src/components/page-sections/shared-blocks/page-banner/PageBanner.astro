      margin-left: 24px;
      margin-right: 24px;
      max-width: 93.75%;
    }
  }

  @media (min-width: 1440px) {
    .cosmetic-dentistry {
      text-align: left;
    }

    .cd-box {
      flex: 0 0 80%;
      margin-left: 150px;
      margin-right: 150px;
      max-width: 80%;
    }
  }

/* wpmig:corrections:begin */
  .cd-eyebrow {
    font-size: 16px;
  }
  @media (min-width: 768px) {
    .cd-eyebrow {
      font-size: 16px;
    }
  }
