---
/**
 * One content section for an interior page: a column of typed blocks, in the
 * order the page states them, with an optional media rail beside it — a photo,
 * or the booking `SidebarForm`.
 *
 * This is the single component the migrator's per-section output collapses
 * onto. Every card-grid / media-prose / prose-block variant the WordPress
 * export produced was the same shape — an eyebrow, a run of headings and prose,
 * maybe a list, some buttons, a photo, or a booking form — captured at a
 * different length. Modelling that as a `blocks` array plus a `media` rail lets
 * one component render all of them.
 */
import Image from "@core-elements/image/Image.astro";
import SidebarForm from "@components/page-sections/shared-blocks/sidebar-form/SidebarForm.astro";
import ReviewsWidget from "@components/page-sections/shared-blocks/reviews-widget/ReviewsWidget.astro";
import Icon from "@core-elements/icon/Icon.astro";

const {
  blocks = [],
  media = null,
  align = "",
  backgroundColor = "",
  eyebrowColor = "",
  headingColor = "",
  textColor = "",
  id = "",
  _component,
  ...rest
} = Astro.props;

const styleVars = [
  backgroundColor ? `--cs-bg:${backgroundColor}` : "",
  eyebrowColor ? `--cs-eb:${eyebrowColor}` : "",
  eyebrowColor ? `--cs-icon:${eyebrowColor}` : "",
  headingColor ? `--cs-hd:${headingColor}` : "",
  textColor ? `--cs-tx:${textColor}` : "",
]
  .filter(Boolean)
  .join(";");

const hasMedia = media && (media.source || media.url);

/**
 * The shape every migrated "request an appointment" form used: a two-up run of
 * name / contact fields over a full-width message box. A `form` block that
 * states no fields of its own gets these.
 */
const defaultFormFields = [
  { name: "first_name", label: "First Name", type: "text", width: "half", required: true },
  { name: "last_name", label: "Last Name", type: "text", width: "half", required: true },
  { name: "phone", label: "Phone Number", type: "tel", width: "half", required: true },
  { name: "email", label: "Email Address", type: "email", width: "half", required: true },
  { name: "message", label: "Your Message", type: "textarea", width: "full", required: false },
];
---

<section
  class:list={[
    "content-section",
    {
      "has-media": hasMedia,
      "has-map": media?.type === "map",
      "has-bg": !!backgroundColor,
      "media-left": media?.side === "left",
      "is-centered": align === "center",
    },
  ]}
  id={id || undefined}
  style={styleVars || undefined}
  {...rest}
>
  <div class="cs-inner">
    <div class="cs-main">
      {
        blocks.map((block: any, blockIndex: number) => {
          switch (block?.type) {
            case "eyebrow":
              return (
                <p class="cs-eyebrow">
                  <span class="cs-eyebrow-rule" aria-hidden="true" />
                  <span set:html={block.html ?? block.text ?? ""} />
                </p>
              );
            case "heading":
              return <h2 class="cs-heading" set:html={block.html ?? ""} />;
            case "subheading":
              return <h3 class="cs-subheading" set:html={block.html ?? ""} />;
            case "prose":
            case "list":
              return <div class="cs-prose" set:html={block.html ?? ""} />;
            case "embed":
              return block.url ? (
                <iframe
                  class="cs-embed"
                  src={block.url}
                  title={block.title || "Form"}
                  loading="lazy"
                  allow="geolocation; microphone; camera; fullscreen; payment"
                />
              ) : null;
            case "form": {
              const fields = Array.isArray(block.fields) && block.fields.length
                ? block.fields
                : defaultFormFields;
              return (
                <form class="cs-form" action={block.action || "#"} method={block.method || "post"}>
                  <div class="cs-form-fields">
                    {fields.map((field: any) => {
                      const label = field?.label ?? "";
                      const name = field?.name || label.toLowerCase().replace(/[^a-z0-9]+/g, "_");
                      const isArea = field?.type === "textarea";
                      return (
                        <p
                          class:list={[
                            "cs-field",
                            { "cs-field-full": isArea || field?.width === "full" },
                          ]}
                        >
                          {isArea ? (
                            <textarea
                              name={name}
                              placeholder={label}
                              aria-label={label}
                              required={!!field?.required}
                              rows={4}
                            />
                          ) : (
                            <input
                              type={field?.type || "text"}
                              name={name}
                              placeholder={label}
                              aria-label={label}
                              required={!!field?.required}
                            />
                          )}
                        </p>
                      );
                    })}
                  </div>
                  <div class="cs-form-actions">
                    <button class="cs-form-submit" type="submit">
                      {block.submitText || "Send"}
                    </button>
                  </div>
                  {block.subject && <input type="hidden" name="_subject" value={block.subject} />}
                  {block.redirect && <input type="hidden" name="_redirect" value={block.redirect} />}
                </form>
              );
            }
            case "reviews":
              return <ReviewsWidget widgetId={block.widgetId} />;
            case "image":
              return block.source ? (
                <Image
                  class="cs-image photo-frame"
                  source={block.source}
                  alt={block.alt || ""}
                  data-prop-src={`blocks.${blockIndex}.source`}
                  data-prop-alt={`blocks.${blockIndex}.alt`}
                />
              ) : null;
            case "buttons":
              return Array.isArray(block.buttons) && block.buttons.length ? (
                <div class="cs-buttons">
                  {block.buttons.map((b: any) =>
                    b?.text ? (
                      <a class="cs-button" href={b.link || "#"}>
                        {b.text}
                      </a>
                    ) : null
                  )}
                </div>
              ) : null;
            case "cards":
              return Array.isArray(block.items) && block.items.length ? (
                <div class="cs-cards">
                  {block.items.map((card: any) => (
                    <div class:list={["cs-card", { "has-icon": !!card.icon }]}>
                      {card.icon && (
                        <div class="cs-card-icon" aria-hidden="true">
                          <Icon name={card.icon} size="4xl" />
                        </div>
                      )}
                      {card.title && <h3 class="cs-card-title" set:html={card.title} />}
                      {card.text && <div class="cs-card-text" set:html={card.text} />}
                      {Array.isArray(card.buttons) &&
                        card.buttons.map((b: any) =>
                          b?.text ? (
                            <a class="cs-button" href={b.link || "#"}>
                              {b.text}
                            </a>
                          ) : null
                        )}
                    </div>
                  ))}
                </div>
              ) : null;
            default:
              return null;
          }
        })
      }
    </div>

    {
      hasMedia &&
        (media.type === "map" && media.url ? (
          <div class="cs-map">
            <iframe
              src={media.url}
              title={media.title || "Office location map"}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        ) : media.type === "embed" && media.url ? (
          <SidebarForm
            logo={media.logo}
            logoAlt={media.logoAlt || undefined}
            heading={media.title}
            url={media.url}
            buttonText={media.button?.text}
            buttonLink={media.button?.link}
          />
        ) : media.source ? (
          <div class="cs-media photo-frame" style={`background-image:url("${media.source}")`}>
            <span class="sr-only">{media.alt || ""}</span>
          </div>
        ) : null)
    }
  </div>
</section>

<style lang="pcss" is:global>
  @layer page-sections {
    .content-section {
      --cs-eb: var(--color-brand, #117d6f);
      --cs-hd: var(--color-text-strong, #111);
      --cs-tx: var(--color-text, #333);
      padding-block: var(--spacing-2xl, 4rem);

      &.has-bg {
        background: var(--cs-bg);
      }

      .cs-inner {
        margin-inline: auto;
        max-width: var(--container-max-width, 1200px);
        padding-inline: var(--spacing-lg, 1.5rem);
      }

      &.has-media .cs-inner {
        align-items: stretch;
        display: grid;
        gap: var(--spacing-2xl, 3rem);
        grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      }

      &.media-left .cs-inner {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      }

      &.has-map .cs-inner {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      }

      &.has-map.media-left .cs-inner {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      }

      &.media-left .cs-main {
        order: 2;
      }

      .cs-main {
        align-self: center;
        min-width: 0;
      }

      .cs-eyebrow {
        align-items: center;
        color: var(--cs-eb);
        display: flex;
        font-size: var(--font-size-sm, 0.85rem);
        font-weight: var(--font-weight-semibold, 600);
        gap: 0.75em;
        letter-spacing: 0.12em;
        margin: 0 0 var(--spacing-sm, 0.75rem);
        text-transform: uppercase;
      }

      .cs-eyebrow-rule {
        background: var(--cs-eb);
        display: inline-block;
        height: 2px;
        width: 2.5rem;
      }

      .cs-heading {
        color: var(--cs-hd);
        font-size: var(--font-size-3xl, 2rem);
        line-height: 1.15;
        margin: 0 0 var(--spacing-md, 1rem);
      }

      .cs-subheading {
        color: var(--cs-hd);
        font-size: var(--font-size-xl, 1.35rem);
        line-height: 1.2;
        margin: var(--spacing-lg, 1.5rem) 0 var(--spacing-sm, 0.75rem);
      }

      .cs-prose {
        color: var(--cs-tx);
        line-height: 1.7;
        margin: 0 0 var(--spacing-md, 1rem);

        :where(p) {
          margin: 0 0 var(--spacing-md, 1rem);
        }

        :where(a) {
          color: var(--color-link, #cc3366);
          text-decoration: underline;
        }

        :where(ul, ol) {
          margin: 0 0 var(--spacing-md, 1rem);
          padding-left: 1.25rem;
        }

        :where(li) {
          margin-bottom: 0.35rem;
        }

        :where(strong, b) {
          color: var(--cs-hd);
        }
      }

      /* A third-party form embedded in the content column itself. */
      .cs-embed {
        border: 0;
        display: block;
        margin: var(--spacing-lg, 1.5rem) 0 0;
        min-height: 720px;
        width: 100%;
      }

      .cs-image {
        border-radius: var(--radius-md, 8px);
        display: block;
        height: auto;
        margin: var(--spacing-md, 1rem) 0;
        max-width: 100%;
      }

      .cs-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm, 0.75rem);
        margin: var(--spacing-lg, 1.5rem) 0 0;
      }

      .cs-button {
        background: var(--color-brand, #117d6f);
        border-radius: var(--radius-sm, 4px);
        color: var(--color-text-on-brand, #fff);
        display: inline-block;
        font-weight: var(--font-weight-semibold, 600);
        letter-spacing: 0.04em;
        padding: 0.75em 1.6em;
        text-decoration: none;
        text-transform: uppercase;
        transition: filter 0.2s ease;

        &:hover {
          filter: brightness(1.06);
        }
      }

      /* A section that stands on its own — no media rail — can centre its
         header over the column, the way the appointment forms do. */
      &.is-centered .cs-main {
        text-align: center;
      }

      /* Inline-block so the block centres on the column but the rule below it
         still measures the text rather than the whole width. */
      &.is-centered .cs-eyebrow {
        display: inline-block;
        margin-bottom: var(--spacing-xs, 0.5rem);
        padding-bottom: var(--spacing-xs, 0.5rem);
        position: relative;
      }

      /* Centred, the rule reads better as an underline than a leading dash. */
      &.is-centered .cs-eyebrow-rule {
        bottom: 0;
        left: 0;
        position: absolute;
        width: 100%;
      }

      &.is-centered .cs-heading {
        margin-bottom: var(--spacing-xl, 2rem);
        text-transform: uppercase;
      }

      /* The appointment form: fields on a tinted plate, ruled underneath. */
      .cs-form {
        margin-inline: auto;
        max-width: 46rem;
        text-align: start;
      }

      .cs-form-fields {
        display: grid;
        gap: var(--spacing-md, 1rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .cs-field {
        margin: 0;
        min-width: 0;
      }

      .cs-field-full {
        grid-column: 1 / -1;
      }

      .cs-form :where(input, textarea) {
        background: var(--color-bg-subtle, #f8f8f8);
        border: 0;
        border-bottom: 2px solid var(--cs-eb);
        border-radius: 0;
        color: var(--cs-tx);
        display: block;
        font: inherit;
        padding: 0.9em 1em;
        width: 100%;
      }

      .cs-form :where(textarea) {
        min-height: 8rem;
        resize: vertical;
      }

      .cs-form :where(input, textarea)::placeholder {
        color: var(--color-text-muted, #8a8a8a);
      }

      .cs-form :where(input, textarea):focus {
        box-shadow: 0 2px 0 0 var(--cs-eb);
        outline: none;
      }

      .cs-form-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: var(--spacing-lg, 1.5rem);
      }

      .cs-form-submit {
        background: transparent;
        border: 1px solid var(--color-link, #cc3366);
        color: var(--color-link, #cc3366);
        cursor: pointer;
        font: inherit;
        letter-spacing: 0.12em;
        min-width: 20rem;
        padding: 0.9em 2em;
        text-transform: uppercase;
        transition:
          background 0.2s ease,
          color 0.2s ease;

        &:hover {
          background: var(--color-link, #cc3366);
          color: #fff;
        }
      }

      .cs-cards {
        display: grid;
        gap: var(--spacing-lg, 1.5rem);
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        margin: var(--spacing-lg, 1.5rem) 0;
      }

      .cs-card {
        background: var(--color-bg-subtle, #f6f7f8);
        border-radius: var(--radius-md, 8px);
        padding: var(--spacing-lg, 1.5rem);
      }

      /* An icon card stands on its own plate, centred under its glyph. */
      .cs-card.has-icon {
        background: #fff;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.08);
        display: grid;
        gap: var(--spacing-sm, 0.75rem);
        justify-items: center;
        padding: var(--spacing-xl, 2.25rem) var(--spacing-lg, 1.5rem);
        text-align: center;
      }

      .cs-card-icon {
        color: var(--cs-icon, #117d6f);
        line-height: 0;
      }

      .cs-card-icon :where(svg) {
        height: 3.5rem;
        stroke-width: 1.6;
        width: 3.5rem;
      }

      .cs-card.has-icon .cs-card-title {
        font-size: var(--font-size-lg, 1.15rem);
        letter-spacing: 0.04em;
        margin: 0;
        text-transform: uppercase;
      }

      .cs-card.has-icon .cs-card-text {
        margin: 0;
      }

      /* The map rides in the media rail opposite the form. */
      .cs-map {
        /* Sits at the top of the rail rather than stretching beside a tall
           form, and follows the reader down as they fill the form in. */
        align-self: start;
        border-radius: var(--radius-md, 8px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
        min-width: 0;
        overflow: hidden;
        position: sticky;
        top: var(--spacing-lg, 1.5rem);
      }

      .cs-map iframe {
        border: 0;
        display: block;
        height: 100%;
        min-height: 620px;
        width: 100%;
      }

      .cs-card-title {
        color: var(--cs-hd);
        font-size: var(--font-size-lg, 1.2rem);
        margin: 0 0 var(--spacing-sm, 0.5rem);
      }

      .cs-card-text {
        color: var(--cs-tx);
        line-height: 1.6;
      }

      /* A photo the source baked into the section, shown as a filled rail. */
      .cs-media {
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        border-radius: var(--radius-md, 8px);
        min-height: 320px;
        min-width: 0;
      }

      .sr-only {
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
      }

      @media (max-width: 900px) {
        &.has-media .cs-inner,
        &.media-left .cs-inner {
          grid-template-columns: 1fr;
        }
        &.media-left .cs-main {
          order: 0;
        }
        .cs-media {
          min-height: 220px;
        }
      }

      @media (max-width: 640px) {
        .cs-form-fields {
          grid-template-columns: 1fr;
        }
        .cs-form-actions {
          justify-content: stretch;
        }
        .cs-form-submit {
          min-width: 0;
          width: 100%;
        }
      }
    }
  }
</style>
