---
/**
 * ContentSection — the one interior-page content band.
 *
 * The migrator emits one component per section it detects, so the same
 * WordPress layout captured with three headings and captured with twenty
 * becomes two components that no fixed prop list can ever unify. That is how
 * this site ended up with `media-prose-b` through `-i`, `card-grid-home-botox`
 * through `-teeth`, and `prose-block-home-cerec` through `-success`: forty
 * files for one design at forty lengths.
 *
 * The length is the variable, so the content is an ordered `blocks` array and
 * the design lives here once. What genuinely differs between instances — the
 * side the photo sits on, the alignment, the band's colours — are inputs.
 *
 * Layout follows the source's `.page-section` / `.top-page-section`: the photo
 * is a floated figure the prose wraps around, not a rigid column, which is why
 * a section with two paragraphs and one with ten both look right.
 */
import Button from "@core-elements/button/Button.astro";
import ContentBlock from "./ContentBlock.astro";

const {
  blocks = [],
  media = null,
  align = "left",
  backgroundColor = "",
  headingColor = "",
  subheadingColor = "",
  textColor = "",
  eyebrowColor = "",
  id,
  _component,
  ...rest
} = Astro.props;

const list = Array.isArray(blocks) ? blocks.filter(Boolean) : [];
// A `more` block folds everything after it into a collapsed "View More" group,
// the source's `.view-more-button` / `.dropdown-container` pattern.
const moreAt = list.findIndex((block: any) => block.type === "more");
const segments =
  moreAt < 0
    ? [{ more: false, label: "", blocks: list }]
    : [
        { more: false, label: "", blocks: list.slice(0, moreAt) },
        { more: true, label: list[moreAt].label || "View More", blocks: list.slice(moreAt + 1) },
      ];
const mediaSide = media?.side === "left" ? "left" : "right";
const style = [
  backgroundColor && `--cs-bg:${backgroundColor}`,
  headingColor && `--cs-hd:${headingColor}`,
  subheadingColor && `--cs-sub:${subheadingColor}`,
  textColor && `--cs-tx:${textColor}`,
  eyebrowColor && `--cs-eyebrow:${eyebrowColor}`,
]
  .filter(Boolean)
  .join(";");
---

<section
  class="content-section"
  id={id || undefined}
  data-align={align === "center" ? "center" : "left"}
  data-banded={backgroundColor ? "true" : undefined}
  style={style || undefined}
  {...rest}
>
  <div class="cs-inner">
    {
      media?.type === "image" && media.source && (
        <figure class="cs-media" data-side={mediaSide}>
          <img src={media.source} alt={media.alt || ""} loading="lazy" />
        </figure>
      )
    }
    {
      media?.type === "embed" && media.url && (
        <div class="cs-embed" data-side={mediaSide}>
          {media.title && <h3 class="cs-embed-title">{media.title}</h3>}
          <iframe src={media.url} title={media.title || "Embedded form"} loading="lazy" />
          {media.button?.text && (
            <Button
              variant="secondary"
              size="md"
              width="none"
              borderRadius="none"
              uppercase
              class="cs-btn"
              text={media.button.text}
              link={media.button.link || "#"}
              editable={false}
            />
          )}
        </div>
      )
    }

    {
      segments.map((segment) =>
        segment.more ? (
          <details class="cs-more">
            <summary class="cs-more-toggle">
              <span class="cs-more-open">{segment.label}</span>
              <span class="cs-more-close">View Less</span>
            </summary>
            <div class="cs-more-body">
              {segment.blocks.map((block: any) => <ContentBlock block={block} />)}
            </div>
          </details>
        ) : (
          segment.blocks.map((block: any) => <ContentBlock block={block} />)
        )
      )
    }
  </div>
</section>

<style lang="pcss" is:global>
  @layer page-sections {
    .content-section {
      --cs-navy: #30475e;
      --cs-teal: #177982;
      --cs-lime: #a6ce39;

      background: var(--cs-bg, transparent);
      box-sizing: border-box;
      width: 100%;
    }

    .content-section .cs-inner {
      box-sizing: border-box;
      margin-inline: auto;
      max-width: 1300px;
      padding: 0 15px 75px;
      width: 100%;
    }

    /* The float has to be contained or the next section rides up beside it. */
    .content-section .cs-inner::after {
      clear: both;
      content: "";
      display: table;
    }

    .content-section[data-align="center"] .cs-inner {
      text-align: center;
    }

    .content-section[data-banded="true"] .cs-inner {
      padding-block: 45px;
    }

    .content-section + .content-section .cs-inner {
      padding-top: 0;
    }

    /* ---- Media: a floated figure the prose wraps, as the source has it ---- */
    /* Unfloated (phones), a photo sits centred on its own line. */
    .content-section .cs-media {
      margin: 0 auto 15px;
      max-width: max-content;
    }

    .content-section .cs-media img {
      display: block;
      height: auto;
      max-width: 500px;
      width: 100%;
    }

    @media (min-width: 768px) {
      .content-section .cs-media[data-side="left"] {
        float: left;
        margin: 0 30px 15px 0;
      }

      .content-section .cs-media[data-side="right"] {
        float: right;
        margin: 0 0 15px 30px;
      }
    }

    /* A portrait that heads its section — the doctors' intro photos. */
    .content-section .cs-media[data-side="center"] {
      clear: both;
      float: none;
      margin: 0 auto 30px;
    }

    .content-section .cs-embed {
      margin-bottom: 30px;
    }

    .content-section .cs-embed iframe {
      border: 0;
      display: block;
      min-height: 520px;
      width: 100%;
    }

    @media (min-width: 992px) {
      .content-section .cs-embed {
        float: right;
        margin: 0 0 30px 30px;
        max-width: 420px;
      }
    }

    /* ---- Typography: the source's `.inner-page` scale ---- */
    .content-section .cs-title {
      clear: both;
      color: var(--cs-hd, var(--cs-navy));
      font-size: 36px;
      font-weight: 700;
      line-height: 1.4;
      margin-block: 0 36px;
      text-align: center;
      text-transform: uppercase;
    }

    /* One converted section can hold several of the source's, so a heading
       starts a fresh band rather than running alongside the previous float. */
    .content-section .cs-heading {
      clear: both;
      color: var(--cs-hd, var(--cs-teal));
      font-size: 24px;
      font-weight: 400;
      line-height: 1.4;
      margin-block: 30px;
      position: relative;
      text-transform: capitalize;
    }

    /* The 1px rule the source draws under every interior heading. It sits
       directly under the words — clearing it here pushed it past the figure
       and took the copy that should wrap beside the photo down with it. */
    .content-section .cs-heading::after {
      background-color: var(--cs-hd, var(--cs-teal));
      content: "";
      display: block;
      height: 1px;
      margin: 15px auto;
      width: 100%;
    }

    /* Each subheading opens its own photo + copy group. Without the clear, a
       short paragraph leaves its float hanging and the next group's photo
       stair-steps in beside it (Invisalign, Dental Implants). */
    .content-section .cs-subheading {
      clear: both;
      color: var(--cs-sub, var(--cs-navy));
      font-size: 20px;
      font-weight: 700;
      line-height: 1.4;
      margin-block: 20px 10px;
    }

    .content-section .cs-eyebrow {
      color: var(--cs-eyebrow, var(--cs-teal));
      margin-block: 0 15px;
    }

    .content-section .cs-prose,
    .content-section .cs-prose :where(p, li) {
      color: var(--cs-tx, inherit);
      line-height: 30px;
    }

    .content-section .cs-prose :where(p) {
      margin-block: 0 20px;
    }

    .content-section .cs-prose :where(p):last-child {
      margin-bottom: 0;
    }

    /* Teal, not the source's lime: lime on white is ~1.9:1 and fails WCAG AA.
       Underlined so a link does not rely on colour alone. */
    .content-section .cs-prose :where(a) {
      color: var(--cs-teal);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .content-section .cs-prose :where(a):hover {
      color: #0f666e;
      text-decoration-thickness: 2px;
    }

    .content-section .cs-prose :where(ul, ol) {
      text-align: left;
    }

    /* A long single-topic list — the insurance carriers — reads as a lookup
       table, not as prose, so it splits into columns rather than running the
       reader down one 30-item rail. Multi-column keeps it one list to anything
       walking the document; only the painting changes. */
    @media (min-width: 600px) {
      .content-section .cs-prose[data-columns="2"] :where(ul, ol) {
        column-gap: 40px;
        columns: 2;
      }
    }

    .content-section .cs-prose[data-columns="2"] :where(li) {
      break-inside: avoid;
    }

    /* The separator the source draws between one carrier's list and the next. */
    .content-section .cs-rule {
      background-color: color-mix(in srgb, var(--cs-navy) 20%, transparent);
      border: 0;
      clear: both;
      height: 1px;
      margin-block: 30px;
      width: 100%;
    }

    .content-section .cs-logos {
      align-items: center;
      clear: both;
      display: flex;
      flex-wrap: wrap;
      gap: 20px 30px;
      justify-content: center;
      list-style: none;
      margin: 20px 0 0;
      padding: 0;
    }

    .content-section .cs-logos li {
      margin: 0;
      padding: 0;
    }

    .content-section .cs-logos li::before {
      content: none;
    }

    .content-section .cs-logos img {
      display: block;
      height: auto;
      max-height: 60px;
      max-width: 140px;
      width: auto;
    }

    /* ---- "View More" group: the source's green toggle over a collapsed run
       of subsections. Native <details>, so it works without script and the
       copy stays in the document. ---- */
    /* Not cleared: like the source, the toggle sits right under the intro
       copy, beside the section photo; the subsections inside clear it. */
    .content-section .cs-more {
      clear: none;
    }

    .content-section .cs-more-toggle {
      background: var(--cs-lime);
      border: 2px solid var(--cs-lime);
      color: #111;
      cursor: pointer;
      display: inline-block;
      font-weight: 700;
      list-style: none;
      margin: 15px 0;
      padding: 8px 22px;
      text-transform: uppercase;
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .content-section .cs-more-toggle::-webkit-details-marker {
      display: none;
    }

    .content-section .cs-more-toggle:hover,
    .content-section .cs-more-toggle:focus-visible {
      background: #fff;
      border-color: var(--cs-teal);
      color: var(--cs-teal);
    }

    .content-section .cs-more-toggle:focus-visible {
      outline: 2px solid var(--cs-teal);
      outline-offset: 2px;
    }

    .content-section .cs-more-close,
    .content-section .cs-more[open] .cs-more-open {
      display: none;
    }

    .content-section .cs-more[open] .cs-more-close {
      display: inline;
    }

    .content-section .cs-more-body::after {
      clear: both;
      content: "";
      display: table;
    }

    /* ---- FAQ accordion ---- */
    .content-section .cs-faqs {
      border-top: 1px solid color-mix(in srgb, var(--cs-navy) 20%, transparent);
      clear: both;
      text-align: left;
    }

    .content-section .cs-faq {
      border-bottom: 1px solid color-mix(in srgb, var(--cs-navy) 20%, transparent);
    }

    .content-section .cs-faq-q {
      align-items: center;
      color: var(--cs-sub, var(--cs-navy));
      cursor: pointer;
      display: flex;
      font-size: 20px;
      font-weight: 700;
      gap: 15px;
      justify-content: space-between;
      line-height: 1.4;
      list-style: none;
      padding: 18px 5px;
    }

    .content-section .cs-faq-q::-webkit-details-marker {
      display: none;
    }

    /* Plus that turns into a minus when open. */
    .content-section .cs-faq-q::after {
      color: var(--cs-teal);
      content: "+";
      flex: none;
      font-size: 28px;
      font-weight: 400;
      line-height: 1;
    }

    .content-section .cs-faq[open] > .cs-faq-q::after {
      content: "\2212";
    }

    .content-section .cs-faq-q:hover,
    .content-section .cs-faq-q:focus-visible {
      color: var(--cs-teal);
    }

    .content-section .cs-faq-a {
      margin: 0;
      padding: 0 5px 20px;
    }

    .content-section .cs-buttons {
      clear: both;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-block: 20px 0;
      padding-top: 10px;
    }

    .content-section[data-align="center"] .cs-buttons {
      justify-content: center;
    }

    .content-section .cs-btn.button {
      background-color: var(--cs-lime);
      border-color: transparent;
      color: #111;
      font-weight: 700;
    }

    .content-section .cs-btn.button:hover {
      background-color: #93b830;
      color: #111;
    }
  }
</style>
