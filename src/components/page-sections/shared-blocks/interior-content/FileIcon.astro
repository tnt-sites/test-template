---
/**
 * The small red glyph leading each row of an `interior-content` `files` block.
 *
 * The source pages drew these with Font Awesome (`fa-external-link-alt`,
 * `fa-file-pdf`, `fa-file-word`). Inlining the three shapes keeps the icon
 * font — the only thing on these pages that needed it — off the page.
 *
 * `kind`: link | pdf | word. Anything else falls back to `link`.
 */
const { kind = "link" } = Astro.props;

const shape = kind === "pdf" || kind === "word" ? kind : "link";
const label = shape === "pdf" ? "PDF" : "W";
---

<svg class="ic-file-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
  {
    shape === "link" ? (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8.5 2.5H2.5v11h11v-6" />
        <path d="M10 1.5h4.5V6" />
        <path d="M14.5 1.5L7.5 8.5" />
      </g>
    ) : (
      <g>
        <path
          d="M3 0.75h6l4 4v10.5H3z"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="1"
          stroke-linejoin="round"
        />
        <path d="M9 0.75V4.75h4" fill="#ffffff" opacity="0.35" />
        <text
          x="8"
          y="13"
          fill="#ffffff"
          font-family="Helvetica, Arial, sans-serif"
          font-size={shape === "pdf" ? "5" : "6.5"}
          font-weight="700"
          text-anchor="middle"
        >
          {label}
        </text>
      </g>
    )
  }
</svg>
