---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  maxContentWidth,
  paddingHorizontal,
  buttonSections = [],
  colorScheme = "inherit",
  backgroundColor,
  backgroundGradient = "",
  backgroundImage,
  paddingVertical = "4xl",
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["more-to-explore", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  <Heading
    class="more-to-explore__heading"
    level="h6"
    alignX="center"
    text={heading}
    data-prop="heading"
  />
  <ButtonGroup class="buttons" buttonSections={buttonSections} alignX="center" />
</CustomSection>

<style is:global>
  /* Ported from the source's `_above-the-fold.css` / `styles.css`.
     Selectors are scoped under `.more-to-explore` so they clear the template's
     own `.heading` rules in `@layer components`, which `source-bridge`
     outranks, and any unlayered Tailwind utility of the same shape, which no
     layer can outrank — only specificity. */
  @layer source-bridge {
    /* Source: `.more-to-explore { padding: 40px 10px 40px }`. `CustomSection`
       puts its padding on the inner `.content` wrapper via a `pad-y-*` token,
       and the nearest token is roughly double the source's 40px — the section
       measured 86px taller than the source with the content itself matching to
       the pixel. Pinned to the source's own value instead. */
    .more-to-explore .content {
      padding: 40px 10px;
    }

    /* Source: `h2, .h2, .dividerLead, .more-to-explore span`. The heading here
       is one member of that shared display group, so it carries the group's
       full rule — 46px spirits-soft, uppercase — not the template's heading
       ramp. It is deliberately NOT highlighted: the source paints the whole
       phrase #292929, with no accent on any word, so the heading takes no
       `.color`/`.heading-color` span. Re-adding one is the recurring mistake. */
    .more-to-explore .more-to-explore__heading {
      color: #292929;
      font: 400 46px/1.2 spirits-soft, serif;

      /* The source's heading is an inline `<span>` whose only vertical space
         is the section's own `padding: 40px 10px`. The template gives every
         `.heading` a `margin-top: var(--spacing-lg)` the source has no
         equivalent for. */
      margin: 0;
      position: relative;
      text-transform: uppercase;
    }

    /* Source never shrinks this heading: the 650px rule that drops `h2, .h2`
       to 36px lists neither `.more-to-explore span` nor `.dividerLead`. */
  }

  @layer components {
    .more-to-explore .buttons,
    .more-to-explore .buttons > editable-array {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      justify-content: center;
    }

    .more-to-explore .buttons .button {
      flex: 0 0 350px;
      min-width: 350px;
      width: 350px;
    }

    @media (max-width: 768px) {
      .more-to-explore .buttons,
      .more-to-explore .buttons > editable-array {
        flex-direction: column;
      }

      .more-to-explore .buttons > editable-array-item,
      .more-to-explore .buttons > editable-array > editable-array-item {
        width: 100%;
      }

      .more-to-explore .buttons .button {
        flex-basis: 100%;
        min-width: auto;
        width: 100%;
      }
    }
  }
</style>
