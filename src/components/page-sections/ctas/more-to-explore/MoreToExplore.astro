---
import Heading from "@core-elements/heading/Heading.astro";
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  buttonSections = [],
  background = "cream",
  class: className,
  editable = true,
  _component,
  // Older settings, no longer used.
  backgroundGradient,
  backgroundImage,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical,
  colorScheme,
  backgroundColor,
  ...htmlAttributes
} = Astro.props;
---

<section
  class:list={["more-to-explore", sectionBackground(background), className]}
  {...htmlAttributes}
>
  <Heading level="h2" size="3xl" alignX="center" text={heading} data-prop="heading" />
  <ButtonGroup buttonSections={buttonSections} alignX="center" />
</section>

<style>
  .more-to-explore {
    padding: 65px 25px;
  }

  .more-to-explore :global(.heading) {
    line-height: 1;
    margin: 0;
  }

  /* Buttons stack full width on phones and wrap three to a row on desktop. */
  .more-to-explore :global(.button-group) {
    margin: 30px auto 0;
    max-width: 1230px;
  }

  .more-to-explore :global(.button-group editable-array) {
    display: block;
    width: 100%;
  }

  .more-to-explore :global(.button-group editable-array-item) {
    display: block;
    margin-bottom: 10px;
  }

  .more-to-explore :global(.button) {
    font-size: 17px;
    letter-spacing: 0.08em;
    min-height: 50px;
    padding: 0 25px;
    text-transform: uppercase;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .more-to-explore {
      padding: 80px 25px;
    }

    .more-to-explore :global(.button-group) {
      margin-top: 50px;
    }

    .more-to-explore :global(.button-group editable-array) {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .more-to-explore :global(.button-group editable-array-item) {
      margin: 0;
    }

    .more-to-explore :global(.button) {
      min-width: 355px;
      white-space: nowrap;
      width: auto;
    }
  }
</style>
