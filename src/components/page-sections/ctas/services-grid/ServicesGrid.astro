---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import ServicesGridItem from "./ServicesGridItem.astro";

type ServiceLink = {
  _component?: string;
  label?: string;
  text?: string;
  href?: string;
};

type ServiceItem = {
  _component?: string;
  imageSource?: string;
  imageAlt?: string;
  title?: string;
  href?: string;
  wide?: boolean | string;
  links?: ServiceLink[];
};

type ServicesGridCta = {
  enabled?: boolean | string;
  id?: string;
  href?: string;
  heading?: string;
  buttonText?: string;
  wide?: boolean | string;
};

const {
  heading = "",
  lead = "",
  subtext = "",
  services = [],
  ctaCard,
  backgroundColor = "base",
  backgroundGradient = "",
  id = "",
  backgroundImage,
  class: className,
  editable = true,
  _component,
  ...rest
} = Astro.props;

const isTrue = (value: unknown) =>
  typeof value === "string" ? value.trim().toLowerCase() === "true" : !!value;

const cleanText = (value: unknown, fallback = "") =>
  typeof value === "string" && value.trim().length > 0 ? value.trim() : fallback;

const stripP = (value: string) =>
  value
    .trim()
    .replace(/<\/p>\s*<p(?:\s[^>]*)?>/gi, "<br>")
    .replace(/^<p(?:\s[^>]*)?>/i, "")
    .replace(/<\/p>\s*$/i, "");

const normalizeLabel = (link: ServiceLink) => cleanText(link.label, cleanText(link.text));

const normalizeLinks = (links: unknown) =>
  Array.isArray(links)
    ? links
        .filter((link): link is ServiceLink => !!link && typeof link === "object")
        .map((link) => ({
          label: normalizeLabel(link),
          href: cleanText(link.href, "#"),
        }))
        .filter((link) => link.label.length > 0)
    : [];

const normalizedServices = Array.isArray(services)
  ? services
      .filter((service): service is ServiceItem => !!service && typeof service === "object")
      .map((service) => ({
        title:
          typeof service.title === "string" && service.title.trim().length > 0
            ? stripP(service.title)
            : "Service",
        href: cleanText(service.href, "#"),
        imageSource: cleanText(service.imageSource),
        imageAlt: cleanText(service.imageAlt),
        wide: isTrue(service.wide),
        links: normalizeLinks(service.links),
      }))
  : [];

const rawCtaCard = !!ctaCard && typeof ctaCard === "object" ? (ctaCard as ServicesGridCta) : {};
const normalizedCtaCard = {
  enabled: rawCtaCard.enabled === undefined ? false : isTrue(rawCtaCard.enabled),
  id: cleanText(rawCtaCard.id, "all").replace(/^#/, "") || "all",
  href: cleanText(rawCtaCard.href, "request-an-appointment.html"),
  heading:
    typeof rawCtaCard.heading === "string" && rawCtaCard.heading.trim().length > 0
      ? stripP(rawCtaCard.heading)
      : "Get Started Now",
  buttonText: cleanText(rawCtaCard.buttonText, "Request an Appointment"),
  wide: rawCtaCard.wide === undefined ? true : isTrue(rawCtaCard.wide),
};

const hasServices = normalizedServices.length > 0;
const hasHeading = typeof heading === "string" && heading.trim().length > 0;
const hasCtaCard = normalizedCtaCard.enabled;

const servicesArrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-component-key": "_component",
      "data-id-key": "_component",
      "data-prop": "services",
    }
  : {};

if (!_component && !hasHeading && !hasServices && !hasCtaCard) {
  return;
}

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["services-grid", className]}
  id={id || undefined}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {
    hasHeading && (
      <div class="services-grid-header">
        <h2 class="services-grid-heading" data-prop="heading">
          {heading}
        </h2>
        <div class="services-grid-divider" aria-hidden="true" />
        {lead && (
          <p class="services-grid-lead" data-prop="lead">
            {lead}
          </p>
        )}
        {subtext && (
          <p class="services-grid-subtext" data-prop="subtext">
            {subtext}
          </p>
        )}
      </div>
    )
  }

  {
    (hasServices || hasCtaCard) && (
      <div class="services-grid-items" {...servicesArrayDataAttributes}>
        {normalizedServices.map((service) => (
          <editable-array-item
            data-component="page-sections/ctas/services-grid/services-grid-item"
            class:list={["services-grid-item", service.wide && "is-wide"]}
          >
            <ServicesGridItem {...service} editable={editable} />
          </editable-array-item>
        ))}

        {hasCtaCard && (
          <div
            id={normalizedCtaCard.id}
            class:list={[
              "services-grid-item",
              "services-grid-cta",
              normalizedCtaCard.wide && "is-wide",
            ]}
          >
            <a href={normalizedCtaCard.href}>
              <div class="services-grid-cta-heading h2">
                <Fragment set:html={normalizedCtaCard.heading} />
              </div>
              <div class="services-grid-cta-button btn btn-white">
                {normalizedCtaCard.buttonText}
              </div>
            </a>
          </div>
        )}
      </div>
    )
  }
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .services-grid {
      position: relative;
    }

    .services-grid .services-grid-header {
      margin: 0 auto;
      max-width: 1224px;
      text-align: center;
    }

    /* The source sets this heading at 60px/66 — larger than the global h2 — and
       centres a dotted rule beneath it. */
    .services-grid .services-grid-heading {
      font-family: var(--font-headings);
      font-size: clamp(2.25rem, 4.2vw, 3.75rem);
      font-weight: 400;
      line-height: 1.1;
      margin: 0;
      text-transform: none;
    }

    .services-grid .services-grid-divider {
      border-top: 5px dotted currentcolor;
      height: 5px;
      margin: 12px auto;
      width: 65px;
    }

    .services-grid .services-grid-lead {
      font-weight: 700;
      margin: 24px 0 0;
    }

    .services-grid .services-grid-subtext {
      margin: 12px 0 0;
    }

    /* Three tiles per row with no gutters, matching the source's 408x150 cells. */
    .services-grid .services-grid-items {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      margin: 40px auto 0;
      max-width: 1224px;
    }

    .services-grid .services-grid-items > editable-array-item,
    .services-grid .services-grid-items > .services-grid-item {
      display: block;
      min-width: 0;
      overflow: hidden;
      position: relative;
    }

    .services-grid .services-grid-link {
      display: block;
      text-decoration: none;
    }

    .services-grid .services-grid-figure {
      background-color: #313131;
      margin: 0;
      position: relative;
    }

    .services-grid .services-grid-figure .image {
      margin: 0;
    }

    .services-grid .services-grid-figure img {
      display: block;
      height: 150px;
      object-fit: cover;
      opacity: 0.55;
      transition: opacity 0.35s ease, transform 0.35s ease;
      width: 100%;
    }

    .services-grid .services-grid-link:hover img,
    .services-grid .services-grid-link:focus-visible img {
      opacity: 0.35;
      transform: scale(1.04);
    }

    .services-grid .services-grid-caption {
      align-items: center;
      display: flex;
      inset: 0;
      justify-content: center;
      padding: 20px;
      position: absolute;
      text-align: center;
    }

    /* Light first word, heavy second — the source splits it on a <span>. */
    .services-grid .services-grid-title {
      color: #fff;
      font-family: var(--font-headings);
      font-size: clamp(1.5rem, 2.6vw, 2.34375rem);
      font-weight: 300;
      line-height: 1.1;
      margin: 0;
      text-transform: none;
    }

    .services-grid .services-grid-title span {
      font-weight: 800;
    }

    .services-grid .services-grid-links {
      display: table;
      margin: 20px auto;
    }

    .services-grid .services-grid-links editable-array-item {
      display: list-item;
      line-height: 1.2;
      margin: 10px auto;
    }

    .services-grid .services-grid-links a {
      color: var(--color-text);
      text-decoration: none;
    }

    .services-grid .services-grid-links editable-array-item:hover a,
    .services-grid .services-grid-links editable-array-item:focus-within a {
      color: var(--color-brand-muted);
    }

    .services-grid .services-grid-cta,
    .services-grid #all {
      align-items: center;
      background-color: var(--color-brand);
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 150px;
      text-align: center;
    }

    .services-grid .services-grid-cta a {
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      justify-content: center;
      min-height: 100%;
      padding: 1.25rem;
      text-decoration: none;
      width: 100%;
    }

    .services-grid .services-grid-cta-heading {
      color: #fff;
      font-family: var(--font-headings);
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 700;
      line-height: 1.05;
    }

    .services-grid .services-grid-cta-button {
      background-color: #fff;
      color: var(--color-brand);
      display: inline-block;
      font-size: var(--font-size-body-sm);
      font-weight: 600;
      padding: 0.65rem 1.1rem;
    }

    @media (max-width: 900px) {
      .services-grid .services-grid-items {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .services-grid .services-grid-items {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
