---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import ServicesGridItem from "./ServicesGridItem.astro";

type ServiceLink = {
  _component?: string;
  label?: string;
  text?: string;
  href?: string;
};

type ServiceItem = {
  _component?: string;
  imageSource?: string;
  imageAlt?: string;
  title?: string;
  href?: string;
  wide?: boolean | string;
  links?: ServiceLink[];
};

type ServicesGridCta = {
  enabled?: boolean | string;
  id?: string;
  href?: string;
  heading?: string;
  buttonText?: string;
  wide?: boolean | string;
};

const {
  heading = "",
  services = [],
  ctaCard,
  backgroundColor = "base",
  backgroundGradient = "",
  id = "",
  backgroundImage,
  class: className,
  editable = true,
  _component,
  ...rest
} = Astro.props;

const isTrue = (value: unknown) =>
  typeof value === "string" ? value.trim().toLowerCase() === "true" : !!value;

const cleanText = (value: unknown, fallback = "") =>
  typeof value === "string" && value.trim().length > 0 ? value.trim() : fallback;

const stripP = (value: string) =>
  value
    .trim()
    .replace(/<\/p>\s*<p(?:\s[^>]*)?>/gi, "<br>")
    .replace(/^<p(?:\s[^>]*)?>/i, "")
    .replace(/<\/p>\s*$/i, "");

const normalizeLabel = (link: ServiceLink) => cleanText(link.label, cleanText(link.text));

const normalizeLinks = (links: unknown) =>
  Array.isArray(links)
    ? links
        .filter((link): link is ServiceLink => !!link && typeof link === "object")
        .map((link) => ({
          label: normalizeLabel(link),
          href: cleanText(link.href, "#"),
        }))
        .filter((link) => link.label.length > 0)
    : [];

const normalizedServices = Array.isArray(services)
  ? services
      .filter((service): service is ServiceItem => !!service && typeof service === "object")
      .map((service) => ({
        title:
          typeof service.title === "string" && service.title.trim().length > 0
            ? stripP(service.title)
            : "Service",
        href: cleanText(service.href, "#"),
        imageSource: cleanText(service.imageSource),
        imageAlt: cleanText(service.imageAlt),
        wide: isTrue(service.wide),
        links: normalizeLinks(service.links),
      }))
  : [];

const rawCtaCard = !!ctaCard && typeof ctaCard === "object" ? (ctaCard as ServicesGridCta) : {};
const normalizedCtaCard = {
  enabled: rawCtaCard.enabled === undefined ? false : isTrue(rawCtaCard.enabled),
  id: cleanText(rawCtaCard.id, "all").replace(/^#/, "") || "all",
  href: cleanText(rawCtaCard.href, "request-an-appointment.html"),
  heading:
    typeof rawCtaCard.heading === "string" && rawCtaCard.heading.trim().length > 0
      ? stripP(rawCtaCard.heading)
      : "Get Started Now",
  buttonText: cleanText(rawCtaCard.buttonText, "Request an Appointment"),
  wide: rawCtaCard.wide === undefined ? true : isTrue(rawCtaCard.wide),
};

const hasServices = normalizedServices.length > 0;
const hasHeading = typeof heading === "string" && heading.trim().length > 0;
const hasCtaCard = normalizedCtaCard.enabled;

const servicesArrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-component-key": "_component",
      "data-id-key": "_component",
      "data-prop": "services",
    }
  : {};

if (!_component && !hasHeading && !hasServices && !hasCtaCard) {
  return;
}

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["services-grid", className]}
  id={id || undefined}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {
    (hasServices || hasCtaCard) && (
      <div class="services-grid-items" {...servicesArrayDataAttributes}>
        {normalizedServices.map((service) => (
          <editable-array-item
            data-component="page-sections/ctas/services-grid/services-grid-item"
            class:list={["services-grid-item", service.wide && "is-wide"]}
          >
            <ServicesGridItem {...service} editable={editable} />
          </editable-array-item>
        ))}

        {hasCtaCard && (
          <div
            id={normalizedCtaCard.id}
            class:list={[
              "services-grid-item",
              "services-grid-cta",
              normalizedCtaCard.wide && "is-wide",
            ]}
          >
            <a href={normalizedCtaCard.href}>
              <div class="services-grid-cta-heading h2">
                <Fragment set:html={normalizedCtaCard.heading} />
              </div>
              <div class="services-grid-cta-button btn btn-white">
                {normalizedCtaCard.buttonText}
              </div>
            </a>
          </div>
        )}
      </div>
    )
  }
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .services-grid {
      position: relative;

      .services-grid-heading {
        margin-top: 0;
      }

      .services-grid-items {
        align-items: stretch;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0;
        margin: 40px auto 0;
      }

      /* Source renders these as a hairline table: every cell shares its
         left/bottom border with its neighbours, and only the outer edge of
         the grid (top row, right column) adds the matching extra side. The
         column count changes per breakpoint below, so which cell counts as
         "top row" / "right column" changes with it. */
      .services-grid-items > editable-array-item,
      .services-grid-items > .services-grid-item:not(.services-grid-cta) {
        background-color: transparent;
        border-bottom: 1px solid #000;
        border-left: 1px solid #000;
        box-shadow: none;
        display: flex;
        flex: 0 1 380px;
        flex-direction: column;
        overflow: hidden;
      }

      .services-grid-items > editable-array-item.is-wide,
      .services-grid-items > .services-grid-item.is-wide {
        flex: 1 1 min(100%, 820px);
      }

      @media (min-width: 1081px) {
        .services-grid-items > editable-array-item:nth-of-type(-n + 3) {
          border-top: 1px solid #000;
        }

        .services-grid-items > editable-array-item:nth-of-type(3n) {
          border-right: 1px solid #000;
        }
      }

      /* Just above the tablet breakpoint, three 380px cells plus their
         borders no longer fit the narrower container — the source shrinks
         each cell to 340px here so the 3-column layout still holds. */
      @media (min-width: 1081px) and (max-width: 1200px) {
        .services-grid-items > editable-array-item {
          flex-basis: 340px;
        }
      }

      @media (min-width: 831px) and (max-width: 1080px) {
        .services-grid-items > editable-array-item:nth-of-type(-n + 2) {
          border-top: 1px solid #000;
        }

        .services-grid-items > editable-array-item:nth-of-type(2n) {
          border-right: 1px solid #000;
        }
      }

      @media (max-width: 830px) {
        .services-grid-items {
          flex-direction: column;
          align-items: center;
        }

        .services-grid-items > editable-array-item,
        .services-grid-items > .services-grid-item:not(.services-grid-cta) {
          border: 1px solid #000;
          border-bottom: none;
          max-width: 420px;
          width: 100%;
        }

        .services-grid-items > editable-array-item:last-of-type {
          border-bottom: 1px solid #000;
        }
      }

      .services-grid-figure {
        margin: 0;
        padding-top: 30px;
        text-align: center;
        transition: 0.4s all;

        /* The source never scales these — each SVG carries its own small
           intrinsic width/height (~40-80px) and renders at that size. A
           `width: 100%` here stretches an icon to the full card width. */
        img {
          display: inline-block;
          height: auto;
          max-width: 100%;
          width: auto;
        }

        .image {
          margin-top: 0;
        }
      }

      .services-grid-content {
        padding: 15px 30px 20px;
      }

      .services-grid-title {
        color: #292929;
        display: block;
        font: 400 35px/1.1 spirits-soft, serif;
        margin: 20px 0 0;
        text-align: center;
        text-transform: uppercase;

        span {
          display: block;
          font-size: 18px;
        }

        a {
          color: #000;
          text-decoration: none;
        }
      }

      .services-grid-title:hover a,
      .services-grid-title:focus-within a {
        color: #2b8435;
      }

      .services-grid-links {
        display: table;
        margin: 20px auto;

        editable-array-item {
          display: list-item;
          line-height: 1.6;
          margin: 0 0 10px 26px;
          overflow: hidden;
          padding-left: 24px;
          position: relative;
        }

        /* Ported from the source's `main ul li:before` marker — restated here
           because these array items are `<editable-array-item>`, not `<li>`,
           so they never matched that selector. */
        editable-array-item::before {
          color: #2b8435;
          content: "\e81a";
          font-family: "fontello";
          font-size: 22px;
          font-style: normal;
          font-weight: 400;
          left: 0;
          line-height: 1;
          margin: 0;
          position: absolute;
          top: 2px;
        }

        a {
          color: #000;
          text-decoration: none;
        }
      }

      .services-grid-links editable-array-item:hover a,
      .services-grid-links editable-array-item:focus-within a {
        color: #2b8435;
      }

      .services-grid-cta,
      #all {
        align-items: center;
        background-color: var(--color-brand);
        display: flex;
        flex: 0 1 400px;
        flex-direction: column;
        justify-content: center;
        max-width: 100%;
        min-height: 250px;
        text-align: center;
        transition: 0.4s all;

        &.is-wide {
          flex: 0 1 62%;
        }

        a {
          color: #fff;
          display: flex;
          flex-direction: column;
          gap: 0.625rem;
          justify-content: center;
          min-height: 100%;
          padding: 1.25rem;
          text-decoration: none;
          width: 100%;
        }
      }

      .services-grid-cta-heading,
      #all .h2 {
        color: #fff;
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4.6vw, 3.3125rem);
        font-weight: 700;
        line-height: 1.05;
        padding: 10px;
      }

      .services-grid-cta-button,
      #all .btn {
        background-color: #fff;
        border: 0;
        color: var(--color-brand);
        display: inline-block;
        font-size: var(--font-size-body-sm);
        font-weight: 600;
        line-height: 1.2;
        padding: 0.65rem 1.1rem;
      }

      .services-grid-cta:hover .services-grid-cta-button,
      .services-grid-cta:focus-within .services-grid-cta-button,
      #all:hover .btn,
      #all:focus-within .btn {
        background-color: var(--color-brand-muted);
        color: #fff;
      }

      /* The CTA tile (`#all` / `.services-grid-cta`) is unrelated to the
         bordered item grid above — it's an optional, source-less extra some
         template instances of this component may enable — but it should
         still stack full-width once the grid itself has gone single-column. */
      @media (max-width: 830px) {
        .services-grid-cta,
        #all {
          flex-basis: 100%;
        }
      }
    }
  }
</style>
