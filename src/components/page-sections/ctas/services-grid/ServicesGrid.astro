---
import { sectionBackground } from "@components/utils/sectionBackgrounds";
import ServicesGridItem from "./ServicesGridItem.astro";

const {
  services = [],
  background = "cream",
  id = "",
  class: className,
  editable = true,
  _component,
  // Older settings, no longer used.
  heading,
  ctaCard,
  backgroundColor,
  backgroundGradient,
  backgroundImage,
  ...htmlAttributes
} = Astro.props;

const normalizedServices = Array.isArray(services)
  ? services.filter((service) => !!service && typeof service === "object")
  : [];

if (!_component && normalizedServices.length === 0) {
  return;
}

const servicesArrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-component-key": "_component",
      "data-id-key": "_component",
      "data-prop": "services",
    }
  : {};
---

<section
  class:list={["services-grid", sectionBackground(background), className]}
  id={id || undefined}
  {...htmlAttributes}
>
  <ul class="no-check block lg:flex flex-wrap justify-between" {...servicesArrayDataAttributes}>
    {
      normalizedServices.map((service: any) => (
        <editable-array-item data-component="page-sections/ctas/services-grid/services-grid-item">
          <ServicesGridItem {...service} editable={editable} />
        </editable-array-item>
      ))
    }
  </ul>
</section>

<style>
  .services-grid {
    padding: 90px 25px 65px;
  }

  .services-grid ul {
    margin: 0 auto;
    max-width: 1230px;
    padding: 0;
  }

  /* One card per row on phones, three on desktop. */
  .services-grid ul > :global(editable-array-item) {
    display: flex;
    margin-bottom: 85px;
  }

  @media (min-width: 1024px) {
    .services-grid {
      padding: 105px 25px 25px;
    }

    .services-grid ul > :global(editable-array-item) {
      width: 32%;
    }
  }
</style>
