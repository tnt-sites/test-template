---
import { Icon as AstroIcon } from "astro-icon/components";

const {
  title = "Service",
  href = "",
  icon = "",
  links = [],
  editable = true,
  class: className,
  _component,
  // Older card settings, replaced by `icon`.
  imageSource,
  imageAlt,
  wide,
  ...htmlAttributes
} = Astro.props;

const titleHtml =
  typeof title === "string" && title.trim().length > 0
    ? title
        .trim()
        .replace(/<\/p>\s*<p(?:\s[^>]*)?>/gi, "<br>")
        .replace(/^<p(?:\s[^>]*)?>/i, "")
        .replace(/<\/p>\s*$/i, "")
    : "Service";

const normalizedLinks = Array.isArray(links)
  ? links.filter(
      (link): link is { label?: string; text?: string; href?: string } =>
        !!link && typeof link === "object"
    )
  : [];

const iconName = typeof icon === "string" && icon.trim() ? `services/${icon.trim()}` : "";
---

<li class:list={["services-grid-item text-center", className]} {...htmlAttributes}>
  {/* White circle holding the icon, half above the card's top edge. */}
  <div class="service-icon">
    {iconName && <AstroIcon name={iconName} aria-hidden="true" />}
  </div>

  {/* Written out (not a dynamic tag) so CloudCannon's editor preview renders it. */}
  <h3>
    {
      href ? (
        <a href={href} data-editable="text" data-prop="title">
          <Fragment set:html={titleHtml} />
        </a>
      ) : (
        <span data-editable="text" data-prop="title">
          <Fragment set:html={titleHtml} />
        </span>
      )
    }
  </h3>

  {
    normalizedLinks.length > 0 && (
      <ul
        class="no-check"
        data-editable={editable ? "array" : undefined}
        data-component-key={editable ? "_component" : undefined}
        data-id-key={editable ? "_component" : undefined}
        data-prop={editable ? "links" : undefined}
      >
        {normalizedLinks.map((link) => (
          <editable-array-item data-component="page-sections/ctas/services-grid/service-link">
            <li>
              <a
                href={link.href?.trim() || "#"}
                data-editable={editable ? "text" : undefined}
                data-prop={editable ? "label" : undefined}
              >
                {(link.label || link.text || "").trim()}
              </a>
            </li>
          </editable-array-item>
        ))}
      </ul>
    )
  }
</li>

<style>
  .services-grid-item {
    background-color: var(--color-bg);
    border-bottom: 10px solid var(--color-brand-muted);
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.16);
    list-style: none;
    margin: 0;
    overflow: visible;
    padding: 85px 25px 40px;
    position: relative;
    width: 100%;
  }

  .service-icon {
    align-items: center;
    background-color: var(--color-bg);
    border-radius: 50%;
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.16);
    display: flex;
    height: 125px;
    justify-content: center;
    left: 50%;
    margin-left: -62px;
    position: absolute;
    top: -62px;
    width: 125px;
  }

  .service-icon :global(svg) {
    height: 50px;
    width: 70px;
  }

  h3 {
    font-size: 34px;
    line-height: 0.95;
    margin: 0 0 25px;
  }

  h3 :global(:is(a, span)) {
    color: var(--color-text-strong);
    text-decoration: none;
  }

  h3 :global(a:hover) {
    color: var(--color-brand);
  }

  ul {
    margin: 0;
    padding: 0;
    text-align: left;
  }

  li li {
    font-size: 17px;
    line-height: 1.3;
    list-style: none;
    margin: 0 0 5px;
    padding-left: 35px;
    position: relative;
  }

  /* Green check mark (from the site's Fontello icon font) before each link. */
  li li::before {
    color: var(--color-brand);
    content: "\e832";
    font-family: Fontello;
    left: 0;
    position: absolute;
    top: 0;
  }

  li li a {
    color: var(--color-text);
    text-decoration: none;
  }

  li li a:hover {
    color: var(--color-brand);
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .services-grid-item {
      min-height: 430px;
      padding: 85px 35px 40px;
    }

    h3 {
      font-size: 40px;
    }
  }
</style>
