---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "",
  items = [],
  headingBackgroundColor = "",
  headingBackgroundColorHex = "",
  headingTextColor = "",
  shadowColor = "rgba(0,0,0,0.10)",
  itemHeadingColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const headingBackgroundColorMap: Record<string, string> = {
  none: "transparent",
  base: "var(--color-bg)",
  surface: "var(--color-bg-surface)",
  accent: "var(--color-bg-accent)",
  highlight: "var(--color-bg-highlight)",
  dark: "var(--color-bg-dark)",
  black: "var(--color-bg-black)",
};

const resolvedHeadingBg =
  headingBackgroundColorHex ||
  headingBackgroundColorMap[headingBackgroundColor] ||
  "var(--color-brand-secondary, var(--color-brand))";
// Removed even/odd backgrounds

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  `--csq-heading-bg: ${resolvedHeadingBg}`,
  headingTextColor ? `--csq-heading-text: ${headingTextColor}` : "",
  shadowColor ? `--csq-shadow-color: ${shadowColor}` : "",
  itemHeadingColor ? `--csq-item-heading-color: ${itemHeadingColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pep-callout-shadows", className]}
  paddingVertical="xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="pep-callout-shadows__inner">
    {heading && <h2 class="pep-callout-shadows__heading" set:html={heading} />}
    <div class="pep-callout-shadows__grid">
      {
        items.map(
          (item: { image?: { source: string; alt: string }; heading?: string }, i: number) => (
            <div
              class:list={[
                "pep-callout-shadows__item",
                i % 2 === 0 ? "pep-callout-shadows__item--odd" : "pep-callout-shadows__item--even",
              ]}
            >
              <span class="pep-callout-shadows__img-wrap">
                <Image
                  source={item.image?.source ?? ""}
                  alt={item.image?.alt ?? ""}
                  rounded={false}
                  editable={true}
                  aspectRatio="none"
                  sizes="(max-width: 600px) 50vw, 200px"
                  widths={[200, 400]}
                  data-prop-src={`items.${i}.image.source`}
                  data-prop-alt={`items.${i}.image.alt`}
                />
              </span>
              {item.heading && (
                <h3 class="pep-callout-shadows__item-heading" set:html={item.heading} />
              )}
            </div>
          )
        )
      }
    </div>
  </div>
</CustomSection>

<style lang="pcss" is:global>
  .pep-callout-shadows__inner {
    margin: 0 auto;
    max-width: 1150px;
    text-align: center;
  }

  .pep-callout-shadows__heading {
    background-color: var(--csq-heading-bg);
    color: var(--csq-heading-text, var(--color-text-inverse, #fff));
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0;
    padding: 1.5rem 2.5rem;
    width: 100%;
  }

  .pep-callout-shadows__grid {
    display: flex;
    flex-flow: row;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .pep-callout-shadows__item {
    background: inherit;
    border-radius: 16px;
    /* Use PCSS color-mix for shadow with opacity */
    box-shadow:
      0 4px 16px color-mix(in srgb, var(--csq-shadow-color) 50%, transparent 50%),
      0 1.5px 6px color-mix(in srgb, var(--csq-shadow-color) 30%, transparent 70%);
    flex: 1 1 25%;
    margin: 0 0.5rem;
    min-width: 0;
    padding: 1.5rem 0.5rem;
    text-align: center;
  }

  /* Removed even/odd backgrounds */

  .pep-callout-shadows__img-wrap {
    align-items: center;
    display: flex;
    height: 110px;
    justify-content: center;
    position: relative;
  }

  .pep-callout-shadows__img-wrap :global(img) {
    display: block;
    margin: 0 auto;
    max-height: 100%;
    width: auto;
  }

  .pep-callout-shadows__item-heading {
    color: var(--csq-item-heading-color, var(--color-text, #000));
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.3;
    margin: 0.75rem auto 0;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .pep-callout-shadows__item {
      flex: 0 1 45%;
      margin: 20px auto;
    }
    
  }

  @media (max-width: 768px) {
    .pep-callout-shadows__item {
      background: inherit;
      border-radius: 16px;
      box-shadow:
        0 4px 16px color-mix(in srgb, var(--csq-shadow-color) 50%, transparent 50%),
        0 1.5px 6px color-mix(in srgb, var(--csq-shadow-color) 30%, transparent 70%);
      flex: 1 1 25%;
      margin: 0 0.5rem;
      min-width: 0;
      padding: 1.5rem 0.5rem;
      text-align: center;
    }
    .pep-callout-shadows__grid {
      display: block;
    }
  }
</style>
