---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "",
  items = [],
  headingBackgroundColor = "",
  headingBackgroundColorHex = "",
  headingTextColor = "",
  oddItemBackgroundColor = "",
  oddItemBackgroundColorHex = "",
  evenItemBackgroundColor = "",
  evenItemBackgroundColorHex = "",
  itemHeadingColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const resolvedHeadingBg =
  headingBackgroundColorHex ||
  headingBackgroundColor ||
  "var(--color-brand-secondary, var(--color-brand))";
const resolvedOddBg = oddItemBackgroundColorHex || oddItemBackgroundColor || "rgba(0,0,0,0.04)";
const resolvedEvenBg =
  evenItemBackgroundColorHex || evenItemBackgroundColor || "var(--color-bg-base, #fff)";

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  `--csq-heading-bg: ${resolvedHeadingBg}`,
  headingTextColor ? `--csq-heading-text: ${headingTextColor}` : "",
  `--csq-odd-bg: ${resolvedOddBg}`,
  `--csq-even-bg: ${resolvedEvenBg}`,
  itemHeadingColor ? `--csq-item-heading-color: ${itemHeadingColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["callout-squares", className]}
  paddingVertical="xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="callout-squares__inner">
    {heading && <h2 class="callout-squares__heading" set:html={heading} />}
    <div class="callout-squares__grid">
      {
        items.map(
          (item: { image?: { source: string; alt: string }; heading?: string }, i: number) => (
            <div
              class:list={[
                "callout-squares__item",
                i % 2 === 0 ? "callout-squares__item--odd" : "callout-squares__item--even",
              ]}
            >
              <span class="callout-squares__img-wrap">
                <Image
                  source={item.image?.source ?? ""}
                  alt={item.image?.alt ?? ""}
                  rounded={false}
                  editable={true}
                  aspectRatio="none"
                  sizes="(max-width: 600px) 50vw, 200px"
                  widths={[200, 400]}
                  data-prop-src={`items.${i}.image.source`}
                  data-prop-alt={`items.${i}.image.alt`}
                />
              </span>
              {item.heading && <h3 class="callout-squares__item-heading" set:html={item.heading} />}
            </div>
          )
        )
      }
    </div>
  </div>
</CustomSection>

<style>
  .callout-squares__inner {
    margin: 0 auto;
    max-width: 1150px;
    text-align: center;
  }

  .callout-squares__heading {
    background-color: var(--csq-heading-bg);
    color: var(--csq-heading-text, var(--color-text-inverse, #fff));
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 400;
    margin: 0;
    padding: 1.5rem 2.5rem;
    width: 100%;
  }

  .callout-squares__grid {
    display: flex;
    flex-flow: row;
  }

  .callout-squares__item {
    flex: 1 1 25%;
    min-width: 0;
    padding: 1.5rem 0.5rem;
    text-align: center;
  }

  .callout-squares__item--odd {
    background-color: var(--csq-odd-bg);
  }

  .callout-squares__item--even {
    background-color: var(--csq-even-bg);
  }

  .callout-squares__img-wrap {
    align-items: center;
    display: flex;
    height: 110px;
    justify-content: center;
    position: relative;
  }

  .callout-squares__img-wrap :global(img) {
    display: block;
    margin: 0 auto;
    max-height: 100%;
    width: auto;
  }

  .callout-squares__item-heading {
    color: var(--csq-item-heading-color, var(--color-text, #000));
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.3;
    margin: 0.75rem auto 0;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .callout-squares__item {
      flex: 1 1 50%;
    }
  }

  @media (max-width: 768px) {
    .callout-squares__grid {
      display: block;
    }
    .callout-squares__item {
      flex: 0 1 100%;
      padding: 1.25rem 0.9rem;
    }
  }
</style>
