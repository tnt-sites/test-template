---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Text from "@components/building-blocks/core-elements/text/Text.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  headingFontFamily = "",
  text = "",
  image = { source: "", alt: "" },
  figcaption = "",
  buttonSections = [],
  backgroundColor = "base",
  backgroundColorHex = "",
  borderColor = "",
  headingColor = "",
  textColor = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  borderColor ? `--pep-border-color: ${borderColor}` : "",
  headingColor ? `--pep-heading-color: ${headingColor}` : "",
  textColor ? `--pep-text-color: ${textColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pep-split-banner", className]}
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="pep-split-banner__inner">
    <article class="pep-split-banner__article">
      <Heading
        text={heading}
        level="h1"
        fontFamily={headingFontFamily}
        data-prop="heading"
        editable={true}
      />
      {text && <Text text={text} class="pep-split-banner__text" data-prop="text" />}
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure class="pep-split-banner__figure">
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="(max-width: 790px) 100vw, 50vw"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .pep-split-banner {
    border-bottom: 6px solid var(--pep-border-color, var(--color-brand));
    overflow: hidden;
  }

  .pep-split-banner__inner {
    align-items: stretch;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    margin: auto;
    max-width: 1920px;
  }

  .pep-split-banner__article {
    align-items: flex-start;
    align-self: center;
    display: flex;
    flex: 1 0 520px;
    flex-direction: column;
    justify-content: center;
    order: 1;
    padding: 50px;
    text-align: left;
  }

  .pep-split-banner__article h1 {
    color: var(--pep-heading-color, var(--color-heading, var(--color-text)));
    font-family: var(--font-headings);
    font-size: 5.375rem;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 1.25rem;
    text-align: left;
    text-shadow: 3px 3px 7px rgba(0, 0, 0, 0.4);
  }

  .pep-split-banner__article :global(.text p) {
    color: var(--pep-text-color, inherit);
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.55;
    margin: 0 0 1rem;
    text-align: left;
  }

  .pep-split-banner__article :global(.text p:last-child) {
    padding-bottom: 2rem;
  }

  .pep-split-banner__figure {
    align-self: stretch;
    flex: 0 1 50%;
    order: 2;
    position: relative;
  }

  .pep-split-banner__figure .image {
    height: 100%;
    width: 100%;
  }

  .pep-split-banner__figure :global(img) {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .pep-split-banner__figure figcaption {
    background: rgba(255, 255, 255, 0.9);
    bottom: 0;
    color: #000;
    font-size: 0.9375rem;
    font-weight: 700;
    left: 0;
    letter-spacing: 0.2em;
    padding: 12px 20px;
    position: absolute;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .pep-split-banner__inner {
      flex-wrap: wrap;
    }

    .pep-split-banner__article {
      flex: 1 1 100%;
      order: 1;
      padding: 30px 20px;
    }

    .pep-split-banner__article h1 {
      font-size: 3.75rem;
    }

    .pep-split-banner__figure {
      flex: 1 1 100%;
      max-height: 500px;
      order: 2;
      overflow: hidden;
    }

    .pep-split-banner__figure :global(img) {
      object-position: top;
    }
  }

  @media (max-width: 600px) {
    .pep-split-banner__article {
      padding: 30px 15px;
    }

    .pep-split-banner__article h1 {
      font-size: 3rem;
    }
  }
</style>
