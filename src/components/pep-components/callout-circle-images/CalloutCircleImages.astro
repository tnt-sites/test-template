---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "",
  items = [],
  headingColor = "",
  itemHeadingColor = "",
  circleBackgroundColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--cci-heading-color: ${headingColor}` : "",
  itemHeadingColor ? `--cci-item-heading-color: ${itemHeadingColor}` : "",
  circleBackgroundColor ? `--cci-circle-bg: ${circleBackgroundColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["callout-circle-images", className]}
  paddingVertical="xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  {heading && <h2 class="callout-circle-images__heading" set:html={heading} />}
  <div class="callout-circle-images__grid">
    {
      items.map(
        (item: { image?: { source: string; alt: string }; heading?: string }, i: number) => (
          <div class="callout-circle-images__item">
            <span class="callout-circle-images__circle">
              <Image
                source={item.image?.source ?? ""}
                alt={item.image?.alt ?? ""}
                rounded={false}
                editable={true}
                aspectRatio="none"
                sizes="(max-width: 600px) 50vw, 200px"
                widths={[200, 400]}
                data-prop-src={`items.${i}.image.source`}
                data-prop-alt={`items.${i}.image.alt`}
              />
            </span>
            {item.heading && (
              <h3 class="callout-circle-images__item-heading" set:html={item.heading} />
            )}
          </div>
        )
      )
    }
  </div>
</CustomSection>

<style>
  .callout-circle-images {
    text-align: center;
  }

  .callout-circle-images__heading {
    color: var(--cci-heading-color, var(--color-brand));
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    margin: 0 auto 2.5rem;
    padding: 0 1rem;
  }

  .callout-circle-images__grid {
    align-items: flex-start;
    display: flex;
    flex-flow: row wrap;
    gap: 2rem;
    justify-content: center;
    margin: 0 auto;
    max-width: 1150px;
  }

  .callout-circle-images__item {
    align-items: center;
    display: flex;
    flex: 0 1 280px;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.5rem;
    text-align: center;
  }

  .callout-circle-images__circle {
    align-items: center;
    aspect-ratio: 1;
    background-color: var(--cci-circle-bg, var(--color-bg-surface, #f0f0f0));
    border-radius: 50%;
    display: flex;
    height: 200px;
    justify-content: center;
    overflow: hidden;
    width: 200px;
  }

  .callout-circle-images__circle :global(img) {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .callout-circle-images__item-heading {
    color: var(--cci-item-heading-color, var(--color-text));
    font-size: clamp(1rem, 2vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.3;
    margin: 0;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .callout-circle-images__grid {
      gap: 1.5rem;
    }

    .callout-circle-images__item {
      flex: 0 1 140px;
    }

    .callout-circle-images__circle {
      height: 140px;
      width: 140px;
    }
  }
</style>
