---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  callText = "",
  phone = "",
  phoneLabel = "",
  image = { source: "", alt: "" },
  figcaption = "",
  iframeEmbed = "",
  bottomText = "",
  backgroundColor = "none",
  backgroundColorHex = "",
  contentBackgroundColor = "",
  contentBackgroundColorHex = "",
  callBackgroundColor = "",
  callBackgroundColorHex = "",
  callTextColor = "",
  linkColor = "",
  class: className,
  ...rest
} = Astro.props;

const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};

const resolvedContentBg =
  contentBackgroundColorHex ||
  getColorValue(contentBackgroundColor) ||
  "var(--color-bg-surface, #f0f0f0)";
const resolvedCallBg =
  callBackgroundColorHex || getColorValue(callBackgroundColor) || "var(--color-bg-base, #fff)";

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  `--pfc-content-bg: ${resolvedContentBg}`,
  `--pfc-call-bg: ${resolvedCallBg}`,
  callTextColor ? `--pfc-call-text-color: ${callTextColor}` : "",
  linkColor ? `--pfc-link-color: ${linkColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pep-form-ctm", className]}
  paddingVertical="xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="pep-form-ctm__content">
    <div class="pep-form-ctm__call">
      {
        image?.source && (
          <figure class="pep-form-ctm__figure">
            <Image
              source={image.source}
              alt={image.alt || ""}
              rounded={false}
              editable={true}
              aspectRatio="none"
              sizes="(max-width: 890px) 100vw, 485px"
              data-prop-src="image.source"
              data-prop-alt="image.alt"
            />
            {figcaption && <figcaption data-prop="figcaption">{figcaption}</figcaption>}
          </figure>
        )
      }
      <article class="pep-form-ctm__article">
        <p data-prop="callText" set:html={callText} />
      </article>
    </div>
    {iframeEmbed && <div class="pep-form-ctm__form" set:html={iframeEmbed} />}
  </div>
  {
    bottomText && (
      <div class="pep-form-ctm__bottom">
        <p data-prop="bottomText" set:html={bottomText} />
      </div>
    )
  }
</CustomSection>

<style>
  .pep-form-ctm__content {
    background-color: var(--pfc-content-bg);
    margin: 0 auto;
    max-width: 1260px;
  }

  .pep-form-ctm__call {
    align-items: center;
    background-color: var(--pfc-call-bg);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    padding: 2.5rem 0.625rem;
  }

  .pep-form-ctm__figure {
    flex: 0 0 485px;
    position: relative;
  }

  .pep-form-ctm__figure figcaption {
    background-color: rgba(255, 255, 255, 0.8);
    bottom: 0;
    font-size: 1.25rem;
    font-weight: 700;
    left: 0;
    letter-spacing: 0.1em;
    padding: 0.3125rem 0.9375rem;
    position: absolute;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }

  .pep-form-ctm__article {
    flex: 0 1 730px;
  }

  .pep-form-ctm__article p {
    color: var(--pfc-call-text-color, var(--color-text, #000));
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 3.5vw, 2.8125rem);
    font-weight: 400;
    :global(.pep-form-ctm__form iframe) {
      border: none !important;
      display: block;
      flex: 1 1 auto;
      height: 100% !important;
      min-height: 400px !important;
      width: 100% !important;
    }
  }

  .pep-form-ctm__article a:hover {
    color: var(--color-brand-secondary, var(--color-brand));
  }

  .pep-form-ctm__form {
    background-color: var(--pfc-content-bg);
    padding: 0;
  }

  .pep-form-ctm__form iframe {
    :global(.pep-form-ctm__form iframe) {
      height: 750px !important;
    }
    border: none;
    min-height: 400px;
  }

  .pep-form-ctm__bottom {
    padding: 2.5rem 1rem 3rem;
    text-align: center;
  }

  .pep-form-ctm__bottom p {
    color: var(--color-text-inverse, #fff);
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 auto;
    max-width: 1100px;
  }

  @media (max-width: 1024px) {
    .pep-form-ctm__call {
      display: block;
      padding: 1.875rem 0.625rem 0.625rem;
      text-align: center;
    }

    .pep-form-ctm__figure {
      flex: 0 1 100%;
      margin: 0 auto;
      max-width: 485px;
    }

    .pep-form-ctm__article p {
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .pep-form-ctm__call {
      display: block;
      text-align: center;
    }

    .pep-form-ctm__article p {
      font-size: 1.2rem;
      text-align: center;
    }

    .pep-form-ctm__form iframe {
      height: 750px;
    }
  }
</style>
