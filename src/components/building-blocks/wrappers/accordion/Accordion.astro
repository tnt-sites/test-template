---
import AccordionItem from "./AccordionItem.astro";

const {
  items,
  openFirst,
  singleOpen = false,
  label,
  theme,
  iconName = "chevron-down",
  editable = true,
  "data-prop": customDataProp = "items",
  _component,
  style: styleProp,
  ...htmlAttributes
} = Astro.props;

/**
 * A measured accordion's design, as the custom properties `AccordionItem`
 * reads. Only the values that were actually measured are written: an empty
 * custom property is invalid at computed-value time, so emitting one would
 * unset the item's own default rather than fall back to it.
 */
const THEME_PROPS: Record<string, string> = {
  titleBackground: "--accordion-title-bg",
  titleColor: "--accordion-title-color",
  titleBackgroundOpen: "--accordion-title-bg-open",
  titleColorOpen: "--accordion-title-color-open",
  titleBackgroundHover: "--accordion-title-bg-hover",
  titleColorHover: "--accordion-title-color-hover",
  titleFontSize: "--accordion-title-font-size",
  titleFontWeight: "--accordion-title-font-weight",
  titlePadding: "--accordion-title-padding",
  titleGap: "--accordion-title-gap",
  itemGap: "--accordion-item-gap",
  itemBorder: "--accordion-item-border",
  detailBackground: "--accordion-detail-bg",
  detailPadding: "--accordion-detail-padding",
  detailBorderTop: "--accordion-detail-border-top",
  detailBorderRight: "--accordion-detail-border-right",
  detailBorderBottom: "--accordion-detail-border-bottom",
  detailBorderLeft: "--accordion-detail-border-left",
};

const themeStyle = Object.entries(THEME_PROPS)
  .map(([key, prop]) => {
    const value = theme?.[key];
    return value === undefined || value === null || value === "" ? "" : `${prop}: ${value}`;
  })
  .filter(Boolean)
  .join("; ");

const style = [themeStyle, styleProp].filter(Boolean).join("; ") || undefined;

const slugifyLabel = (label: string) => {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

const generatedLabel = label || `Accordion-${crypto.randomUUID()}`;

if (!htmlAttributes.id) {
  htmlAttributes.id = slugifyLabel(generatedLabel);
}

const accordionName = singleOpen ? `accordion-${crypto.randomUUID()}` : undefined;

const arrayDataAttributes = editable
  ? {
      "data-editable": "array",
      "data-prop": customDataProp,
      "data-component-key": "_component",
      "data-id-key": "_component",
    }
  : {};

const hasItems = items?.length > 0;
const slotContent = Astro.slots.has("default") ? await Astro.slots.render("default") : null;
const hasSlotContent = (slotContent?.toString().trim().length ?? 0) > 0;

if (!_component && !hasItems && !hasSlotContent) return;
---

<div class:list={["accordion"]} style={style} {...arrayDataAttributes} {...htmlAttributes}>
  <slot>
    {
      items &&
        items.length > 0 &&
        items.map((item: any, index: number) => {
          const isFirst = index === 0 && openFirst;

          return (
            <editable-array-item data-component="building-blocks/wrappers/accordion/accordion-item">
              <AccordionItem
                title={item.title}
                contentSections={item.contentSections}
                isOpen={isFirst}
                accordionName={accordionName}
                iconName={iconName}
              />
            </editable-array-item>
          );
        })
    }
  </slot>
</div>

<style lang="pcss" is:global>
  @layer components {
    .accordion {
      margin-top: var(--spacing-lg);
    }
  }
</style>
