---
import { Icon as AstroIcon } from "astro-icon/components";
import CarouselSlide from "./CarouselSlide.astro";

const {
  slides = [],
  autoPlay = false,
  autoScroll = false,
  slideWidthPercent = 100,
  minSlideWidth = 0,
  maxSlideWidth = 0,
  style = "",
  label,
  arrowStyle = "default",
  // Arrows either side of the slides, with the dots above ("top") or below
  // ("bottom"). On phones the arrows move beside the dots.
  arrowsBeside = false,
  dotsPosition = "top",
  class: className,
  "data-prop": customDataProp = "slides",
  editable = true,
  _component,
  ...htmlAttributes
} = Astro.props;

// Maps arrowStyle to the prev/next icon names from src/icons/
const arrowIcons: Record<string, [string, string]> = {
  chevron: ["chevron-left", "chevron-right"],
  circle: ["arrow-left-circle", "arrow-right-circle"],
  arrow: ["arrow-left", "arrow-right"],
  long: ["arrow-long", "arrow-long"],
};
const [prevIcon, nextIcon] = arrowIcons[arrowStyle] ?? [null, null];

const slugifyLabel = (label: string) => {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const dataAttributes: Record<string, string> = {};

// These are hardcoded variables that you could setup
// to be configured to be set by the editor.

// Shows the indicators dots.
dataAttributes["data-show-indicators"] = "true";

// Shows the navigational arrows.
dataAttributes["data-show-arrows"] = "true";

// If false, the carousel will stop at the last slide.
dataAttributes["data-loop"] = "true";

// Positions the slides in the viewport.
dataAttributes["data-align"] = "center";

// Allows the carousel to scroll a specific number of
// slides at a time.
dataAttributes["data-slides-to-scroll"] = "auto";

if (autoPlay) {
  dataAttributes["data-autoplay"] = "3";
}

if (autoScroll) {
  dataAttributes["data-autoscroll"] = "1";
  dataAttributes["data-show-indicators"] = "false";
  dataAttributes["data-show-arrows"] = "false";
}

const carouselClasses = "carousel";

// Build the style attribute, merging custom styles with CSS variables
const carouselStyles = `
  --slide-width: ${slideWidthPercent}%;
  --min-slide-width: ${minSlideWidth}px;
  ${maxSlideWidth > 0 ? `--max-slide-width: ${maxSlideWidth}px;` : ""}
  ${style}
`.trim();
---

<section
  class:list={[carouselClasses, arrowsBeside && "carousel-arrows-beside", className]}
  role="region"
  aria-label="Carousel"
  style={carouselStyles}
  {...htmlAttributes}
  {...dataAttributes}
>
  {
    arrowsBeside ? (
      <>
        {dotsPosition === "top" && (
          <>
            {/* Phones: arrows either side of the dots, above the slides. */}
            <div class="phone-controls is-top flex lg:hidden items-center justify-between">
              <button class="button prev" type="button" aria-label="Previous slide">
                <AstroIcon name={prevIcon || "arrow-long"} is:inline />
              </button>
              <div class="indicators" />
              <button class="button next" type="button" aria-label="Next slide">
                <AstroIcon name={nextIcon || "arrow-long"} is:inline />
              </button>
            </div>
            <div class="indicators desktop-dots hidden lg:flex" />
          </>
        )}
        <div class="slides-row flex items-center">
          <button class="button prev hidden lg:block" type="button" aria-label="Previous slide">
            <AstroIcon name={prevIcon || "arrow-long"} is:inline />
          </button>
          <div class="viewport">
            <div
              class="track"
              {...(editable
                ? {
                    "data-editable": "array",
                    "data-component-key": "_component",
                    "data-id-key": "_component",
                    "data-prop": customDataProp,
                  }
                : {})}
            >
              <slot />
            </div>
          </div>
          <button class="button next hidden lg:block" type="button" aria-label="Next slide">
            <AstroIcon name={nextIcon || "arrow-long"} is:inline />
          </button>
        </div>
        {dotsPosition === "bottom" && (
          <>
            {/* Phones: arrows either side of the dots, below the slides. */}
            <div class="phone-controls is-bottom flex lg:hidden items-center justify-between">
              <button class="button prev" type="button" aria-label="Previous slide">
                <AstroIcon name={prevIcon || "arrow-long"} is:inline />
              </button>
              <div class="indicators" />
              <button class="button next" type="button" aria-label="Next slide">
                <AstroIcon name={nextIcon || "arrow-long"} is:inline />
              </button>
            </div>
            {/* Optional content (e.g. a button) beside the dots on desktop. */}
            <div class="controls-row block lg:flex items-center justify-center">
              <slot name="controls" />
              <div class="indicators hidden lg:flex" />
            </div>
          </>
        )}
      </>
    ) : (
      <>
        <div class="viewport">
          <div
            class="track"
            {...(editable
              ? {
                  "data-editable": "array",
                  "data-component-key": "_component",
                  "data-id-key": "_component",
                  "data-prop": customDataProp,
                }
              : {})}
          >
            {slides.length > 0 ? (
              slides.map((slide: any, index: number) => (
                <editable-array-item data-component="building-blocks/wrappers/carousel/carousel-slide">
                  <CarouselSlide
                    contentSections={slide.contentSections}
                    aria-label={`Slide ${index + 1} of ${slides.length}`}
                  />
                </editable-array-item>
              ))
            ) : (
              <slot />
            )}
          </div>
        </div>

        <div class="controls-wrapper">
          <button class="button prev" type="button" aria-label="Previous slide">
            <slot name="prev-arrow">
              {prevIcon ? (
                <AstroIcon name={prevIcon} is:inline />
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="49.498"
                  height="49.498"
                  viewBox="0 0 49.498 49.498"
                >
                  <path
                    id="Union_2"
                    data-name="Union 2"
                    d="M-612,7.5V-23h-30.5a1.5,1.5,0,0,1-1.5-1.5,1.5,1.5,0,0,1,1.5-1.5h32a1.5,1.5,0,0,1,1.5,1.5v32A1.5,1.5,0,0,1-610.5,9,1.5,1.5,0,0,1-612,7.5Z"
                    transform="translate(461.741 473.762) rotate(45)"
                    fill="#e3e3e3"
                  />
                </svg>
              )}
            </slot>
          </button>

          <div class="indicators" />

          <button class="button next" type="button" aria-label="Next slide">
            <slot name="next-arrow">
              {nextIcon ? (
                <AstroIcon name={nextIcon} is:inline />
              ) : (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="49.498"
                  height="49.498"
                  viewBox="0 0 49.498 49.498"
                >
                  <path
                    id="Union_2"
                    data-name="Union 2"
                    d="M-612,7.5V-23h-30.5a1.5,1.5,0,0,1-1.5-1.5,1.5,1.5,0,0,1,1.5-1.5h32a1.5,1.5,0,0,1,1.5,1.5v32A1.5,1.5,0,0,1-610.5,9,1.5,1.5,0,0,1-612,7.5Z"
                    transform="translate(461.741 473.762) rotate(45)"
                    fill="#e3e3e3"
                  />
                </svg>
              )}
            </slot>
          </button>
        </div>
      </>
    )
  }
</section>

<script>
  import EmblaCarousel from "embla-carousel";
  import AutoScroll from "embla-carousel-auto-scroll";
  import Autoplay from "embla-carousel-autoplay";
  import ClassNames from "embla-carousel-class-names";

  function setupCarousels() {
    const carousels = document.querySelectorAll(".carousel");

    carousels.forEach((carousel) => {
      if (carousel.hasAttribute("data-embla-initialized")) {
        return;
      }

      const viewport = carousel.querySelector(".viewport") as HTMLElement;
      const track = viewport?.querySelector(".track");
      const slides = track?.querySelectorAll(".slide");
      // Arrows and dots can appear more than once (desktop and phone versions).
      const indicatorContainers = carousel.querySelectorAll(".indicators");

      if (!viewport || !track || !slides || !slides.length) {
        console.warn("Carousel: Missing required elements");
        return;
      }

      const loop = carousel.hasAttribute("data-loop");
      const slidesToScroll = carousel.hasAttribute("data-slides-to-scroll")
        ? Number(carousel.getAttribute("data-slides-to-scroll")) || "auto"
        : "auto";
      const align = (carousel.getAttribute("data-align") || "start") as "start" | "center" | "end";
      const containScroll = carousel.hasAttribute("data-no-contain-scroll")
        ? false
        : ("trimSnaps" as const);

      const plugins = [ClassNames()];
      if (carousel.hasAttribute("data-autoplay")) {
        const autoplayInterval = Number(carousel.getAttribute("data-autoplay")) * 1000 || 3000;
        plugins.push(Autoplay({ delay: autoplayInterval, stopOnInteraction: false }));
      }

      let watchDrag = true;
      if (carousel.hasAttribute("data-autoscroll")) {
        const scrollValue = parseFloat(carousel.getAttribute("data-autoscroll") || "1");
        const speed = isNaN(scrollValue) ? 1 : scrollValue;
        plugins.push(AutoScroll({ speed }));
        watchDrag = false;
      }

      const embla = EmblaCarousel(
        viewport,
        {
          loop,
          slidesToScroll,
          align,
          containScroll,
          watchDrag,
          duration: 20,
          startIndex: 0,
          skipSnaps: false,
          inViewThreshold: 0.7,
        },
        plugins
      );

      // Store embla instance on the element so external scripts can access it.
      (carousel as any)._embla = embla;

      // Mark this carousel as initialized
      carousel.setAttribute("data-embla-initialized", "true");

      // Navigation buttons — wired up once, always.
      const prevButtons = carousel.querySelectorAll<HTMLButtonElement>(".prev");
      const nextButtons = carousel.querySelectorAll<HTMLButtonElement>(".next");

      prevButtons.forEach((button) => button.addEventListener("click", () => embla.scrollPrev()));
      nextButtons.forEach((button) => button.addEventListener("click", () => embla.scrollNext()));

      const updateButtons = () => {
        prevButtons.forEach((button) => (button.disabled = !embla.canScrollPrev()));
        nextButtons.forEach((button) => (button.disabled = !embla.canScrollNext()));
      };

      // Show/hide arrows and indicators based on snap availability.
      // Called on both init and reInit so carousels that start hidden
      // (e.g. in a tab panel) recover correctly once they become visible.
      const updateControls = () => {
        const hasSnaps = embla.scrollSnapList().length > 1;
        carousel.setAttribute("data-show-arrows", hasSnaps ? "true" : "false");
        carousel.setAttribute("data-show-indicators", hasSnaps ? "true" : "false");
        if (!hasSnaps) {
          embla.plugins()?.autoplay?.stop?.();
        } else {
          updateButtons();
        }
      };

      updateControls();
      embla.on("select", updateButtons);
      embla.on("reInit", updateControls);

      // Setup indicators
      indicatorContainers.forEach((indicatorsContainer) => {
        const renderDots = () => {
          indicatorsContainer.innerHTML = "";
          embla.scrollSnapList().forEach((_, index) => {
            const dot = document.createElement("button");
            dot.className = "indicator";
            dot.setAttribute("type", "button");
            dot.setAttribute("aria-label", `Go to position ${index + 1}`);
            dot.setAttribute("data-selected", (index === embla.selectedScrollSnap()).toString());
            dot.setAttribute("aria-selected", (index === embla.selectedScrollSnap()).toString());
            dot.addEventListener("click", () => embla.scrollTo(index));
            indicatorsContainer.appendChild(dot);
          });
        };

        const updateSelectedDot = () => {
          indicatorsContainer.querySelectorAll(".indicator").forEach((dot, index) => {
            const isSelected = index === embla.selectedScrollSnap();
            dot.setAttribute("data-selected", isSelected.toString());
            dot.setAttribute("aria-selected", isSelected.toString());
          });
        };

        embla.on("select", updateSelectedDot);
        embla.on("reInit", renderDots);
        renderDots();
      });
    });
  }

  // Initialize carousels when the page loads
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCarousels);
  } else {
    setupCarousels();
  }
  document.addEventListener("astro:page-load", setupCarousels);
</script>

<style lang="pcss" is:global>
  @layer components {
    .carousel {
      margin-top: var(--spacing-lg);
      position: relative;
      width: 100%;
      --slide-width: 100%;
      --min-slide-width: 0px;

      .viewport {
        overflow: hidden;
        position: relative;
        width: 100%;
      }

      .viewport > .track {
        display: flex;
        flex-wrap: nowrap;

        > editable-array-item, > .slide {
          flex-shrink: 0;
          flex-basis: calc(max(var(--slide-width, 100%), var(--min-slide-width, 0px)));
          max-width: var(--max-slide-width, none);
        }

        > editable-array-item > .slide {
          width: 100%;
          max-width: var(--max-slide-width, none);
        }
      }

      > .controls-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-md);
        margin-top: var(--spacing-sm);
        margin-bottom: var(--spacing-sm);
      }

      > .controls-wrapper > .prev,
      > .controls-wrapper > .next {
        pointer-events: auto;
        border-radius: var(--radius-full);
        border: none;
        background-color: transparent;
        flex-shrink: 0;

        svg{path, line{transition: .3s;}}

        &:hover {
          svg{path, line{fill: var(--color-brand);}}
        }

        /* Icon-based arrows (chevron / circle / arrow variants) */
        svg[data-icon] {
          width: 2rem;
          height: 2rem;
          stroke: currentcolor;
          fill: none;
          transition: color var(--animation-normal) ease;
        }

        &:hover svg[data-icon] {
          color: var(--color-brand);
        }
      }
      > .controls-wrapper > .prev svg{
        transform: rotate(180deg);
      }

      > .controls-wrapper > .indicators {
        display: flex;
        justify-content: center;
        gap: var(--spacing-sm);
      }

      > .controls-wrapper > .indicators > .indicator {
        border-radius: var(--radius-full);
        width: 12px;
        aspect-ratio: 1/1;
        padding: 0;
        min-width: 0;
        min-height: 0;
        transition:
          transform var(--animation-normal) ease,
          background-color var(--animation-normal) ease;
        border: none;
        cursor: pointer;
        background-color: var(--color-brand);
        &[data-selected="true"] {
          background-color: var(--color-brand-muted);
          transform: scale(1.2);
        }
      }

      /* "Arrows beside slides" layout: long thin arrows and small round dots. */
      &.carousel-arrows-beside {
        .prev,
        .next {
          background: transparent;
          border: 0;
          color: var(--color-text-strong);
          flex-shrink: 0;
          height: 36px;
          min-height: 0;
          min-width: 0;
          padding: 0;
          width: 62px;

          svg {
            height: 36px;
            width: 62px;
          }

          &:hover,
          &:focus-visible {
            background: transparent;
            color: var(--color-brand);
          }
        }

        .prev svg {
          transform: rotate(180deg);
        }

        .indicators {
          display: flex;
          gap: 25px;
          justify-content: center;
        }

        .slides-row {
          gap: 30px;
        }

        .slides-row > .viewport {
          flex: 1;
          min-width: 0;
        }

        .desktop-dots {
          margin-bottom: 35px;
        }

        .phone-controls {
          gap: 10px;
        }

        .phone-controls.is-top {
          margin-bottom: 25px;
        }

        .phone-controls.is-bottom {
          margin-top: 25px;
        }

        /* Extra controls (e.g. a button) beside the dots on desktop. */
        .controls-row {
          margin-top: 25px;
          text-align: center;
        }

        @media (min-width: 1024px) {
          .controls-row {
            gap: 35px;
            margin-top: 30px;
          }
        }

        .indicator {
          aspect-ratio: 1;
          background-color: #d5d1c6;
          border: 0;
          border-radius: var(--radius-full);
          cursor: pointer;
          min-height: 0;
          min-width: 0;
          padding: 0;
          width: 10px;

          &[data-selected="true"] {
            background-color: var(--color-brand);
          }
        }

        /* Hidden when there's only one slide. !important beats the lg:block /
           lg:flex utility classes on the controls. */
        &[data-show-arrows="false"] :is(.prev, .next),
        &[data-show-indicators="false"] .indicators {
          display: none !important;
        }
      }

      &[data-show-indicators="false"] {
        > .controls-wrapper > .indicators {
          display: none;
        }
      }

      &[data-show-arrows="false"] {
        > .controls-wrapper > .prev,
        > .controls-wrapper > .next {
          display: none;
        }
      }
    }
  }
</style>
