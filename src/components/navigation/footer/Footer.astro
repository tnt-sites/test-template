---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Button from "@core-elements/button/Button.astro";
import Divider from "@core-elements/divider/Divider.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  links = [],
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  contactTitle = "Contact Us",
  // The source labels its social column "Connect with us"; the template had no
  // field for it, so the heading was simply absent.
  socialsTitle = "",
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  mapEmbedUrl = "",
  legalBlurb = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  logoSource,
  logoAlt,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const getOfficeHoursGeneralNotes = (office: any) => {
  const notes = [
    office?.officeHoursNote,
    office?.["office-hours-note"],
    ...(Array.isArray(office?.officeHoursNotes) ? office.officeHoursNotes : []),
    ...(Array.isArray(office?.["office-hours-notes"]) ? office["office-hours-notes"] : []),
  ];

  return notes.filter((note) => typeof note === "string" && note.trim().length > 0);
};

const copyYear = new Date().getFullYear();
const embedSrc = typeof mapEmbedUrl === "string" ? mapEmbedUrl.trim() : "";
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";
const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};
const footerStyle = [
  getColorValue(addressLinkColor)
    ? `--footer-address-link-color: ${getColorValue(addressLinkColor)}`
    : "",
  getColorValue(addressLinkHoverColor)
    ? `--footer-address-link-hover-color: ${getColorValue(addressLinkHoverColor)}`
    : "",
  getColorValue(phoneLinkColor)
    ? `--footer-phone-link-color: ${getColorValue(phoneLinkColor)}`
    : "",
  getColorValue(phoneLinkHoverColor)
    ? `--footer-phone-link-hover-color: ${getColorValue(phoneLinkHoverColor)}`
    : "",
]
  .filter(Boolean)
  .join("; ");
---

<footer class="footer" style={footerStyle || undefined} {...htmlAttributes}>
  <CustomSection maxContentWidth="2xl" paddingHorizontal="md" paddingVertical="2xl">
    <div class="footer-content">
      <div class="content-container">
        <a href="/">
          <Image source={logoSource} alt={logoAlt} class="footer-logo" editable={false} />
        </a>
      </div>
      <!-- <div class="content-container">
        <Bar navData={links} />
      </div> -->
    </div>

    <div id="fo-content" class="fo-content block lg:flex justify-around items-start text-center">
      <div class="fo-info">
        <span class="fo-title">{contactTitle}</span>
        {
          resolvedOffices.map((office: any) => (
            <div class="office-block">
              {office?.name && <span class="office-name">{office.name}</span>}
              {Array.isArray(office?.phones) &&
                office.phones.map((phone: any) =>
                  phone?.display ? (
                    <a href={phone?.href || "#"} class="pho">
                      {phone?.label ? `${phone.label}: ` : ""}
                      {phone.display}
                    </a>
                  ) : null
                )}
              {Array.isArray(office?.emails) &&
                office.emails.map((email: any) =>
                  email?.display ? (
                    <a href={email?.href || "#"} class="pho">
                      {email?.label ? `${email.label}: ` : ""}
                      {email.display}
                    </a>
                  ) : null
                )}
              {Array.isArray(office?.addresses) &&
                office.addresses.map((address: any) => {
                  const formattedLines = formatAddressLines(address);

                  return formattedLines.length > 0 ? (
                    <a
                      href={address?.mapUrl || "#"}
                      class="phy"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {formattedLines.map((line: string, index: number) => (
                        <>
                          {line}
                          {index < formattedLines.length - 1 && <br />}
                        </>
                      ))}
                    </a>
                  ) : null;
                })}
            </div>
          ))
        }

        {
          sharedSocials.length > 0 && (
            <div class="social">
              {socialsTitle && <span class="fo-title">{socialsTitle}</span>}
              <ButtonGroup alignX="center">
                {sharedSocials.map((social: any) => (
                  <Button
                    variant="ghost"
                    size="lg"
                    iconName={social.icon}
                    link={social.link}
                    hideText="true"
                    aria-label={`Visit our ${social.icon} page`}
                    target="_blank"
                    rel="noopener noreferrer"
                  />
                ))}
              </ButtonGroup>
            </div>
          )
        }
      </div>

      <div class="fo-hours">
        <span class="fo-title">{officeHoursTitle}</span>
        {
          resolvedOffices.map((office: any) => (
            <div class="office-hours">
              {/* {office?.name && <span class="office-name">{office.name}</span>} */}
              <div class="office-hours-list">
                {(office?.officeHours || []).map((item: any) => (
                  <div class="office-hours-row">
                    <div class="office-hours-line">
                      <span class="office-hours-day">{item.day || ""}</span>
                      <span class="office-hours-time">{item.hours || ""}</span>
                    </div>
                    {(item?.note || item?.hoursNote || item?.["hours-note"]) && (
                      <small class="office-hours-note">
                        {item?.note || item?.hoursNote || item?.["hours-note"]}
                      </small>
                    )}
                  </div>
                ))}
              </div>
              {getOfficeHoursGeneralNotes(office).length > 0 && (
                <div class="office-hours-general-notes">
                  {getOfficeHoursGeneralNotes(office).map((note: string) => (
                    <small class="office-hours-general-note">{note}</small>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>

    {
      embedSrc && (
        <div class="footer-map-embed" aria-label="Map location">
          <iframe
            src={embedSrc}
            title="Office location map"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      )
    }

    <Divider />

    <div class="footer-content">
      <div class="content-container">
        <div class="footer-legal-text" id="copy">
          <span class="footer-legal-line footer-legal-line--primary">
            &copy;<span class="inline" id="copyDate">{copyYear}</span>
            {displaySiteName}
          </span>
          {
            legalLinks.length > 0 && (
              <span class="footer-legal-separator" aria-hidden="true">
                |
              </span>
            )
          }
          {
            legalLinks.length > 0 && (
              <span class="footer-legal-line footer-legal-line--links">
                {legalLinks.map((item: any, index: number) => (
                  <>
                    <a href={item.path || "#"}>{item.name || "Link"}</a>
                    {index < legalLinks.length - 1 && <span class="mx-2">|</span>}
                  </>
                ))}
              </span>
            )
          }
          <span class="footer-legal-separator" aria-hidden="true">|</span>
          <span class="footer-legal-line footer-legal-line--credit">
            Site designed and maintained by{" "}
            <a href="https://www.tntdental.com" target="_blank" rel="noopener noreferrer">
              TNT Dental
            </a>
          </span>
        </div>
        {blurb && <p class="footer-legal-blurb">{blurb}</p>}
      </div>
    </div>
  </CustomSection>
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    .footer {
      container-type: inline-size;

      &[data-fixed-tabs-active="true"] {
        @media (max-width: 1024px) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom));
        }
      }

      .button-group {
        &.align-end {
          @container (max-width: 599px) {
            justify-content: center;
          }
        }


      }

      .footer-content {
        @container (min-width: 600px) {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
        }

        .content-container {
          flex: 1;

          > a {
            display: block;
            text-align: center;
          }
        }
      }

      .footer-map-embed {
        margin-block: var(--spacing-lg);

        iframe {
          aspect-ratio: 16 / 9;
          border: 0;
          border-radius: var(--radius-md);
          display: block;
          width: 100%;
        }
      }

      .footer-legal-text {
        color: var(--color-text-muted);
        text-align: center;
        @container (min-width: 600px) {
          text-align: start;
        }
      }

      .footer-legal-blurb {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        line-height: var(--line-height-relaxed);
        margin-top: var(--spacing-sm);
        text-align: center;

        @container (min-width: 600px) {
          text-align: start;
        }
      }

      .footer-logo {
        flex-shrink: 0;
        margin-top: 0 !important;

        img {
          margin: 0 auto 30px;
          width: auto;
        }
      }

      .bar .bar-list {
        flex-flow: column wrap;
        @container (min-width: 600px) {
          flex-direction: row;
          justify-content: end;
        }
      }

      .fo-content {
        margin-block: var(--spacing-lg);

        @container (min-width: 700px) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fo-title {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-sm);
          text-align: center;
        }

        .office-block,
        .office-hours-block {
          margin-bottom: var(--spacing-md);
        }

        .office-name {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-xs);
        }

        .pho,
        .phy {
          color: var(--color-text);
          display: block;
          margin-bottom: var(--spacing-sm);
          text-decoration: none;

          &:hover,
          &:focus-visible {
            color: var(--color-link-hover);
          }
        }

        .pho {
          color: var(--footer-phone-link-color, var(--color-text));

          &:hover,
          &:focus-visible {
            color: var(--footer-phone-link-hover-color, var(--color-link-hover));
          }
        }

        .phy {
          color: var(--footer-address-link-color, var(--color-text));

          &:hover,
          &:focus-visible {
            color: var(--footer-address-link-hover-color, var(--color-link-hover));
          }
        }

        .office-hours {
          display: table;
          margin: 10px auto;
          text-align: left;

          .fo-title { text-align: center; }
        }

        .social {
          margin-top: var(--spacing-sm); 

          .button{min-width: auto;}
        }
      }
    }

    #copy {
      font-size: var(--font-size-sm);
      line-height: 1.5;
      padding: var(--spacing-md) var(--spacing-sm);
      text-align: center;

      .footer-legal-line {
        display: inline;
      }

      .footer-legal-separator {
        display: inline;
        margin: 0 0.5rem;
      }

      a {
        color: var(--color-link);

        &:hover,
        &:focus-visible {
          color: var(--color-link-hover);
        }
      }

      @media (max-width: 1024px) {
        .footer-legal-line {
          display: block;
        }

        .footer-legal-line + .footer-legal-line {
          margin-top: 0.25rem;
        }

        .footer-legal-separator {
          display: none;
        }
      }
    }
  }
</style>

<style lang="pcss" is:global>
  /* ----------------------------------------------------------------------
     Source footer architecture (newteethhouston.com)

     `mig chrome` fills the footer's data and colour but not its arrangement.
     The source is a single three-column row inside a 1200px container, with a
     separate full-bleed dark bar beneath it:

       #fo-contents (row, align center, max 1200, pad 60/20)
         .fo-info    Contact / phone / address / Office Hours table
         a.logo      the big apple logo, centred
         .fo-social  "Connect with us" + three 70px colour circles
       #copy         full-bleed #292929 bar: copyright, legal links, TNT credit

     The template stacks instead: a full-width logo block on top, then contact
     and hours side by side with the socials nested inside the contact column,
     and the legal row on the page background. 864px against the source's 605px,
     but the shape was the real mismatch.

     `.fo-content` and `.fo-info` are flattened with `display: contents` so
     their children become items of one grid on the footer's content box —
     that is what lets the socials sit in their own column while staying
     nested in the markup.

     DELIBERATELY UNLAYERED. `.fo-content` carries Tailwind's `lg:flex`, and
     Tailwind's generated utilities are unlayered, so an `@layer source-bridge`
     rule loses to them however specific it is — an unlayered declaration beats
     every layered one. Written in the cascade's unlayered origin instead, where
     specificity decides; every selector is scoped under `.footer`.

     Gated at the source's own 1025px breakpoint — below it the template's
     stacked footer is already the right answer.
     ---------------------------------------------------------------------- */
  @media (min-width: 1025px) {
    .footer > .custom-section > .outer-content > .content {
      align-items: center;
      column-gap: 40px;
      display: grid;
      grid-template-areas:
        "contact logo social"
        "office  logo social"
        "hours   logo social"
        "legal   legal legal";
      grid-template-columns: 1fr 330px 1fr;
      margin: 0 auto;
      max-width: 1200px;
      padding: 60px 20px 0;
    }

    /* Flatten the two wrappers so their children land on the grid above. */
    .footer .fo-content,
    .footer .fo-content .fo-info {
      display: contents;
    }

    .footer .fo-info > .fo-title {
      grid-area: contact;
    }

    .footer .fo-info > .office-block {
      grid-area: office;
    }

    .footer .fo-hours {
      grid-area: hours;
    }

    .footer .fo-info > .social {
      grid-area: social;
    }

    .footer .footer-content:has(.footer-logo) {
      grid-area: logo;
    }

    .footer .footer-content:has(.footer-legal-text) {
      grid-area: legal;
    }

    /* The source separates the bands with the dark bar, not a rule. */
    .footer .divider {
      display: none;
    }

    /* ---- left column: contact + hours, stacked and centred ---- */
    .footer .fo-info > .fo-title,
    .footer .fo-hours > .fo-title,
    .footer .social > .fo-title {
      color: #292929;
      display: block;
      font: 500 14px/1 aktiv-grotesk-extended, sans-serif;
      letter-spacing: 1px;
      text-align: center;
      text-transform: uppercase;
    }

    .footer .social > .fo-title {
      margin-bottom: 20px;
    }

    /* The source footer's contact column is title / phone / address — it does
       not repeat the practice name, which the template prints from
       `office.name`. */
    .footer .fo-info .office-block .office-name {
      display: none;
    }

    .footer .fo-info > .office-block {
      text-align: center;
    }

    .footer .fo-info .pho {
      display: block;
      font: 500 26px/1.2 aktiv-grotesk-extended, sans-serif;
      margin: 10px auto;
      text-align: center;
    }

    /* The source footer lists phone and address only — no email. */
    .footer .fo-info .office-block a[href^="mailto:"] {
      display: none;
    }

    /* ---- centre column: the logo ---- */
    .footer .footer-content:has(.footer-logo) {
      display: block;
    }

    .footer .footer-content:has(.footer-logo) .content-container,
    .footer .footer-content:has(.footer-logo) a {
      display: block;
      width: 100%;
    }

    .footer .footer-content:has(.footer-logo) :is(img, .image) {
      height: auto;
      margin: 0 auto;
      max-width: 330px;
      width: 100%;
    }

    /* ---- the full-bleed dark legal bar ---- */
    /* The source's #copy is a sibling of the 1200px container and spans the
       whole viewport, so it is pulled back out to full width here. */
    /* Full-bleed WITHOUT `width: 100vw` + a negative margin: `100vw` counts the
       scrollbar, so that version pushed the document to 1307px at a 1280
       viewport — a horizontal scrollbar on desktop, which `mig qa` fails on.
       Painting the band with a large box-shadow instead keeps the element at
       its normal width (shadows never add to scrollable overflow), and the
       clip-path stops the shadow bleeding vertically into the row above. */
    .footer .footer-content:has(.footer-legal-text) {
      background-color: #292929;
      box-shadow: 0 0 0 100vmax #292929;
      clip-path: inset(0 -100vmax);
      color: #fff;
      font: 400 15px/1.5 figtree, sans-serif;
      margin-top: 60px;
      padding: 12px 10px;
    }

    .footer .footer-content:has(.footer-legal-text) .content-container {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      justify-content: center;
      margin: 0 auto;
      max-width: 1280px;
    }

    /* "Site designed and maintained by TNT Dental" is one phrase in the source
       and was breaking across two lines here. */
    .footer .footer-legal-line--credit {
      white-space: nowrap;
    }

    .footer .footer-content:has(.footer-legal-text) :is(span, p) {
      color: #fff;
    }

    .footer .footer-content:has(.footer-legal-text) a {
      color: #9ecae1;
      text-decoration: underline;
    }

    .footer .footer-content:has(.footer-legal-text) a:hover {
      color: #fff;
    }

    /* The TNT credit is not one of the legal links and stays white. */
    .footer .footer-legal-line--credit a {
      color: #fff;
      text-decoration: none;
    }

    .footer .footer-legal-line--credit a:hover {
      color: #9ecae1;
    }
  }

  /* ---- colour social circles, at every width ----
     Also unlayered, and deliberately outside the 1025px gate: the circles are
     the design at every width, not a desktop enhancement. Below it the
     template falls back to ghost icon buttons, and `Button`'s
     `@media (max-width: 768px) { .button { display: block } }` additionally
     breaks the flex centring the icon relies on. Matched on href because the
     data model carries no per-network class. */
  .footer .fo-info > .social {
    margin: 0 auto;
    max-width: 220px;
    width: 100%;
  }

  .footer .social .button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    width: 100%;
  }

  .footer .social .button-group .button {
    align-items: center;
    border: none;
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex: 0 0 70px;
    height: 70px;
    justify-content: center;
    margin: 0;
    min-width: 0;
    padding: 0;
    transition: 0.3s all;
    width: 70px;
  }

  .footer .social .button-group .button .icon {
    color: #fff;
    font-size: 33px;
  }

  .footer .social .button-group .button[href*="facebook"] {
    background-color: #4d70a8;
  }

  .footer .social .button-group .button[href*="goo.gl"],
  .footer .social .button-group .button[href*="google"] {
    background-color: #dc4e41;
  }

  .footer .social .button-group .button[href*="instagram"] {
    background-color: transparent;
    background-image: url("/assets/images/instagram-bg.svg");
    background-size: cover;
  }

  .footer .social .button-group .button:hover {
    background-color: #2b8435;
    background-image: none;
  }

  /* `_chrome.pcss`'s ported `footer a` pins every footer link to 17px, which in
     the legal bar leaves the links a size larger than the text they sit in.
     Unlayered so it beats that `source-bridge` rule. */
  .footer #copy a {
    font-size: inherit;
    line-height: inherit;
  }
</style>
