---
/**
 * Footer — rebuilt by hand to match the source: a teal-to-lime gradient band
 * with a row of secondary links across the top, then the white logo, the
 * contact block and circular social icons, and finally the copyright line.
 *
 * The prop surface is unchanged, so `footer.json` and `siteInfo.json` still
 * drive it.
 */
import Icon from "@core-elements/icon/Icon.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  links = [],
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = "",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  mapEmbedUrl = "",
  legalBlurb = "",
  logoSource,
  logoAlt = "Logo",
  _component,
  ...htmlAttributes
} = Astro.props;

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [{ lines: addressLines, mapUrl: addressHref || "" }]
                : [],
            phones: phoneText ? [{ display: phoneText, href: phoneHref || "" }] : [],
            emails: emailText ? [{ display: emailText, href: emailHref || "" }] : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials) && resolvedOffices[0].socials.length > 0
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const office = resolvedOffices[0] ?? {};
const address = office?.addresses?.[0];
const phone = office?.phones?.[0];
const email = office?.emails?.[0];

const addressText = address
  ? [
      ...(Array.isArray(address.lines) ? address.lines : []),
      [address.city, [address.state, address.postalCode].filter(Boolean).join(" ")]
        .filter(Boolean)
        .join(", "),
    ]
      .filter((line: string) => line && line.trim().length > 0)
      .join(", ")
  : "";

// Collapse the weekly hours into the source's one-line summary, e.g.
// "Monday to Thursday: 8:00 AM - 5:00 PM". Closed days are left out.
const isClosed = (hours: string) => !hours || /closed/i.test(hours);
const hoursSummary: string[] = [];
for (const entry of Array.isArray(office?.officeHours) ? office.officeHours : []) {
  const hours = String(entry?.hours || "").trim();
  if (isClosed(hours)) continue;
  const day = String(entry?.day || "").trim();
  const last = hoursSummary.length > 0 ? hoursSummary[hoursSummary.length - 1] : null;
  if (last && last.hours === hours) {
    last.end = day;
  } else {
    hoursSummary.push({ start: day, end: "", hours } as any);
  }
}
const hoursLines = (hoursSummary as any[]).map((group) =>
  group.end ? `${group.start} to ${group.end}: ${group.hours}` : `${group.start}: ${group.hours}`
);

const copyYear = new Date().getFullYear();
const embedSrc = typeof mapEmbedUrl === "string" ? mapEmbedUrl.trim() : "";
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";

// The address / phone / email already have their own rows below, so keep them
// out of the link bar even when they were captured into `links`.
const skipInLinkBar = new Set(
  [addressText, phone?.display, email?.display, "E-mail Us"].filter(Boolean) as string[]
);
const navLinks = (Array.isArray(links) ? links : []).filter(
  (item: any) => item?.name && !skipInLinkBar.has(item.name)
);
---

<footer class="footer" {...htmlAttributes}>
  <div class="footer-inner">
    {
      navLinks.length > 0 && (
        <nav class="footer-links" aria-label="Footer">
          {navLinks.map((item: any) => (
            <a href={item.path || "#"}>{item.name}</a>
          ))}
        </nav>
      )
    }

    <div class="footer-main">
      <div class="footer-logo">
        <a href="/">
          <img src={logoSource} alt={logoAlt} />
        </a>
      </div>

      <div class="footer-contact">
        {
          addressText && (
            <a href={address?.mapUrl || "#"} target="_blank" rel="noopener noreferrer">
              <Icon name="map-pin" size="none" />
              <span>{addressText}</span>
            </a>
          )
        }
        {
          phone?.display && (
            <a href={phone.href || "#"}>
              <Icon name="phone" size="none" />
              <span>Call Us Today: {phone.display}</span>
            </a>
          )
        }
        {
          email?.display && (
            <a href={email.href || "#"}>
              <Icon name="envelope" size="none" />
              <span>E-mail Us</span>
            </a>
          )
        }
        {
          hoursLines.map((line: string) => (
            <span class="footer-hours">
              <Icon name="clock" size="none" />
              <span>{line}</span>
            </span>
          ))
        }
      </div>

      {
        sharedSocials.length > 0 && (
          <div class="footer-social">
            {sharedSocials.map((social: any) => (
              <a
                href={social.link}
                aria-label={social.label || "Social link"}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={social.icon} size="none" />
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      embedSrc && (
        <div class="footer-map-embed">
          <iframe
            src={embedSrc}
            title="Office location map"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      )
    }

    <div class="footer-copy">
      <p>
        &copy; {copyYear} {displaySiteName}. All Rights Reserved.
        {
          legalLinks.length > 0 &&
            legalLinks.map((item: any) => (
              <>
                <span class="footer-copy-sep" aria-hidden="true">
                  |
                </span>
                <a href={item.path || "#"}>{item.name || "Link"}</a>
              </>
            ))
        }
        <span class="footer-copy-sep" aria-hidden="true">|</span>
        Site maintained by{" "}
        <a href="https://www.tntdental.com" target="_blank" rel="noopener noreferrer">
          TNT Dental
        </a>
      </p>
      {blurb && <p class="footer-blurb">{blurb}</p>}
    </div>
  </div>
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    .footer {
      background: linear-gradient(-35deg, #177982, #5f7915);
      width: 100%;

      &[data-fixed-tabs-active="true"] {
        @media (max-width: 1024px) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom));
        }
      }
    }

    .footer .footer-inner {
      box-sizing: border-box;
      margin-inline: auto;
      max-width: 1300px;
      padding: 30px 15px 15px;
      width: 100%;
    }

    /* ---- Secondary link bar (desktop only, matching the source) ---- */
    .footer .footer-links {
      display: none;
    }

    @media (min-width: 992px) {
      .footer .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        padding-bottom: 30px;
      }
    }

    .footer .footer-links a {
      color: #fff;
      text-decoration: none;
    }

    .footer .footer-links a:hover {
      text-decoration: underline;
    }

    /* ---- Logo · contact · social ---- */
    .footer .footer-main {
      align-items: center;
      display: grid;
      gap: 30px;
      grid-template-columns: 1fr;
      text-align: center;
    }

    @media (min-width: 1025px) {
      .footer .footer-main {
        grid-template-columns: 3fr 5fr 4fr;
        text-align: left;
      }
    }

    .footer .footer-logo img {
      display: inline-block;
      height: 60px;
      width: auto;
    }

    @media (min-width: 768px) and (max-width: 1199px) {
      .footer .footer-logo img {
        height: 45px;
      }
    }

    .footer .footer-contact {
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .footer .footer-contact a,
    .footer .footer-contact .footer-hours {
      align-items: baseline;
      color: #fff;
      display: inline-flex;
      gap: 0.5em;
      justify-content: center;
      text-decoration: none;
    }

    @media (min-width: 1025px) {
      .footer .footer-contact a,
      .footer .footer-contact .footer-hours {
        justify-content: flex-start;
      }
    }

    .footer .footer-contact a:hover {
      text-decoration: underline;
    }

    .footer .footer-contact .icon {
      flex-shrink: 0;
      font-size: 1em;
    }

    /* ---- Social circles ---- */
    .footer .footer-social {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
    }

    @media (min-width: 1025px) {
      .footer .footer-social {
        justify-content: flex-end;
      }
    }

    .footer .footer-social a {
      align-items: center;
      background: #fff;
      border: 2px solid #177982;
      border-radius: 50%;
      color: #177982;
      display: inline-flex;
      height: 44px;
      justify-content: center;
      transition:
        background 0.3s ease,
        color 0.3s ease;
      width: 44px;
    }

    .footer .footer-social a:hover {
      background: #177982;
      color: #fff;
    }

    .footer .footer-social .icon {
      font-size: 20px;
    }

    .footer .footer-social svg {
      height: 20px;
      width: 20px;
    }

    /* ---- Map ---- */
    .footer .footer-map-embed {
      margin-top: 30px;
    }

    .footer .footer-map-embed iframe {
      aspect-ratio: 16 / 9;
      border: 0;
      display: block;
      width: 100%;
    }

    /* ---- Copyright ---- */
    .footer .footer-copy {
      padding-block: 30px 15px;
      text-align: center;
    }

    @media (min-width: 768px) {
      .footer .footer-copy {
        text-align: left;
      }
    }

    .footer .footer-copy p {
      color: #fff;
      font-size: 14px;
      margin: 0;
    }

    @media (min-width: 1200px) {
      .footer .footer-copy p {
        font-size: 16px;
      }
    }

    .footer .footer-copy a {
      color: #fff;
      text-decoration: underline;
    }

    .footer .footer-copy-sep {
      margin-inline: 0.5rem;
    }

    .footer .footer-blurb {
      margin-top: 0.5rem;
      opacity: 0.9;
    }
  }
</style>
