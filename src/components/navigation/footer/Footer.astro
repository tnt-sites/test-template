---
import siteInfoData from "@data/siteInfo.json";
import { Icon as AstroIcon } from "astro-icon/components";

const {
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  contactTitle = "Contact",
  officeHoursTitle = "Office Hours",
  logoAlt = "Medford Dental Wellness",
  creditText = "Maintained by",
  creditLink = "https://www.tntdental.com",
  _component,
  // Older settings, no longer shown in the redesigned footer.
  links,
  logoSource,
  phoneText,
  phoneHref,
  addressHref,
  addressLines,
  emailHref,
  emailText,
  officeHours,
  officeHoursNote,
  officeHoursNotes,
  mapEmbedUrl,
  legalBlurb,
  addressLinkColor,
  addressLinkHoverColor,
  phoneLinkColor,
  phoneLinkHoverColor,
  ...htmlAttributes
} = Astro.props;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const displaySiteName = siteName || (siteInfoData as any).siteName || "";

const sharedSocials =
  Array.isArray(socials) && socials.length > 0 ? socials : ((siteInfoData as any).socials ?? []);

const formatAddress = (address: any) => {
  const lines = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");

  return [...lines, address?.city, stateAndPostal]
    .filter((part) => typeof part === "string" && part.trim().length > 0)
    .join(", ");
};

const getOfficeHoursGeneralNotes = (office: any) => {
  const notes = [
    office?.officeHoursNote,
    ...(Array.isArray(office?.officeHoursNotes) ? office.officeHoursNotes : []),
  ];

  return notes.filter((note) => typeof note === "string" && note.trim().length > 0);
};

const copyYear = new Date().getFullYear();
---

<footer class="footer" {...htmlAttributes}>
  <div class="main block text-center lg:text-left lg:flex justify-around items-start">
    <a class="logo" href="/" aria-label={logoAlt}>
      <AstroIcon name="medford-logo-stacked" aria-hidden="true" />
    </a>

    <div class="contact">
      <h2>{contactTitle}</h2>
      {
        resolvedOffices.map((office: any) => (
          <div>
            {office?.name && <span>{office.name}</span>}
            {Array.isArray(office?.phones) &&
              office.phones.map((phone: any) =>
                phone?.display ? (
                  <a href={phone?.href || undefined} class="phone">
                    {phone?.label ? `${phone.label}: ` : ""}
                    {phone.display}
                  </a>
                ) : null
              )}
            {Array.isArray(office?.addresses) &&
              office.addresses.map((address: any) =>
                formatAddress(address) ? (
                  <a
                    href={address?.mapUrl || undefined}
                    class="address"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {formatAddress(address)}
                  </a>
                ) : null
              )}
            {Array.isArray(office?.emails) &&
              office.emails.map((email: any) =>
                email?.display ? (
                  <a href={email?.href || undefined} class="address">
                    {email.display}
                  </a>
                ) : null
              )}
          </div>
        ))
      }
      {
        sharedSocials.length > 0 && (
          <ul class="socials no-check flex justify-center lg:justify-start">
            {sharedSocials.map((social: any) => (
              <li>
                <a
                  href={social.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label || social.icon}
                >
                  <AstroIcon name={social.icon} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="hours">
      <h2>{officeHoursTitle}</h2>
      {
        resolvedOffices.map((office: any) => (
          <div class="office-hours">
            <div class="office-hours-list">
              {(office?.officeHours || []).map((item: any) => (
                <div class="office-hours-row">
                  <div class="office-hours-line">
                    <span class="office-hours-day">{item.day || ""}</span>
                    <span class="office-hours-time">{item.hours || ""}</span>
                  </div>
                  {item?.note && <small class="office-hours-note">{item.note}</small>}
                </div>
              ))}
            </div>
            {getOfficeHoursGeneralNotes(office).map((note: string) => (
              <small class="office-hours-general-note">{note}</small>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="bottom block text-center lg:flex justify-around items-center">
    <p>&copy;{copyYear} {displaySiteName}</p>
    {
      legalLinks.length > 0 && (
        <p class="legal">
          {legalLinks.map((item: any, index: number) => (
            <>
              <a href={item.path || undefined}>{item.name || "Link"}</a>
              {index < legalLinks.length - 1 && <span aria-hidden="true"> | </span>}
            </>
          ))}
        </p>
      )
    }
    <p class="credit">
      {creditText}
      <a href={creditLink} target="_blank" rel="noopener noreferrer" aria-label="TNT Dental">
        <AstroIcon name="tnt-dental" aria-hidden="true" />
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: #0a1a24;
    color: var(--gray-0);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer p {
    color: inherit;
    margin: 0;
  }

  /* ---- Main band: logo, contact, office hours ---- */
  .main {
    background: var(--color-brand-secondary);
    padding: 55px 25px;
  }

  .footer .logo {
    color: #657c8b;
    display: block;
    margin: 0 auto 40px;
    max-width: 355px;
  }

  .footer .logo:hover {
    color: var(--gray-0);
  }

  .logo :global(svg) {
    display: block;
    height: auto;
    width: 100%;
  }

  h2 {
    color: var(--gray-0);
    font-family: var(--font-accent);
    font-size: 22px;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .contact {
    margin-bottom: 40px;
  }

  .contact > div {
    display: flex;
    flex-direction: column;
  }

  .phone {
    font-size: 32px;
    line-height: 1.1;
  }

  .address {
    font-size: 17px;
    letter-spacing: 0.03em;
    margin-top: 5px;
  }

  .phone:hover,
  .address:hover {
    color: var(--color-brand-muted);
  }

  .socials {
    gap: 10px;
    margin: 25px 0 0;
    padding: 0;
  }

  .socials li {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer .socials a {
    align-items: center;
    color: var(--gray-0);
    background: #0a1a24;
    border-radius: 50%;
    display: flex;
    height: 70px;
    justify-content: center;
    width: 70px;
  }

  .footer .socials a:hover {
    background: var(--color-brand);
  }

  .socials :global(svg) {
    height: 20px;
    width: 20px;
  }

  /* Social icons have no fill of their own. */
  .socials :global(svg *) {
    fill: currentColor;
  }

  /* Office hours list colours (the shared office-hours styles use these variables). */
  .hours .office-hours {
    --office-hours-color: var(--gray-0);
    --office-hours-day-color: var(--gray-0);
    --office-hours-day-width: 130px;
    --office-hours-gap: 0;

    display: inline-block;
    font-size: 18px;
    text-align: left;
  }

  .hours :global(.office-hours-day) {
    font-weight: var(--font-weight-normal);
  }

  .hours :global(.office-hours-row + .office-hours-row) {
    margin-top: 5px;
  }

  /* ---- Bottom bar ---- */
  .bottom {
    font-size: 19px;
    padding: 15px 25px;
  }

  .bottom p {
    margin: 10px 0;
  }

  .legal a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal a:hover {
    color: var(--color-brand-muted);
  }

  .credit {
    align-items: center;
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .credit :global(svg) {
    display: block;
    height: 45px;
    width: auto;
  }

  @media (min-width: 1024px) {
    .main,
    .bottom {
      padding-left: 80px;
      padding-right: 80px;
    }

    .footer .logo {
      align-self: center;
      margin: 0;
      width: 355px;
    }

    .contact,
    .hours {
      margin: 50px 0 0;
    }

    .phone {
      font-size: 38px;
    }

    .bottom {
      min-height: 80px;
    }
  }

  /* Leaves room above the mobile tab bar. */
  @media (max-width: 1024px) {
    .footer[data-fixed-tabs-active="true"] {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>
