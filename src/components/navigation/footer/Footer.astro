---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Button from "@core-elements/button/Button.astro";
import Divider from "@core-elements/divider/Divider.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  links = [],
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  contactTitle = "Contact Us",
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  followTitle = "Follow Us",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  mapEmbedUrl = "",
  legalBlurb = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  logoSource,
  logoAlt,
  followImages = [],
  _component,
  ...htmlAttributes
} = Astro.props;

const resolvedFollowImages = (Array.isArray(followImages) ? followImages : []).filter(
  (image: any) => image && typeof image.source === "string" && image.source.trim().length > 0
);

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const getOfficeHoursGeneralNotes = (office: any) => {
  const notes = [
    office?.officeHoursNote,
    office?.["office-hours-note"],
    ...(Array.isArray(office?.officeHoursNotes) ? office.officeHoursNotes : []),
    ...(Array.isArray(office?.["office-hours-notes"]) ? office["office-hours-notes"] : []),
  ];

  return notes.filter((note) => typeof note === "string" && note.trim().length > 0);
};

const copyYear = new Date().getFullYear();
const embedSrc = typeof mapEmbedUrl === "string" ? mapEmbedUrl.trim() : "";
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";
const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};
const footerStyle = [
  getColorValue(addressLinkColor)
    ? `--footer-address-link-color: ${getColorValue(addressLinkColor)}`
    : "",
  getColorValue(addressLinkHoverColor)
    ? `--footer-address-link-hover-color: ${getColorValue(addressLinkHoverColor)}`
    : "",
  getColorValue(phoneLinkColor)
    ? `--footer-phone-link-color: ${getColorValue(phoneLinkColor)}`
    : "",
  getColorValue(phoneLinkHoverColor)
    ? `--footer-phone-link-hover-color: ${getColorValue(phoneLinkHoverColor)}`
    : "",
]
  .filter(Boolean)
  .join("; ");
---

<footer class="footer" style={footerStyle || undefined} {...htmlAttributes}>
  <CustomSection maxContentWidth="2xl" paddingHorizontal="md" paddingVertical="2xl">
    <div class="footer-content">
      <div class="content-container">
        <a href="/">
          <Image source={logoSource} alt={logoAlt} class="footer-logo" editable={false} />
        </a>
      </div>
      <!-- <div class="content-container">
        <Bar navData={links} />
      </div> -->
    </div>

    <div id="fo-content" class="fo-content block lg:flex justify-around items-start text-center">
      <div class="fo-info">
        <span class="fo-title">{contactTitle}</span>
        {
          resolvedOffices.map((office: any) => (
            <div class="office-block">
              {office?.name && <span class="office-name">{office.name}</span>}
              {Array.isArray(office?.phones) &&
                office.phones.map((phone: any) =>
                  phone?.display ? (
                    <a href={phone?.href || "#"} class="pho">
                      {phone?.label ? `${phone.label}: ` : ""}
                      {phone.display}
                    </a>
                  ) : null
                )}
              {Array.isArray(office?.emails) &&
                office.emails.map((email: any) =>
                  email?.display ? (
                    <a href={email?.href || "#"} class="pho">
                      {email?.label ? `${email.label}: ` : ""}
                      {email.display}
                    </a>
                  ) : null
                )}
              {Array.isArray(office?.addresses) &&
                office.addresses.map((address: any) => {
                  const formattedLines = formatAddressLines(address);

                  return formattedLines.length > 0 ? (
                    <a
                      href={address?.mapUrl || "#"}
                      class="phy"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {formattedLines.map((line: string, index: number) => (
                        <>
                          {line}
                          {index < formattedLines.length - 1 && <br />}
                        </>
                      ))}
                    </a>
                  ) : null;
                })}
            </div>
          ))
        }

      </div>

      <div class="fo-hours">
        <span class="fo-title">{officeHoursTitle}</span>
        {
          resolvedOffices.map((office: any) => (
            <div class="office-hours">
              {/* {office?.name && <span class="office-name">{office.name}</span>} */}
              <div class="office-hours-list">
                {(office?.officeHours || []).map((item: any) => (
                  <div class="office-hours-row">
                    <div class="office-hours-line">
                      <span class="office-hours-day">{item.day || ""}</span>
                      <span class="office-hours-time">{item.hours || ""}</span>
                    </div>
                    {(item?.note || item?.hoursNote || item?.["hours-note"]) && (
                      <small class="office-hours-note">
                        {item?.note || item?.hoursNote || item?.["hours-note"]}
                      </small>
                    )}
                  </div>
                ))}
              </div>
              {getOfficeHoursGeneralNotes(office).length > 0 && (
                <div class="office-hours-general-notes">
                  {getOfficeHoursGeneralNotes(office).map((note: string) => (
                    <small class="office-hours-general-note">{note}</small>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>

      {
        (sharedSocials.length > 0 || resolvedFollowImages.length > 0) && (
          <div class="fo-follow">
            <hr class="fo-follow-divider" />

            {sharedSocials.length > 0 && (
              <div class="fo-follow-socials">
                {followTitle && <span class="fo-title">{followTitle}</span>}
                <div class="social">
                  <ButtonGroup alignX="center">
                    {sharedSocials.map((social: any) => (
                      <Button
                        variant="ghost"
                        size="lg"
                        iconName={social.icon}
                        link={social.link}
                        hideText="true"
                        aria-label={`Visit our ${social.icon} page`}
                        target="_blank"
                        rel="noopener noreferrer"
                      />
                    ))}
                  </ButtonGroup>
                </div>
              </div>
            )}

            {resolvedFollowImages.length > 0 && (
            <div class="flex-imgs">
              {resolvedFollowImages.map((image: any) => {
                const figure = (
                  <Image
                    source={image.source}
                    alt={image.alt || ""}
                    class="fo-follow-image"
                    editable={false}
                  />
                );

                return image.link ? (
                  <a href={image.link} target="_blank" rel="noopener noreferrer">
                    {figure}
                  </a>
                ) : (
                  figure
                );
              })}
            </div>
            )}
          </div>
        )
      }
    </div>

    {
      embedSrc && (
        <div class="footer-map-embed" aria-label="Map location">
          <iframe
            src={embedSrc}
            title="Office location map"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      )
    }

    <Divider />

    <div class="footer-content">
      <div class="content-container">
        <div class="footer-legal-text" id="copy">
          <span class="footer-legal-line footer-legal-line--primary">
            &copy;<span class="inline" id="copyDate">{copyYear}</span>
            {displaySiteName}
          </span>
          {
            legalLinks.length > 0 && (
              <span class="footer-legal-separator" aria-hidden="true">
                |
              </span>
            )
          }
          {
            legalLinks.length > 0 && (
              <span class="footer-legal-line footer-legal-line--links">
                {legalLinks.map((item: any, index: number) => (
                  <>
                    <a href={item.path || "#"}>{item.name || "Link"}</a>
                    {index < legalLinks.length - 1 && <span class="mx-2">|</span>}
                  </>
                ))}
              </span>
            )
          }
          <span class="footer-legal-separator" aria-hidden="true">|</span>
          <span class="footer-legal-line footer-legal-line--credit">
            Site designed and maintained by{" "}
            <a href="https://www.tntdental.com" target="_blank" rel="noopener noreferrer">
              TNT Dental
            </a>
          </span>
        </div>
        {blurb && <p class="footer-legal-blurb">{blurb}</p>}
      </div>
    </div>
  </CustomSection>
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    .footer {
      container-type: inline-size;

      &[data-fixed-tabs-active="true"] {
        @media (max-width: 1024px) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom));
        }
      }

      .button-group {
        &.align-end {
          @container (max-width: 599px) {
            justify-content: center;
          }
        }


      }

      .footer-content {
        @container (min-width: 600px) {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
        }

        .content-container {
          flex: 1;

          > a {
            display: block;
            text-align: center;
          }
        }
      }

      .footer-map-embed {
        margin-block: var(--spacing-lg);

        iframe {
          aspect-ratio: 16 / 9;
          border: 0;
          border-radius: var(--radius-md);
          display: block;
          width: 100%;
        }
      }

      .footer-legal-text {
        color: var(--color-text-muted);
        text-align: center;
        @container (min-width: 600px) {
          text-align: start;
        }
      }

      .footer-legal-blurb {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        line-height: var(--line-height-relaxed);
        margin-top: var(--spacing-sm);
        text-align: center;

        @container (min-width: 600px) {
          text-align: start;
        }
      }

      .footer-logo {
        flex-shrink: 0;
        margin-top: 0 !important;

        img {
          margin: 0 auto 30px;
          width: auto;
        }
      }

      .bar .bar-list {
        flex-flow: column wrap;
        @container (min-width: 600px) {
          flex-direction: row;
          justify-content: end;
        }
      }

      .fo-content {
        margin-block: var(--spacing-lg);

        @container (min-width: 700px) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fo-title {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-sm);
          text-align: center;
        }

        .office-block,
        .office-hours-block {
          margin-bottom: var(--spacing-md);
        }

        .office-name {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-xs);
        }

        .pho,
        .phy {
          color: var(--color-text);
          display: block;
          margin-bottom: var(--spacing-sm);
          text-decoration: none;

          &:hover,
          &:focus-visible {
            color: var(--color-link-hover);
          }
        }

        .pho {
          color: var(--footer-phone-link-color, var(--color-text));

          &:hover,
          &:focus-visible {
            color: var(--footer-phone-link-hover-color, var(--color-link-hover));
          }
        }

        .phy {
          color: var(--footer-address-link-color, var(--color-text));

          &:hover,
          &:focus-visible {
            color: var(--footer-address-link-hover-color, var(--color-link-hover));
          }
        }

        .office-hours {
          display: table;
          margin: 10px auto;
          text-align: left;

          .fo-title { text-align: center; }
        }

        .fo-follow-socials{display: flex; align-items: center; justify-content: center; .fo-title{margin: 0;}}

        .social {
          margin-left: 10px;

          .button{min-width: auto;}
        }
      }
    }

    #copy {
      font-size: var(--font-size-sm);
      line-height: 1.5;
      padding: var(--spacing-md) var(--spacing-sm);
      text-align: center;

      .footer-legal-line {
        display: inline;
      }

      .footer-legal-separator {
        display: inline;
        margin: 0 0.5rem;
      }

      a {
        color: var(--color-link);
              font-size: var(--font-size-sm);


        &:hover,
        &:focus-visible {
          color: var(--color-link-hover);
        }
      }

      @media (max-width: 1024px) {
        .footer-legal-line {
          display: block;
        }

        .footer-legal-line + .footer-legal-line {
          margin-top: 0.25rem;
        }

        .footer-legal-separator {
          display: none;
        }
      }
    }
  }

@layer source-bridge {
  footer {
    background-color: var(--color-bg, #ffffff);
    color: var(--src-color2, #000000);
    position: relative;
  }

  footer a {
    color: var(--color-text, #32302f);
    font-family: jost, sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 21.6px;
  }

  footer a:hover {
    color: #a3c90d;
  }

  footer p {
    color: var(--color-text, #32302f);
    font-family: jost, sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 25.2px;
  }

  footer .fo-title {
    color: #32302f;
    display: block;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 2px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  footer .content {
    max-width: 1150px;
  }

  footer .fo-follow-divider {
    background-color: #e0dedb;
    border: 0;
    height: 1px;
    margin: 0 0 24px;
    width: 100%;
  }

  footer .fo-follow-socials {
    text-align: center;
  }

  footer .fo-follow-socials .fo-title {
    text-align: center;
  }

  footer .social {
    display: flex;
    flex-wrap: nowrap;
    gap: 10px;
    justify-content: center;
  }

  footer .social .button-group {
    display: contents;
  }

  footer .social a {
    align-items: center;
    background-color: #118534;
    border-radius: 50%;
    color: #fff;
    display: inline-flex;
    height: 40px;
    justify-content: center;
    width: 40px;
  }

  footer .social a:hover {
    background-color: #a3c90d;
    color: #fff;
  }

  footer .social a svg {
    height: 16px;
    width: 16px;
  }

  footer hr.rule {
    display: none;
  }

  footer #fo-content {
    flex-wrap: wrap;
  }

  footer .fo-follow {
    flex: 0 0 100%;
    margin-top: 32px;
  }

  footer .fo-follow .flex-imgs {
    margin-top: 24px;
  }

  footer .flex-imgs {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }

  footer .flex-imgs img {
    aspect-ratio: 1;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  footer .footer-content:has(#copy) .content-container,
  footer #copy {
    margin-inline: auto;
    max-width: 1000px;
    text-align: center;
  }

  footer #copy a {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  footer::after {
    background: linear-gradient(270deg, #5ec4c8 0%, #a3c90d 50%, #118534 100%);
    content: "";
    height: 14px;
    inset: auto 0 0;
    position: absolute;
  }

  @media (min-width: 1025px) {
    footer .content {
      padding-inline: 0;
    }

    footer .outer-content > .content {
      align-items: start;
      column-gap: 168px;
      display: grid;
      grid-template-columns: 406px 576px;
      justify-content: center;
    }

    footer .footer-content:not(:has(#copy)) {
      grid-column: 1;
      grid-row: 1;
    }

    footer #fo-content {
      grid-column: 2;
      grid-row: 1;
    }

    footer .footer-content:has(#copy) {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 30px;
      width: 100%;
    }

    footer .footer-content:not(:has(#copy)) .footer-logo img {
      height: auto;
      margin: 0;
      max-width: 100%;
      width: 406px;
    }

    footer #fo-content {
      display: flex;
      gap: 40px;
      justify-content: space-between;
      text-align: left;
    }

    footer #fo-content .fo-info {
      flex: 0 0 191px;
    }

    footer #fo-content .fo-hours {
      flex: 0 0 271px;
    }

    footer #fo-content :is(.fo-info, .fo-hours),
    footer #fo-content :is(.fo-info, .fo-hours) :is(.fo-title, .pho, .phy, .office-block) {
      text-align: left;
    }

    footer #fo-content .pho,
    footer #fo-content .phy {
      display: block;
      margin-inline: 0;
    }

    footer .flex-imgs {
      grid-template-columns: repeat(4, 1fr);
    }
  }
}
</style>
