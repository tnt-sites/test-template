---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Button from "@core-elements/button/Button.astro";
import Divider from "@core-elements/divider/Divider.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import { Icon as AstroIcon } from "astro-icon/components";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  links = [],
  linkColumns = [],
  socialImages = [],
  copyright = null,
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  contactTitle = "Contact Us",
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  mapEmbedUrl = "",
  legalBlurb = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  logoSource,
  logoAlt,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const getOfficeHoursGeneralNotes = (office: any) => {
  const notes = [
    office?.officeHoursNote,
    office?.["office-hours-note"],
    ...(Array.isArray(office?.officeHoursNotes) ? office.officeHoursNotes : []),
    ...(Array.isArray(office?.["office-hours-notes"]) ? office["office-hours-notes"] : []),
  ];

  return notes.filter((note) => typeof note === "string" && note.trim().length > 0);
};

/*
 * A footer drawn as titled link columns, the way most WordPress themes build
 * one, rather than as the starter's contact/hours pair.
 *
 * The two are different enough that they are alternatives rather than
 * settings: the column footer has no office-hours table and the starter footer
 * has no place to put four headed lists. Whichever the *source* had wins, and
 * a site migrated from a theme without columns keeps the starter's layout
 * untouched — `linkColumns` is simply absent from its data.
 */
const columns = (Array.isArray(linkColumns) ? linkColumns : []).filter(
  (column: any) => column?.links?.length > 0 || column?.logo?.source
);
const hasColumns = columns.length > 0;
const brandImages = Array.isArray(socialImages) ? socialImages.filter((s: any) => s?.image && s?.link) : [];

const copyYear = new Date().getFullYear();
const embedSrc = typeof mapEmbedUrl === "string" ? mapEmbedUrl.trim() : "";
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";
const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};
const footerStyle = [
  getColorValue(addressLinkColor)
    ? `--footer-address-link-color: ${getColorValue(addressLinkColor)}`
    : "",
  getColorValue(addressLinkHoverColor)
    ? `--footer-address-link-hover-color: ${getColorValue(addressLinkHoverColor)}`
    : "",
  getColorValue(phoneLinkColor)
    ? `--footer-phone-link-color: ${getColorValue(phoneLinkColor)}`
    : "",
  getColorValue(phoneLinkHoverColor)
    ? `--footer-phone-link-hover-color: ${getColorValue(phoneLinkHoverColor)}`
    : "",
]
  .filter(Boolean)
  .join("; ");
---

<footer class="footer" style={footerStyle || undefined} {...htmlAttributes}>
  {
    hasColumns ? (
      <>
        <CustomSection maxContentWidth="2xl" paddingHorizontal="md" paddingVertical="2xl">
          <div class="footer-columns" style={`--footer-column-count:${columns.length}`}>
            {columns.map((column: any) => (
              <div class:list={["footer-column", column.brand && "footer-column--brand"]}>
                {column.logo?.source && (
                  <a href="/" class="footer-column-logo">
                    <Image
                      source={column.logo.source}
                      alt={column.logo.alt || logoAlt || displaySiteName}
                      editable={false}
                    />
                  </a>
                )}

                {brandImages.length > 0 && column.brand && (
                  <div class="footer-column-socials">
                    {brandImages.map((social: any) => (
                      <a
                        href={social.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={social.alt || "Social profile"}
                      >
                        <img
                          src={social.image}
                          alt={social.alt || ""}
                          width={social.width || 50}
                          height={social.width || 50}
                          loading="lazy"
                        />
                      </a>
                    ))}
                  </div>
                )}

                {column.title && (
                  <>
                    <h3 class="footer-column-title">{column.title}</h3>
                    <hr class="footer-column-rule" />
                  </>
                )}

                {column.links.map((link: any) => (
                  <a
                    href={link.path || "#"}
                    class:list={[
                      "footer-column-link",
                      link.iconAfter && "footer-column-link--trailing",
                      link.color && "footer-column-link--accent",
                    ]}
                    style={link.color ? `--footer-link-accent:${link.color}` : undefined}
                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {/*
                      `is:inline` rather than astro-icon's default: without it
                      the icon is emitted as a `<use>` pointing at a `<symbol>`
                      that astro-icon hoists to the icon's first appearance on
                      the page — and when that first appearance is a component
                      which inlines its own copy instead, the symbol is never
                      defined and the footer's icon renders as blank space.
                      Three of them did.
                    */}
                    {link.icon && !link.iconAfter && (
                      <AstroIcon name={link.icon} class="footer-column-icon" is:inline />
                    )}
                    <span>{link.name}</span>
                    {link.icon && link.iconAfter && (
                      <AstroIcon name={link.icon} class="footer-column-icon" is:inline />
                    )}
                  </a>
                ))}
              </div>
            ))}
          </div>
        </CustomSection>

        {(copyright?.text || copyright?.links?.length) && (
          <div class="footer-copyright">
            <div class="footer-copyright-inner">
              {copyright.text && <span>{copyright.text}</span>}
              {(copyright.links ?? []).map((link: any) => (
                <>
                  <span class="footer-copyright-separator" aria-hidden="true">
                    |
                  </span>
                  <a
                    href={link.path || "#"}
                    {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {link.name}
                  </a>
                </>
              ))}
            </div>
          </div>
        )}
      </>
    ) : (
    <CustomSection maxContentWidth="2xl" paddingHorizontal="md" paddingVertical="2xl">
      <div class="footer-content">
        <div class="content-container">
          <a href="/">
            <Image source={logoSource} alt={logoAlt} class="footer-logo" editable={false} />
          </a>
        </div>
        <!-- <div class="content-container">
          <Bar navData={links} />
        </div> -->
      </div>

      <div id="fo-content" class="fo-content block lg:flex justify-around items-start text-center">
        <div class="fo-info">
          <span class="fo-title">{contactTitle}</span>
          {
            resolvedOffices.map((office: any) => (
              <div class="office-block">
                {office?.name && <span class="office-name">{office.name}</span>}
                {Array.isArray(office?.phones) &&
                  office.phones.map((phone: any) =>
                    phone?.display ? (
                      <a href={phone?.href || "#"} class="pho">
                        {phone?.label ? `${phone.label}: ` : ""}
                        {phone.display}
                      </a>
                    ) : null
                  )}
                {Array.isArray(office?.emails) &&
                  office.emails.map((email: any) =>
                    email?.display ? (
                      <a href={email?.href || "#"} class="pho">
                        {email?.label ? `${email.label}: ` : ""}
                        {email.display}
                      </a>
                    ) : null
                  )}
                {Array.isArray(office?.addresses) &&
                  office.addresses.map((address: any) => {
                    const formattedLines = formatAddressLines(address);

                    return formattedLines.length > 0 ? (
                      <a
                        href={address?.mapUrl || "#"}
                        class="phy"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {formattedLines.map((line: string, index: number) => (
                          <>
                            {line}
                            {index < formattedLines.length - 1 && <br />}
                          </>
                        ))}
                      </a>
                    ) : null;
                  })}
              </div>
            ))
          }

          {
            sharedSocials.length > 0 && (
              <div class="social">
                <ButtonGroup alignX="center">
                  {sharedSocials.map((social: any) => (
                    <Button
                      variant="ghost"
                      size="lg"
                      iconName={social.icon}
                      link={social.link}
                      hideText="true"
                      aria-label={`Visit our ${social.icon} page`}
                      target="_blank"
                      rel="noopener noreferrer"
                    />
                  ))}
                </ButtonGroup>
              </div>
            )
          }
        </div>

        <div class="fo-hours">
          <span class="fo-title">{officeHoursTitle}</span>
          {
            resolvedOffices.map((office: any) => (
              <div class="office-hours">
                {/* {office?.name && <span class="office-name">{office.name}</span>} */}
                <div class="office-hours-list">
                  {(office?.officeHours || []).map((item: any) => (
                    <div class="office-hours-row">
                      <div class="office-hours-line">
                        <span class="office-hours-day">{item.day || ""}</span>
                        <span class="office-hours-time">{item.hours || ""}</span>
                      </div>
                      {(item?.note || item?.hoursNote || item?.["hours-note"]) && (
                        <small class="office-hours-note">
                          {item?.note || item?.hoursNote || item?.["hours-note"]}
                        </small>
                      )}
                    </div>
                  ))}
                </div>
                {getOfficeHoursGeneralNotes(office).length > 0 && (
                  <div class="office-hours-general-notes">
                    {getOfficeHoursGeneralNotes(office).map((note: string) => (
                      <small class="office-hours-general-note">{note}</small>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>

      {
        embedSrc && (
          <div class="footer-map-embed" aria-label="Map location">
            <iframe
              src={embedSrc}
              title="Office location map"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            />
          </div>
        )
      }

      <Divider />

      <div class="footer-content">
        <div class="content-container">
          <div class="footer-legal-text" id="copy">
            <span class="footer-legal-line footer-legal-line--primary">
              &copy;<span class="inline" id="copyDate">{copyYear}</span>
              {displaySiteName}
            </span>
            {
              legalLinks.length > 0 && (
                <span class="footer-legal-separator" aria-hidden="true">
                  |
                </span>
              )
            }
            {
              legalLinks.length > 0 && (
                <span class="footer-legal-line footer-legal-line--links">
                  {legalLinks.map((item: any, index: number) => (
                    <>
                      <a href={item.path || "#"}>{item.name || "Link"}</a>
                      {index < legalLinks.length - 1 && <span class="mx-2">|</span>}
                    </>
                  ))}
                </span>
              )
            }
            <span class="footer-legal-separator" aria-hidden="true">|</span>
            <span class="footer-legal-line footer-legal-line--credit">
              Site designed and maintained by{" "}
              <a href="https://www.tntdental.com" target="_blank" rel="noopener noreferrer">
                TNT Dental
              </a>
            </span>
          </div>
          {blurb && <p class="footer-legal-blurb">{blurb}</p>}
        </div>
      </div>
    </CustomSection>
    )
  }
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    /*
     * Column footer.
     *
     * Every value here reads a `--chrome-*` token measured from the source by
     * `wpmig dev-chrome`, with the starter's own token as the fallback. That
     * ordering is deliberate: a site migrated from a theme this file has never
     * seen still renders in the target's design rather than collapsing to
     * unstyled defaults, and a site that *was* measured looks like itself.
     */
    .footer:has(.footer-columns) {
      background: var(--chrome-footer-bg, transparent);
      border-top: var(--chrome-footer-border-top, none);
      color: var(--chrome-footer-color, var(--color-text));
      padding-block: var(--chrome-footer-pad-block, 0);
    }

    .footer .footer-columns {
      display: grid;
      /*
       * The column font belongs to the columns, not to the band around them.
       * The source sets a different family on each, and hoisting the column's
       * up one level happens to look identical here only because every visible
       * word is inside a column.
       */
      font-family: var(--chrome-footer-column-font, inherit);
      gap: var(--spacing-xl) var(--spacing-lg);
      grid-template-columns: 1fr;

      /*
       * Four columns is what the source draws, but it is not a constant — a
       * footer with two headed lists should lay out as two. The count comes
       * from the data, so the grid is told how many boxes it is placing rather
       * than assuming the common case.
       */
      @media (min-width: 992px) {
        grid-template-columns: repeat(var(--footer-column-count, 4), minmax(0, 1fr));
      }
    }

    .footer .footer-column {
      min-width: 0;
    }

    .footer .footer-column--brand {
      text-align: center;
    }

    .footer .footer-column-logo {
      display: block;

      img {
        height: auto;
        margin-inline: auto;
        max-width: 100%;
        width: var(--chrome-footer-logo-width, 255px);
      }
    }

    .footer .footer-column-socials {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-top: 20px;

      img {
        height: auto;
        width: 50px;
      }
    }

    .footer .footer-column-title {
      color: var(--chrome-footer-heading-color, var(--color-text));
      font-family: var(--chrome-footer-heading-font, inherit);
      font-size: var(--chrome-footer-heading-size, var(--font-size-lg));
      font-weight: var(--chrome-footer-heading-weight, 500);
      line-height: 1.2;
      margin: 0;
      text-transform: var(--chrome-footer-heading-transform, none);
    }

    .footer .footer-column-rule {
      border: 0;
      border-top: var(--chrome-footer-rule, 1px solid currentColor);
      margin-bottom: var(--chrome-footer-rule-margin-bottom, 14px);
      margin-top: var(--chrome-footer-rule-margin-top, 4px);
    }

    .footer .footer-column-link {
      align-items: start;
      color: var(--chrome-footer-link-color, inherit);
      display: flex;
      font-family: var(--chrome-footer-link-font, inherit);
      font-size: var(--chrome-footer-link-size, var(--font-size-sm));
      font-weight: var(--chrome-footer-link-weight, 400);
      gap: var(--chrome-footer-icon-gap, 12px);
      margin-block: var(--chrome-footer-link-gap, 7px);
      text-decoration: none;

      /* A trailing glyph hugs its label rather than sitting at the far edge. */
      &.footer-column-link--trailing {
        gap: 0;
        justify-content: start;
      }

      &:hover {
        color: var(--chrome-footer-rule-color, var(--color-primary));
        text-decoration: underline;
      }
    }

    /* A link the source singles out — this footer's is its directions link. */
    .footer .footer-column-link--accent {
      color: var(--footer-link-accent, inherit);
      font-weight: 500;
    }

    .footer .footer-column-link--trailing .footer-column-icon {
      margin-left: var(--chrome-footer-icon-gap, 12px);
    }

    .footer .footer-column-icon {
      /*
       * Pinned to the first line rather than centred on the block: the address
       * link wraps to two lines and a centred icon then floats between them,
       * which is not where the source puts it.
       */
      color: var(--chrome-footer-icon-color, currentColor);
      flex: none;
      height: var(--chrome-footer-icon-size, 12px);
      margin-top: calc((1lh - var(--chrome-footer-icon-size, 12px)) / 2);
      width: var(--chrome-footer-icon-size, 12px);
    }

    .footer .footer-copyright {
      background: var(--chrome-copyright-bg, transparent);
      color: var(--chrome-copyright-color, inherit);
      font-family: var(--chrome-copyright-font, inherit);
      font-size: var(--chrome-copyright-size, var(--font-size-sm));
      font-weight: var(--chrome-copyright-weight, 300);
      padding-block: var(--chrome-copyright-pad-block, 10px);
      text-align: var(--chrome-copyright-align, center);
    }

    .footer .footer-copyright-inner {
      margin-inline: auto;
      max-width: var(--chrome-container-max, 1140px);
      padding-inline: var(--chrome-container-pad, 15px);

      a {
        color: inherit;
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }
    }

    .footer .footer-copyright-separator {
      margin-inline: 0.35em;
    }

    .footer {
      container-type: inline-size;

      &[data-fixed-tabs-active="true"] {
        @media (max-width: 1024px) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom));
        }
      }

      .button-group {
        &.align-end {
          @container (max-width: 599px) {
            justify-content: center;
          }
        }


      }

      .footer-content {
        @container (min-width: 600px) {
          align-items: center;
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
        }

        .content-container {
          flex: 1;

          > a {
            display: block;
            text-align: center;
          }
        }
      }

      .footer-map-embed {
        margin-block: var(--spacing-lg);

        iframe {
          aspect-ratio: 16 / 9;
          border: 0;
          border-radius: var(--radius-md);
          display: block;
          width: 100%;
        }
      }

      .footer-legal-text {
        color: var(--color-text-muted);
        text-align: center;
        @container (min-width: 600px) {
          text-align: start;
        }
      }

      .footer-legal-blurb {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        line-height: var(--line-height-relaxed);
        margin-top: var(--spacing-sm);
        text-align: center;

        @container (min-width: 600px) {
          text-align: start;
        }
      }

      .footer-logo {
        flex-shrink: 0;
        margin-top: 0 !important;

        img {
          margin: 0 auto 30px;
          width: auto;
        }
      }

      .bar .bar-list {
        flex-flow: column wrap;
        @container (min-width: 600px) {
          flex-direction: row;
          justify-content: end;
        }
      }

      .fo-content {
        margin-block: var(--spacing-lg);

        @container (min-width: 700px) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fo-title {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-sm);
          text-align: center;
        }

        .office-block,
        .office-hours-block {
          margin-bottom: var(--spacing-md);
        }

        .office-name {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-xs);
        }

        .pho,
        .phy {
          color: var(--color-text);
          display: block;
          margin-bottom: var(--spacing-sm);
          text-decoration: none;

          &:hover,
          &:focus-visible {
            color: var(--color-link-hover);
          }
        }

        .pho {
          color: var(--footer-phone-link-color, var(--color-text));

          &:hover,
          &:focus-visible {
            color: var(--footer-phone-link-hover-color, var(--color-link-hover));
          }
        }

        .phy {
          color: var(--footer-address-link-color, var(--color-text));

          &:hover,
          &:focus-visible {
            color: var(--footer-address-link-hover-color, var(--color-link-hover));
          }
        }

        .office-hours {
          display: table;
          margin: 10px auto;
          text-align: left;

          .fo-title { text-align: center; }
        }

        .social {
          margin-top: var(--spacing-sm); 

          .button{min-width: auto;}
        }
      }
    }

    #copy {
      font-size: var(--font-size-sm);
      line-height: 1.5;
      padding: var(--spacing-md) var(--spacing-sm);
      text-align: center;

      .footer-legal-line {
        display: inline;
      }

      .footer-legal-separator {
        display: inline;
        margin: 0 0.5rem;
      }

      a {
        color: var(--color-link);

        &:hover,
        &:focus-visible {
          color: var(--color-link-hover);
        }
      }

      @media (max-width: 1024px) {
        .footer-legal-line {
          display: block;
        }

        .footer-legal-line + .footer-legal-line {
          margin-top: 0.25rem;
        }

        .footer-legal-separator {
          display: none;
        }
      }
    }
  }
</style>
