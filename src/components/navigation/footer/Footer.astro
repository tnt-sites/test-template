---
import Button from "@core-elements/button/Button.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  links = [],
  socials = [],
  siteName = "",
  offices = [],
  legalLinks = [],
  contactTitle = "Contact Us",
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  mapEmbedUrl = "",
  legalBlurb = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  logoSource,
  logoAlt,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const getOfficeHoursGeneralNotes = (office: any) => {
  const notes = [
    office?.officeHoursNote,
    office?.["office-hours-note"],
    ...(Array.isArray(office?.officeHoursNotes) ? office.officeHoursNotes : []),
    ...(Array.isArray(office?.["office-hours-notes"]) ? office["office-hours-notes"] : []),
  ];

  return notes.filter((note) => typeof note === "string" && note.trim().length > 0);
};

const copyYear = new Date().getFullYear();
const embedSrc = typeof mapEmbedUrl === "string" ? mapEmbedUrl.trim() : "";
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";
const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};
const footerStyle = [
  getColorValue(addressLinkColor)
    ? `--footer-address-link-color: ${getColorValue(addressLinkColor)}`
    : "",
  getColorValue(addressLinkHoverColor)
    ? `--footer-address-link-hover-color: ${getColorValue(addressLinkHoverColor)}`
    : "",
  getColorValue(phoneLinkColor)
    ? `--footer-phone-link-color: ${getColorValue(phoneLinkColor)}`
    : "",
  getColorValue(phoneLinkHoverColor)
    ? `--footer-phone-link-hover-color: ${getColorValue(phoneLinkHoverColor)}`
    : "",
]
  .filter(Boolean)
  .join("; ");
---

<footer class="footer" style={footerStyle || undefined} {...htmlAttributes}>
  <!-- Logo, contact info and hours (original #fo-contents) -->
  <div id="fo-contents">
    <a href="/" class="logo">
      <Image source={logoSource} alt={logoAlt} class="footer-logo" editable={false} />
    </a>

    <div class="fo-info">
      <span class="fo-title">{contactTitle}</span>
      {
        resolvedOffices.map((office: any) => (
          <div class="office-block">
            {office?.name && <span class="office-name">{office.name}</span>}
            {Array.isArray(office?.phones) &&
              office.phones.map((phone: any) =>
                phone?.display ? (
                  <a
                    href={phone?.href || "#"}
                    class:list={["pho", phone?.type === "sms" && "ctm-no-swap"]}
                  >
                    {phone?.label ? `${phone.label}: ` : ""}
                    {phone.display}
                  </a>
                ) : null
              )}
            {Array.isArray(office?.emails) &&
              office.emails.map((email: any) =>
                email?.display ? (
                  <a href={email?.href || "#"} class="pho">
                    {email?.label ? `${email.label}: ` : ""}
                    {email.display}
                  </a>
                ) : null
              )}
            {Array.isArray(office?.addresses) &&
              office.addresses.map((address: any) => {
                const formattedLines = formatAddressLines(address);

                return formattedLines.length > 0 ? (
                  <a
                    href={address?.mapUrl || "#"}
                    class="phy"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {formattedLines.map((line: string, index: number) => (
                      <>
                        {line}
                        {index < formattedLines.length - 1 && <br />}
                      </>
                    ))}
                  </a>
                ) : null;
              })}
          </div>
        ))
      }

      {
        sharedSocials.length > 0 && (
          <div class="social">
            {sharedSocials.map((social: any) => (
              <Button
                variant="ghost"
                size="lg"
                iconName={social.icon}
                link={social.link}
                hideText="true"
                aria-label={`Visit our ${social.icon} page`}
                target="_blank"
                rel="noopener noreferrer"
              />
            ))}
          </div>
        )
      }
    </div>

    <div class="fo-hours">
      <span class="fo-title">{officeHoursTitle}</span>
      {
        resolvedOffices.map((office: any) => (
          <div class="hours office-hours">
            <div class="office-hours-list">
              {(office?.officeHours || []).map((item: any) => (
                <div class="office-hours-row">
                  <div class="office-hours-line">
                    <span class="office-hours-day">{item.day || ""}</span>
                    <span class="office-hours-time">{item.hours || ""}</span>
                  </div>
                  {(item?.note || item?.hoursNote || item?.["hours-note"]) && (
                    <small class="office-hours-note">
                      {item?.note || item?.hoursNote || item?.["hours-note"]}
                    </small>
                  )}
                </div>
              ))}
            </div>
            {getOfficeHoursGeneralNotes(office).length > 0 && (
              <div class="office-hours-general-notes">
                {getOfficeHoursGeneralNotes(office).map((note: string) => (
                  <small class="office-hours-general-note">{note}</small>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>

  {
    embedSrc && (
      <div class="footer-map-embed" aria-label="Map location">
        <iframe
          src={embedSrc}
          title="Office location map"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      </div>
    )
  }

  <!-- Copyright row (original #copy) -->
  <div id="copy">
    <div>
      <div class="name">
        &copy; <em id="copyDate">{copyYear}</em>
        {displaySiteName}
      </div>
      {
        legalLinks.length > 0 && (
          <div class="links">
            <span aria-hidden="true">|</span>
            {legalLinks.map((item: any) => (
              <>
                <a href={item.path || "#"}>{item.name || "Link"}</a>
                <span aria-hidden="true">|</span>
              </>
            ))}
          </div>
        )
      }
    </div>
    <a href="https://www.tntdental.com" target="_blank" rel="noopener noreferrer" class="tnt">
      Site designed and maintained by TNT Dental
    </a>
  </div>
  {blurb && <p class="footer-legal-blurb">{blurb}</p>}
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    /* Footer styles ported from the original site (static/styles.css: footer,
       #fo-contents, .fo-info, .fo-title, .social, .hours, #copy). Original hexes
       map onto branding tokens where they match. */
    .footer {
      /* #D0C8B7 has no branding token — same tan as the header contact bar. */
      --footer-bg: #d0c8b7;

      background-color: var(--footer-bg);
      background-image: url("/images/footer-bg.svg");
      background-position: 60% 0;
      background-repeat: no-repeat;
      color: var(--color-text-inverse);

      &[data-fixed-tabs-active="true"] {
        @media (max-width: 1024px) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom));
        }
      }

      a {
        color: var(--color-brand);

        &:hover,
        &:focus-visible {
          color: var(--color-link);
        }
      }

      .logo {
        display: block;
        margin-bottom: 10px;
      }

      .footer-logo {
        flex-shrink: 0;
        margin-top: 0 !important;

        img {
          height: auto;
          max-width: 100%;
          width: auto;
        }
      }

      .fo-title {
        color: var(--color-link);
        display: block;
        font-size: var(--font-size-md);
        font-weight: var(--font-weight-semibold);
        line-height: 1;
        text-transform: uppercase;
      }

      .office-name {
        color: var(--color-brand);
        display: block;
        font-weight: var(--font-weight-semibold);
        margin-bottom: var(--spacing-xs);
      }

      .pho {
        color: var(--footer-phone-link-color, var(--color-brand));
        display: block;
        font-size: 28px;
        line-height: 1.2;
        margin: 10px auto;

        &:hover,
        &:focus-visible {
          color: var(--footer-phone-link-hover-color, var(--color-link));
        }
      }

      .phy {
        color: var(--footer-address-link-color, var(--color-brand));
        display: block;
        font-size: 16px;
        line-height: 1.2;
        margin: 15px auto 20px;

        &:hover,
        &:focus-visible {
          color: var(--footer-address-link-hover-color, var(--color-link));
        }
      }

      /* .social a — icon buttons rather than the original icon font */
      .social {
        display: flex;
        gap: 10px;
        justify-content: flex-start;
        margin: 10px auto;

        .button {
          background: transparent;
          border: none;
          color: var(--color-brand);
          font-size: 22px;
          margin: 5px;
          min-width: auto;
          padding: 0;

          &:first-of-type {
            margin-left: 0;
          }

          &:hover,
          &:focus-visible {
            background: transparent;
            color: var(--color-link);
          }
        }
      }

      .fo-hours .fo-title {
        margin-bottom: 15px;
      }

      /* footer .hours p { color: #134545 } — the shared office-hours block already
         matches the original's 120px day column. */
      .hours {
        --office-hours-color: var(--color-brand);
        --office-hours-day-color: var(--color-brand);
        --office-hours-note-color: var(--color-brand);

        display: table;
        margin: 0;
        text-align: left;

        .office-hours-day {
          font-weight: var(--font-weight-bold);
        }
      }

      .footer-map-embed {
        margin: 0 auto var(--spacing-lg);
        max-width: 1200px;
        padding-inline: 10px;

        iframe {
          aspect-ratio: 16 / 9;
          border: 0;
          border-radius: var(--radius-md);
          display: block;
          width: 100%;
        }
      }

      .footer-legal-blurb {
        color: var(--color-brand-muted);
        font-size: var(--font-size-sm);
        margin: 0 auto;
        max-width: 1200px;
        padding: 0 10px 20px;
        text-align: center;
      }
    }

    /* #fo-contents */
    #fo-contents {
      display: flex;
      justify-content: space-between;
      margin: auto;
      max-width: 1200px;
      padding: 80px 10px;
      position: relative;
    }

    .fo-info {
      flex: 0 1 auto;

      .fo-title {
        margin-bottom: 20px;
      }
    }

    /* #copy */
    #copy {
      align-items: center;
      border-top: 1px solid var(--color-brand-subtle);
      color: #000;
      display: flex;
      font-size: 14px;
      justify-content: center;
      line-height: 1.5;
      margin: 0 auto;
      max-width: 1200px;
      padding: 15px 10px 40px;
      text-align: center;

      > div {
        align-items: center;
        display: flex;
      }

      em {
        font-style: normal;
      }

      span {
        margin: 0 10px;
      }

      a {
        color: #000;

        &:hover,
        &:focus-visible {
          color: var(--color-link);
        }
      }
    }

    @media (max-width: 1024px) {
      .footer {
        background-position: 60% 100%;

        .logo {
          margin-bottom: 20px;
          max-width: 80%;
        }
      }

      #fo-contents {
        align-items: center;
        flex-direction: column;
        gap: 30px;
        padding: 50px 10px;

        > div {
          max-width: 320px;
          width: 100%;
        }
      }

      #copy {
        flex-direction: column;
        gap: 0;
        padding: 15px 10px;

        > div {
          flex-direction: column;
        }

        .links span:first-of-type,
        .links span:last-of-type {
          display: none;
        }
      }
    }
  }
</style>
