---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [],
  pageButtons = [],
  socials = [],
  class: className,
  offices = [],
  legalLinks = [],
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  _component,
  ...htmlAttributes
} = Astro.props;

const defaultSearchButtonSections = [
  {
    _component: "building-blocks/core-elements/button",
    text: "Search",
    hideText: true,
    link: "/search/",
    iconName: "magnifying-glass",
    iconPosition: "before",
    variant: "ghost",
    size: "lg",
    width: "xs",
  },
];

const resolvedSearchButtonSections =
  Array.isArray(buttonSections) && buttonSections.length > 0
    ? buttonSections
    : defaultSearchButtonSections;

const sanitizeButtonSection = (button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
});

const searchButtons = resolvedSearchButtonSections.map((button: any) =>
  sanitizeButtonSection(button)
);

const buttons = pageButtons.map((button: any) => sanitizeButtonSection(button));

const mobileNavData = [
  ...navData,
  ...searchButtons.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};
---

<div class="hd-top">
  {
    resolvedOffices.map((office: any) =>
      Array.isArray(office?.addresses)
        ? office.addresses.map((address: any) => {
            const formattedLines = formatAddressLines(address);
            const singleLine = formattedLines.join(" ");

            return singleLine ? (
              <a
                href={address?.mapUrl || "#"}
                class="phy"
                target="_blank"
                rel="noopener noreferrer"
              >
                {singleLine}
              </a>
            ) : null;
          })
        : null
    )
  }
</div>
<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["main-nav", className]}
  {...htmlAttributes}
>
  <div class="hd-content">
    <!-- Desktop Nav -->
    <div class="hd-nav">
      <div class="nav-end">
        <Bar navData={navData} class="desktop-main-nav" />

        <ButtonGroup
          direction="row"
          align="center"
          class="desktop-button-group"
          buttonSections={searchButtons}
          editable={false}
        />
      </div>
    </div>
    <!-- End Desktop Nav -->
    <a class="logo-link" href="/">
      <img
        src={logoSource}
        alt={logoAlt}
        class="main-nav-logo"
        data-editable="false"
        data-prop-src="logoSource"
        data-prop-alt="logoAlt"
      />
    </a>
    <div class="hd-right">
      <!-- Phone and Address -->
      <div class="hd-info">
        {
          resolvedOffices.map((office: any) => (
            <>
              <div>
                {Array.isArray(office?.phones) &&
                  office.phones.map((phone: any) =>
                    phone?.display ? (
                      <a href={phone?.href || "#"} class="pho">
                        {phone?.label ? `${phone.label}: ` : ""}
                        {phone.display}
                      </a>
                    ) : null
                  )}

                {Array.isArray(office?.addresses) &&
                  office.addresses.map((address: any) => {
                    const formattedLines = formatAddressLines(address);

                    return formattedLines.length > 0 ? (
                      <a
                        href={address?.mapUrl || "#"}
                        class="phy"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {formattedLines.map((line: string, index: number) => (
                          <>
                            {line}
                            {index < formattedLines.length - 1 && <br />}
                          </>
                        ))}
                      </a>
                    ) : null;
                  })}
              </div>
            </>
          ))
        }
      </div>
      {
        buttons.length > 0 && (
          <div class="hd-btns page-buttons">
            <ButtonGroup
              direction="row"
              align="center"
              class="desktop-button-group"
              buttonSections={buttons}
              editable={false}
            />
          </div>
        )
      }
    </div>
  </div>
  <!-- Mobile Nav -->
  <Mobile
    logoSource={logoSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    offices={resolvedOffices}
    sharedSocials={sharedSocials}
  />
  <!-- End Mobile Nav -->
</CustomSection>

<!-- Adds --site-header-height CSS variable based on header height. Works with multiple screen sizes. -->
<script>
  const initMainNavHeaderHeight = () => {
    document.querySelectorAll(".main-nav").forEach((mainNav) => {
      if (mainNav.getAttribute("data-header-height-initialized") === "true") return;

      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      syncHeaderHeight();

      if (typeof ResizeObserver !== "undefined") {
        const resizeObserver = new ResizeObserver(syncHeaderHeight);
        resizeObserver.observe(mainNav);
      }

      mainNav.setAttribute("data-header-height-initialized", "true");
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNavHeaderHeight);
  } else {
    initMainNavHeaderHeight();
  }
</script>

<style lang="pcss" is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      background-color: var(--color-bg-dark);
      color: #fff;
      padding-block: var(--spacing-md);
      position: sticky;
      top: 0;
      transition: 0.3s all;

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 1024px) {
          display: none;
        }
      }

      .main-nav-logo {
        margin-top: 0 !important;
        transition: height var(--animation-normal) ease-in-out;
      }

      .nav-hamburger.mobile-button {
        @media (min-width: 1025px) {
          display: none;
        }
      }

      > .outer-content .hd-content {
        align-items: center;
        container-type: inline-size;
        display: flex;
        justify-content: space-between;

        > a > .main-nav-logo {
          height: 44px;
          max-width: 100%;
          width: auto;
        }

        @container (max-width: 1000px) {
          > a > .main-nav-logo {
            height: 36px;
          }
        }

        @container (max-width: 820px) {
          > a > .main-nav-logo {
            height: 28px;
          }
        }

        @container (max-width: 1350px) {
          .hd-nav .desktop-button-group.button-group {
            display: none;
          }
        }

        @container (max-width: 1150px) {
          .bar .bar-list{align-items: start;}

          .desktop-main-nav .bar-list > .nav-item.has-children {
            align-items: center;
            flex-direction: column;
            row-gap: 0;
          }

          .desktop-main-nav .bar-list > .nav-item.has-children > a {
            padding-right: var(--spacing-md);
          }

          .desktop-main-nav .bar-list > .nav-item.has-children .nav-item-trigger {
            margin-inline-start: 0;
            min-height: 0;
          }
        }

        .button-group {
          margin-top: 0;
        }
      }

      > .outer-content .hd-content .hd-nav {
        justify-self: start;
        min-width: 0;
      }

      > .outer-content .hd-content .logo-link {
        justify-self: center;
      }

      > .outer-content .hd-content .hd-right {
        align-items: center;
        display: flex;
        flex-direction: row;
        gap: var(--spacing-lg);
        justify-self: end;
      }

      > .outer-content .hd-content .hd-actions {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        gap: var(--spacing-xs);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end > .desktop-main-nav.bar {
        flex: 0 1 auto;
      }

      > .outer-content .hd-content .nav-end > .desktop-button-group.button-group {
        flex: 0 0 30px;
        margin-top: 0;
        width: auto;
      }

      > .outer-content .hd-content .page-buttons {
        flex: 0 0 auto;

        > .button-group {
          container-type: normal;
          margin-left: 0;
        }
      }
    }

    .hd-top {
      background-color: #fff;
      padding: 5px;
      text-align: center;
    }

    .hd-top .phy {
      color: var(--color-text-strong);
      display: block;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 3px;
      margin: 0 auto;
      text-transform: uppercase;
      transition: 0.3s;
    }

    .hd-top .phy:hover {
      color: var(--color-brand);
    }

    .hd-info{display: block; text-align: center;}
    .main-nav .phy{display: block; text-transform: uppercase; font-family: var(--font-body); font-size: 13px; font-weight: 500; letter-spacing: 2.6px; color: #fff; line-height: 1; margin-top: 5px; transition: .3s;}
      .main-nav .pho{font-family: var(--font-body); font-weight: 500; letter-spacing: 1.9px; color: #fff; font-size: 19px; line-height: 1; transition: .3s; display: block; margin: 0 auto 5px;}

    .main-nav .pho:hover, .main-nav .phy:hover{color: var(--color-brand)}

    .main-nav .page-buttons .button.ra {
      font-family: var(--font-body);
      font-size: 9px;
      min-width: 195px;
      padding-block: 12px;
      line-height: 1;;
    }

    .main-nav .page-buttons .button.ra .label-text {
      display: block;
      line-height: 1.3;
    }

    .main-nav .page-buttons .button.ra .label-text .ra-main {
      display: block;
      font-size: 16px;
      font-weight: 500;
      letter-spacing: 1.6px;
    }

    .main-nav .bar .bar-list {
      flex-wrap: wrap;
      gap: 0;
      justify-content: flex-end;
      row-gap: var(--spacing-xs);
    }

    .main-nav .bar .nav-item > a {
      color: #fff;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0px;
      padding-inline: var(--spacing-sm);
      text-transform: uppercase;

      &:hover {
        color: var(--color-brand);
      }

      &[aria-current="page"] {
        text-decoration-color: #fff;
      }
    }

    .main-nav .bar .nav-item.has-children > a {
      padding-right: 2px;
    }

    .main-nav .bar .nav-item-trigger {
      border-color: rgba(255, 255, 255, 0.3);
      color: #fff;
    }

    .main-nav .bar .nav-item-icon {
      color: rgba(255, 255, 255, 0.7);
    }

    .main-nav .nav-end .button-group .button.variant-ghost {
      color: #fff;

      &:hover,
      &:focus {
        color: var(--color-brand);
      }
    }

    .main-nav .bar .nav-item > .nav-item-content {
      background: #000000;
      border-color: #000000;
    }

    .main-nav .bar .nav-item-nested {
      background: #1a1a1a;
      border-color: #1a1a1a;
    }

    .main-nav .bar .nav-item-content .nav-item > a,
    .main-nav .bar .nav-item-nested .nav-item > a {
      color: #fff;

      &:hover {
        background-color: var(--color-brand);
        color: #fff;
      }
    }

    .mobile-nav-button{min-width: 10px;border-radius: 0; border: none; height: 70px; width: 70px; background-color: #000000; color: #fff; display: flex; align-items: center; justify-content: center;}
    .nav-hamburger .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .nav-hamburger .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-close .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .mobile-close .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-nav-close {}


    @media (max-width: 1024px) {
      .main-nav{padding: 0;}
      .main-nav > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: space-between;
        padding-right: 0;
      }

      .main-nav > .outer-content .hd-content {
        align-items: center;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
      }

      .main-nav > .outer-content .hd-content .logo-link {
        display: block;
        flex: 0 0 auto;
        margin-left: 0;
      }

      .main-nav > .outer-content .hd-content .logo-link .main-nav-logo {
        display: block;
      }

      .hd-info, .hd-top{display: none;}
      .main-nav > .outer-content .hd-content .hd-right {display: none;}
      .main-nav > .outer-content .hd-content .hd-nav {display: none;}
    }
  }

</style>
