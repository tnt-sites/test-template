---
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import siteInfoData from "@data/siteInfo.json";
import { Icon as AstroIcon } from "astro-icon/components";

const {
  logoSource,
  logoAlt = "Medford Dental Wellness",
  navData = [],
  pageButtons = [],
  socials = [],
  offices = [],
  overlay = false,
  class: className,
  _component,
  // Older settings, no longer shown in the redesigned header.
  buttonSections,
  legalLinks,
  phoneText,
  phoneHref,
  addressHref,
  addressLines,
  emailHref,
  emailText,
  officeHoursTitle,
  officeHours,
  officeHoursNote,
  officeHoursNotes,
  ...htmlAttributes
} = Astro.props;

const sanitizeButtonSection = (button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
});

const buttons = pageButtons.map((button: any) => sanitizeButtonSection(button));

const mobileNavData = [
  ...navData,
  ...buttons.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const sharedSocials =
  Array.isArray(socials) && socials.length > 0 ? socials : ((siteInfoData as any).socials ?? []);

const firstOffice = resolvedOffices[0] ?? {};
const firstAddress = Array.isArray(firstOffice.addresses) ? firstOffice.addresses[0] : undefined;
const firstPhone = Array.isArray(firstOffice.phones) ? firstOffice.phones[0] : undefined;

const addressText = firstAddress
  ? [
      ...(Array.isArray(firstAddress.lines) ? firstAddress.lines : []),
      firstAddress.city,
      [firstAddress.state, firstAddress.postalCode].filter(Boolean).join(" "),
    ]
      .filter((part) => typeof part === "string" && part.trim().length > 0)
      .join(", ")
  : "";
---

<header
  class:list={["main-nav", overlay ? "is-overlay" : "is-solid", className]}
  data-main-nav
  {...htmlAttributes}
>
  {
    (addressText || firstPhone?.display) && (
      <div class="main-nav-topbar">
        {addressText && (
          <a href={firstAddress?.mapUrl || undefined} target="_blank" rel="noopener noreferrer">
            {addressText}
          </a>
        )}
        {addressText && firstPhone?.display && <span class="main-nav-dot" aria-hidden="true" />}
        {firstPhone?.display && <a href={firstPhone.href || undefined}>{firstPhone.display}</a>}
      </div>
    )
  }

  <div class="main-nav-bar">
    <a class="main-nav-logo" href="/" aria-label={logoAlt}>
      <AstroIcon name="medford-logo" aria-hidden="true" />
    </a>

    <Bar navData={navData} class="desktop-main-nav" />

    {
      buttons.length > 0 && (
        <ButtonGroup
          direction="row"
          align="center"
          class="main-nav-buttons"
          buttonSections={buttons}
          editable={false}
        />
      )
    }

    <Mobile
      logoSource={logoSource}
      logoAlt={logoAlt}
      navData={mobileNavData}
      class="mobile-main-nav"
      offices={resolvedOffices}
      sharedSocials={sharedSocials}
    >
      <AstroIcon slot="logo" name="medford-logo" class="mobile-logo-svg" aria-hidden="true" />
    </Mobile>
  </div>
</header>

<script>
  const initMainNav = () => {
    document.querySelectorAll<HTMLElement>("[data-main-nav]").forEach((mainNav) => {
      if (mainNav.dataset.initialized === "true") return;

      // Exposes the header height as --site-header-height for anchor offsets.
      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      // Switches to the compact, solid header once the page scrolls.
      const syncScrolled = () => {
        mainNav.classList.toggle("is-scrolled", window.scrollY > 40);
      };

      syncHeaderHeight();
      syncScrolled();
      window.addEventListener("scroll", syncScrolled, { passive: true });

      if (typeof ResizeObserver !== "undefined") {
        new ResizeObserver(syncHeaderHeight).observe(mainNav);
      }

      mainNav.dataset.initialized = "true";
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNav);
  } else {
    initMainNav();
  }
</script>

<style lang="pcss" is:global>
  @layer page-sections {
    .main-nav {
      --main-nav-text: var(--gray-0);
      /* Sizes scale with the window so everything fits on one line from
         1025px up; they reach the design's full size at about 1400px. */
      --main-nav-logo-height: clamp(50px, 6.3vw, 90px);

      color: var(--main-nav-text);
      left: 0;
      position: sticky;
      right: 0;
      top: 0;
      transition: background-color var(--animation-slow) ease;
      z-index: var(--layer-4);

      &.is-solid,
      &.is-scrolled {
        background-color: var(--color-brand-subtle);
      }

      /* Over a banner the header floats on the photo until the page scrolls. */
      &.is-overlay {
        background-color: transparent;
        position: fixed;

        &.is-scrolled {
          background-color: var(--color-brand-subtle);
        }
      }

      &.is-scrolled {
        --main-nav-logo-height: 60px;

        .main-nav-bar {
          padding-block: 5px;
        }

        .main-nav-buttons .button {
          min-height: 50px;
        }
      }

      a {
        color: inherit;
        text-decoration: none;
      }
    }

    .main-nav-topbar {
      align-items: center;
      background-color: rgb(0 0 0 / 0.85);
      display: flex;
      font-family: var(--font-accent);
      font-size: 1.0625rem;
      gap: 15px;
      justify-content: center;
      letter-spacing: 0.04em;
      min-height: 35px;
      padding-inline: 25px;

      .main-nav.is-solid &,
      .main-nav.is-scrolled & {
        background-color: #161e23;
      }

      a:hover,
      a:focus-visible {
        color: var(--color-brand-muted);
      }
    }

    .main-nav-dot {
      background-color: var(--color-brand-muted);
      border-radius: 50%;
      height: 6px;
      width: 6px;
    }

    .main-nav-bar {
      align-items: center;
      display: flex;
      gap: clamp(10px, 1.8vw, 25px);
      padding: 20px clamp(15px, 3.3vw, 45px);
      transition: padding var(--animation-slow) ease;
    }

    .main-nav-logo {
      --logo-accent: currentColor;

      display: block;
      flex-shrink: 0;

      svg {
        display: block;
        height: var(--main-nav-logo-height);
        transition: height var(--animation-slow) ease;
        width: auto;
      }
    }

    /* Desktop nav: uppercase Faculty Glyphic with small green chevrons. */
    .main-nav .desktop-main-nav.bar {
      flex: 1 1 auto;
      font-weight: var(--font-weight-normal);

      min-width: 0;

      .bar-list {
        gap: clamp(0px, 0.3vw, 5px);
        justify-content: center;
      }

      > .bar-list > .nav-item {
        align-items: center;

        > a {
          color: var(--main-nav-text);
          font-family: var(--font-accent);
          font-size: clamp(0.8125rem, 1.22vw, 1.0625rem);
          letter-spacing: clamp(0.02em, 0.06vw, 0.06em);
          padding: 10px clamp(0px, 0.45vw, 5px);
          text-transform: uppercase;

          &:hover,
          &[aria-current="page"] {
            color: var(--color-brand-muted);
            text-decoration: none;
          }
        }
      }

      /* Dropdown arrows: white chevron in a white outlined box so they read as
         buttons separate from the link text. */
      > .bar-list > .nav-item > .nav-item-trigger {
        border: 1px solid var(--gray-0);
        border-radius: 3px;
        color: var(--gray-0);
        min-height: 20px;
        min-width: 20px;
        padding: 0;

        &:hover,
        &:focus-visible {
          background: var(--gray-0);
          border-color: var(--gray-0);
          color: var(--color-brand-secondary);
        }

        .nav-item-icon {
          color: inherit;
          display: flex;
          transform: rotate(90deg);
          width: 0.75rem;
        }
      }

      > .bar-list > .nav-item > .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon {
        transform: rotate(-90deg);
      }

      /* The bar's default animation re-centres the menu with translateX(-50%);
         these menus line up with their link instead. */
      > .bar-list > .nav-item > .nav-item-toggle:checked ~ .nav-item-content {
        animation-name: grow-out;
      }

      > .bar-list > .nav-item > .nav-item-content {
        border: 0;
        border-radius: 0;
        box-shadow: 0 6px 18px rgb(0 0 0 / 0.18);
        left: 0;
        margin-top: 0;
        min-width: 15rem;
        padding-block: 5px;
        transform: none;

        .nav-item > a {
          color: var(--color-text-strong);
          padding: 10px 20px;
          white-space: nowrap;

          &:hover,
          &[aria-current="page"] {
            background: var(--color-bg-cream);
            color: var(--color-brand);
            text-decoration: none;
          }
        }

        .nav-item-trigger {
          background: var(--color-brand-secondary);
          border: 1px solid var(--color-brand-secondary);
          border-radius: 3px;
          color: var(--gray-0);
          margin-right: 10px;
          min-height: 20px;
          min-width: 20px;

          &:hover,
          &:focus-visible {
            background: var(--color-brand);
            border-color: var(--color-brand);
          }

          .nav-item-icon {
            color: inherit;
            display: flex;
            width: 0.75rem;
          }
        }

        /* Nested arrows point right and stay that way while their menu is open. */
        .nav-item-toggle:checked ~ .nav-item-trigger .nav-item-icon {
          transform: none;
        }

        /* Third-level menus fly out to the right of their arrow instead of
           opening inline. */
        .nav-item.has-children > .nav-item-nested {
          background: var(--color-bg);
          box-shadow: 0 6px 18px rgb(0 0 0 / 0.18);
          left: 100%;
          min-width: 15rem;
          padding-block: 5px;
          position: absolute;
          top: -5px;
          z-index: var(--layer-3);

          .nav-item > a {
            padding: 10px 20px;
          }
        }
      }
    }

    /* Button groups default to full width as size containers; keep this one to
       its content so the nav gets the remaining space. */
    .main-nav .main-nav-buttons {
      container-type: normal;
      flex: 0 0 auto;
      width: auto;
      margin-top: 0;

      .button {
        background-color: var(--color-brand-muted);
        border-color: transparent;
        color: var(--color-brand-secondary);
        font-size: clamp(0.875rem, 1.43vw, 1.25rem);
        letter-spacing: 0.06em;
        min-height: clamp(45px, 4.9vw, 70px);
        padding-inline: clamp(15px, 3.15vw, 45px);
        text-transform: uppercase;
        transition:
          background-color var(--animation-normal) ease,
          min-height var(--animation-slow) ease;

        &:hover,
        &:focus-visible {
          background-color: var(--gray-0);
          color: var(--color-brand-secondary);
        }
      }
    }


    .main-nav .nav-hamburger.mobile-button {
      display: none;
    }

    /* Green square "Menu" button and the logo inside the slide-out menu. */
    .main-nav .mobile-nav-button {
      align-items: center;
      background-color: var(--color-brand);
      border: 0;
      border-radius: 0;
      color: var(--gray-0);
      display: flex;
      flex-direction: column;
      height: 70px;
      justify-content: center;
      min-width: 0;
      padding: 0;
      width: 70px;

      .icon {
        font-size: 2rem;

        svg path {
          stroke-width: 2.25;
        }
      }

      &:hover {
        background-color: var(--color-brand-secondary);
        color: var(--gray-0);
      }
    }

    .main-nav .nav-hamburger .mobile-nav-button::after {
      content: "Menu";
      font-family: var(--font-accent);
      font-size: 0.75rem;
      line-height: 1;
    }

    /* The slide-out menu is moved to <body> by its script, so these target its
       own class rather than .main-nav. */
    .mobile-main-nav .mobile-header {
      padding: 10px 0 10px 25px;
    }

    .mobile-main-nav .mobile-logo {
      --logo-accent: var(--color-brand);

      color: var(--color-brand-secondary);
      flex-shrink: 0;
    }

    .mobile-main-nav .mobile-header .mobile-logo svg {
      display: block;
      height: 60px;
      max-height: none;
      width: auto;
    }

    /* Close button: green square to match the Menu button. */
    .mobile-main-nav .mobile-close .mobile-nav-button {
      align-items: center;
      background-color: var(--color-brand);
      border: 0;
      border-radius: 0;
      color: var(--gray-0);
      display: flex;
      height: 70px;
      justify-content: center;
      min-width: 0;
      padding: 0;
      width: 70px;
    }

    .mobile-main-nav .mobile-close .mobile-nav-button:hover {
      background-color: var(--color-brand-secondary);
      color: var(--gray-0);
    }

    .mobile-main-nav .mobile-close .mobile-nav-button .icon {
      font-size: 2rem;
    }

    .mobile-main-nav .mobile-header .mobile-close {
      align-self: flex-start;
      margin-top: -10px;
    }

    /* Social icons on one line. */
    .mobile-main-nav .mobile-content .mobile-socials {
      flex-wrap: nowrap;
      gap: 15px;
    }

    .mobile-main-nav .mobile-socials .button {
      min-width: 0;
    }

    /* Below desktop: white bar with the navy logo and the green Menu button. */
    @media (max-width: 1024px) {
      .main-nav .nav-hamburger.mobile-button {
        align-self: flex-start;
        display: block;
        margin-top: -10px;
      }

      .main-nav,
      .main-nav.is-overlay,
      .main-nav.is-overlay.is-scrolled,
      .main-nav.is-solid,
      .main-nav.is-scrolled {
        --main-nav-logo-height: 60px;
        --main-nav-text: var(--color-brand-secondary);

        background-color: var(--color-bg);
        box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
        position: sticky;
      }

      .main-nav-topbar,
      .main-nav .desktop-main-nav.bar,
      .main-nav .main-nav-buttons {
        display: none;
      }

      .main-nav-bar,
      .main-nav.is-scrolled .main-nav-bar {
        justify-content: space-between;
        padding: 10px 0 10px 25px;
      }

      .main-nav-logo {
        --logo-accent: var(--color-brand);
      }
    }
  }
</style>
