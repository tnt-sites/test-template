---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [],
  pageButtons = [],
  socials = [],
  class: className,
  offices = [],
  legalLinks = [],
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  topBar = null,
  overlay = false,
  _component,
  ...htmlAttributes
} = Astro.props;

/*
 * The strip above the menu: a phone number, a "Contact Us", an address, laid
 * across the full width in the brand colour.
 *
 * It is a tier of its own, not a column of the menu row. Folded into the menu
 * row instead — which is where a template with no notion of one puts it — the
 * number and the address stack up beside the logo at menu-link size, and that
 * single difference is what makes a migrated header read as a different site
 * from three metres away.
 *
 * Drawn only when the source had one, so a header that is just a logo and a
 * menu keeps the template's single tier.
 */
const topBarPhone = topBar?.phone?.display ? topBar.phone : null;
const topBarLink = topBar?.link && topBar?.label ? { label: topBar.label, link: topBar.link } : null;

const defaultSearchButtonSections = [
  {
    _component: "building-blocks/core-elements/button",
    text: "Search",
    hideText: true,
    link: "/search/",
    iconName: "magnifying-glass",
    iconPosition: "before",
    variant: "ghost",
    size: "lg",
    width: "xs",
  },
];

/*
 * An empty list means no button, not "use the default".
 *
 * The template ships a search control for sites that never say otherwise, and
 * the only way for a site to say otherwise is to set the list to nothing — so
 * treating empty as unset leaves a search icon in the header of every site
 * whose original had none, with no way to remove it. Absent still falls back.
 */
const resolvedSearchButtonSections = Array.isArray(buttonSections)
  ? buttonSections
  : defaultSearchButtonSections;

const sanitizeButtonSection = (button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
});

const searchButtons = resolvedSearchButtonSections.map((button: any) =>
  sanitizeButtonSection(button)
);

const buttons = pageButtons.map((button: any) => sanitizeButtonSection(button));

const mobileNavData = [
  ...navData,
  ...searchButtons.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
  ...buttons.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

/*
 * The address as the strip writes it — one line, not the stacked block the
 * footer uses. There is a single row to put it in.
 */
const topBarAddress = (() => {
  const address = resolvedOffices[0]?.addresses?.[0];
  if (!address) return null;
  const stateAndPostal = [address.state, address.postalCode].filter(Boolean).join(" ");
  const text = [...(address.lines ?? []), address.city, stateAndPostal, address.country]
    .filter((part: any) => typeof part === "string" && part.trim())
    .join(", ");
  return text ? { text, mapUrl: address.mapUrl || "" } : null;
})();

const hasTopBar = Boolean(topBarPhone || topBarLink || topBarAddress);

---

{
  hasTopBar && (
    <div class="site-top-bar" data-overlay={overlay ? "true" : undefined}>
      <div class="stb-inner">
        <div class="stb-group">
          {topBarPhone && (
            <a class="stb-item" href={topBarPhone.href || "#"}>
              <Icon name="phone" size="none" aria-hidden="true" />
              <span>{topBarPhone.display}</span>
            </a>
          )}
          {topBarLink && (
            <a class="stb-item" href={topBarLink.link}>
              <Icon name="envelope" size="none" aria-hidden="true" />
              <span>{topBarLink.label}</span>
            </a>
          )}
        </div>
        {topBarAddress && (
          <a
            class="stb-item"
            href={topBarAddress.mapUrl || "#"}
            target={topBarAddress.mapUrl ? "_blank" : undefined}
            rel={topBarAddress.mapUrl ? "noopener noreferrer" : undefined}
          >
            <Icon name="map-pin" size="none" aria-hidden="true" />
            <span>{topBarAddress.text}</span>
          </a>
        )}
      </div>
    </div>
  )
}

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["main-nav", className]}
  data-overlay={overlay ? "true" : undefined}
  {...htmlAttributes}
>
  <div class="hd-content">
    <a class="logo-link" href="/">
      <Image source={logoSource} class="main-nav-logo" alt={logoAlt} editable={false} />
    </a>
    <!-- Desktop Nav -->
    <div class="hd-right">
      {
        buttons.length > 0 && (
          <div class="hd-btns page-buttons">
            <ButtonGroup
              direction="row"
              align="center"
              class="desktop-button-group"
              buttonSections={buttons}
              editable={false}
            />
          </div>
        )
      }
      <div class="hd-nav">
        <div class="nav-end">
          <Bar navData={navData} class="desktop-main-nav" />

          {searchButtons.length > 0 && (
            <ButtonGroup
              direction="row"
              align="center"
              class="desktop-button-group"
              buttonSections={searchButtons}
              editable={false}
            />
          )}
        </div>
      </div>
      <!-- End Desktop Nav -->
    </div>
  </div>
  <!-- Mobile Nav -->
  <Mobile
    logoSource={logoSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    offices={resolvedOffices}
    sharedSocials={sharedSocials}
  />
  <!-- End Mobile Nav -->
</CustomSection>

<!-- Adds --site-header-height CSS variable based on header height. Works with multiple screen sizes. -->
<script>
  const initMainNavHeaderHeight = () => {
    document.querySelectorAll(".main-nav").forEach((mainNav) => {
      if (mainNav.getAttribute("data-header-height-initialized") === "true") return;

      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      syncHeaderHeight();

      if (typeof ResizeObserver !== "undefined") {
        const resizeObserver = new ResizeObserver(syncHeaderHeight);
        resizeObserver.observe(mainNav);
      }

      /*
       * A transparent bar has to know when it has run out of hero. Threshold
       * rather than zero so the state does not flip on the first pixel of a
       * momentum scroll, and rather than the hero's height so it does not have
       * to know which section is the hero.
       */
      if (mainNav.getAttribute("data-overlay") === "true") {
        const syncScrolled = () => {
          mainNav.setAttribute("data-scrolled", window.scrollY > 24 ? "true" : "false");
        };
        syncScrolled();
        window.addEventListener("scroll", syncScrolled, { passive: true });
      }

      mainNav.setAttribute("data-header-height-initialized", "true");
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNavHeaderHeight);
  } else {
    initMainNavHeaderHeight();
  }
</script>

<style lang="pcss" is:global>
  @layer page-sections {
    /*
     * The strip above the menu. Its colour, type and height are the source's
     * own, measured by `wpmig dev-chrome`; the fallbacks are what a site with
     * no such strip would get if one were ever rendered anyway.
     */
    .site-top-bar {
      background-color: var(--chrome-topbar-bg, var(--color-brand));
      color: var(--chrome-topbar-color, var(--color-text-on-brand, #fff));
      font-family: var(--chrome-topbar-font, inherit);
      font-size: var(--chrome-topbar-size, var(--font-size-sm));
      font-weight: var(--chrome-topbar-weight, 400);
      position: relative;
      z-index: var(--layer-2);

      /*
       * Not decoration. The source spreads a near-black wash two hundred
       * pixels past this forty-five pixel strip, and that wash is what the
       * white menu below is legible against — without it the bar floats
       * transparently over a bright hero and the links disappear.
       *
       * Only where the menu is actually floating, though. On a page that opens
       * with prose rather than a hero the menu has a ground of its own, and
       * the wash would be two hundred pixels of grey spilling down the top of
       * an article.
       */
      &[data-overlay="true"] {
        box-shadow: var(--chrome-topbar-shadow, none);
      }

      /* Hidden on phones, where the source drops it: three items across a
         390px row wrap into a block taller than the menu it introduces. */
      @media (max-width: 767px) {
        display: none;
      }

      .stb-inner {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xs) var(--spacing-lg);
        justify-content: space-between;
        margin: 0 auto;
        min-height: var(--chrome-topbar-height, 45px);
        /* Set in by the same inset as the menu bar below, so the phone and
           the logo, the address and the last menu item, line up. */
        padding: var(--spacing-xs) var(--chrome-header-inset, var(--spacing-lg));
      }

      .stb-group {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xs) var(--spacing-lg);
      }

      .stb-item {
        align-items: center;
        color: inherit;
        display: inline-flex;
        gap: var(--spacing-xs);
        line-height: 1.2;
        text-decoration: none;

        .icon {
          flex: 0 0 auto;
          font-size: 1.05em;
          margin-right: 0.15em;
        }

        &:hover,
        &:focus-visible {
          opacity: 0.85;
        }
      }
    }

    .main-nav {
      z-index: var(--layer-3);
      background-color: var(--nav-bg, var(--color-bg));
      padding-block: var(--spacing-md);
      position: sticky; 
      top: 0;

      /*
       * Over the hero, not above it.
       *
       * The source draws its menu as a transparent bar sitting on the page's
       * first section — the logo and the links float over a dark hero image,
       * and the page begins at the top of the window rather than under a
       * white band. `main` is pulled up by the bar's own height to put it
       * back there; `data-overlay` is set per page by the layout, because the
       * trick only works where the page actually opens with a hero.
       */
      &[data-overlay="true"] {
        /*
         * Not fully transparent. The hero image is a sibling of this bar, not
         * an ancestor — `main` sits below it in the DOM and is only pulled up
         * visually with a negative margin — so a contrast checker walking up
         * from the white nav text never finds the hero and resolves against
         * the white <body> instead, flagging white-on-white. A real (if
         * faint) dark scrim painted here gives it an ancestor background to
         * resolve against, the same fix already used for `.site-top-bar`.
         */
        --nav-bg: rgba(0, 0, 0, 0.6);

        /* Once the hero has scrolled past, there is nothing dark left to sit
           on and white links on white would vanish, so the bar takes a ground
           of its own. */
        &[data-scrolled="true"] {
          --nav-bg: var(--chrome-nav-scrolled-bg, #2f3438);
        }
      }

      /* Pages with no hero — a blog post, a search result — never go
         transparent: there is nothing underneath to read against. */
      &:not([data-overlay="true"]) {
        --nav-bg: var(--chrome-nav-scrolled-bg, #2f3438);
      }

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 1024px) {
          display: none;
        }
      }

      .main-nav-logo {
        margin-top: 0 !important;
      }

      .nav-hamburger.mobile-button {
        @media (min-width: 1025px) {
          display: none;
        }
      }

      /* Edge to edge, like the source, rather than inside the template's
         centred column — and as tall as the source's bar, which is what sets
         the logo down off the strip above it. */
      > .outer-content > .content {
        max-width: none;
        padding-inline: var(--chrome-header-inset, var(--spacing-lg));
      }

      > .outer-content .hd-content {
        align-items: center;
        container-type: inline-size;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);

        @media (min-width: 1025px) {
          min-height: calc(
            var(--chrome-navbar-height, 86px) - (2 * var(--spacing-md))
          );
        }

        > a > .image img {
          height: auto;
          max-width: 100%;
          /* The source's own logo width. Without it the mark renders at the
             template's 1.8em cap — about a third of the original — and the
             brand end of the bar looks empty next to it. */
          width: var(--chrome-header-logo-width, auto);
        }

        .button-group {
          margin-top: 0;
        }
      }

      > .outer-content .hd-content .hd-right {
        display: flex;
        flex: 0 1 700px;
        flex-direction: column;
        gap: var(--spacing-sm);
        margin-left: auto;
        align-items: end;
        margin-right: 20px;
      }

      > .outer-content .hd-content .hd-actions {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        gap: var(--spacing-xs);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end > .desktop-main-nav.bar {
        flex: 0 1 auto;
      }

      > .outer-content .hd-content .nav-end > .desktop-button-group.button-group {
        flex: 0 0 30px;
        margin-top: 0;
        width: auto;
      }

      > .outer-content .hd-content .page-buttons {
        flex: 0 0 auto;

        > .button-group {
          container-type: normal;
          margin-left: 0;
        }
      }
    }

    /*
     * The menu's own type, measured from the source: Lato 14/600 uppercase in
     * white. The caret is the template's chevron turned to point down, which
     * is where this menu's carets point, and stripped of the bordered box the
     * template draws around it — the source has a bare glyph.
     */
    .main-nav .desktop-main-nav.bar {
      > .bar-list > .nav-item > a,
      > .bar-list > .nav-item > .nav-item-trigger {
        color: var(--chrome-nav-link-color, var(--color-text));
        font-family: var(--chrome-nav-link-font, inherit);
        font-size: var(--chrome-nav-link-size, var(--font-size-sm));
        font-weight: var(--chrome-nav-link-weight, var(--font-weight-semibold));
        text-transform: var(--chrome-nav-link-transform, none);
      }

      > .bar-list > .nav-item > .nav-item-trigger {
        background: none;
        border: 0;
        padding-inline: var(--spacing-xs);

        /* The source marks a menu that opens with a solid caret under the
           label. The template's hairline chevron in a bordered box reads as a
           control rather than as punctuation, so the box goes and the glyph
           takes the link's own weight and colour. */
        .nav-item-icon {
          color: var(--chrome-nav-link-color, currentColor);
          font-size: 0.85em;
          rotate: 90deg;

          svg {
            stroke-width: 3;
          }
        }
      }
    }

    .hd-info{display: flex; justify-content: space-between; align-items: center;}
    .main-nav .phy{display: block; text-transform: uppercase; letter-spacing: 2px; color: var(--color-text); line-height: 1; transition: .3s;}
      .main-nav .pho{font-weight: var(--font-weight-bold); color: var(--color-brand); font-size: var(--font-size-2xl); line-height: 1; transition: .3s; display: block; margin: 0 auto 5px;}

    /* The strip's second destination. Sized with the address rather than the
       phone number: at `.pho` it reads as a second number to call. */
    .main-nav .top-bar-link{display: block; color: var(--color-text); line-height: 1; margin-bottom: 5px; transition: .3s;}

    .main-nav .pho:hover, .main-nav .phy:hover, .main-nav .top-bar-link:hover{color: var(--color-brand-secondary)}

    /*
     * The collapsed menu's button, at the size and colour the source drew it.
     *
     * The template's is a 70px brand-coloured block flush to the edge of the
     * window; the source's is a small white square set in from it. Over a hero
     * the difference is the loudest thing in the header, because the template's
     * block is the only saturated colour on the screen.
     */
    .mobile-nav-button{
      min-width: 10px;
      border: none;
      border-radius: var(--chrome-nav-toggle-radius, 0);
      height: var(--chrome-nav-toggle-size, 70px);
      width: var(--chrome-nav-toggle-size, 70px);
      background-color: var(--chrome-nav-toggle-bg, var(--color-brand));
      color: var(--chrome-nav-toggle-color, var(--color-text-on-brand));
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .nav-hamburger .mobile-nav-button .icon {
      font-size: calc(var(--chrome-nav-toggle-size, 70px) * 0.62);
    }

    .nav-hamburger .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-close .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .mobile-close .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-nav-close {}


    @media (max-width: 1024px) {
      .main-nav{padding: 0;}
      .main-nav > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: space-between;
        /* The toggle is a small square set in from the edge now, not a
           full-height block flush against it. */
        padding-right: var(--chrome-header-inset, var(--spacing-lg));
      }

      .main-nav > .outer-content .hd-content {
        align-items: center;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
      }

      .main-nav > .outer-content .hd-content .logo-link {
        display: block;
        flex: 0 0 auto;
      }

      .main-nav > .outer-content .hd-content .logo-link .image img {
        display: block;
      }

      .hd-info, .top-bar{display: none;}
      .main-nav > .outer-content .hd-content .hd-right {display: none;}
    }
  }

</style>
