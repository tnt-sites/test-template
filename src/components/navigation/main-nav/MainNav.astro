---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [],
  pageButtons = [],
  socials = [],
  class: className,
  offices = [],
  legalLinks = [],
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  _component,
  ...htmlAttributes
} = Astro.props;

const defaultSearchButtonSections = [
  {
    _component: "building-blocks/core-elements/button",
    text: "Search",
    hideText: true,
    link: "/search/",
    iconName: "magnifying-glass",
    iconPosition: "before",
    variant: "ghost",
    size: "lg",
    width: "xs",
  },
];

const resolvedSearchButtonSections =
  Array.isArray(buttonSections) && buttonSections.length > 0
    ? buttonSections
    : defaultSearchButtonSections;

const sanitizeButtonSection = (button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
});

const searchButtons = resolvedSearchButtonSections.map((button: any) =>
  sanitizeButtonSection(button)
);

const buttons = pageButtons.map((button: any) => sanitizeButtonSection(button));

// A page button flattened into the mobile menu becomes a plain nav link, so
// its `newTab` toggle has to be restated as `target`/`rel` here — the mobile
// nav items have no `newTab` field of their own.
const toMobileNavItem = (button: any) => {
  const newTab = typeof button?.newTab === "string"
    ? button.newTab.trim().toLowerCase() === "true"
    : !!button?.newTab;

  return {
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
    ...(newTab ? { target: "_blank", rel: "noopener noreferrer" } : {}),
  };
};

const mobileNavData = [
  ...navData,
  ...searchButtons.map(toMobileNavItem),
  ...buttons.map(toMobileNavItem),
];

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["main-nav", className]}
  {...htmlAttributes}
>
  <div class="hd-content">
    <a class="logo-link" href="/">
      <Image source={logoSource} class="main-nav-logo" alt={logoAlt} editable={false} />
    </a>
    <!-- Desktop Nav -->
    <div class="hd-right">
      <!-- Phone and Address -->
      <div class="hd-info">
        {
          resolvedOffices.map((office: any) => (
            <>
              <div>
                {Array.isArray(office?.phones) &&
                  office.phones.map((phone: any) =>
                    phone?.display ? (
                      <a href={phone?.href || "#"} class="pho">
                        {phone?.label ? `${phone.label}: ` : ""}
                        {phone.display}
                      </a>
                    ) : null
                  )}

                {Array.isArray(office?.addresses) &&
                  office.addresses.map((address: any) => {
                    const formattedLines = formatAddressLines(address);

                    return formattedLines.length > 0 ? (
                      <a
                        href={address?.mapUrl || "#"}
                        class="phy"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {/* The source header prints the address on one line
                            ("4005 Broadway St, Houston, TX 77087"); only the
                            footer breaks it across two. Joining here rather
                            than hiding a <br> in CSS, because `display: none`
                            on the <br> merges the two text runs into a single
                            anonymous flex item and no gap can separate them. */}
                        {formattedLines.join(", ")}
                      </a>
                    ) : null;
                  })}
              </div>
            </>
          ))
        }
      </div>
      {
        buttons.length > 0 && (
          <div class="hd-btns page-buttons">
            <ButtonGroup
              direction="row"
              align="center"
              class="desktop-button-group"
              buttonSections={buttons}
              editable={false}
            />
          </div>
        )
      }
      <div class="hd-nav">
        <div class="nav-end">
          <Bar navData={navData} class="desktop-main-nav" />

          <ButtonGroup
            direction="row"
            align="center"
            class="desktop-button-group"
            buttonSections={searchButtons}
            editable={false}
          />
        </div>
      </div>
      <!-- End Desktop Nav -->
    </div>
  </div>
  <!-- Mobile Nav -->
  <Mobile
    logoSource={logoSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    offices={resolvedOffices}
    sharedSocials={sharedSocials}
  />
  <!-- End Mobile Nav -->
</CustomSection>

<!-- Adds --site-header-height CSS variable based on header height. Works with multiple screen sizes. -->
<script>
  const initMainNavHeaderHeight = () => {
    document.querySelectorAll(".main-nav").forEach((mainNav) => {
      if (mainNav.getAttribute("data-header-height-initialized") === "true") return;

      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      syncHeaderHeight();

      if (typeof ResizeObserver !== "undefined") {
        const resizeObserver = new ResizeObserver(syncHeaderHeight);
        resizeObserver.observe(mainNav);
      }

      mainNav.setAttribute("data-header-height-initialized", "true");
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNavHeaderHeight);
  } else {
    initMainNavHeaderHeight();
  }
</script>

<!-- Mirrors the source's `body.fix-nav` state: once the page scrolls past the
     header's own height the transparent scrim is swapped for the solid band. -->
<script>
  const initMainNavScrolled = () => {
    const mainNav = document.querySelector(".main-nav");
    if (!mainNav || mainNav.getAttribute("data-scrolled-initialized") === "true") return;
    mainNav.setAttribute("data-scrolled-initialized", "true");

    const sync = () => {
      mainNav.classList.toggle("is-scrolled", window.scrollY >= mainNav.offsetHeight);
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNavScrolled);
  } else {
    initMainNavScrolled();
  }
</script>

<style lang="pcss" is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      background-color: var(--color-bg); 
      padding-block: var(--spacing-md);
      position: sticky; 
      top: 0;

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 1024px) {
          display: none;
        }
      }

      .main-nav-logo {
        margin-top: 0 !important;
      }

      .nav-hamburger.mobile-button {
        @media (min-width: 1025px) {
          display: none;
        }
      }

      > .outer-content .hd-content {
        align-items: center;
        container-type: inline-size;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);

        > a > .image img {
          height: 1.8em;
          max-width: min(20em, 100%);
          width: auto;
        }

        .button-group {
          margin-top: 0;
        }
      }

      > .outer-content .hd-content .hd-right {
        display: flex;
        flex: 0 1 700px;
        flex-direction: column;
        gap: var(--spacing-sm);
        margin-left: auto;
        align-items: end;
        margin-right: 20px;
      }

      > .outer-content .hd-content .hd-actions {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        gap: var(--spacing-xs);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end > .desktop-main-nav.bar {
        flex: 0 1 auto;
      }

      > .outer-content .hd-content .nav-end > .desktop-button-group.button-group {
        flex: 0 0 30px;
        margin-top: 0;
        width: auto;
      }

      > .outer-content .hd-content .page-buttons {
        flex: 0 0 auto;

        > .button-group {
          container-type: normal;
          margin-left: 0;
        }
      }
    }

    .hd-info{display: flex; justify-content: space-between; align-items: center;}
    .main-nav .phy{display: block; text-transform: uppercase; letter-spacing: 2px; color: var(--color-text); line-height: 1; transition: .3s;}
      .main-nav .pho{font-weight: var(--font-weight-bold); color: var(--color-brand); font-size: var(--font-size-2xl); line-height: 1; transition: .3s; display: block; margin: 0 auto 5px;}

    .main-nav .pho:hover, .main-nav .phy:hover{color: var(--color-brand-secondary)}

    .mobile-nav-button{min-width: 10px;border-radius: 0; border: none; height: 70px; width: 70px; background-color: var(--color-brand); color: var(--color-text-on-brand); display: flex; align-items: center; justify-content: center;}
    .nav-hamburger .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .nav-hamburger .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-close .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .mobile-close .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-nav-close {}


    @media (max-width: 1024px) {
      .main-nav{padding: 0;}
      .main-nav > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: space-between;
        padding-right: 0;
      }

      .main-nav > .outer-content .hd-content {
        align-items: center;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
      }

      .main-nav > .outer-content .hd-content .logo-link {
        display: block;
        flex: 0 0 auto;
      }

      .main-nav > .outer-content .hd-content .logo-link .image img {
        display: block;
      }

      .hd-info, .top-bar{display: none;}
      .main-nav > .outer-content .hd-content .hd-right {display: none;}
    }
  }

  /* ----------------------------------------------------------------------
     Source header architecture (newteethhouston.com)

     `mig chrome` migrates the header as data plus colour and type, never its
     architecture. Matching heights was not enough here: the source's header is
     two stacked pills, and the template renders three loose stacked rows.

     Source:
       .place-nav (row, max 1350, pad 15, align flex-start)
         a.logo                       position:absolute — hangs below the band
         .hd-container (margin-left auto)
           #hd-top > .hd-info         DARK pill  #292929, radius 50, pad 8/20
                                      address · CALL TODAY (713) 497-1814
           nav#main-nav               GREY pill  #E2E2E2, radius 50, pad-left 50
                                      the menu AND the blue Book Online button

     Template: .hd-content > a.logo-link + .hd-right > (.hd-info, .hd-btns,
     .hd-nav) — no pills, phone above address, CTA floating outside the nav.

     Rebuilt below with grid areas so the CTA joins the nav row and the two
     share one continuous grey pill (left half on .hd-nav, right half on
     .hd-btns). `source-bridge` outranks `components`/`page-sections`, so this
     wins without forking the component, and everything is gated at the
     source's own 1025px breakpoint — below it the template's responsive
     chrome already works and ungated fixed columns overflow a phone.
     ---------------------------------------------------------------------- */
  @layer source-bridge {
    @media (min-width: 1025px) {
      /* The source's logo is `position: absolute; top: 15px; left: 15px`, so
         its 186px height never sizes the header — it deliberately hangs below
         the 160px band. Left in flow it was the tallest flex item and set the
         header height on its own. */
      .main-nav > .outer-content .hd-content {
        align-items: flex-start;
        position: relative;
      }

      .main-nav > .outer-content .hd-content .logo-link {
        left: 0;
        position: absolute;
        top: 0;
        z-index: 2;
      }

      /* `minmax(0, 1fr)` on the nav column and `min-width: 0` on .hd-right are
         what let the nav band shrink below its content width. Without them the
         grid held its min-content size and the Book Online button pushed the
         document 27px past a 1280 viewport — a desktop horizontal scrollbar,
         which `mig qa` fails on. The source shrinks the same band with
         `nav { flex: 0 1 1050px }`. */
      /* `flex: 0 1 auto` + `margin-left: auto` sizes the block to its content
         and pushes it right, mirroring the source's `.hd-container
         { margin-left: auto }`. `1 1 auto` made it grow instead, sliding the
         nav pill left underneath the logo.

         `minmax(0, 1fr)` on the nav column and `min-width: 0` here are what
         let the band shrink below its content width; without them the grid
         held its min-content size and the Book Online button pushed the
         document 27px past a 1280 viewport. The source shrinks the same band
         with `nav { flex: 0 1 1050px }`. */
      .main-nav > .outer-content .hd-content .hd-right {
        align-items: stretch;
        display: grid;
        flex: 0 1 auto;
        gap: 15px 0;
        grid-template-areas:
          "info info"
          "nav  btns";
        grid-template-columns: minmax(0, 1fr) auto;
        justify-content: end;
        margin-left: auto;
        margin-right: 0;
        min-width: 0;
      }

      /* Reserves the logo's column. The logo is absolutely positioned, and an
         abspos element resolves `left: 0` against the padding box, so this
         holds the flex content clear of it without moving the logo itself. */
      .main-nav > .outer-content .hd-content {
        padding-left: 210px;
      }

      /* The source's header box is `.place-nav { max-width: 1350px; padding:
         15px }`, i.e. content from 60px to 1380px at a 1440 viewport. The
         template's CustomSection was giving 104px–1336px, so both pills sat
         44px short of the source's right edge. */
      .main-nav > .outer-content > .content {
        margin: 0 auto;
        max-width: 1350px;
        padding: 15px;
      }

      /* CustomSection still applies 16px block padding of its own despite
         `paddingVertical="none"`, which put the header 32px over the source's
         160px. The source's only vertical padding is the 15px above. */
      .main-nav.custom-section {
        padding-block: 0;
      }

      /* Source: `nav { flex: 0 1 1050px }` — a declared basis the band shrinks
         from. Its measured width at 1440 is 928px (a 608px menu region plus
         the 320px button), which is what this basis reproduces; the nav column
         is free to shrink below it at narrower viewports. */
      .main-nav > .outer-content .hd-content .hd-right {
        flex-basis: 928px;
      }

      /* ---- dark pill: address · CALL TODAY phone ---- */
      .main-nav > .outer-content .hd-content .hd-info {
        align-items: center;
        background-color: #292929;
        border-radius: 50px;
        display: flex;
        gap: 20px;
        grid-area: info;
        justify-content: center;
        /* The source's dark pill spans the same 928px as the nav band below
           it; content-sizing it left the two edges misaligned. */
        justify-self: stretch;
        margin: 0;
        padding: 8px 20px;
      }

      .main-nav > .outer-content .hd-content .hd-info > div {
        align-items: center;
        display: flex;
        gap: 20px;
      }

      /* The template emits the phone before the address; the source shows the
         address first, separated by a fontello dot. */
      .main-nav .hd-info .phy {
        color: #fff;
        font: 500 17px/1 aktiv-grotesk-extended, sans-serif;
        order: 1;
        position: relative;
      }

      .main-nav .hd-info .pho {
        align-items: center;
        color: #fff;
        display: flex;
        font: 500 26px/1 aktiv-grotesk-extended, sans-serif;
        gap: 10px;
        order: 2;
        position: relative;
      }

      /* The source's separator dot between address and phone, and its small
         blue "CALL TODAY" kicker. Both are presentational in the source
         (`<i class="icon-circle">` and a `<span>`); the template's data model
         has no field for either, so they are restated in CSS rather than
         faked into the phone's label — a label would render as plain
         "CALL TODAY: (713)…" in the same size and colour as the number. */
      .main-nav .hd-info .pho::before {
        color: #9ecae1;
        content: "\e933  CALL TODAY";
        font-family: "fontello", aktiv-grotesk-extended, sans-serif;
        font-size: 12px;
        letter-spacing: 1px;
        white-space: pre;
      }

      .main-nav .hd-info .pho:hover,
      .main-nav .hd-info .phy:hover {
        color: #9ecae1;
      }

      /* The source prints the header address in mixed case; the template's own
         `.main-nav .phy` uppercases it. (The one-line join happens in the
         markup above, not here.) */
      .main-nav .hd-info .phy {
        text-transform: none;
      }

      /* ---- grey pill: nav on the left, Book Online button on the right ---- */
      .main-nav > .outer-content .hd-content .hd-nav {
        backdrop-filter: blur(10px);
        background-color: #e2e2e2;
        border-radius: 50px 0 0 50px;
        display: flex;
        grid-area: nav;
        min-width: 0;
        padding-left: 50px;
        padding-right: 12px;
      }


      .main-nav > .outer-content .hd-content .hd-nav .nav-end {
        flex: 1 1 auto;
        justify-content: space-around;
        width: 100%;
      }

      .main-nav > .outer-content .hd-content .hd-nav .desktop-main-nav {
        flex: 1 1 auto;
      }

      /* Source: `nav > ul > li > a { padding: 6px 8px; font-size: 16px }`. The
         template's own item padding made the band 94px wider than the
         source's 928px. */
      .main-nav > .outer-content .hd-content .hd-nav :is(a, button) {
        font-size: 16px;
      }

      /* The source nests each submenu caret INSIDE its link
         (`$('nav > ul > .has-submenu > a').append('<button>…')`), so the whole
         menu fits its 608px region. The template renders the caret as a
         separate trigger NEXT TO the link — 17px of trigger plus a 4px column
         gap on each of the four dropdowns, 84px the 608px pill does not have,
         which pushed "Contact" underneath the Book Online button.
         Tightened padding alone did not buy that back; the caret is taken out
         of flow instead and laid over the link's own right padding, so a
         dropdown item measures exactly as wide as a plain one plus the caret's
         inset — the same footprint the source's nested caret has. */
      .main-nav .hd-nav .bar-list > .nav-item > a {
        padding: 6px 4px;
      }

      .main-nav .hd-nav .bar-list > .nav-item.has-children {
        column-gap: 0;
      }

      .main-nav .hd-nav .bar-list > .nav-item.has-children > a {
        padding-right: 14px;
      }

      .main-nav .hd-nav .bar-list > .nav-item.has-children > .nav-item-trigger {
        align-items: center;
        bottom: 0;
        display: flex;
        justify-content: flex-end;
        position: absolute;
        right: 0;
        top: 0;
      }

      /* The source's own gap between items is zero — `nav ul` spaces them with
         `justify-content: space-around` alone. The template's 8px flex gap put
         another 32px on a band that had none to give. */
      .main-nav .hd-nav .bar-list {
        column-gap: 0;
        justify-content: space-between;
        width: 100%;
      }

      /* The source header has no search affordance. Setting `buttonSections`
         to [] in mainNav.json is not enough — MainNav falls back to a built-in
         `defaultSearchButtonSections` whenever that array is empty, so the
         magnifying glass comes back. Hidden here instead; the /search/ page
         itself still exists and works. */
      .main-nav > .outer-content .hd-content .hd-nav .nav-end > .desktop-button-group {
        display: none;
      }

      /* Submenu carets. The template renders a bordered <label> around a
         `chevron-right` SVG, which read as an empty box next to each item. The
         source appends `<button><i class="icon-angle-down"></i></button>` — a
         small green chevron pointing DOWN, with no box of its own. */
      .main-nav .hd-nav .nav-item-trigger {
        background: none;
        border: none;
        box-shadow: none;
        height: auto;
        min-height: 0;
        min-width: 0;
        padding: 0 0 0 4px;
        width: auto;
      }

      .main-nav .hd-nav .nav-item-trigger .icon {
        color: #2b8435;
        font-size: 10px;
      }

      .main-nav .hd-nav .nav-item-trigger svg {
        rotate: 90deg;
      }

      /* The CTA is a separate grid cell but paints the right end of the same
         pill, so the two read as one continuous shape. */
      .main-nav > .outer-content .hd-content .hd-btns {
        align-items: center;
        background-color: #e2e2e2;
        border-radius: 0 50px 50px 0;
        display: flex;
        grid-area: btns;
      }

      /* The source's buttons are styled with the attribute selector
         `[class^=btn]`, which carries the 320px min-width; ported as `.btn`
         alone the pill shrink-wraps its label — 211px against the source's
         320px. */
      .main-nav > .outer-content .hd-content .hd-btns .button {
        background-color: #9ecae1;
        border: none;
        border-radius: 50px;
        color: #292929;
        font: 500 16px/1 aktiv-grotesk-extended, sans-serif;
        justify-content: center;
        letter-spacing: 1px;
        min-width: 320px;
        padding: 25px 35px;
        text-transform: uppercase;
      }

      .main-nav > .outer-content .hd-content .hd-btns .button:hover {
        background-color: #2b8435;
        color: #fff;
      }

      /* ---- the source's own desktop step-downs ----
         `_above-the-fold.css:140–142`. Between 1025 and 1350 the source stops
         treating the CTA as a fixed 320px slab and shrinks it, the nav's 50px
         inset, and the menu type, in three steps. Only the 1025px breakpoint
         itself was ported, so every width below 1350 kept the widest possible
         menu AND the widest possible button inside a band that shrinks with
         `minmax(0, 1fr)` — the menu simply ran out under the button. Ported
         verbatim, keyed to the same three widths. */
      @media (max-width: 1350px) {
        .main-nav > .outer-content .hd-content .hd-nav {
          padding-left: 30px;
        }

        .main-nav .hd-nav .bar-list > .nav-item > a {
          padding: 6px;
        }

        .main-nav > .outer-content .hd-content .hd-btns .button {
          font-size: 14px;
          min-width: 0;
          padding: 25px 20px;
        }
