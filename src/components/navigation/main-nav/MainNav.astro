---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  buttonSections = [],
  pageButtons = [],
  socials = [],
  class: className,
  offices = [],
  legalLinks = [],
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  _component,
  ...htmlAttributes
} = Astro.props;

const defaultSearchButtonSections = [
  {
    _component: "building-blocks/core-elements/button",
    text: "Search",
    hideText: true,
    link: "/search/",
    iconName: "magnifying-glass",
    iconPosition: "before",
    variant: "ghost",
    size: "lg",
    width: "xs",
  },
];

const resolvedSearchButtonSections =
  Array.isArray(buttonSections) && buttonSections.length > 0
    ? buttonSections
    : defaultSearchButtonSections;

const sanitizeButtonSection = (button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
});

const searchButtons = resolvedSearchButtonSections.map((button: any) =>
  sanitizeButtonSection(button)
);

const buttons = pageButtons.map((button: any) => sanitizeButtonSection(button));

const mobileNavData = [
  ...navData,
  ...searchButtons.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
  ...buttons.map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
];

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["main-nav", className]}
  {...htmlAttributes}
>
  <div class="hd-content">
    <a class="logo-link" href="/">
      <Image source={logoSource} class="main-nav-logo" alt={logoAlt} editable={false} />
    </a>
    <!-- Desktop Nav -->
    <div class="hd-right">
      <!-- Phone and Address -->
      <div class="hd-info">
        {
          resolvedOffices.map((office: any) => (
            <>
              <div>
                {Array.isArray(office?.phones) &&
                  office.phones.map((phone: any) =>
                    phone?.display ? (
                      <a href={phone?.href || "#"} class="pho">
                        {phone?.label ? `${phone.label}: ` : ""}
                        {phone.display}
                      </a>
                    ) : null
                  )}

                {Array.isArray(office?.addresses) &&
                  office.addresses.map((address: any) => {
                    const formattedLines = formatAddressLines(address);

                    return formattedLines.length > 0 ? (
                      <a
                        href={address?.mapUrl || "#"}
                        class="phy"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {formattedLines.map((line: string, index: number) => (
                          <>
                            {line}
                            {index < formattedLines.length - 1 && <br />}
                          </>
                        ))}
                      </a>
                    ) : null;
                  })}
              </div>
            </>
          ))
        }
      </div>
      {
        buttons.length > 0 && (
          <div class="hd-btns page-buttons">
            <ButtonGroup
              direction="row"
              align="center"
              class="desktop-button-group"
              buttonSections={buttons}
              editable={false}
            />
          </div>
        )
      }
      <div class="hd-nav">
        <div class="nav-end">
          <Bar navData={navData} class="desktop-main-nav" />

          <ButtonGroup
            direction="row"
            align="center"
            class="desktop-button-group"
            buttonSections={searchButtons}
            editable={false}
          />
        </div>
      </div>
      <!-- End Desktop Nav -->
    </div>
  </div>
  <!-- Mobile Nav -->
  <Mobile
    logoSource={logoSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    offices={resolvedOffices}
    sharedSocials={sharedSocials}
  />
  <!-- End Mobile Nav -->
</CustomSection>

<!-- Adds --site-header-height CSS variable based on header height. Works with multiple screen sizes. -->
<script>
  const initMainNavHeaderHeight = () => {
    document.querySelectorAll(".main-nav").forEach((mainNav) => {
      if (mainNav.getAttribute("data-header-height-initialized") === "true") return;

      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      syncHeaderHeight();

      if (typeof ResizeObserver !== "undefined") {
        const resizeObserver = new ResizeObserver(syncHeaderHeight);
        resizeObserver.observe(mainNav);
      }

      mainNav.setAttribute("data-header-height-initialized", "true");
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNavHeaderHeight);
  } else {
    initMainNavHeaderHeight();
  }
</script>

<style lang="pcss" is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      background-color: var(--color-bg); 
      padding-block: var(--spacing-md);
      position: sticky; 
      top: 0;
      z-index: 9999;

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 1024px) {
          display: none;
        }
      }

      .main-nav-logo {
        margin-top: 0 !important;
      }

      .nav-hamburger.mobile-button {
        @media (min-width: 1025px) {
          display: none;
        }
      }

      > .outer-content .hd-content {
        align-items: center;
        container-type: inline-size;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);

        > a > .image img {
          height: 1.8em;
          max-width: min(20em, 100%);
          width: auto;
        }

        .button-group {
          margin-top: 0;
        }
      }

      > .outer-content .hd-content .hd-right {
        display: flex;
        flex: 0 1 700px;
        flex-direction: column;
        gap: var(--spacing-sm);
        margin-left: auto;
        align-items: end;
        margin-right: 20px;
      }

      > .outer-content .hd-content .hd-actions {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        gap: var(--spacing-xs);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end > .desktop-main-nav.bar {
        flex: 0 1 auto;
      }

      > .outer-content .hd-content .nav-end > .desktop-button-group.button-group {
        flex: 0 0 30px;
        margin-top: 0;
        width: auto;
      }

      > .outer-content .hd-content .page-buttons {
        flex: 0 0 auto;

        > .button-group {
          container-type: normal;
          margin-left: 0;
        }
      }
    }

    .hd-info{display: flex; justify-content: space-between; align-items: center;}
    .main-nav .phy{display: block; text-transform: uppercase; letter-spacing: 2px; color: var(--color-text); line-height: 1; transition: .3s;}
      .main-nav .pho{font-weight: var(--font-weight-bold); color: var(--color-brand); font-size: var(--font-size-2xl); line-height: 1; transition: .3s; display: block; margin: 0 auto 5px;}

    .main-nav .pho:hover, .main-nav .phy:hover{color: var(--color-brand-secondary)}

    .mobile-nav-button{min-width: 10px;border-radius: 0; border: none; height: 70px; width: 70px; background-color: var(--color-brand); color: var(--color-text-on-brand); display: flex; align-items: center; justify-content: center;}
    .nav-hamburger .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .nav-hamburger .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-close .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .mobile-close .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-nav-close {}


    @media (max-width: 1024px) {
      .main-nav{padding: 0;}
      .main-nav > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: space-between;
        padding-right: 0;
      }

      .main-nav > .outer-content .hd-content {
        align-items: center;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
      }

      .main-nav > .outer-content .hd-content .logo-link {
        display: block;
        flex: 0 0 auto;
      }

      .main-nav > .outer-content .hd-content .logo-link .image img {
        display: block;
      }

      .hd-info, .top-bar{display: none;}
      .main-nav > .outer-content .hd-content .hd-right {display: none;}
    }
  }


@layer source-bridge {
  .main-nav {
    background-color: var(--color-bg, #ffffff);
  }

  .main-nav .hd-content {
    align-items: center;
    column-gap: 20px;
    display: flex;
    flex-direction: row;
    gap: 20px;
    justify-content: space-between;
    max-width: 1350px;
  }

  .main-nav nav > ul > li > a {
    color: var(--color-text, #32302f);
    font-family: jost, sans-serif;
    font-size: 19px;
    font-weight: 400;
    line-height: 22.8px;
  }

  .main-nav picture img,
  .main-nav img {
    height: auto;
    max-width: 100%;
    width: 115.453px;
  }

  .main-nav .hd-info a.pho {
    color: #32302f;
    font-size: 25px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  .main-nav .hd-info a.phy {
    color: #32302f;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.2;
    text-transform: none;
  }

  .main-nav .hd-btns .button {
    background-color: #32302f;
    border-color: #32302f;
    border-radius: 50px;
    color: #fff;
    font-weight: 500;
  }

  .main-nav .hd-btns .button:hover {
    background-color: #118534;
    border-color: #118534;
  }

  .main-nav .nav-end > .desktop-button-group {
    display: none;
  }

  .main-nav .desktop-main-nav .nav-item-trigger {
    background: none;
    border: 1px solid rgba(58, 191, 206, 0.4);
    border-radius: 4px;
    color: #3abfce;
    margin-inline-start: 2px;
    min-height: 0;
    min-width: 0;
    padding: 2px;
  }

  .main-nav .desktop-main-nav .nav-item-trigger:hover,
  .main-nav .desktop-main-nav .nav-item-trigger:focus-visible {
    background: #3abfce;
    border-color: #3abfce;
    color: #fff;
  }

  .main-nav .desktop-main-nav .nav-item-trigger .icon {
    font-size: 19px;
  }

  .main-nav .desktop-main-nav .nav-item-trigger svg {
    transform: rotate(90deg);
  }

  @media (min-width: 1025px) {
    .main-nav nav > ul > li > a span {
      color: #32302f;
    }

    .main-nav nav > ul > li:hover > a {
      color: #a3c90d;
    }

    .main-nav nav ul ul li > a {
      font-size: 14px;
      line-height: 1.3;
      text-transform: none;
    }
  }

  @media (min-width: 1025px) {
    .main-nav {
      padding-block: 0;
    }

    .main-nav .content {
      max-width: 1350px;
      padding-inline: 10px;
    }

    .main-nav .hd-content {
      align-items: center;
      flex-wrap: nowrap;
      min-height: 132px;
    }

    .main-nav .hd-content .hd-right {
      align-items: center;
      flex: 1 1 auto;
      flex-direction: row;
      gap: 0;
      justify-content: flex-end;
      margin-right: 0;
    }

    .main-nav .hd-content .hd-nav {
      margin-inline: 40px auto;
      order: 1;
    }

    .main-nav .hd-content .hd-info {
      flex: 0 0 auto;
      flex-direction: column;
      order: 2;
      text-align: center;
      white-space: nowrap;
    }

    .main-nav .hd-content .page-buttons {
      margin-left: 59px;
      order: 3;
    }

    .main-nav .hd-btns .button {
      font-size: 18px;
      padding: 22px 30px;
    }
  }
}
</style>
