---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Bar from "@components/navigation/bar/Bar.astro";
import Mobile from "@components/navigation/mobile/Mobile.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "logo",
  navData = [],
  hideSearch = false,
  buttonSections = [],
  pageButtons = [],
  socials = [],
  class: className,
  offices = [],
  legalLinks = [],
  phoneText = "",
  phoneHref = "",
  addressHref = "",
  addressLines = [],
  emailHref = "",
  emailText = [],
  officeHoursTitle = "Office Hours",
  officeHours = [],
  officeHoursNote = "",
  officeHoursNotes = [],
  _component,
  ...htmlAttributes
} = Astro.props;

const defaultSearchButtonSections = [
  {
    _component: "building-blocks/core-elements/button",
    text: "Search",
    hideText: true,
    link: "/search/",
    iconName: "magnifying-glass",
    iconPosition: "before",
    variant: "ghost",
    size: "lg",
    width: "xs",
  },
];

const resolvedSearchButtonSections =
  Array.isArray(buttonSections) && buttonSections.length > 0
    ? buttonSections
    : defaultSearchButtonSections;

const sanitizeButtonSection = (button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
});

const searchButtons = resolvedSearchButtonSections.map((button: any) =>
  sanitizeButtonSection(button)
);

const buttons = pageButtons.map((button: any) => sanitizeButtonSection(button));

const mobileNavData = [
  ...navData,
  ...(hideSearch ? [] : searchButtons).map((button: any) => ({
    name: button.text || "Button",
    path: button.link || button.href || "#",
    children: [],
  })),
  // Phone buttons stay out of the side menu; the fixed Call tab covers mobile
  ...buttons
    .filter((button: any) => !String(button.link || button.href || "").startsWith("tel:"))
    .map((button: any) => ({
      name: button.text || "Button",
      path: button.link || button.href || "#",
      children: [],
    })),
];

const hasLegacyOffice = (Array.isArray(addressLines) && addressLines.length > 0) || !!phoneText;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0
    ? offices
    : hasLegacyOffice
      ? [
          {
            name: "",
            addresses:
              Array.isArray(addressLines) && addressLines.length > 0
                ? [
                    {
                      lines: addressLines,
                      mapUrl: addressHref || "",
                    },
                  ]
                : [],
            phones: phoneText
              ? [
                  {
                    display: phoneText,
                    href: phoneHref || "",
                  },
                ]
              : [],
            officeHours,
            officeHoursNote,
            officeHoursNotes,
            socials,
          },
        ]
      : ((siteInfoData as any).offices ?? []);

const sharedSocials =
  Array.isArray(socials) && socials.length > 0
    ? socials
    : Array.isArray(resolvedOffices[0]?.socials)
      ? resolvedOffices[0].socials
      : ((siteInfoData as any).socials ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["main-nav", className]}
  {...htmlAttributes}
>
  <div class="hd-content">
    <a class="logo-link" href="/">
      <Image source={logoSource} class="main-nav-logo" alt={logoAlt} editable={false} />
    </a>
    <!-- Desktop Nav -->
    <div class="hd-right">
      <!-- Address, Socials and Buttons -->
      <div class="hd-top">
        <div class="hd-info">
          {
            resolvedOffices.map((office: any) =>
              Array.isArray(office?.addresses) &&
              office.addresses.map((address: any) => {
                const formattedLines = formatAddressLines(address);

                return formattedLines.length > 0 ? (
                  <a
                    href={address?.mapUrl || "#"}
                    class="phy"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {formattedLines.map((line: string, index: number) => (
                      <>
                        {line}
                        {index < formattedLines.length - 1 && <br />}
                      </>
                    ))}
                  </a>
                ) : null;
              })
            )
          }
        </div>
        {
          sharedSocials.length > 0 && (
            <ul class="hd-socials">
              {sharedSocials.map((social: any) => (
                <li>
                  <a
                    href={social.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit our ${social.label || social.icon} page`}
                  >
                    <Icon name={social.icon} size="none" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          buttons.length > 0 && (
            <div class="hd-btns page-buttons">
              <ButtonGroup
                direction="row"
                align="center"
                class="desktop-button-group"
                buttonSections={buttons}
                editable={false}
              />
            </div>
          )
        }
      </div>
      <div class="hd-nav">
        <div class="nav-end">
          <Bar navData={navData} class="desktop-main-nav" />

          {
            !hideSearch && (
              <ButtonGroup
                direction="row"
                align="center"
                class="desktop-button-group"
                buttonSections={searchButtons}
                editable={false}
              />
            )
          }
        </div>
      </div>
      <!-- End Desktop Nav -->
    </div>
  </div>
  <!-- Mobile Nav -->
  <Mobile
    logoSource={logoSource}
    logoAlt={logoAlt}
    navData={mobileNavData}
    class="mobile-main-nav"
    offices={resolvedOffices}
    sharedSocials={sharedSocials}
  />
  <!-- End Mobile Nav -->
</CustomSection>

<!-- Adds --site-header-height CSS variable based on header height. Works with multiple screen sizes. -->
<script>
  const initMainNavHeaderHeight = () => {
    document.querySelectorAll(".main-nav").forEach((mainNav) => {
      if (mainNav.getAttribute("data-header-height-initialized") === "true") return;

      const syncHeaderHeight = () => {
        document.documentElement.style.setProperty(
          "--site-header-height",
          `${Math.round(mainNav.getBoundingClientRect().height)}px`
        );
      };

      syncHeaderHeight();

      if (typeof ResizeObserver !== "undefined") {
        const resizeObserver = new ResizeObserver(syncHeaderHeight);
        resizeObserver.observe(mainNav);
      }

      mainNav.setAttribute("data-header-height-initialized", "true");
    });

    // Condensed header once the page has scrolled past the top bar.
    const toggleCondensed = () => {
      document
        .querySelectorAll(".main-nav")
        .forEach((mainNav) => mainNav.classList.toggle("is-condensed", window.scrollY > 60));
    };
    toggleCondensed();
    window.addEventListener("scroll", toggleCondensed, { passive: true });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMainNavHeaderHeight);
  } else {
    initMainNavHeaderHeight();
  }
</script>

<style lang="pcss" is:global>
  @layer page-sections {
    .main-nav {
      z-index: var(--layer-2);
      background-color: var(--color-bg); 
      padding-block: var(--spacing-md);
      position: sticky; 
      top: 0;

      .desktop-main-nav.bar,
      .desktop-button-group.button-group {
        @media (max-width: 1024px) {
          display: none;
        }
      }

      .main-nav-logo {
        margin-top: 0 !important;
      }

      .nav-hamburger.mobile-button {
        @media (min-width: 1025px) {
          display: none;
        }
      }

      > .outer-content .hd-content {
        align-items: center;
        container-type: inline-size;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);

        > a > .image img {
          height: 1.8em;
          max-width: min(20em, 100%);
          width: auto;
        }

        .button-group {
          margin-top: 0;
        }
      }

      > .outer-content .hd-content .hd-right {
        display: flex;
        flex: 0 1 700px;
        flex-direction: column;
        gap: var(--spacing-sm);
        margin-left: auto;
        align-items: end;
        margin-right: 20px;
      }

      > .outer-content .hd-content .hd-actions {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end {
        align-items: center;
        display: inline-flex;
        flex: 0 0 auto;
        gap: var(--spacing-xs);
        justify-content: flex-end;
      }

      > .outer-content .hd-content .nav-end > .desktop-main-nav.bar {
        flex: 0 1 auto;
      }

      > .outer-content .hd-content .nav-end > .desktop-button-group.button-group {
        flex: 0 0 30px;
        margin-top: 0;
        width: auto;
      }

      > .outer-content .hd-content .page-buttons {
        flex: 0 0 auto;

        > .button-group {
          container-type: normal;
          margin-left: 0;
        }
      }
    }

    .hd-info{display: flex; justify-content: space-between; align-items: center;}
    .main-nav .phy{display: block; text-transform: uppercase; letter-spacing: 2px; color: var(--color-text); line-height: 1; transition: .3s;}
      .main-nav .pho{font-weight: var(--font-weight-bold); color: var(--color-brand); font-size: var(--font-size-2xl); line-height: 1; transition: .3s; display: block; margin: 0 auto 5px;}

    .main-nav .pho:hover, .main-nav .phy:hover{color: var(--color-brand-secondary)}

    .mobile-nav-button{min-width: 10px;border-radius: 0; border: none; height: 70px; width: 70px; background-color: var(--color-brand); color: var(--color-text-on-brand); display: flex; align-items: center; justify-content: center;}
    .nav-hamburger .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .nav-hamburger .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-close .mobile-nav-button .icon {
      font-size: var(--font-size-4xl);
    }

    .mobile-close .mobile-nav-button .icon svg path {
      stroke-width: 2.25;
    }

    .mobile-nav-close {}

    /* Header layout from Final.xd: address, socials and buttons on top, nav underneath */
    .main-nav {
      padding-block: 10px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);

      /* XD header spans 50px to 1350px on a 1400px artboard */
      > .outer-content > .content {
        max-width: 1400px;
        padding-inline: 50px;
      }

      > .outer-content .hd-content > a > .image img {
        height: 150px;
        max-width: none;
        transition: height 0.3s;
      }

      > .outer-content .hd-content .hd-right {
        flex: 1 1 auto;
        gap: 25px;
        margin-right: 0;
      }

      .hd-top {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .phy {
        font-size: 14px;
        line-height: 18px;
        letter-spacing: 0;
        text-transform: none;
        color: #000;
        margin-right: 40px;
      }

      .phy:hover {
        color: var(--color-brand-secondary);
      }

      .hd-socials {
        display: flex;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;

        a {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 38px;
          height: 38px;
          border-radius: 4px;
          background-color: var(--color-text-intro);
          color: #fff;
          font-size: 18px;
          transition: background-color 0.3s;
        }

        a:hover {
          background-color: var(--color-brand-secondary);
        }

        .icon,
        .icon svg,
        .icon svg path {
          color: #fff;
          fill: #fff;
        }
      }

      .page-buttons .button-group {
        gap: 10px;
      }

      .page-buttons .button {
        min-width: 215px;
        height: 50px;
        border-radius: 4px;
        background-color: var(--color-accent);
        font-family: var(--font-body);
        font-size: 18px;
      }

      .page-buttons .button:hover,
      .page-buttons .button:focus {
        background-color: var(--color-brand-secondary);
      }

      .bar a {
        font-family: var(--font-ui);
        font-size: 16px;
        color: var(--color-text-nav);
      }

      .bar .bar-list {
        gap: 10px;
      }

      .bar .bar-list > .nav-item > a {
        padding: 10px 15px;
      }

      .bar a:hover {
        color: var(--color-brand-secondary);
      }

      .bar .bar-list > .nav-item > a[aria-current="page"] {
        text-decoration: none;
        box-shadow: inset 0 -3px 0 #1a77c0;
      }
      &.is-condensed {
        > .outer-content .hd-content > a > .image img {
          height: 85px;
        }

        > .outer-content .hd-content .hd-right {
          gap: 10px;
        }
      }
    }


    @media (max-width: 1024px) {
      .main-nav{padding: 0;}
      .main-nav > .outer-content > .content {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        justify-content: space-between;
        padding-right: 0;
      }

      .main-nav > .outer-content .hd-content {
        align-items: center;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
      }

      .main-nav > .outer-content .hd-content .logo-link {
        display: block;
        flex: 0 0 auto;
      }

      .main-nav > .outer-content .hd-content .logo-link .image img {
        display: block;
      }

      .hd-info, .top-bar{display: none;}
      .main-nav > .outer-content .hd-content .hd-right {display: none;}
    }
  }

</style>
