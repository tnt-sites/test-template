---
import Button from "@core-elements/button/Button.astro";
import { schedulingLinkAttrs } from "@component-utils/scheduling-links";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";

const {
  logoSource,
  logoAlt,
  navData = [],
  socials = [],
  officeHoursTitle = "Office Hours",
  offices = [],
  sharedSocials = [],
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props as Props;

const toggleId = `mobile-toggle-${crypto.randomUUID()}`;

// Check if item is current page
function isCurrentPage(item) {
  return Boolean(item.path && Astro.url.pathname === item.path);
}

// Check if any child is current page (recursive)
function hasCurrentChild(item) {
  if (isCurrentPage(item)) return true;
  return Boolean(item.children?.some((child) => hasCurrentChild(child)));
}

// Create navigation item data
function createNavItemData(item, level, parentGroupId) {
  const hasChildren = Boolean(item.children?.length);

  return {
    ...item,
    hasChildren,
    // Spread onto the item's anchor — empty for everything but booking links.
    linkAttrs: schedulingLinkAttrs(item.path),
    level,
    contentId: `dropdown-content-${crypto.randomUUID()}`,
    isCurrent: isCurrentPage(item),
    hasCurrent: hasCurrentChild(item),
    parentGroupId: parentGroupId || crypto.randomUUID(),
  };
}

const getOfficeHoursGeneralNotes = (office: any) => {
  const notes = [
    office?.officeHoursNote,
    office?.["office-hours-note"],
    ...(Array.isArray(office?.officeHoursNotes) ? office.officeHoursNotes : []),
    ...(Array.isArray(office?.["office-hours-notes"]) ? office["office-hours-notes"] : []),
  ];

  return notes.filter((note) => typeof note === "string" && note.trim().length > 0);
};
---

<input type="checkbox" id={toggleId} class="nav-toggle" autocomplete="off" />
<label
  for={toggleId}
  class="nav-hamburger mobile-button"
  tabindex="0"
>
  <span class="visually-hidden">Toggle navigation menu</span>
  <Button
    variant="tertiary"
    size="lg"
    element="div"
    iconName="bars-3"
    hideText="true"
    class="mobile-nav-button"
  />
</label>

<nav class:list={["mobile", className]} aria-label="Mobile menu" data-toggle-id={toggleId} {...htmlAttributes}>
  <div class="mobile-header">
    <div class="mobile-logo">
      <slot name="logo">
        <Image
          source={logoSource}
          alt={logoAlt || "Logo"}
          width={120}
          height={48}
          class="mobile-logo-image"
          editable={false}
        />
      </slot>
    </div>
    <label
      for={toggleId}
      class="mobile-close mobile-button"
      tabindex="0"
    >
      <span class="visually-hidden">Close navigation menu</span>
      <Button
        variant="tertiary"
        size="lg"
        element="span"
        iconName="x-mark"
        hideText="true"
        class="mobile-nav-close mobile-nav-button"
      />
    </label>
  </div>

  <div class="mobile-content">
    {
      sharedSocials.length > 0 && (
        <div class="mobile-socials">
          {sharedSocials.map((social: any) => (
            <Button
              variant="ghost"
              size="lg"
              iconName={social.icon}
              link={social.link}
              hideText="true"
              aria-label={`Visit our ${social.icon} page`}
              target="_blank"
              rel="noopener noreferrer"
            />
          ))}
        </div>
      )
    }

    <ul class="mobile-list">
      {
        navData.map((item) => {
          const itemData = createNavItemData(item, "top");

          if (!itemData.hasChildren) {
            return (
              <li class="nav-item">
                <a
                  href={itemData.path}
                  {...itemData.linkAttrs}
                  aria-current={itemData.isCurrent ? "page" : undefined}
                >
                  {itemData.name}
                </a>
              </li>
            );
          }

          return (
            <li class="nav-item has-children">
              <a
                href={itemData.path}
                {...itemData.linkAttrs}
                aria-current={itemData.isCurrent ? "page" : undefined}
              >
                {itemData.name}
              </a>
              <button
                type="button"
                class="nav-item-trigger"
                aria-controls={itemData.contentId}
                aria-expanded={itemData.hasCurrent ? "true" : "false"}
              >
                <span class="visually-hidden">{`Toggle ${itemData.name} submenu`}</span>
                <span class="nav-item-icon">
                  <Icon name="chevron-right" size="none" aria-hidden="true" />
                </span>
              </button>
              <div
                id={itemData.contentId}
                class="nav-item-content"
                role="region"
                aria-label={`${itemData.name} submenu`}
                aria-hidden={!itemData.hasCurrent}
              >
                <ul class="nav-list">
                  {itemData.children!.map((child) => {
                    const childData = createNavItemData(child, "child", itemData.parentGroupId);

                    if (!childData.hasChildren) {
                      return (
                        <li class="nav-item">
                          <a
                            href={childData.path}
                            {...childData.linkAttrs}
                            aria-current={childData.isCurrent ? "page" : undefined}
                          >
                            {childData.name}
                          </a>
                        </li>
                      );
                    }

                    return (
                      <li class="nav-item has-children">
                        <a
                          href={childData.path}
                          {...childData.linkAttrs}
                          aria-current={childData.isCurrent ? "page" : undefined}
                        >
                          {childData.name}
                        </a>
                        <button
                          type="button"
                          class="nav-item-trigger"
                          aria-controls={childData.contentId}
                          aria-expanded={childData.hasCurrent ? "true" : "false"}
                        >
                          <span class="visually-hidden">{`Toggle ${childData.name} submenu`}</span>
                          <span class="nav-item-icon">
                            <Icon name="chevron-right" size="none" aria-hidden="true" />
                          </span>
                        </button>
                        <div
                          id={childData.contentId}
                          class="nav-item-content"
                          role="region"
                          aria-label={`${childData.name} submenu`}
                          aria-hidden={!childData.hasCurrent}
                        >
                          <ul class="nav-list">
                            {childData.children!.map((grandChild) => {
                              const grandChildData = createNavItemData(
                                grandChild,
                                "child",
                                childData.parentGroupId
                              );

                              return (
                                <li class="nav-item">
                                  <a
                                    href={grandChildData.path}
                                    {...grandChildData.linkAttrs}
                                    aria-current={grandChildData.isCurrent ? "page" : undefined}
                                  >
                                    {grandChildData.name}
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </li>
          );
        })
      }
    </ul>
    <div class="hd-hours">
      <span class="hd-title">{officeHoursTitle}</span>
      {
        offices.map((office: any) => (
          <div class="hours office-hours-block">
            {office?.name && <span class="office-name">{office.name}</span>}
            <div class="hours-list">
              {(office?.officeHours || []).map((item: any) => (
                <div class="hours-row">
                  <div class="hours-line">
                    <span class="hours-day">{item.day || ""}</span>
                    <span class="hours-time">{item.hours || ""}</span>
                  </div>
                  {(item?.note || item?.hoursNote || item?.["hours-note"]) && (
                    <small class="hours-note">
                      {item?.note || item?.hoursNote || item?.["hours-note"]}
                    </small>
                  )}
                </div>
              ))}
            </div>
            {getOfficeHoursGeneralNotes(office).length > 0 && (
              <div class="hours-general-notes">
                {getOfficeHoursGeneralNotes(office).map((note: string) => (
                  <small class="hours-general-note">{note}</small>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</nav>

<script>
  // Create overlays container for proper z-index stacking
  function getOrCreateOverlaysContainer() {
    let container = document.getElementById("overlays-container");
    if (!container) {
      container = document.createElement("div");
      container.id = "overlays-container";
      container.style.cssText = "position: relative; z-index: 9999;";
      document.body.insertBefore(container, document.body.firstChild);
    }
    return container;
  }

  // Initialize mobile navigation instances
  const allMobileNavs = document.querySelectorAll(".mobile");
  const overlaysContainer = getOrCreateOverlaysContainer();

  allMobileNavs.forEach((nav) => {
    // Add a class to indicate JS is available
    nav.classList.add("js-enabled");

    // Move entire nav to overlays container for proper z-index stacking
    overlaysContainer.appendChild(nav);

    // Find the toggle for this specific nav instance
    const toggleId = nav.getAttribute("data-toggle-id");
    const toggle = document.getElementById(toggleId);
    const hamburger = document.querySelector(`label[for="${toggleId}"].nav-hamburger`);

    // Handle navigation toggle state and accessibility
    function handleNavToggle(isOpen) {
      if (isOpen) {
        nav.setAttribute("aria-hidden", "false");
        nav.style.transform = "translateX(0)";
        document.body.style.overflow = "hidden";
        nav.querySelector(".mobile-close")?.focus();
      } else {
        nav.setAttribute("aria-hidden", "true");
        nav.style.transform = "translateX(-100%)";
        document.body.style.overflow = "";
        hamburger?.focus();
      }
    }

    // Handle hamburger button interactions
    if (hamburger && toggle) {
      const toggleHandler = (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggle.checked = !toggle.checked;
        handleNavToggle(toggle.checked);
      };

      hamburger.addEventListener("click", toggleHandler);
      hamburger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          toggleHandler(e);
        }
      });
    }

    // Handle close button interactions
    const closeButton = nav.querySelector(".mobile-close");
    if (closeButton && toggle) {
      const closeHandler = (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggle.checked = false;
        handleNavToggle(false);
      };

      closeButton.addEventListener("click", closeHandler);
      closeButton.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          closeHandler(e);
        }
      });
    }

    // Handle toggle state changes
    if (toggle) {
      toggle.addEventListener("change", (e) => {
        handleNavToggle(e.target.checked);
      });
    }

    // Each submenu's open state lives on its trigger button's aria-expanded,
    // which the CSS keys off. Enter and Space click a button natively, so the
    // one click handler covers keyboard use too.
    const setExpanded = (trigger, isExpanded) => {
      trigger.setAttribute("aria-expanded", String(isExpanded));
      document.getElementById(trigger.getAttribute("aria-controls") || "")?.setAttribute("aria-hidden", String(!isExpanded));
    };

    const handleDropdownToggle = (e) => {
      const trigger = e.target?.closest(".nav-item-trigger");
      if (!trigger) return;

      e.preventDefault();
      const opening = trigger.getAttribute("aria-expanded") !== "true";

      // One submenu open per level, as the source's accordion behaves.
      if (opening) {
        const list = trigger.closest(".nav-item")?.parentElement;

        list?.querySelectorAll(":scope > .nav-item > .nav-item-trigger").forEach((sibling) => {
          if (sibling !== trigger) setExpanded(sibling, false);
        });
      }

      setExpanded(trigger, opening);
    };

    nav.addEventListener("click", handleDropdownToggle);

    // Handle escape key to close navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle?.checked) {
        toggle.checked = false;
        handleNavToggle(false);
      }
    });
  });
</script>

<style lang="pcss" is:global>
  @layer components {
    .nav-toggle {
      display: none;
    }

    .nav-toggle:checked ~ .mobile {
      transform: translateX(0);
    }

    .mobile-button {
      border-radius: var(--radius-xs);
      display: inline-block;
      outline-offset: -2px;
    }

    .mobile {
      background: var(--color-bg);
      display: flex;
      flex-direction: column;
      height: 100vh;
      inset: 0;
      position: fixed;
      transform: translateX(-100%);
      transition: transform var(--animation-normal) ease-in-out;
      z-index: var(--layer-5);

      .mobile-logo-image {
        margin-top: 0 !important;
      }

      .mobile-header {
        align-items: center;
        border-bottom: 1px solid var(--color-border-subtle);
        display: flex;
        flex-shrink: 0;
        justify-content: space-between;
        padding: var(--spacing-md);

        .mobile-logo {
          svg {
            height: 100%;
            width: 100%;
            max-height: 3em;
          }
          img,
          mobile-logo-image {
            height: auto;
            max-height: 3em;
            max-width: min(20em, 100%);
            width: auto;
          }
        }
      }

      .mobile-content {
        flex: 1;
        overflow-y: auto;

        .mobile-list {
          font-size: var(--font-size-lg);
          list-style: none;
          margin: 0;
          padding: 0;
        }

        .nav-list {
          list-style: none;
          margin: 0;
          padding: 0;
        }

        .mobile-socials {
          align-items: center;
          border-top: 1px solid var(--color-border-subtle);
          display: flex;
          flex-wrap: wrap;
          gap: var(--spacing-sm);
          justify-content: center;
          padding: var(--spacing-lg) var(--spacing-md);
        }
      }

      .nav-item {
        border-bottom: 1px solid var(--color-border-subtle);
        position: relative;

        > a {
          border-radius: var(--radius-xs);
          color: var(--color-text-strong);
          cursor: pointer;
          display: block;
          font-weight: var(--font-weight-semibold);
          padding: var(--spacing-md);
          text-decoration: none;
          transition: background var(--animation-normal) ease-in-out;
          user-select: none;
          white-space: nowrap;
          width: 100%;

          &[aria-current="page"] {
            text-decoration: underline dotted;
            text-decoration-color: var(--color-text-muted);
            text-underline-offset: 3px;
          }

          &:hover,
          &:focus-visible {
            background: var(--color-state-hover);
            color: var(--color-text-strong);
          }
        }

        &.has-children {
          align-items: center;
          display: flex;
          flex-wrap: wrap;

          > a {
            flex: 1 1 auto;
            min-width: 0;
            width: auto;
          }

          > .nav-item-content {
            flex: 1 1 100%;
          }
        }

        > .nav-item-trigger {
          align-items: center;
          background: none;
          border: 1px solid var(--color-border-subtle);
          padding: 0;
          border-radius: var(--radius-xs);
          color: var(--color-text-muted);
          cursor: pointer;
          display: inline-flex;
          flex-shrink: 0;
          justify-content: center;
          margin: var(--spacing-xs);
          min-height: 1.75rem;
          min-width: 1.75rem;
          transition:
            background-color var(--animation-normal) ease-in-out,
            border-color var(--animation-normal) ease-in-out,
            color var(--animation-normal) ease-in-out;

          .nav-item-icon {
            color: currentColor;
            transition: transform var(--animation-normal) ease-in-out;
          }

          &:hover,
          &:focus-visible {
            background: var(--color-brand-secondary);
            border-color: var(--color-brand-secondary);
            color: var(--color-text-inverse);
          }
        }

        .nav-item-content {
          display: none;
        }

        .nav-item-trigger[aria-expanded="true"] ~ .nav-item-content {
          animation: grow-out var(--animation-normal) ease-out;
          display: block;
        }

        .nav-item-trigger[aria-expanded="true"] .nav-item-icon {
          transform: rotate(90deg);
        }
      }

      .nav-item > .nav-item-content .nav-item {
        > a {
          padding: var(--spacing-md) var(--spacing-xl);
          width: 100%;
        }

        &.has-children > a {
          width: auto;
        }

        &:last-child {
          border-bottom: none;
        }

        > .nav-item-content .nav-item {
          > a {
            padding: var(--spacing-md) var(--spacing-2xl);
            width: 100%;
          }

          &.has-children > a {
            width: auto;
          }
        }
      }

      .hd-title {
        color: var(--color-text-strong);
        display: block;
        font-weight: var(--font-weight-semibold);
        margin-bottom: var(--spacing-sm);
        text-align: center;
      }

      .hd-hours {
        padding: var(--spacing-md);

        .office-name {
          color: var(--color-text-strong);
          display: block;
          font-weight: var(--font-weight-semibold);
          margin-bottom: var(--spacing-xs);
        }

        .office-hours-block {
          margin-bottom: var(--spacing-md);
        }

        .hours {
          display: table;
          margin: 10px auto;
          text-align: left;

          .hd-title { text-align: center; }

          .hours-list {
            color: var(--color-text);
            margin: 0;
          }

          .hours-row + .hours-row {
            margin-top: 4px;
          }

          .hours-line {
            display: block;
          }

          .hours-day {
            color: var(--color-text-strong);
            display: inline-block;
            font-weight: var(--font-weight-semibold);
            width: 120px;
          }

          .hours-note {
            color: var(--color-text-muted);
            display: block;
            font-size: var(--font-size-xs);
            margin-left: 120px;
          }

          .hours-general-notes {
            margin-top: var(--spacing-xs);
          }

          .hours-general-note {
            color: var(--color-text-muted);
            display: block;
            font-size: var(--font-size-xs);
          }
        }
      }
    }

    .mobile-overlay {
      background: var(--color-bg);
      display: flex;
      flex-direction: column;
      height: 100vh;
      inset: 0;
      position: fixed;
      transform: translateX(-100%);
      transition: transform var(--animation-normal) ease-in-out;
      z-index: var(--layer-6);

      &.open {
        transform: translateX(0);
      }
    }
  }
</style>
