---
import Image from "@core-elements/image/Image.astro";

/*
 * The band the source runs above the footer on every interior page: three
 * calls to action (directions / book / contact) over a strip of accreditation
 * logos. Both appear on all 133 /vista-ca/ pages.
 */
const { ctas = [], logos = [], enabled = true } = Astro.props;
---

{
  enabled && (ctas.length > 0 || logos.length > 0) && (
    <section class="pre-footer">
      {ctas.length > 0 && (
        <div class="pf-ctas">
          {ctas.map((c: any) => (
            <div class="pf-cta">
              {c.lines?.map((l: string) => (
                <p class="pf-line">{l}</p>
              ))}
              {c.buttonText && (
                <a class="pf-button" href={c.buttonLink || "#"}>
                  {c.buttonText}
                </a>
              )}
            </div>
          ))}
        </div>
      )}

      {logos.length > 0 && (
        <div class="pf-logos">
          {logos.map((l: any) => (
            <Image
              source={l.source}
              alt={l.alt || ""}
              editable={false}
              class:list={["pf-logo", l.wide && "pf-logo-wide"]}
            />
          ))}
        </div>
      )}
    </section>
  )
}

<style lang="pcss">
  .pre-footer {
    background-color: #fff;
  }

  .pf-ctas {
    background-color: #e6e6e6;
    display: grid;
    gap: 1px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .pf-ctas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pf-cta {
    background-color: #e6e6e6;
    padding: var(--spacing-lg);
    text-align: center;
  }

  @media (min-width: 768px) {
    .pf-cta + .pf-cta {
      border-left: 1px solid #d2cec7;
    }
  }

  .pf-line {
    font-size: 1.3125rem; /* 21px, measured on the source */
    font-weight: 300;
    line-height: 1.3;
    margin: 0 0 0.25rem;
  }

  .pf-button {
    background-color: var(--color-brand-secondary, #ba9764);
    border-radius: 30px;
    color: #fff;
    display: inline-block;
    font-family: var(--font-accent, Montserrat, sans-serif);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    margin-top: var(--spacing-sm);
    min-width: 275px; /* measured on the source */
    padding: 0.55rem 1.75rem;
    text-align: center;
    text-decoration: none;
  }

  .pf-button:hover {
    background-color: #a8854f;
  }

  /* The source spreads the logos across its full 1296px container
     (x=182 to x=1234) rather than bunching them at a fixed gap. */
  .pf-logos {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    justify-content: space-evenly;
    margin: 0 auto;
    max-width: 1296px;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  /* The source sizes these by height, not width: every logo renders 100px tall
     except ADA, which is wider and caps at 197x69. A single max-height cap
     shrank the other four by about a third. */
  .pf-logos :global(img) {
    height: 100px;
    max-width: 197px;
    object-fit: contain;
    width: auto;
  }

  .pf-logos :global(.pf-logo-wide img) {
    height: 69px;
  }
</style>
