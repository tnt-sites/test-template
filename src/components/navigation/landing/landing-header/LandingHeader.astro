---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  logoSource,
  logoAlt = "Logo",
  pageButtons = [],
  offices = [],
  mobileCallSmallText = "Call Now",
  mobileRequestLabel = "Request an Appointment",
  mobileRequestHref = "",
  mobileCallBackgroundColor = "",
  mobileCallBackgroundColorHex = "",
  mobileRequestBackgroundColor = "",
  mobileRequestBackgroundColorHex = "",
  mobileCallTextColor = "",
  mobileCallSmallTextColor = "",
  mobileRequestTextColor = "",
  mobileRequestSmallTextColor = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  class: className,
  ...htmlAttributes
} = Astro.props as {
  logoSource?: string;
  logoAlt?: string;
  pageButtons?: any[];
  offices?: any[];
  mobileCallSmallText?: string;
  mobileRequestLabel?: string;
  mobileRequestHref?: string;
  mobileCallBackgroundColor?: string;
  mobileCallBackgroundColorHex?: string;
  mobileRequestBackgroundColor?: string;
  mobileRequestBackgroundColorHex?: string;
  mobileCallTextColor?: string;
  mobileCallSmallTextColor?: string;
  mobileRequestTextColor?: string;
  mobileRequestSmallTextColor?: string;
  addressLinkColor?: string;
  addressLinkHoverColor?: string;
  phoneLinkColor?: string;
  phoneLinkHoverColor?: string;
  class?: string;
  [key: string]: any;
};

const normalizedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const normalizedPageButtons = (Array.isArray(pageButtons) ? pageButtons : []).map(
  (button: any) => ({
    ...button,
    text: typeof button?.text === "string" ? button.text : "",
  })
);

const colorTokenMap: Record<string, string> = {
  brand: "var(--color-brand)",
  "brand-secondary": "var(--color-brand-secondary)",
  "brand-tertiary": "var(--color-brand-muted)",
  dark: "var(--color-text)",
  white: "var(--color-text-inverse)",
};

const mobilePhone = normalizedOffices[0]?.phones?.[0] ?? null;
const resolvedMobileRequestLabel = mobileRequestLabel || normalizedPageButtons[0]?.text || "";
const mobileRequestLink = normalizedPageButtons[0]?.link || mobileRequestHref;
const mobileRequestLabelParts =
  typeof resolvedMobileRequestLabel === "string"
    ? resolvedMobileRequestLabel.trim().split(/\s+/)
    : [];
const mobileRequestFirstLine = mobileRequestLabelParts.slice(0, 2).join(" ");
const mobileRequestSecondLine = mobileRequestLabelParts.slice(2).join(" ");
const resolvedMobileCallBg =
  mobileCallBackgroundColorHex || colorTokenMap[mobileCallBackgroundColor] || "";
const resolvedMobileRequestBg =
  mobileRequestBackgroundColorHex || colorTokenMap[mobileRequestBackgroundColor] || "";
const resolvedMobileCallTextColor = colorTokenMap[mobileCallTextColor] || "";
const resolvedMobileCallSmallTextColor = colorTokenMap[mobileCallSmallTextColor] || "";
const resolvedMobileRequestTextColor = colorTokenMap[mobileRequestTextColor] || "";
const resolvedMobileRequestSmallTextColor = colorTokenMap[mobileRequestSmallTextColor] || "";
const resolvedAddressLinkColor = colorTokenMap[addressLinkColor] || "";
const resolvedAddressLinkHoverColor = colorTokenMap[addressLinkHoverColor] || "";
const resolvedPhoneLinkColor = colorTokenMap[phoneLinkColor] || "";
const resolvedPhoneLinkHoverColor = colorTokenMap[phoneLinkHoverColor] || "";
const cssVars = [
  resolvedMobileCallBg && `--lh-mobile-call-bg: ${resolvedMobileCallBg}`,
  resolvedMobileRequestBg && `--lh-mobile-request-bg: ${resolvedMobileRequestBg}`,
  resolvedMobileCallTextColor && `--lh-mobile-call-text-color: ${resolvedMobileCallTextColor}`,
  resolvedMobileCallSmallTextColor &&
    `--lh-mobile-call-small-text-color: ${resolvedMobileCallSmallTextColor}`,
  resolvedMobileRequestTextColor &&
    `--lh-mobile-request-text-color: ${resolvedMobileRequestTextColor}`,
  resolvedMobileRequestSmallTextColor &&
    `--lh-mobile-request-small-text-color: ${resolvedMobileRequestSmallTextColor}`,
  resolvedAddressLinkColor && `--lh-address-link-color: ${resolvedAddressLinkColor}`,
  resolvedAddressLinkHoverColor &&
    `--lh-address-link-hover-color: ${resolvedAddressLinkHoverColor}`,
  resolvedPhoneLinkColor && `--lh-phone-link-color: ${resolvedPhoneLinkColor}`,
  resolvedPhoneLinkHoverColor && `--lh-phone-link-hover-color: ${resolvedPhoneLinkHoverColor}`,
]
  .filter(Boolean)
  .join("; ");
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["landing-header", className]}
  style={cssVars || undefined}
  {...htmlAttributes}
>
  <div class="landing-header-inner">
    <a class="landing-header-logo-link" href="/">
      <Image source={logoSource} class="landing-header-logo" alt={logoAlt} editable={false} />
    </a>

    <div class="landing-header-contact">
      {
        normalizedOffices.map((office: any) => (
          <div class="landing-header-office">
            {Array.isArray(office?.phones) &&
              office.phones.map((phone: any) =>
                phone?.display ? (
                  <a href={phone?.href || "#"} class="landing-header-phone">
                    {phone?.label ? `${phone.label}: ` : ""}
                    {phone.display}
                  </a>
                ) : null
              )}

            {Array.isArray(office?.addresses) &&
              office.addresses.map((address: any) => {
                const formattedLines = formatAddressLines(address);

                return formattedLines.length > 0 ? (
                  <a
                    href={address?.mapUrl || "#"}
                    class="landing-header-address"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {formattedLines.map((line: string, index: number) => (
                      <>
                        {line}
                        {index < formattedLines.length - 1 && <br />}
                      </>
                    ))}
                  </a>
                ) : null;
              })}
          </div>
        ))
      }
    </div>

    {
      normalizedPageButtons.length > 0 && (
        <div class="landing-header-buttons">
          <ButtonGroup
            direction="row"
            align="center"
            class="landing-header-button-group"
            buttonSections={normalizedPageButtons}
            editable={false}
          />
        </div>
      )
    }
  </div>

  <div class="mobile-btns landing-header-mobile-bar">
    {
      mobilePhone?.display && (
        <a href={mobilePhone.href || "#"} class="mobile-call landing-header-mobile-call">
          <span class="mobile-small">{mobileCallSmallText}</span>
          {mobilePhone.display}
        </a>
      )
    }
    {
      resolvedMobileRequestLabel && (
        <a href={mobileRequestLink || "#"} class="mobile-ra landing-header-mobile-request">
          <span class="mobile-small">{mobileRequestFirstLine || resolvedMobileRequestLabel}</span>
          {mobileRequestSecondLine || resolvedMobileRequestLabel}
        </a>
      )
    }
  </div>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-header {
      .landing-header-inner {
        align-items: center;
        display: grid;
        gap: var(--spacing-md);
        grid-template-columns: 1fr;
        padding-block: var(--spacing-sm);

        @media (min-width: 1024px) {
          grid-template-columns: auto 1fr auto;
        }
      }

      .landing-header-logo-link {
        display: inline-flex;
      }

      .landing-header-logo {
        margin: 0 !important;
      }

      .landing-header-contact {
        text-align: left;
      }

      .landing-header-phone,
      .landing-header-address {
        display: block;
        text-decoration: none;
      }

      .landing-header-phone {
        color: var(--lh-phone-link-color, var(--color-text));

        &:hover,
        &:focus-visible {
          color: var(--lh-phone-link-hover-color, var(--color-link-hover));
        }
      }

      .landing-header-address {
        color: var(--lh-address-link-color, var(--color-text));

        &:hover,
        &:focus-visible {
          color: var(--lh-address-link-hover-color, var(--color-link-hover));
        }
      }

      .landing-header-phone {
        font-weight: var(--font-weight-semibold);
      }

      .landing-header-address {
        margin-top: var(--spacing-2xs);
      }

      .landing-header-buttons {
        justify-self: end;

        @media (max-width: 1023px) {
          display: none;
        }
      }

      .landing-header-button-group {
        justify-content: flex-end;
      }

      .landing-header-mobile-bar {
        display: flex;
        width: 100%;

        @media (min-width: 1024px) {
          display: none;
        }

        > a {
          align-items: center;
          display: flex;
          flex: 1 1 50%;
          flex-direction: column;
          font-size: 16px;
          font-weight: 700;
          justify-content: center;
          letter-spacing: 2.4px;
          line-height: 1.1;
          min-height: 3rem;
          padding: 12px 5px;
          text-align: center;
          text-decoration: none;
          text-transform: uppercase;
        }

        .mobile-small {
          display: block;
          font-size: 14px;
          letter-spacing: 0.7px;
          line-height: 1.1;
        }

        .landing-header-mobile-call {
          background-color: var(--lh-mobile-call-bg, var(--color-brand-secondary));
          color: var(--lh-mobile-call-text-color, #fff);

          .mobile-small {
            color: var(--lh-mobile-call-small-text-color, #fff);
          }
        }

        .landing-header-mobile-request {
          background-color: var(--lh-mobile-request-bg, var(--color-brand));
          color: var(--lh-mobile-request-text-color, #fff);
          text-transform: uppercase;

          .mobile-small {
            color: var(--lh-mobile-request-small-text-color, #fff);
          }
        }
      }

      @media (max-width: 1023px) {
        .content {
          padding-inline: 0;
        }

        .landing-header-logo-link {
          justify-self: center;
        }

        .landing-header-contact,
        .landing-header-buttons {
          display: none;
        }

        .landing-header-inner {
          justify-items: center;
        }
      }
    }
  }
</style>
