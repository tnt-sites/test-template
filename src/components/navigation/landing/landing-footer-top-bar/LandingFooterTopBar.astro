---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import { backgroundImageCss } from "@core-elements/image/backgroundImageCss";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "Logo",
  siteName = "",
  contactTitle = "Contact Us",
  offices = [],
  mapEmbedUrl = "",
  legalLinks = [],
  legalBlurb = "",
  backgroundImage = { source: "", alt: "" },
  backgroundColor = "",
  backgroundColorHex = "",
  accentColor = "",
  officeHoursAlignment = "right",
  linkColor = "",
  linkHoverColor = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  class: className,
  ...htmlAttributes
} = Astro.props;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);
const displaySiteName = siteName || (siteInfoData as any).siteName || "";
const copyYear = new Date().getFullYear();

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const getHoursSource = (source: any) => {
  if (!source || typeof source !== "object") {
    return [];
  }

  return (
    source?.officeHours ?? source?.["office-hours"] ?? source?.office_hours ?? source?.hours ?? []
  );
};

const formatOfficeHours = (source: any) => {
  const rawHours = getHoursSource(source);
  const rawEntries = Array.isArray(rawHours)
    ? rawHours
    : rawHours && typeof rawHours === "object"
      ? Object.entries(rawHours).map(([day, value]: [string, any]) => {
          if (typeof value === "string") {
            return { day, hours: value, note: "" };
          }

          if (value && typeof value === "object") {
            return {
              day,
              hours:
                typeof value?.hours === "string"
                  ? value.hours
                  : typeof value?.time === "string"
                    ? value.time
                    : typeof value?.display === "string"
                      ? value.display
                      : "",
              note:
                typeof value?.note === "string"
                  ? value.note
                  : typeof value?.hoursNote === "string"
                    ? value.hoursNote
                    : "",
            };
          }

          return null;
        })
      : [];

  return rawEntries
    .map((entry: any) => {
      if (typeof entry === "string") {
        const line = entry.trim();

        return line.length > 0 ? { day: "", hours: line, note: "" } : null;
      }

      if (!entry || typeof entry !== "object") {
        return null;
      }

      const day =
        typeof entry?.day === "string"
          ? entry.day.trim()
          : typeof entry?.label === "string"
            ? entry.label.trim()
            : "";

      const hours =
        typeof entry?.hours === "string"
          ? entry.hours.trim()
          : typeof entry?.time === "string"
            ? entry.time.trim()
            : typeof entry?.display === "string"
              ? entry.display.trim()
              : "";

      const note =
        typeof entry?.note === "string"
          ? entry.note.trim()
          : typeof entry?.hoursNote === "string"
            ? entry.hoursNote.trim()
            : typeof entry?.["hours-note"] === "string"
              ? entry["hours-note"].trim()
              : "";

      if (!day && !hours && !note) {
        return null;
      }

      return { day, hours, note };
    })
    .filter(Boolean);
};

const firstOffice = resolvedOffices[0] ?? {};
const firstAddress = firstOffice?.addresses?.[0] ?? null;
const firstPhone = firstOffice?.phones?.[0] ?? null;
const officeHours = formatOfficeHours(firstOffice);

const embedSrc =
  (typeof mapEmbedUrl === "string" && mapEmbedUrl.trim()) ||
  (typeof firstOffice?.mapEmbedUrl === "string" && firstOffice.mapEmbedUrl.trim()) ||
  "";

const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};

const resolvedOfficeHoursAlignment = officeHoursAlignment === "left" ? "left" : "right";
const bgImage = await backgroundImageCss(backgroundImage);
const bgStyle = [
  bgImage.style,
  (backgroundColorHex || getColorValue(backgroundColor)) ? `--lftb-bg-color: ${backgroundColorHex || getColorValue(backgroundColor)}` : "",
  accentColor ? `--lftb-accent-color: ${accentColor}` : "",
  getColorValue(linkColor) ? `--footer-link-color: ${getColorValue(linkColor)}` : "",
  getColorValue(linkHoverColor)
    ? `--footer-link-hover-color: ${getColorValue(linkHoverColor)}`
    : "",
  getColorValue(addressLinkColor)
    ? `--footer-address-link-color: ${getColorValue(addressLinkColor)}`
    : "",
  getColorValue(addressLinkHoverColor)
    ? `--footer-address-link-hover-color: ${getColorValue(addressLinkHoverColor)}`
    : "",
  getColorValue(phoneLinkColor)
    ? `--footer-phone-link-color: ${getColorValue(phoneLinkColor)}`
    : "",
  getColorValue(phoneLinkHoverColor)
    ? `--footer-phone-link-hover-color: ${getColorValue(phoneLinkHoverColor)}`
    : "",
]
  .filter(Boolean)
  .join("; ");
const blurb = typeof legalBlurb === "string" ? legalBlurb.trim() : "";
---

<footer
  class:list={["landing-footer-top-bar", "bg-layers", className]}
  style={bgStyle || undefined}
  {...htmlAttributes}
>
  <CustomSection maxContentWidth="2xl" paddingHorizontal="md" paddingVertical="none">
    <div class="footer-main">
      <div class="fo-logo">
        {
          logoSource && (
            <Image source={logoSource} alt={logoAlt} editable={false} class="footer-logo" />
          )
        }
      </div>

      <div class="fo-contact">
        <span class="fo-title">{contactTitle}</span>

        {
          firstAddress && (
            <a
              href={firstAddress?.mapUrl || "#"}
              target="_blank"
              rel="noopener noreferrer"
              class="fo-address"
            >
              {formatAddressLines(firstAddress).map((line: string, i: number) => (
                <>
                  {line}
                  {i < formatAddressLines(firstAddress).length - 1 && <br />}
                </>
              ))}
            </a>
          )
        }

        {
          firstPhone?.display && (
            <a href={firstPhone?.href || "#"} class="fo-phone">
              {firstPhone.display}
            </a>
          )
        }

        {
          officeHours.length > 0 && (
            <>
              <span class="fo-title">Office Hours</span>
              <div
                class:list={[
                  "office-hours",
                  "office-hours--left",
                  "lftb-office-hours",
                  `office-hours--time-${resolvedOfficeHoursAlignment}`,
                ]}
              >
                <div class="office-hours-list">
                  {officeHours.map((item: any) => (
                    <div class="office-hours-row">
                      <div class="office-hours-line">
                        {item.day && <span class="office-hours-day">{item.day}</span>}
                        <span class="office-hours-time">{item.hours}</span>
                      </div>
                      {item.note && <small class="office-hours-note">{item.note}</small>}
                    </div>
                  ))}
                </div>
              </div>
            </>
          )
        }
      </div>

      {
        embedSrc && (
          <div class="fo-map">
            <iframe
              src={embedSrc}
              width="100%"
              height="415"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Office location map"
            />
          </div>
        )
      }
    </div>

    <div class="copy">
      <span class="footer-legal-line footer-legal-line--primary">
        Copyright &copy; {copyYear}
        {displaySiteName}
      </span>
      {
        legalLinks.length > 0 && (
          <span class="footer-legal-separator" aria-hidden="true">
            |
          </span>
        )
      }
      {
        legalLinks.length > 0 && (
          <span class="footer-legal-line footer-legal-line--links">
            {legalLinks.map((item: any, index: number) => (
              <>
                <a href={item?.path || "#"}>{item?.name || "Link"}</a>
                {index < legalLinks.length - 1 && (
                  <span class="footer-legal-link-separator">|</span>
                )}
              </>
            ))}
          </span>
        )
      }
      <span class="footer-legal-separator" aria-hidden="true">|</span>
      <span class="footer-legal-line footer-legal-line--credit">
        Site designed and maintained by{" "}
        <a href="https://www.tntdental.com" target="_blank" rel="noopener noreferrer">TNT Dental</a>
      </span>
      {blurb && <p class="copy-blurb">{blurb}</p>}
    </div>
  </CustomSection>
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-footer-top-bar {
      background-color: var(--lftb-bg-color, #000);
      overflow: hidden;
      padding-top: 60px;
      position: relative;

      .content {
        position: relative;
        z-index: 1;
      }

      .footer-main {
        align-items: center;
        border-top: 1px solid #e7e7e7;
        display: flex;
        flex-wrap: nowrap;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 1260px;
        padding: 50px 10px 10px;

        @media (max-width: 1000px) {
          flex-wrap: wrap;
          justify-content: center;
        }
      }

      .fo-logo {
        flex: 0 1 360px;
      }

      .footer-logo {
        margin: 0 auto !important;
      }

      .fo-contact {
        color: #fff;
        flex: 0 1 325px;
        text-align: left;
      }

      .fo-title {
        color: #fff;
        display: block;
        font-weight: 600;
        letter-spacing: 0.1em;
        margin: 10px 0;
        text-transform: uppercase;
      }

      .fo-address {
        color: var(--footer-address-link-color, var(--color-brand));
        display: block;
        text-decoration: none;
        transition: 0.3s all;
      }

      .fo-address:hover {
        color: var(--footer-address-link-hover-color, var(--color-brand-secondary));
      }

      .fo-phone {
        color: var(--footer-phone-link-color, var(--color-brand));
        display: block;
        font-size: 33px;
        font-weight: 700;
        letter-spacing: 1.65px;
        transition: 0.3s all;
        text-decoration: none;
      }

      .fo-phone:hover {
        color: var(--footer-phone-link-hover-color, var(--color-brand-secondary));
      }

      .lftb-office-hours {
        --office-hours-color: #fff;
        --office-hours-day-color: #fff;
        --office-hours-note-color: rgba(255, 255, 255, 0.8);
        margin-top: 0.25rem;
      }

      .fo-map {
        border-radius: 10px;
        flex: 0 1 500px;
        height: 415px;
        width: 100%;

        iframe {
          border-radius: 10px;
          width: 100%;
        }

        @media (max-width: 790px) {
          display: none;
        }
      }

      .copy {
        color: #fff;
        font-size: var(--font-size-sm);
        letter-spacing: 0.1em;
        line-height: 1.5;
        margin: 20px auto 0;
        padding: 30px 10px;
        text-align: center;
        text-transform: uppercase;

        .footer-legal-line {
          display: inline;
        }

        .footer-legal-separator,
        .footer-legal-link-separator {
          display: inline;
          margin: 0 0.5rem;
        }
      }

      .copy a {
        color: var(--footer-link-color, var(--lftb-accent-color, #4f95d0));
        text-decoration: none;

        &:hover,
        &:focus-visible {
          color: var(--footer-link-hover-color, #fff);
        }
      }

      .copy-blurb {
        color: #fff;
        font-size: var(--font-size-xs);
        letter-spacing: 0;
        line-height: var(--line-height-relaxed);
        margin: 20px auto 0;
        max-width: 1150px;
        text-transform: none;
      }

      @media (max-width: 1024px) {
        .copy {
          .footer-legal-line {
            display: block;
          }

          .footer-legal-line + .footer-legal-line {
            margin-top: 0.25rem;
          }

          .footer-legal-separator {
            display: none;
          }
        }
      }
    }
  }
</style>
