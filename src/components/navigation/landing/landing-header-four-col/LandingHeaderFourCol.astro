---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  logoSource,
  logoAlt = "Logo",
  offices = [],
  pageButtons = [],
  mobileCallLabel = "Call Now",
  mobileRequestLabel = "Request an Appointment",
  mobileRequestHref = "",
  mobileCallBackgroundColor = "",
  mobileRequestBackgroundColor = "",
  mobileCallTextColor = "",
  mobileCallSmallTextColor = "",
  mobileRequestTextColor = "",
  mobileRequestSmallTextColor = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  class: className,
  ...htmlAttributes
} = Astro.props;

const normalizedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const office = normalizedOffices[0] || {};
const phone = office?.phones?.[0] || null;
const address = office?.addresses?.[0] || null;
const firstButton = Array.isArray(pageButtons) ? pageButtons[0] : null;
const resolvedMobileRequestLabel =
  (typeof mobileRequestLabel === "string" ? mobileRequestLabel.trim() : "") ||
  (typeof firstButton?.text === "string" ? firstButton.text.trim() : "");
const resolvedMobileRequestHref = mobileRequestHref || firstButton?.link || "#";
const mobileRequestLabelParts = resolvedMobileRequestLabel.split(/\s+/).filter(Boolean);
const mobileRequestFirstLine = mobileRequestLabelParts.slice(0, 2).join(" ");
const mobileRequestSecondLine = mobileRequestLabelParts.slice(2).join(" ");

const formatAddressLines = (addressObject: any) => {
  const lineItems = Array.isArray(addressObject?.lines) ? addressObject.lines : [];
  const stateAndPostal = [addressObject?.state, addressObject?.postalCode]
    .filter(Boolean)
    .join(" ");
  const cityStatePostal = [addressObject?.city, stateAndPostal].filter(Boolean).join(", ");

  return [...lineItems, cityStatePostal].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const addressLines = formatAddressLines(address);
const getColorValue = (value: any) => {
  const raw = typeof value === "string" ? value : (value?.id ?? value?.value ?? value?.name);

  if (typeof raw !== "string") return "";

  const normalized = raw.trim();

  return normalized && normalized !== "none" ? normalized : "";
};
const cssVars = [
  getColorValue(addressLinkColor)
    ? `--lh4-address-link-color: ${getColorValue(addressLinkColor)}`
    : "",
  getColorValue(addressLinkHoverColor)
    ? `--lh4-address-link-hover-color: ${getColorValue(addressLinkHoverColor)}`
    : "",
  getColorValue(phoneLinkColor) ? `--lh4-phone-link-color: ${getColorValue(phoneLinkColor)}` : "",
  getColorValue(phoneLinkHoverColor)
    ? `--lh4-phone-link-hover-color: ${getColorValue(phoneLinkHoverColor)}`
    : "",
  getColorValue(mobileCallBackgroundColor)
    ? `--lh4-mobile-call-bg: ${getColorValue(mobileCallBackgroundColor)}`
    : "",
  getColorValue(mobileRequestBackgroundColor)
    ? `--lh4-mobile-request-bg: ${getColorValue(mobileRequestBackgroundColor)}`
    : "",
  getColorValue(mobileCallTextColor)
    ? `--lh4-mobile-call-text-color: ${getColorValue(mobileCallTextColor)}`
    : "",
  getColorValue(mobileCallSmallTextColor)
    ? `--lh4-mobile-call-small-text-color: ${getColorValue(mobileCallSmallTextColor)}`
    : "",
  getColorValue(mobileRequestTextColor)
    ? `--lh4-mobile-request-text-color: ${getColorValue(mobileRequestTextColor)}`
    : "",
  getColorValue(mobileRequestSmallTextColor)
    ? `--lh4-mobile-request-small-text-color: ${getColorValue(mobileRequestSmallTextColor)}`
    : "",
]
  .filter(Boolean)
  .join("; ");
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  class:list={["landing-header-four-col", className]}
  style={cssVars || undefined}
  {...htmlAttributes}
>
  <div class="inner">
    <a href="/" class="logo-link">
      <Image source={logoSource} alt={logoAlt} class="logo" editable={false} />
    </a>

    {
      addressLines.length > 0 && (
        <a href={address?.mapUrl || "#"} class="address" target="_blank" rel="noopener noreferrer">
          {addressLines.map((line: string, index: number) => (
            <>
              {line}
              {index < addressLines.length - 1 && <br />}
            </>
          ))}
        </a>
      )
    }

    {
      phone?.display && (
        <a href={phone?.href || "#"} class="phone">
          {phone.display}
        </a>
      )
    }

    <div class="desktop-cta">
      {
        Array.isArray(pageButtons) && pageButtons.length > 0 && (
          <ButtonGroup
            buttonSections={pageButtons}
            direction="row"
            align="center"
            editable={false}
          />
        )
      }
    </div>
  </div>

  <div class="mobile-buttons mobile-btns">
    {
      phone?.display && (
        <a href={phone?.href || "#"} class="mobile-call">
          <span class="mobile-small">{mobileCallLabel}</span>
          {phone.display}
        </a>
      )
    }
    {
      resolvedMobileRequestLabel && (
        <a href={resolvedMobileRequestHref} class="mobile-request mobile-ra">
          <span class="mobile-small">{mobileRequestFirstLine || resolvedMobileRequestLabel}</span>
          {mobileRequestSecondLine || resolvedMobileRequestLabel}
        </a>
      )
    }
  </div>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-header-four-col {
      background: #fff;

      .content {
        max-width: 1320px;
      }

      .inner {
        align-items: center;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 25px 10px;

      }

      .logo-link,
      .address,
      .phone {
        text-decoration: none;
      }

      .logo {
        margin: 0 !important;
      }

      .address {
        color: var(--lh4-address-link-color, #000);
        font-size: 19px;
        letter-spacing: 2.9px;
        line-height: 1.25;
        text-align: center;
        text-transform: uppercase;
      }

      .address:hover {
        color: var(--lh4-address-link-hover-color, #4f95d0);
      }

      .phone {
        color: var(--lh4-phone-link-color, #4f95d0);
        font-size: 38px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 1.1;
      }

      .phone:hover {
        color: var(--lh4-phone-link-hover-color, #000);
      }

      .desktop-cta {
        flex: 0 1 200px;
        @media (max-width: 1000px) {
          display: none;
        }
      }

      .desktop-cta :global(.button-group) {
        justify-content: flex-end;
      }

      .desktop-cta :global(.button-group .button) {
        border-radius: 10px;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.15em;
        padding: 15px 25px 12px;
        text-transform: uppercase;
      }

      .mobile-buttons {
        display: none;

        @media (max-width: 1000px) {
          display: flex;
          width: 100%;
        }
      }

      .mobile-buttons a {
        align-items: center;
        display: flex;
        flex: 1 1 50%;
        flex-direction: column;
        font-size: 16px;
        font-weight: 700;
        justify-content: center;
        letter-spacing: 2.4px;
        line-height: 1.1;
        min-height: 3rem;
        padding: 12px 5px;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
      }

      .mobile-small {
        display: block;
        font-size: 14px;
        letter-spacing: 0.7px;
        line-height: 1.1;
      }

      .mobile-call {
        background: var(--lh4-mobile-call-bg, #476682);
        color: var(--lh4-mobile-call-text-color, #fff);

        .mobile-small {
          color: var(--lh4-mobile-call-small-text-color, #fff);
        }
      }

      .mobile-request {
        background: var(--lh4-mobile-request-bg, #4f95d0);
        color: var(--lh4-mobile-request-text-color, #fff);

        .mobile-small {
          color: var(--lh4-mobile-request-small-text-color, #fff);
        }
      }

      @media (max-width: 1000px) {
        .content {
          padding-inline: 0;
        }

        .inner {
          justify-items: center;
          padding: 10px;
        }

        .logo-link {
          justify-self: center;
        }

        .address,
        .phone {
          display: none;
        }

        .desktop-cta {
          display: none;
        }
      }
    }
  }
</style>
