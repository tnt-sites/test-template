---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";

const {
  logoSource,
  logoAlt = "Logo",
  pageButtons = [],
  offices = [],
  mobileCallLabel = "Call Now",
  mobileCallSmallText = "",
  mobileRequestLabel = "",
  mobileRequestHref = "",
  mobileCallBackgroundColor = "",
  mobileCallBackgroundColorHex = "",
  mobileRequestBackgroundColor = "",
  mobileRequestBackgroundColorHex = "",
  mobileCallTextColor = "",
  mobileCallSmallTextColor = "",
  mobileRequestTextColor = "",
  mobileRequestSmallTextColor = "",
  addressLinkColor = "",
  addressLinkHoverColor = "",
  phoneLinkColor = "",
  phoneLinkHoverColor = "",
  id: elementId,
  class: className,
  ...htmlAttributes
} = Astro.props as {
  logoSource?: string;
  logoAlt?: string;
  pageButtons?: any[];
  offices?: any[];
  mobileCallLabel?: string;
  mobileCallSmallText?: string;
  mobileRequestLabel?: string;
  mobileRequestHref?: string;
  mobileCallBackgroundColor?: string;
  mobileCallBackgroundColorHex?: string;
  mobileRequestBackgroundColor?: string;
  mobileRequestBackgroundColorHex?: string;
  mobileCallTextColor?: string;
  mobileCallSmallTextColor?: string;
  mobileRequestTextColor?: string;
  mobileRequestSmallTextColor?: string;
  addressLinkColor?: string;
  addressLinkHoverColor?: string;
  phoneLinkColor?: string;
  phoneLinkHoverColor?: string;
  id?: string;
  class?: string;
  [key: string]: any;
};

const formatAddressLines = (address: any) => {
  const lineItems = Array.isArray(address?.lines) ? address.lines : [];
  const stateAndPostal = [address?.state, address?.postalCode].filter(Boolean).join(" ");
  const cityStatePostal = [address?.city, stateAndPostal].filter(Boolean).join(", ");
  const locationLine = [cityStatePostal, address?.country].filter(Boolean).join(", ");

  return [...lineItems, locationLine].filter(
    (line) => typeof line === "string" && line.trim().length > 0
  );
};

const buttons = (Array.isArray(pageButtons) ? pageButtons : []).map((button: any) => ({
  ...button,
  text: typeof button?.text === "string" ? button.text : "",
}));

const colorTokenMap: Record<string, string> = {
  brand: "var(--color-brand)",
  "brand-secondary": "var(--color-brand-secondary)",
  "brand-tertiary": "var(--color-brand-muted)",
  dark: "var(--color-text)",
  white: "var(--color-text-inverse)",
};

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);

const leftOffice = resolvedOffices[0] ?? null;
const rightOffice = resolvedOffices[1] ?? null;

// Mobile call: use first phone from either office
const mobilePhone = leftOffice?.phones?.[0] ?? rightOffice?.phones?.[0] ?? null;

// Mobile CTA: use first page button
const mobileButton = buttons[0] ?? null;
const resolvedMobileCallText = mobileCallSmallText || mobileCallLabel || "Call Now";
const resolvedMobileRequestLabel = mobileRequestLabel || mobileButton?.text || "";
const resolvedMobileRequestHref = mobileRequestHref || mobileButton?.link || "#";
const mobileButtonLabelParts =
  typeof resolvedMobileRequestLabel === "string"
    ? resolvedMobileRequestLabel.trim().split(/\s+/)
    : [];
const mobileButtonFirstLine = mobileButtonLabelParts.slice(0, 2).join(" ");
const mobileButtonSecondLine = mobileButtonLabelParts.slice(2).join(" ");

const resolvedMobileCallBg =
  mobileCallBackgroundColorHex || colorTokenMap[mobileCallBackgroundColor] || "";
const resolvedMobileRequestBg =
  mobileRequestBackgroundColorHex || colorTokenMap[mobileRequestBackgroundColor] || "";
const resolvedMobileCallTextColor = colorTokenMap[mobileCallTextColor] || "";
const resolvedMobileCallSmallTextColor = colorTokenMap[mobileCallSmallTextColor] || "";
const resolvedMobileRequestTextColor = colorTokenMap[mobileRequestTextColor] || "";
const resolvedMobileRequestSmallTextColor = colorTokenMap[mobileRequestSmallTextColor] || "";
const resolvedAddressLinkColor = colorTokenMap[addressLinkColor] || "";
const resolvedAddressLinkHoverColor = colorTokenMap[addressLinkHoverColor] || "";
const resolvedPhoneLinkColor = colorTokenMap[phoneLinkColor] || "";
const resolvedPhoneLinkHoverColor = colorTokenMap[phoneLinkHoverColor] || "";

const cssVars = [
  resolvedMobileCallBg && `--lhtl-mobile-call-bg: ${resolvedMobileCallBg}`,
  resolvedMobileRequestBg && `--lhtl-mobile-request-bg: ${resolvedMobileRequestBg}`,
  resolvedMobileCallTextColor && `--lhtl-mobile-call-text-color: ${resolvedMobileCallTextColor}`,
  resolvedMobileCallSmallTextColor &&
    `--lhtl-mobile-call-small-text-color: ${resolvedMobileCallSmallTextColor}`,
  resolvedMobileRequestTextColor &&
    `--lhtl-mobile-request-text-color: ${resolvedMobileRequestTextColor}`,
  resolvedMobileRequestSmallTextColor &&
    `--lhtl-mobile-request-small-text-color: ${resolvedMobileRequestSmallTextColor}`,
  resolvedAddressLinkColor && `--lhtl-address-link-color: ${resolvedAddressLinkColor}`,
  resolvedAddressLinkHoverColor &&
    `--lhtl-address-link-hover-color: ${resolvedAddressLinkHoverColor}`,
  resolvedPhoneLinkColor && `--lhtl-phone-link-color: ${resolvedPhoneLinkColor}`,
  resolvedPhoneLinkHoverColor && `--lhtl-phone-link-hover-color: ${resolvedPhoneLinkHoverColor}`,
]
  .filter(Boolean)
  .join("; ");

const renderOffice = (office: any) => {
  if (!office) return null;
  const phones: any[] = Array.isArray(office.phones) ? office.phones : [];
  const addresses: any[] = Array.isArray(office.addresses) ? office.addresses : [];

  return { phones, addresses };
};

const left = renderOffice(leftOffice);
const right = renderOffice(rightOffice);
---

<CustomSection
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="none"
  id={elementId || undefined}
  class:list={["landing-header-two-locations", className]}
  style={cssVars || undefined}
  {...htmlAttributes}
>
  <div class="lhtl-inner">
    {/* Left office — desktop only */}
    {
      left && (
        <div class="lhtl-office lhtl-office-left">
          {left.phones.map((phone: any) =>
            phone?.display ? (
              <a href={phone?.href || "#"} class="lhtl-phone">
                {phone?.label ? `${phone.label}: ` : ""}
                {phone.display}
              </a>
            ) : null
          )}
          {left.addresses.map((address: any) => {
            const lines = formatAddressLines(address);

            return lines.length > 0 ? (
              <a
                href={address?.mapUrl || "#"}
                class="lhtl-address"
                target="_blank"
                rel="noopener noreferrer"
              >
                {lines.map((line: string, i: number) => (
                  <>
                    {line}
                    {i < lines.length - 1 && <br />}
                  </>
                ))}
              </a>
            ) : null;
          })}
        </div>
      )
    }

    {/* Logo — always centered */}
    <a class="lhtl-logo-link" href="/">
      <Image source={logoSource} class="lhtl-logo" alt={logoAlt} editable={false} />
    </a>

    {/* Right office — desktop only */}
    {
      right && (
        <div class="lhtl-office lhtl-office-right">
          {right.phones.map((phone: any) =>
            phone?.display ? (
              <a href={phone?.href || "#"} class="lhtl-phone">
                {phone?.label ? `${phone.label}: ` : ""}
                {phone.display}
              </a>
            ) : null
          )}
          {right.addresses.map((address: any) => {
            const lines = formatAddressLines(address);

            return lines.length > 0 ? (
              <a
                href={address?.mapUrl || "#"}
                class="lhtl-address"
                target="_blank"
                rel="noopener noreferrer"
              >
                {lines.map((line: string, i: number) => (
                  <>
                    {line}
                    {i < lines.length - 1 && <br />}
                  </>
                ))}
              </a>
            ) : null;
          })}
        </div>
      )
    }

    {/* Mobile buttons — visible only on small screens */}
    <div class="lhtl-mobile-btns mobile-btns">
      {
        mobilePhone && (
          <a href={mobilePhone.href || "#"} class="lhtl-mobile-call mobile-call">
            <span class="mobile-small">{resolvedMobileCallText}</span>
            {mobilePhone.display}
          </a>
        )
      }
      {
        resolvedMobileRequestLabel && (
          <a href={resolvedMobileRequestHref} class="lhtl-mobile-cta mobile-ra">
            <span class="mobile-small">{mobileButtonFirstLine || resolvedMobileRequestLabel}</span>
            {mobileButtonSecondLine || resolvedMobileRequestLabel}
          </a>
        )
      }
    </div>
  </div>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-header-two-locations {
      box-shadow: 0 3px 7px rgba(0, 0, 0, 0.2);

      .lhtl-inner {
        align-items: center;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-areas:
          "logo"
          "mobile-btns";
        padding-block: var(--spacing-sm);

        @media (min-width: 1024px) {
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
          grid-template-areas: "left logo right";
          gap: var(--spacing-md);
        }
      }

      .lhtl-logo-link {
        display: inline-flex;
        justify-self: center;
        grid-area: logo;
      }

      .lhtl-logo {
        margin: 0 !important;
      }

      .lhtl-office {
        display: none;

        @media (min-width: 1024px) {
          display: block;
        }
      }

      .lhtl-office-left {
        grid-area: left;
        text-align: left;
        justify-self: start;
      }

      .lhtl-office-right {
        grid-area: right;
        text-align: right;
        justify-self: end;
      }

      .lhtl-phone {
        color: var(--lhtl-phone-link-color, var(--color-brand));
        display: block;
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        text-decoration: none;

        &:hover,
        &:focus-visible {
          color: var(--lhtl-phone-link-hover-color, var(--color-link-hover));
        }
      }

      .lhtl-address {
        color: var(--lhtl-address-link-color, var(--color-text));
        display: block;
        font-size: var(--font-size-sm);
        margin-top: var(--spacing-2xs);
        text-decoration: none;

        &:hover,
        &:focus-visible {
          color: var(--lhtl-address-link-hover-color, var(--color-brand));
        }
      }

      .lhtl-mobile-btns {
        display: flex;
        grid-area: mobile-btns;
        width: 100%;

        @media (min-width: 1024px) {
          display: none;
        }
      }

      .lhtl-mobile-call,
      .lhtl-mobile-cta {
        align-items: center;
        display: flex;
        flex: 1 1 50%;
        flex-direction: column;
        font-size: 16px;
        font-weight: 700;
        justify-content: center;
        letter-spacing: 2.4px;
        line-height: 1.1;
        min-height: 3rem;
        padding: 12px 5px;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
      }

      .mobile-small {
        display: block;
        font-size: 14px;
        letter-spacing: 0.7px;
        line-height: 1.1;
      }

      .lhtl-mobile-call {
        background-color: var(--lhtl-mobile-call-bg, var(--color-brand-secondary));
        color: var(--lhtl-mobile-call-text-color, var(--color-text-on-brand));

        .mobile-small {
          color: var(--lhtl-mobile-call-small-text-color, currentColor);
        }

        &:hover,
        &:focus-visible {
          filter: brightness(0.9);
        }
      }

      .lhtl-mobile-cta {
        background-color: var(--lhtl-mobile-request-bg, var(--color-brand));
        color: var(--lhtl-mobile-request-text-color, var(--color-text-on-brand));
        text-transform: uppercase;

        .mobile-small {
          color: var(--lhtl-mobile-request-small-text-color, currentColor);
        }

        &:hover,
        &:focus-visible {
          filter: brightness(0.9);
        }
      }

      @media (max-width: 1023px) {
        .content {
          padding-inline: 0;
        }

        .lhtl-logo-link {
          justify-self: center;
        }

        .lhtl-office {
          display: none;
        }
      }

    }
  }
</style>
