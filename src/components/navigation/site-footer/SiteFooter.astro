---
import { Icon } from "astro-icon/components";
import Image from "@core-elements/image/Image.astro";
import siteInfoData from "@data/siteInfo.json";

/*
 * The site footer as measured on the source at 1440px: a 386px white band over
 * a 129px grey subfooter.
 *
 * The band splits into two 659px halves — a centred 300x150 logo with the site
 * URL beneath it, and an info column holding About (567px wide, with a 1px rule
 * under it) above a two-up Office / Contact row of 301px columns. Headings are
 * 19.5px/500, body copy 16px/300.
 *
 * The subfooter carries the copyright and legal links at 12px on the left and
 * the social icons at 30px on the right, over #e6e6e6.
 */
const {
  logoSource = "",
  logoAlt = "",
  websiteText = "",
  websiteHref = "",
  aboutTitle = "About",
  aboutText = "",
  officeTitle = "Office",
  contactTitle = "Contact",
  phoneLabel = "Phone:",
  siteName = "",
  offices = [],
  socials = [],
  legalLinks = [],
  copyright = "",
  _component,
  ...htmlAttributes
} = Astro.props;

const clean = (value: unknown, fallback = "") =>
  typeof value === "string" && value.trim().length > 0 ? value.trim() : fallback;

const resolvedOffices =
  Array.isArray(offices) && offices.length > 0 ? offices : ((siteInfoData as any).offices ?? []);
const office = resolvedOffices[0] ?? {};

const resolvedSocials =
  Array.isArray(socials) && socials.length > 0 ? socials : ((siteInfoData as any).socials ?? []);

const displaySiteName = clean(siteName, (siteInfoData as any).siteName ?? "");

const address = (office.addresses ?? [])[0] ?? {};
// The source prints street then "City, ST ZIP" — and no country line.
const addressLines: string[] = [
  ...(Array.isArray(address.lines) ? address.lines : []),
  [clean(address.city), [clean(address.state), clean(address.postalCode)].filter(Boolean).join(" ")]
    .filter(Boolean)
    .join(", "),
].filter((line) => line.length > 0);

const phone = (office.phones ?? [])[0] ?? {};
const copyrightText = clean(copyright);
const legal = Array.isArray(legalLinks) ? legalLinks.filter((l: any) => l && l.name) : [];
---

<footer class="site-footer" {...htmlAttributes}>
  <div class="sf-inner">
    <div class="sf-brand">
      {
        logoSource && (
          <div class="sf-logo">
            <Image source={logoSource} alt={logoAlt || displaySiteName} editable={false} />
          </div>
        )
      }
      {
        websiteText &&
          (websiteHref ? (
            <a class="sf-website" href={websiteHref}>
              {websiteText}
            </a>
          ) : (
            <div class="sf-website">{websiteText}</div>
          ))
      }
    </div>

    <div class="sf-info">
      {
        aboutText && (
          <div class="sf-about">
            <h3 class="sf-heading">{aboutTitle}</h3>
            <p class="sf-text">{aboutText}</p>
          </div>
        )
      }

      <div class="sf-rule" aria-hidden="true"></div>

      <div class="sf-columns">
        {
          addressLines.length > 0 && (
            <div class="sf-column">
              <h3 class="sf-heading">{officeTitle}</h3>
              {displaySiteName && (
                <p class="sf-text sf-office-name">
                  <b>{displaySiteName}</b>
                </p>
              )}
              <address class="sf-text sf-address">
                {address.mapUrl ? (
                  <a href={address.mapUrl} target="_blank" rel="noopener">
                    {addressLines.map((line) => (
                      <span class="sf-address-line">{line}</span>
                    ))}
                  </a>
                ) : (
                  addressLines.map((line) => <span class="sf-address-line">{line}</span>)
                )}
              </address>
            </div>
          )
        }

        {
          phone.display && (
            <div class="sf-column">
              <h3 class="sf-heading">{contactTitle}</h3>
              <p class="sf-text sf-phone">
                <b>{phoneLabel} </b>
                <a href={phone.href || `tel:${phone.display}`}>{phone.display}</a>
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</footer>

<div class="site-subfooter">
  <div class="sf-sub-inner">
    <div class="sf-legal">
      {copyrightText && <div class="sf-copyright">{copyrightText}</div>}
      {
        legal.length > 0 && (
          <ul class="sf-legal-links">
            {legal.map((link: any, i: number) => (
              <>
                {i > 0 && <li aria-hidden="true">/</li>}
                <li>
                  <a href={link.path || "#"}>{link.name}</a>
                </li>
              </>
            ))}
          </ul>
        )
      }
    </div>

    {
      resolvedSocials.length > 0 && (
        <div class="sf-socials">
          {resolvedSocials.map((social: any) => (
            <a
              href={social.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit our ${social.label || social.icon} page`}
            >
              <Icon name={social.icon} />
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>

<style lang="pcss">
  .site-footer {
    background-color: #fff;
    /* source: 72px above, 57.6px below */
    padding: 72px 0 57.6px;
  }

  .sf-inner {
    box-sizing: border-box;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr 1fr; /* two 659px halves at 1440 */
    margin: 0 auto;
    max-width: 1440px;
    padding-inline: 61px;
  }

  .sf-brand {
    padding-inline: 39.5px;
    text-align: center;
  }

  .sf-brand :global(img) {
    display: block;
    height: auto;
    margin: 0 auto;
    max-width: 300px;
    width: 100%;
  }

  .sf-website {
    color: inherit;
    display: block;
    font-size: 0.9375rem; /* 15px */
    font-weight: 300;
    margin-top: 10px;
    text-align: center;
    text-decoration: none;
  }

  .sf-website:hover {
    text-decoration: underline;
  }

  .sf-info {
    padding-inline: 27.5px;
  }

  .sf-about,
  .sf-column {
    padding-inline: 18px;
  }

  .sf-heading {
    font-family: var(--font-headings);
    font-size: 1.21875rem; /* 19.5px */
    font-weight: 500;
    line-height: 1.1;
    margin: 10px 0;
    text-align: left;
    text-transform: none;
  }

  .sf-text {
    font-size: 1rem; /* 16px */
    font-weight: 300;
    line-height: 1.3;
    margin: 0;
  }

  .sf-rule {
    border-top: 1px solid rgb(0 0 0 / 25%);
    margin: 15px 18px;
  }

  /* The source's subfooter is 129px: the copyright sits above the legal links
     rather than beside them. */
  .sf-legal {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sf-columns {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr 1fr;
  }

  .sf-office-name {
    line-height: 1.5;
    margin-bottom: 0.15em;
  }

  .sf-address {
    font-style: normal;
    line-height: 1.5;
  }

  .sf-address-line {
    display: block;
  }

  .sf-address a,
  .sf-phone a {
    color: inherit;
    text-decoration: none;
  }

  .sf-address a:hover,
  .sf-phone a:hover {
    text-decoration: underline;
  }

  .sf-phone {
    line-height: 1.5;
  }

  .site-subfooter {
    background-color: #e6e6e6;
    padding-block: 14.4px;
  }

  .sf-sub-inner {
    min-height: 100px; /* source: 129px band less its 14.4px padding */
  }

  .sf-sub-inner {
    align-items: center;
    box-sizing: border-box;
    display: flex;
    gap: var(--spacing-md);
    justify-content: space-between;
    margin: 0 auto;
    max-width: 1440px;
    padding-inline: 72px;
  }

  .sf-copyright {
    font-size: 0.75rem; /* 12px */
    line-height: 1.5;
  }

  .sf-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sf-legal-links a {
    color: inherit;
    font-size: 0.75rem;
    line-height: 1.5;
    text-decoration: underline;
  }

  .sf-legal-links li {
    font-size: 0.75rem;
  }

  .sf-socials {
    display: flex;
    gap: 0;
  }

  .sf-socials a {
    align-items: center;
    color: inherit;
    display: flex;
    justify-content: center;
    padding: 0 10px;
  }

  .sf-socials :global(svg) {
    height: 30px;
    width: 30px;
  }

  @media (max-width: 992px) {
    .sf-inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
      padding-inline: 32px;
    }

    .sf-brand,
    .sf-info {
      padding-inline: 0;
    }

    .sf-sub-inner {
      flex-direction: column;
      padding-inline: 32px;
      text-align: center;
    }

    .sf-legal {
      text-align: center;
    }

    .sf-legal-links {
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .sf-columns {
      gap: var(--spacing-lg);
      grid-template-columns: 1fr;
    }
  }
</style>
