---
import Icon from "@core-elements/icon/Icon.astro";
import { schedulingLinkAttrs } from "@component-utils/scheduling-links";

const { navData = [], class: className, _component, ...htmlAttributes } = Astro.props;

function isCurrentPage(item) {
  return Boolean(item.path && Astro.url.pathname === item.path);
}

function hasCurrentChild(item) {
  if (isCurrentPage(item)) return true;
  return Boolean(item.children?.some((child) => hasCurrentChild(child)));
}

// Helper function to create navigation item data
function createNavItemData(item, level, parentGroupId) {
  const hasChildren = Boolean(item.children?.length);

  return {
    ...item,
    hasChildren,
    // Spread onto the item's anchor — empty for everything but booking links.
    linkAttrs: schedulingLinkAttrs(item.path),
    level,
    contentId: `dropdown-content-${crypto.randomUUID()}`,
    isCurrent: isCurrentPage(item),
    hasCurrent: hasCurrentChild(item),
    parentGroupId: parentGroupId || crypto.randomUUID(),
  };
}
---

<nav class:list={["bar", className]} {...htmlAttributes}>
  <ul class="bar-list">
    {
      navData.map((item) => {
        const itemData = createNavItemData(item, "top");

        if (!itemData.hasChildren) {
          return (
            <li class="nav-item">
              <a
                href={itemData.path}
                {...itemData.linkAttrs}
                aria-current={itemData.isCurrent ? "page" : undefined}
              >
                {itemData.icon && (
                  <Icon name={itemData.icon} size="none" class="nav-item-lead" aria-hidden="true" />
                )}
                {itemData.name}
              </a>
            </li>
          );
        }

        return (
          <li class="nav-item has-children">
            <a
              href={itemData.path}
              {...itemData.linkAttrs}
              aria-current={itemData.isCurrent ? "page" : undefined}
            >
              {itemData.name}
            </a>
            <button
              type="button"
              class="nav-item-trigger"
              aria-controls={itemData.contentId}
              aria-expanded="false"
            >
              <span class="visually-hidden">{`Toggle ${itemData.name} submenu`}</span>
              <span class="nav-item-icon">
                <Icon name="chevron-right" size="none" aria-hidden="true" />
              </span>
            </button>
            <div
              id={itemData.contentId}
              class="nav-item-content"
              role="region"
              aria-label={`${itemData.name} submenu`}
              aria-hidden="true"
            >
              <ul class="nav-list">
                {itemData.children!.map((child) => {
                  const childData = createNavItemData(child, "child", itemData.parentGroupId);

                  if (!childData.hasChildren) {
                    return (
                      <li class="nav-item">
                        <a
                          href={childData.path}
                          {...childData.linkAttrs}
                          aria-current={childData.isCurrent ? "page" : undefined}
                        >
                          {childData.icon && (
                            <Icon
                              name={childData.icon}
                              size="none"
                              class="nav-item-lead"
                              aria-hidden="true"
                            />
                          )}
                          {childData.name}
                        </a>
                      </li>
                    );
                  }

                  return (
                    <li class="nav-item has-children">
                      <a
                        href={childData.path}
                        {...childData.linkAttrs}
                        aria-current={childData.isCurrent ? "page" : undefined}
                      >
                        {childData.icon && (
                          <Icon
                            name={childData.icon}
                            size="none"
                            class="nav-item-lead"
                            aria-hidden="true"
                          />
                        )}
                        {childData.name}
                      </a>
                      <button
                        type="button"
                        class="nav-item-trigger"
                        aria-controls={childData.contentId}
                        aria-expanded="false"
                      >
                        <span class="visually-hidden">{`Toggle ${childData.name} submenu`}</span>
                        <span class="nav-item-icon">
                          <Icon name="chevron-right" size="none" aria-hidden="true" />
                        </span>
                      </button>
                      <div
                        id={childData.contentId}
                        class="nav-item-nested"
                        role="region"
                        aria-label={`${childData.name} submenu`}
                        aria-hidden="true"
                      >
                        <ul class="nav-list">
                          {childData.children!.map((grandChild) => {
                            const grandChildData = createNavItemData(
                              grandChild,
                              "child",
                              childData.parentGroupId
                            );

                            return (
                              <li class="nav-item">
                                <a
                                  href={grandChildData.path}
                                  {...grandChildData.linkAttrs}
                                  aria-current={grandChildData.isCurrent ? "page" : undefined}
                                >
                                  {grandChildData.icon && (
                                    <Icon
                                      name={grandChildData.icon}
                                      size="none"
                                      class="nav-item-lead"
                                      aria-hidden="true"
                                    />
                                  )}
                                  {grandChildData.name}
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  // Each submenu's open state lives on its trigger button's aria-expanded,
  // which the CSS keys off — the button is both the control and the state.
  function setExpanded(trigger, isExpanded) {
    trigger.setAttribute("aria-expanded", String(isExpanded));
    const content = document.getElementById(trigger.getAttribute("aria-controls") || "");

    content?.setAttribute("aria-hidden", String(!isExpanded));

    // Closing a menu closes whatever was open inside it.
    if (!isExpanded) {
      content?.querySelectorAll('.nav-item-trigger[aria-expanded="true"]').forEach((nested) => {
        setExpanded(nested, false);
      });
    }
  }

  function closeAll(scope) {
    scope.querySelectorAll('.bar .nav-item-trigger[aria-expanded="true"]').forEach((trigger) => {
      setExpanded(trigger, false);
    });
  }

  // Enter and Space click a button natively, so one handler covers keyboard too.
  function handleTriggerClick(e) {
    const trigger = e.currentTarget as HTMLElement;
    const opening = trigger.getAttribute("aria-expanded") !== "true";

    // One submenu open per level: opening this closes its siblings.
    if (opening) {
      const list = trigger.closest(".nav-item")?.parentElement;

      list?.querySelectorAll(":scope > .nav-item > .nav-item-trigger").forEach((sibling) => {
        if (sibling !== trigger) setExpanded(sibling, false);
      });
    }

    setExpanded(trigger, opening);
  }

  function initBarNavigation() {
    // Clicking anywhere outside the bar closes its menus.
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      if (target && !target.closest(".bar")) closeAll(document);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAll(document);
    });

    document.querySelectorAll(".bar .nav-item-trigger").forEach((trigger) => {
      trigger.addEventListener("click", handleTriggerClick);
    });
  }

  initBarNavigation();
</script>

<style lang="pcss" is:global>
  @layer components {
    .bar {
      font-weight: var(--font-weight-semibold);
      .bar-list {
        align-items: center;
        display: flex;
        gap: var(--spacing-sm);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-item {
        position: relative;
        display: flex;;
      }

      .nav-item > a{
        border-radius: var(--radius-xs);
        color: var(--color-text-strong);
        cursor: pointer;
        display: block;
        font-weight: var(--font-weight-medium);
        padding: var(--spacing-sm) var(--spacing-md);
        text-decoration: none;
        transition: background var(--animation-normal) ease-in-out;
        white-space: nowrap;

        &[aria-current="page"] {
          text-decoration: underline dotted;
          text-decoration-color: var(--color-text-muted);
          text-underline-offset: 3px;
        }

        &:hover {
          /* background: var(--color-state-hover); */
          color: var(--color-brand-secondary);
        }
      }



      .nav-item-trigger {
        align-items: center;
        background: none;
        border: 1px solid var(--color-border-subtle);
        padding: 0;
        border-radius: var(--radius-xs);
        color: var(--color-text-muted);
        cursor: pointer;
        display: inline-flex;
        flex-shrink: 0;
        gap: var(--spacing-xs);
        justify-content: center;
        min-height: 1.75rem;
        min-width: 1.75rem;
        transition:
          background-color var(--animation-normal) ease-in-out,
          border-color var(--animation-normal) ease-in-out,
          color var(--animation-normal) ease-in-out;

        .icon svg{
          path {
            stroke: currentColor;
          }
        }

        &:hover,
        &:focus-visible {
          background: var(--color-brand-secondary);
          border-color: var(--color-brand-secondary);
          color: var(--color-text-inverse);
        }
      }

      .nav-item.has-children {
        column-gap: var(--spacing-xs);

        > a {
          padding-right: 2px;
        }
      }

      .nav-item-icon {
        color: var(--color-text-muted);
        display: inline-block;
        transition:
          color var(--animation-normal) ease-in-out,
          transform var(--animation-normal) ease-in-out;
        width: 0.8rem;
        transform-origin: 50% 60%;
      }

      .nav-item-trigger:hover .nav-item-icon,
      .nav-item-trigger:focus-visible .nav-item-icon {
        color: currentColor;
      }

      .nav-item-trigger[aria-expanded="true"] .nav-item-icon {
        transform: rotate(90deg);
      }

      .nav-item-trigger ~ .nav-item-content,
      .nav-item-trigger ~ .nav-item-nested {
        display: none;
      }

      .nav-item-trigger[aria-expanded="true"] ~ .nav-item-content {
        animation: grow-out-centered var(--animation-normal) ease-out forwards;
        display: block;
      }

      .nav-item-trigger[aria-expanded="true"] ~ .nav-item-nested {
        animation: grow-out var(--animation-normal) ease-out forwards;
        display: block;
      }

      .nav-item > .nav-item-content {
        background: var(--color-bg);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-xs);
        left: 50%;
        margin-top: var(--spacing-xs);
        min-width: 200px;
        position: absolute;
        top: 100%;
        transform: translateX(-50%);
        width: max-content;
        z-index: var(--layer-3);
      }

      .nav-item-content .nav-item {
        display: block;
      }

      .nav-item-content .nav-item.has-children {
        align-items: center;
        column-gap: var(--spacing-xs);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .nav-item-content .nav-item.has-children > .nav-item-nested {
        grid-column: 1 / -1;
      }

      .nav-item-content .nav-item > a {
        border-radius: 0;
      }

      .nav-item-content .nav-item > .nav-item-trigger {
        margin-inline-start: var(--spacing-xs);
      }

      .nav-item-nested .nav-item > a {
        border-radius: 0;
        padding-left: var(--spacing-xl);
      }
    }
  }
</style>
