---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

interface Paragraph {
  body: string;
}

const {
  heading = "",
  headingFontFamily = "",
  paragraphs = [] as Paragraph[],
  image = { source: "", alt: "" },
  figcaption = "",
  reverse = false,
  buttonSections = [],
  waveImage = { source: "", alt: "" },
  headingColor = "",
  accentColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--pw-split-heading: ${headingColor}` : "",
  accentColor ? `--pw-split-accent: ${accentColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pw-split", reverse && "alt", className]}
  paddingHorizontal="md"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  {
    waveImage?.source && (
      <div class="wave-image" aria-hidden="true">
        <Image
          source={waveImage.source}
          alt={waveImage.alt || ""}
          rounded={false}
          editable={true}
          aspectRatio="none"
          sizes="auto"
          widths={[]}
          data-prop-src="waveImage.source"
          data-prop-alt="waveImage.alt"
        />
      </div>
    )
  }

  <div class="inner">
    <article>
      <Heading
        text={heading}
        level="h2"
        fontFamily={headingFontFamily}
        data-prop="heading"
        editable={true}
      />
      {paragraphs.map((paragraph: Paragraph) => <p set:html={paragraph.body} />)}
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>

    <figure>
      <div class="image-frame">
        <Image
          source={image.source}
          alt={image.alt}
          rounded={false}
          editable={true}
          aspectRatio="none"
          sizes="auto"
          data-prop-src="image.source"
          data-prop-alt="image.alt"
        />
      </div>
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .pw-split {
    position: relative;
  }

  .pw-split .content {
    position: relative;
    z-index: 2;
  }

  .pw-split .wave-image {
    left: -110px;
    pointer-events: none;
    position: absolute;
    top: 10%;
    z-index: 1;
  }

  .pw-split .wave-image :global(.image),
  .pw-split .wave-image :global(img) {
    display: block;
    width: 260px;
  }

  .pw-split.alt .wave-image {
    left: auto;
    right: -120px;
    transform: scaleX(-1);
  }

  .pw-split .inner {
    align-items: center;
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin: 0 auto;
    max-width: 1150px;
  }

  .pw-split article {
    text-align: left;
  }

  .pw-split h2 {
    color: var(--pw-split-heading, var(--color-text));
    font-size: clamp(1.9rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.06;
    margin: 0 0 1rem;
  }

  .pw-split p {
    color: var(--color-text);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    margin: 0.9rem 0;
  }

  .pw-split p :global(strong) {
    color: var(--pw-split-accent, var(--color-brand-secondary));
  }

  .pw-split figure {
    margin: 0;
  }

  .pw-split .image-frame {
    border-radius: 1.25rem;
    overflow: hidden;
    position: relative;
  }

  .pw-split .image-frame :global(img) {
    width: 100%;
  }

  .pw-split figcaption {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin-top: 0.625rem;
    text-align: center;
    text-transform: uppercase;
  }

  @media (min-width: 960px) {
    .pw-split .inner {
      grid-template-columns: 1fr 1fr;
    }

    .pw-split.alt .inner article {
      order: 2;
    }

    .pw-split.alt .inner figure {
      order: 1;
    }
  }

  @media (max-width: 959px) {
    .pw-split .wave-image {
      left: -80px;
    }

    .pw-split .wave-image :global(.image),
    .pw-split .wave-image :global(img) {
      width: 180px;
    }

    .pw-split.alt .wave-image {
      right: -80px;
    }
  }
</style>
