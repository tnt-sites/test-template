---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  subheading = "",
  listItems = [],
  image = { source: "", alt: "" },
  buttonSections = [],
  waveTopImage = { source: "", alt: "" },
  waveMiddleImage = { source: "", alt: "" },
  waveBottomImage = { source: "", alt: "" },
  headingColor = "",
  accentColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--pw-banner-heading: ${headingColor}` : "",
  accentColor ? `--pw-banner-accent: ${accentColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["pw-banner", className]}
  paddingHorizontal="none"
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="wave-wrap" aria-hidden="true">
    {
      waveTopImage?.source && (
        <span class="wave wave-top">
          <Image
            source={waveTopImage.source}
            alt={waveTopImage.alt || ""}
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            widths={[]}
            data-prop-src="waveTopImage.source"
            data-prop-alt="waveTopImage.alt"
          />
        </span>
      )
    }
    {
      waveMiddleImage?.source && (
        <span class="wave wave-middle">
          <Image
            source={waveMiddleImage.source}
            alt={waveMiddleImage.alt || ""}
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            widths={[]}
            data-prop-src="waveMiddleImage.source"
            data-prop-alt="waveMiddleImage.alt"
          />
        </span>
      )
    }
    {
      waveBottomImage?.source && (
        <span class="wave wave-bottom">
          <Image
            source={waveBottomImage.source}
            alt={waveBottomImage.alt || ""}
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            widths={[]}
            data-prop-src="waveBottomImage.source"
            data-prop-alt="waveBottomImage.alt"
          />
        </span>
      )
    }
  </div>

  <div class="inner">
    <article>
      {subheading && <p class="subheading">{subheading}</p>}
      {heading && <h1 set:html={heading} />}
      {
        listItems.length > 0 && (
          <ul>
            {listItems.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>

    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
    </figure>
  </div>
</CustomSection>

<style>
  .pw-banner {
    overflow: hidden;
    position: relative;
  }

  .pw-banner .content {
    max-width: 100%;
    padding: 0;
    position: relative;
  }

  .pw-banner .wave-wrap {
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .pw-banner .wave {
    display: block;
    left: -10%;
    margin: 0;
    position: absolute;
    right: -10%;
  }

  .pw-banner .wave :global(.image),
  .pw-banner .wave :global(img) {
    display: block;
    width: 100%;
  }

  .pw-banner .wave-top {
    top: -120px;
  }

  .pw-banner .wave-middle {
    top: -55px;
  }

  .pw-banner .wave-bottom {
    bottom: -120px;
  }

  .pw-banner .inner {
    align-items: stretch;
    display: grid;
    grid-template-columns: 1fr;
    margin: 0 auto;
    max-width: 1440px;
    min-height: 520px;
    position: relative;
    z-index: 2;
  }

  .pw-banner article {
    align-self: center;
    padding: 90px 20px 120px;
    text-align: left;
  }

  .pw-banner .subheading {
    color: var(--pw-banner-accent, var(--color-brand-secondary));
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 0 0 0.625rem;
    text-transform: uppercase;
  }

  .pw-banner h1 {
    color: var(--pw-banner-heading, var(--color-text));
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
  }

  .pw-banner ul {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
  }

  .pw-banner li {
    color: var(--color-text);
    font-size: clamp(1rem, 2vw, 1.3125rem);
    margin: 0.5rem 0;
    padding-left: 1.625rem;
    position: relative;
  }

  .pw-banner li::before {
    color: var(--pw-banner-accent, var(--color-brand-secondary));
    content: "+";
    font-size: 1.25em;
    left: 0;
    line-height: 1;
    position: absolute;
    top: 0.05em;
  }

  .pw-banner figure {
    margin: 0;
    min-height: 340px;
    position: relative;
  }

  .pw-banner figure :global(.image),
  .pw-banner figure :global(img) {
    display: block;
    height: 100%;
    width: 100%;
  }

  .pw-banner figure :global(img) {
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .pw-banner .inner {
      grid-template-columns: 1.02fr 0.98fr;
    }

    .pw-banner article {
      padding: 110px 48px 140px;
    }
  }

  @media (max-width: 899px) {
    .pw-banner .wave-top {
      top: -86px;
    }

    .pw-banner .wave-middle {
      top: -44px;
    }

    .pw-banner .wave-bottom {
      bottom: -74px;
    }
  }
</style>
