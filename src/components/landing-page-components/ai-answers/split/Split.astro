---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  headingFontFamily = "",
  text = "",
  image = { source: "", alt: "" },
  figcaption = "",
  reverse = false,
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--ai-accent-color: ${accentColor}` : "",
  headingColor ? `--ai-heading-color: ${headingColor}` : "",
  fontHeadings ? `--ai-font-headings: ${fontHeadings}` : "",
  fontBody ? `--ai-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["ai-split", reverse && "alt", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <article>
      <div class="content">
        <Heading
          text={heading}
          level="h2"
          fontFamily={headingFontFamily}
          data-prop="heading"
          editable={true}
        />
        <Text text={text} fontFamily={fontBody} data-prop="text" editable={true} />

        {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
      </div>
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .ai-split .flex-ed {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-around;
    margin: 0 auto;
    max-width: 1300px;
  }

  .ai-split.alt figure {
    order: -1;
  }

  .ai-split article {
    flex: 0 1 630px;
    padding: 0 10px;
    text-align: left;
  }

  .ai-split h2 {
    color: var(--nptc-heading-color, var(--color-brand));
    font-family: var(--nptc-font-headings, var(--font-headings));
    font-size: 3.4375rem;
    font-weight: 500;
    line-height: 1.1;
    margin: 0.3125rem auto 0.9375rem;
    text-align: left;
  }

  .ai-split .text p {
    font-size: 22px;
  }

  .ai-split figure {
    flex: 0 1 540px;
  }

  .ai-split figure :global(img) {
    width: 100%;
  }

  .ai-split figcaption {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    margin-top: 0.9375rem;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .ai-split .flex-ed {
      display: block;
    }

    .ai-split article {
      flex: none;
    }

    .ai-split.alt figure {
      order: unset;
    }

    .ai-split h2 {
      text-align: center;
    }

    .ai-split ul {
      display: table;
      margin: 0 auto;
    }

    .ai-split figure {
      flex: none;
      margin: 1.25rem auto 0;
      max-width: 500px;
      width: 100%;
    }
  }
</style>
