---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import siteInfo from "@data/siteInfo.json";
import Form from "@forms/form/Form.astro";

const {
  heading = "Request an Appointment",
  formAction = "",
  formBlocks = [],
  backgroundColor = "base",
  backgroundColorHex = "",
  id = "",
  backgroundImage,
  backgroundGradient = "",
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const sectionStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  backgroundGradient ? `--section-bg-gradient: ${backgroundGradient}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["landing-page-form", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={resolvedBg}
  backgroundImage={backgroundImage}
  style={sectionStyle || undefined}
  {...htmlAttributes}
>
  <Heading level="h2" size="xl" alignX="center" data-prop="heading" text={heading} />
  <p class="lp-intro">
    Thank you for your interest in {siteInfo.siteName}. Please fill out your information in the form
    below and a member of our team will reach out to you soon.
  </p>
  <Form class="lp-form" action={formAction} formBlocks={formBlocks?.length > 0 ? formBlocks : []}>
    <slot />
  </Form>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-page-form {
      .lp-intro {
        margin: var(--spacing-lg) auto 0;
        max-width: 700px;
        text-align: center;
      }

      .lp-form {
        margin: var(--spacing-2xl) auto var(--spacing-lg);
        max-width: 550px;

        .label {
          display: none;
        }

        .field {
          background-color: #d3d3d3;
          border: none;
          border-radius: 5px;
          box-shadow: inset 0 1px 3px 0 rgba(0, 0, 0, 0.5);
          color: #000;
          font-size: 16px;
          padding: 15px;
          width: 100%;

          &:focus {
            background-color: #e3e3e3;
            outline: #0e345e solid thin;
          }
        }

        .textarea .field {
          height: 200px;
        }

        .submit {
          display: block;
          margin: auto;
          width: 200px;
        }

        editable-array-item:has(.submit) {
          display: flex;
          justify-content: center;
        }
      }
    }
  }
</style>
