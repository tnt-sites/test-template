---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import FontelloIcon from "@core-elements/fontello-icon/FontelloIcon.astro";

interface Item {
  headingLine1: string;
  headingLine2: string;
  iconName: string;
  iconCount: number;
  iconColor: string;
  iconPosition: string;
  link: string;
}

const {
  items = [] as Item[],
  sectionColor = "",
  accentColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  sectionColor ? `--di-section-color: ${sectionColor}` : "",
  accentColor ? `--di-accent-color: ${accentColor}` : "",
  fontHeadings ? `--di-font-headings: ${fontHeadings}` : "",
  fontBody ? `--di-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["di-secondary-callouts", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="cards">
    {
      items.map((item: Item, i: number) => {
        const Tag = item.link ? "a" : "div";
        const linkProps = item.link ? { href: item.link } : {};
        const count = Math.max(1, Math.min(10, Number(item.iconCount) || 1));
        return (
          <Tag class="card" {...linkProps} data-cms-bind={`#items/${i}`}>
            <div
              class="portrait"
              style={item.iconColor ? `--di-card-icon-color: ${item.iconColor}` : undefined}
            >
              <h3>
                {item.headingLine1 && <span class="line1">{item.headingLine1}</span>}
                {item.iconName && item.iconPosition !== "bottom" && (
                  <span class="icons">
                    <FontelloIcon name={item.iconName} count={count} size="lg" />
                  </span>
                )}
                {item.headingLine2 && <span class="line2">{item.headingLine2}</span>}
                {item.iconName && item.iconPosition === "bottom" && (
                  <span class="icons">
                    <FontelloIcon name={item.iconName} count={count} size="lg" />
                  </span>
                )}
              </h3>
            </div>
          </Tag>
        );
      })
    }
  </div>
</CustomSection>

<style>
  .di-secondary-callouts {
    background-color: var(--di-section-color, #000) !important;
  }

  .di-secondary-callouts .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    margin: 0 auto;
    max-width: 1190px;
  }

  .di-secondary-callouts .card {
    color: #fff;
    flex: 0 1 255px;
    text-decoration: none;
  }

  .di-secondary-callouts .portrait {
    align-items: center;
    background-color: #fff;
    border-radius: 10px;
    box-shadow:
      0 0 0 10px rgba(255, 255, 255, 0.15),
      0 3px 16px 7px rgba(0, 0, 0, 0.35);
    color: var(--di-section-color, #324248);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 260px;
    padding: 1.5rem 1rem;
    position: relative;
    text-align: center;
  }

  .di-secondary-callouts .portrait::after {
    border: 1px solid var(--di-accent-color, #000);
    border-radius: 8px;
    content: "";
    inset: 5px;
    pointer-events: none;
    position: absolute;
    transition: inset 0.3s ease;
  }

  .di-secondary-callouts h3 {
    align-items: center;
    color: var(--di-section-color, #324248);
    display: flex;
    flex-direction: column;
    font-family: var(--di-font-headings, var(--font-headings));
    font-size: 1.25rem;
    font-weight: 600;
    gap: 0.2rem;
    letter-spacing: 0.04em;
    line-height: 1.25;
    margin: 0;
    text-transform: uppercase;
  }

  .di-secondary-callouts h3 .line1,
  .di-secondary-callouts h3 .line2 {
    display: block;
  }

  .di-secondary-callouts .icons {
    color: var(--di-card-icon-color, var(--di-accent-color, var(--color-brand-secondary)));
    display: block;
  }

  .di-secondary-callouts .icons :global(.fontello-icon) {
    color: inherit;
  }

  @media (hover: hover) {
    .di-secondary-callouts a.card:hover {
      transform: none;
    }
    .di-secondary-callouts a.card:hover .portrait:after {
      inset: 0;
    }
  }
  @media (max-width: 768px) {
    .di-secondary-callouts .card {
      flex: 0 1 45%;
    }
  }

  @media (max-width: 640px) {
    .di-secondary-callouts .card {
      flex: 0 1 100%;
      max-width: 280px;
    }
  }
</style>
