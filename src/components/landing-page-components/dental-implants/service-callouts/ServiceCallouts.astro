---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";

interface Item {
  heading: string;
  image: { source: string; alt: string };
  text: string;
  link: string;
}

const {
  heading = "",
  headingFontFamily = "",
  items = [] as Item[],
  headingColor = "",
  accentColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--di-heading-color: ${headingColor}` : "",
  accentColor ? `--di-accent-color: ${accentColor}` : "",
  fontHeadings ? `--di-font-headings: ${fontHeadings}` : "",
  fontBody ? `--di-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["di-service-callouts", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  {
    heading && (
      <Heading
        text={heading}
        level="h2"
        fontFamily={headingFontFamily}
        data-prop="heading"
        editable={true}
      />
    )
  }
  <div class="options">
    {
      items.map((item: Item, i: number) => (
        <a class="col" href={item.link || "#"} data-cms-bind={`#items/${i}`}>
          <h3>{item.heading}</h3>
          <div class="portrait">
            {item.image?.source && (
              <Image
                source={item.image.source}
                alt={item.image.alt || ""}
                rounded={false}
                editable={true}
                aspectRatio="none"
                sizes="auto"
                widths={[]}
                data-prop-src={`items.${i}.image.source`}
                data-prop-alt={`items.${i}.image.alt`}
              />
            )}
          </div>
          {item.text && <p set:html={item.text} />}
        </a>
      ))
    }
  </div>
</CustomSection>

<style>
  .di-service-callouts h2 {
    color: var(--di-heading-color, var(--color-heading));
    font-family: var(--di-font-headings, var(--font-headings));
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    margin: 0 auto 1.5rem;
    text-align: center;
  }

  .di-service-callouts .options {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: space-around;
    margin: 0 auto;
    max-width: 1250px;
  }

  /* ── Card link ────────────────────────────────────────────────────────────── */
  .di-service-callouts .col {
    color: inherit;
    flex: 0 1 255px;
    font-family: var(--di-font-headings, var(--font-headings));
    text-align: center;
    text-decoration: none;
  }

  .di-service-callouts .col h3 {
    color: var(--di-heading-color, var(--color-heading));
    font-size: 1.375rem;
    letter-spacing: 0.05em;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .di-service-callouts .col p {
    font-family: var(--di-font-body, var(--font-body));
    font-size: 1rem;
    margin: 0.75rem 0 0;
  }

  /* ── Portrait frame ───────────────────────────────────────────────────────── */
  .di-service-callouts .portrait {
    background-color: var(--color-surface, #fff);
    border-radius: 10px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    position: relative;

    .image {
      margin: 0;
      width: 100%;
    }
  }

  /* White inset border overlay */
  .di-service-callouts .portrait::after {
    border: 2px solid #fff;
    border-radius: 8px;
    content: "";
    inset: 5px;
    pointer-events: none;
    position: absolute;
  }

  .di-service-callouts .portrait :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  /* ── Hover ────────────────────────────────────────────────────────────────── */
  @media (hover: hover) {
    .di-service-callouts .col:hover .portrait:after {
      border-color: var(--di-accent-color, var(--color-brand));
    }

    .di-service-callouts .col:hover h3 {
      color: var(--di-accent-color, var(--color-brand));
    }
  }

  /* ── Responsive ───────────────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .di-service-callouts .options {
      gap: 2rem;
    }

    .di-service-callouts .col {
      flex: 0 1 45%;
    }
  }

  @media (max-width: 440px) {
    .di-service-callouts .col {
      flex: 0 1 100%;
      max-width: 280px;
    }
  }
</style>
