---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  cityState = "",
  heading = "",
  offerLabel = "",
  offerTitle = "",
  offerSubtitle = "",
  image = { source: "", alt: "" },
  figcaption = "",
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--di-accent-color: ${accentColor}` : "",
  headingColor ? `--di-heading-color: ${headingColor}` : "",
  fontHeadings ? `--di-font-headings: ${fontHeadings}` : "",
  fontBody ? `--di-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["di-banner", className]}
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <article>
      <h1>
        {cityState && <span class="city">{cityState}</span>}
        <span class="title" set:html={heading} />
      </h1>
      {
        (offerLabel || offerTitle || offerSubtitle) && (
          <div class="offer-box">
            {offerLabel && <p class="offer-label">{offerLabel}</p>}
            {offerTitle && <p class="offer-title">{offerTitle}</p>}
            {offerSubtitle && <strong class="offer-subtitle">{offerSubtitle}</strong>}
          </div>
        )
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .di-banner {
    overflow: hidden;
  }

  .di-banner .flex-ed {
    align-items: stretch;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-around;
    margin: auto;
    max-width: 1170px;
  }

  /* ── Article ─────────────────────────────────────────────────────────────── */
  .di-banner article {
    display: flex;
    flex: 0 1 50%;
    flex-direction: column;
    justify-content: center;
    order: 1;
    padding: 2.5rem 1.25rem 3.75rem;
    text-align: center;
    z-index: 3;
  }

  /* ── H1 ──────────────────────────────────────────────────────────────────── */
  .di-banner h1 {
    font-family: var(--di-font-headings, var(--font-headings));
    letter-spacing: 0.07em;
    line-height: 1.15;
    margin: 0 0 3.125rem;
  }

  .di-banner h1 .city {
    color: var(--di-heading-color, #ccc);
    display: block;
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 0.07em;
  }

  .di-banner h1 .title {
    color: var(--color-text-inverse, #fff);
    display: block;
    font-size: 4.5rem;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.3);
  }

  /* ── Offer box ───────────────────────────────────────────────────────────── */
  .di-banner .offer-box {
    background-color: #000;
    border-bottom: 5px solid rgba(229, 237, 233, 0.5);
    border-top: 5px solid rgba(229, 237, 233, 0.5);
    color: var(--color-text-inverse, #fff);
    font-family: var(--di-font-body, var(--font-body));
    margin: 0 auto;
    max-width: 36.5625rem;
    padding: 0.3125rem 0;
    text-align: center;
  }

  .di-banner .offer-label {
    font-size: 1.25rem;
    letter-spacing: 0.15625rem;
    line-height: 2.5625rem;
    margin: 0;
  }

  .di-banner .offer-title {
    color: var(--di-accent-color, var(--color-brand));
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.11;
    margin: 0;
  }

  .di-banner .offer-subtitle {
    display: block;
    font-size: 1.6875rem;
    letter-spacing: 0.1em;
  }

  /* ── Figure ──────────────────────────────────────────────────────────────── */
  .di-banner figure {
    align-self: stretch;
    flex: 0 1 50%;
    order: 2;
    position: relative;
  }

  .di-banner figure .image {
    margin-top: 0;
  }

  .di-banner figure :global(img) {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .di-banner figcaption {
    background-color: rgba(0, 0, 0, 0.9);
    bottom: 0;
    color: var(--color-text-inverse, #fff);
    font-size: 0.9375rem;
    font-weight: 400;
    left: 50%;
    letter-spacing: 0.08125rem;
    max-width: 100%;
    padding: 0.3125rem 0.625rem;
    position: absolute;
    text-transform: uppercase;
    transform: translateX(-50%);
    width: 23.75rem;
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .di-banner .flex-ed {
      display: block;
    }

    .di-banner article {
      flex: none;
      margin: 0.625rem auto 1.25rem;
      padding-top: 1.25rem;
    }

    .di-banner h1 {
      margin-bottom: 0;
    }

    .di-banner figure :global(img) {
      height: auto;
      width: 100%;
    }

    .di-banner figcaption {
      left: auto;
      right: 50%;
      transform: translateX(50%);
    }
  }

  @media (max-width: 590px) {
    .di-banner h1 .city {
      font-size: 1.75rem;
    }

    .di-banner h1 .title {
      font-size: 2.625rem;
    }
  }
</style>
