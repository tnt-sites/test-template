---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

interface Card {
  image: { source: string; alt: string };
  text: string;
  listItems: string[];
}

const {
  cards = [] as Card[],
  primaryCardColor = "",
  accentCardColor = "",
  accentCardTextColor = "",
  bulletColor = "",
  overlapBanner = true,
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  primaryCardColor && `--nptc-card-color: ${primaryCardColor}`,

  accentCardColor && `--nptc-accent-card-color: ${accentCardColor}`,
  accentCardTextColor && `--nptc-accent-card-text-color: ${accentCardTextColor}`,
  bulletColor && `--nptc-bullet-color: ${bulletColor}`,
  fontHeadings && `--nptc-font-headings: ${fontHeadings}`,
  fontBody && `--nptc-font-body: ${fontBody}`,
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-count", overlapBanner && "overlap-banner", className]}
  paddingHorizontal="md"
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="cards">
    {
      cards.map((card: Card) => (
        <div class="card">
          {card.image?.source && (
            <span class="img">
              <Image
                source={card.image.source}
                alt={card.image.alt || ""}
                rounded={false}
                editable={false}
                aspectRatio="none"
                sizes="auto"
                widths={[]}
              />
            </span>
          )}
          <span class="text" set:html={card.text} />
          {card.listItems?.length > 0 && (
            <ul>
              {card.listItems.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</CustomSection>

<style>
  .nptc-count .content {
    padding: 0;
  }

  /*  Cards row  */
  .nptc-count .cards {
    display: flex;
    gap: 0;
    justify-content: center;
    margin: 0 auto;
    max-width: 1200px;
  }

  .nptc-count .card {
    align-items: center;
    background-color: var(--nptc-card-color, #ebebeb);
    box-shadow: 3px 3px 16px 0 rgba(0, 0, 0, 0.36);
    display: flex;
    flex: 0 1 396px;
    flex-direction: column;
    justify-content: center;
    margin: 1.25rem 0;
    min-height: 382px;
    padding: 1.5rem 1.25rem;
  }

  .nptc-count .card:first-child {
    border-radius: 2.8125rem 0 0 2.8125rem;
  }

  .nptc-count .card:last-child {
    border-radius: 0 2.8125rem 2.8125rem 0;
  }

  /* Middle card */
  .nptc-count .card:nth-child(2) {
    background-color: var(--nptc-accent-card-color, var(--color-bg-brand));
    color: var(--nptc-accent-card-text-color, var(--color-text-inverse));
  }

  .nptc-count .card:nth-child(2) .text {
    color: var(--nptc-accent-card-text-color, var(--color-text-inverse));
  }

  /*  Icon image  */
  .nptc-count .img {
    align-items: center;
    display: flex;
    height: 5rem;
    justify-content: center;
    margin: 0 auto 0.625rem;
    width: 5rem;
  }

  .nptc-count .img :global(img) {
    max-height: 5rem;
    width: auto;
  }

  /*  Card text  */
  .nptc-count .text {
    display: block;
    font-family: var(--nptc-font-headings, var(--font-headings));
    font-size: 2rem;
    line-height: 1.2;
    text-align: center;
  }

  /*  List  */
  .nptc-count ul {
    font-family: var(--nptc-font-body, var(--font-body));
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0.5rem 0.625rem;
    text-align: left;
  }

  .nptc-count ul li {
    font-size: 1.25rem;
    margin: 0.375rem 0;
    padding-left: 1.25rem;
    position: relative;
  }

  .nptc-count ul li::before {
    color: var(--nptc-bullet-color, var(--color-brand));
    content: "+";
    font-size: 1.25rem;
    left: 0;
    position: absolute;
    top: 0;
  }

  /*  Responsive  */

  @media (min-width: 1025px) {
    .nptc-count.overlap-banner {
      margin-top: -100px;
      position: relative;
      z-index: 20;
    }
  }

  @media (max-width: 1024px) {
    .nptc-count .cards {
      display: block;
    }

    .nptc-count .card {
      flex: none;
      margin: 0.625rem auto;
      max-width: 480px;
      width: 100%;
    }

    .nptc-count .card:first-child {
      border-radius: 2.8125rem 2.8125rem 0 0;
    }

    .nptc-count .card:last-child {
      border-radius: 0 0 2.8125rem 2.8125rem;
    }

    .nptc-count .card:nth-child(2) {
      border-radius: 0;
    }
  }
</style>
