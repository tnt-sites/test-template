---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  subheading = "",
  heading = "",
  badgeImage = { source: "", alt: "" },
  image = { source: "", alt: "" },
  figcaption = "",
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--nptc-accent-color: ${accentColor}` : "",
  headingColor ? `--nptc-heading-color: ${headingColor}` : "",
  fontHeadings ? `--nptc-font-headings: ${fontHeadings}` : "",
  fontBody ? `--nptc-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-banner", className]}
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <article>
      <h1>
        {subheading && <small>{subheading}</small>}
        <span set:html={heading} />
      </h1>
      {
        badgeImage?.source && (
          <span class="badge">
            <Image
              source={badgeImage.source}
              alt={badgeImage.alt || ""}
              rounded={false}
              editable={true}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
              data-prop-src="badgeImage.source"
              data-prop-alt="badgeImage.alt"
            />
          </span>
        )
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .nptc-banner {
    overflow: hidden;
  }

  .nptc-banner .flex-ed {
    align-items: stretch;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    margin: auto;
    max-width: 1920px;
  }

  .nptc-banner article {
    align-self: center;
    display: flex;
    flex: 0 1 520px;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    order: 1;
    padding: 60px 20px 150px 50px;
    position: relative;
    text-align: left;
    z-index: 3;
  }

  /* Three-sided bracket decoration — left, top, bottom borders */
  .nptc-banner article::before {
    border-bottom: 4px solid var(--nptc-accent-color, var(--color-brand));
    border-left: 4px solid var(--nptc-accent-color, var(--color-brand));
    border-top: 4px solid var(--nptc-accent-color, var(--color-brand));

    /* Move bottom up to overlap with badge, if needed */
    bottom: 120px;
    content: "";
    left: 0;
    pointer-events: none;
    position: absolute;
    top: 25px;
    width: 100px;
  }

  .nptc-banner h1 {
    color: var(--nptc-heading-color, var(--color-text));
    font-family: var(--nptc-font-headings, var(--font-headings));
    font-size: 4.375rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
  }

  .nptc-banner h1 small {
    display: block;
    font-family: var(--nptc-font-body, var(--font-body));
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    margin-bottom: 0.9375rem;
    text-transform: uppercase;
  }

  .nptc-banner .badge {
    display: block;
    margin-top: 1.5625rem;
    max-width: 280px;
  }

  .nptc-banner figure {
    align-self: stretch;
    display: flex;
    flex: 0 1 50%;
    flex-direction: column;
    order: 2;
    position: relative;
  }

  .nptc-banner figure :global(.image) {
    display: block;
    flex: 1 1 auto;
    height: 100%;
    margin-top: 0;
    min-height: 0;
    width: 100%;
  }

  .nptc-banner figure :global(img) {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .nptc-banner figure figcaption {
    background: rgba(255, 255, 255, 0.9);
    bottom: 0;
    color: #000;
    font-size: 0.875rem;
    font-weight: 700;
    left: 0;
    letter-spacing: 0.2em;
    padding: 0.75rem 1.25rem;
    position: absolute;
    right: 0;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .nptc-banner .flex-ed {
      display: block;
    }

    .nptc-banner article {
      flex: none;
      padding: 20px;
      text-align: center;
    }

    .nptc-banner article::before {
      display: none;
    }

    .nptc-banner .badge {
      margin: 1.5625rem auto 0;
    }

    .nptc-banner figure :global(img) {
      height: auto;
      width: 100%;
    }
  }
</style>
