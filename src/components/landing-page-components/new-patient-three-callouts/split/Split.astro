---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  headingFontFamily = "",
  listItems = [],
  image = { source: "", alt: "" },
  figcaption = "",
  reverse = false,
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--nptc-accent-color: ${accentColor}` : "",
  headingColor ? `--nptc-heading-color: ${headingColor}` : "",
  fontHeadings ? `--nptc-font-headings: ${fontHeadings}` : "",
  fontBody ? `--nptc-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-split", reverse && "alt", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <article>
      <div class="content">
        <Heading
          text={heading}
          level="h2"
          fontFamily={headingFontFamily}
          data-prop="heading"
          editable={true}
        />
        {
          listItems.length > 0 && (
            <ul>
              {listItems.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }
        {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
      </div>
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .nptc-split .flex-ed {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-around;
  }

  /* "alt" variant: image on the left */
  .nptc-split.alt figure {
    order: -1;
  }

  /* ── Article ────────────────────────────────────────────────────────────── */
  .nptc-split article {
    flex: 0 1 540px;
    text-align: left;
  }

  .nptc-split h2 {
    color: var(--nptc-heading-color, var(--color-brand));
    font-family: var(--nptc-font-headings, var(--font-headings));
    font-size: 3.4375rem;
    font-weight: 500;
    line-height: 1.1;
    margin: 0.3125rem auto 0.9375rem;
    text-align: left;
  }

  /* ── List ───────────────────────────────────────────────────────────────── */
  .nptc-split ul {
    font-family: var(--nptc-font-body, var(--font-body));
    list-style: none;
    padding: 0;
    text-align: left;
  }

  .nptc-split ul li {
    font-size: 1.875rem;
    margin: 0.9375rem auto;
    padding-left: 2.1875rem;
    position: relative;
  }

  .nptc-split ul li::before {
    color: var(--nptc-accent-color, var(--color-brand));
    content: "+";
    font-size: 1.875rem;
    left: 0;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  /* ── Figure ─────────────────────────────────────────────────────────────── */
  .nptc-split figure {
    flex: 0 1 480px;
  }

  .nptc-split figure :global(img) {
    width: 100%;
  }

  .nptc-split figcaption {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    margin-top: 0.9375rem;
    text-align: center;
    text-transform: uppercase;
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .nptc-split .flex-ed {
      display: block;
    }

    .nptc-split article {
      flex: none;
    }

    .nptc-split.alt figure {
      order: unset;
    }

    .nptc-split h2 {
      text-align: center;
    }

    .nptc-split ul {
      display: table;
      margin: 0 auto;
    }

    .nptc-split figure {
      flex: none;
      margin: 1.25rem auto 0;
      max-width: 500px;
      width: 100%;
    }
  }
</style>
