---
import CustomSection from "@builders/custom-section/CustomSection.astro";

interface Paragraph {
  emphasis: string;
  body: string;
}

const {
  paragraphs = [] as Paragraph[],
  accentColor = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--nptc-accent-color: ${accentColor}` : "",
  fontBody ? `--nptc-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-welcome", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="inner">
    {
      paragraphs.map((p: Paragraph) => (
        <p>
          {p.emphasis && <strong>{p.emphasis}</strong>}
          {p.emphasis && " "}
          <Fragment set:html={p.body} />
        </p>
      ))
    }
  </div>
</CustomSection>

<style>
  .nptc-welcome .inner {
    font-family: var(--nptc-font-body, var(--font-body));
    font-size: 1.375rem;
    line-height: 1.6;
    margin: 0 auto;
    max-width: 71.875rem;
    text-align: center;
  }

  .nptc-welcome p {
    margin: 0.75rem auto;
  }

  /* Emphasized phrase at the start of each paragraph */
  .nptc-welcome p strong {
    color: var(--nptc-accent-color, var(--color-brand));
    font-weight: 500;
  }
</style>
