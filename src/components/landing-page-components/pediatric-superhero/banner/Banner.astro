---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  subheading = "",
  heading = "",
  tagline = "",
  listItems = [],
  image = { source: "", alt: "" },
  buttonSections = [],
  waveImage = { source: "", alt: "" },
  waveHeight = "92px",
  headingColor = "",
  accentColor = "",
  backgroundColor = "accent",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--ps-banner-heading: ${headingColor}` : "",
  accentColor ? `--ps-banner-accent: ${accentColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["ps-banner", className]}
  paddingHorizontal="none"
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="inner">
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
    </figure>

    <article>
      <h1>
        {subheading && <small set:html={subheading} />}
        <span set:html={heading} />
        {tagline && <em set:html={tagline} />}
      </h1>
      {
        listItems.length > 0 && (
          <ul>
            {listItems.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
  </div>

  {
    waveImage?.source && (
      <div
        class="wave-image"
        aria-hidden="true"
        style={`background-image: url(${waveImage.source}); height: ${waveHeight};`}
        data-prop-src="waveImage.source"
        data-prop-alt="waveImage.alt"
      />
    )
  }
</CustomSection>

<style>
  .ps-banner {
    position: relative;
  }

  .ps-banner .inner {
    align-items: center;
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    position: relative;
  }

  .ps-banner figure {
    align-self: end;
    margin: 0;
    width: 100%;
  }

  .ps-banner figure :global(img) {
    display: block;
    object-fit: cover;
    width: 100%;
  }

  .ps-banner article {
    padding: 2.5rem 1.5rem 60px;
    text-align: center;
    width: 100%;
  }

  .ps-banner h1 {
    color: var(--ps-banner-heading, #000);
    font:
      700 4.5rem/1.1 "Amatic SC",
      sans-serif;
    margin: 0;
    text-transform: uppercase;
  }

  .ps-banner h1 small {
    display: block;
    font:
      400 1.5rem/1 Neuton,
      serif;
    text-transform: none;
  }

  .ps-banner h1 :global(span) {
    color: var(--ps-banner-accent, #00aced);
  }

  .ps-banner h1 em {
    display: block;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-style: normal;
  }

  .ps-banner ul {
    display: table;
    list-style: none;
    margin: 1.5rem auto 0;
    padding: 0;
    text-align: left;
  }

  .ps-banner li {
    font-size: clamp(1.1rem, 2.5vw, 1.7rem);
    line-height: 1.2;
    margin-bottom: 0.75rem;
    padding-left: 2.25rem;
    position: relative;
  }

  .ps-banner li::before {
    color: var(--ps-banner-accent, #00aced);
    content: "✓";
    font-weight: 700;
    left: 0;
    position: absolute;
    top: 0;
  }

  .ps-banner .wave-image {
    background-position: center;
    background-repeat: repeat-x;
    background-size: auto 100%;
    bottom: -50px;
    left: 50%;
    pointer-events: none;
    position: absolute;
    transform: translateX(-50%);
    width: 100vw;
    z-index: 11;
  }

  @media (min-width: 960px) {
    .ps-banner .inner {
      flex-direction: row;
      min-height: 580px;
    }

    .ps-banner figure {
      flex: 1 1 55%;
      height: 100%;
      position: relative;
    }

    .ps-banner figure :global(.image),
    .ps-banner figure :global(img) {
      height: 100%;
    }

    .ps-banner article {
      flex: 0 0 auto;
      max-width: 560px;
      padding: 20px 2.5rem 70px;
      text-align: center;
    }

    .ps-banner h1 {
      font-size: 5.5rem;
    }
  }
</style>
