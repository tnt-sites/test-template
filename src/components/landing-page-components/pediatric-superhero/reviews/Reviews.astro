---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  reviewLogo = { source: "", alt: "" },
  stars = 5,
  reviewText = "",
  reviewerName = "",
  badgeBackgroundColor = "",
  headingColor = "",
  backgroundColor = "accent",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const safeStars = Math.max(0, Math.min(5, Number(stars) || 0));

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  badgeBackgroundColor ? `--ps-reviews-badge-bg: ${badgeBackgroundColor}` : "",
  headingColor ? `--ps-reviews-heading-color: ${headingColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["ps-reviews", className]}
  paddingHorizontal="md"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="inner">
    <aside>
      {
        safeStars > 0 && (
          <p class="stars" aria-label={`Rated ${safeStars} out of 5 stars`}>
            {"★".repeat(safeStars)}
          </p>
        )
      }
      <p class="badge-label">Actual</p>
      {
        reviewLogo?.source && (
          <span class="logo-wrap">
            <Image
              source={reviewLogo.source}
              alt={reviewLogo.alt || "Google"}
              rounded={false}
              editable={true}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
              data-prop-src="reviewLogo.source"
              data-prop-alt="reviewLogo.alt"
            />
          </span>
        )
      }
      <p class="badge-label">Review</p>
    </aside>

    <article>
      {reviewText && <p class="review-text">{reviewText}</p>}
      {reviewerName && <p class="reviewer">- {reviewerName}</p>}
    </article>
  </div>
</CustomSection>

<style>
  .ps-reviews .inner {
    align-items: stretch;
    background-color: #fff;
    box-shadow: 0 12px 16px rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0 auto;
    max-width: 1150px;
  }

  .ps-reviews aside,
  .ps-reviews article {
    padding: 1.875rem 1.25rem;
  }

  .ps-reviews aside {
    align-items: center;
    background-color: var(--ps-reviews-badge-bg, #e4f8d4);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    justify-content: center;
  }

  .ps-reviews .stars {
    color: #f4bd17;
    font-size: 1.4rem;
    letter-spacing: 0.25rem;
    margin: 0;
  }

  .ps-reviews .badge-label {
    color: var(--ps-reviews-heading-color, #252627);
    font-size: 1.125rem;
    letter-spacing: 0.125rem;
    margin: 0;
    text-transform: uppercase;
  }

  .ps-reviews .logo-wrap {
    display: inline-block;
    width: 130px;
  }

  .ps-reviews .logo-wrap :global(img) {
    margin: 0;
    width: 100%;
  }

  .ps-reviews article {
    margin: 0 auto;
    max-width: 51.25rem;
  }

  .ps-reviews .review-text {
    color: #252627;
    font: 400 1.5rem/1.3 "Neuton", serif;
    margin: 0;
    text-align: left;
  }

  .ps-reviews .reviewer {
    color: #252627;
    font: 700 1rem/1 "Neuton", serif;
    letter-spacing: 0.0625rem;
    margin: 0.9375rem 0 0;
    text-align: right;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .ps-reviews .inner {
      border-radius: 0.3rem;
      flex-direction: row;
      overflow: hidden;
    }

    .ps-reviews aside {
      flex: 0 0 220px;
    }

    .ps-reviews article {
      padding: 2.5rem 0.625rem;
    }
  }
</style>
