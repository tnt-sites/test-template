---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Text from "@core-elements/text/Text.astro";

const {
  text = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  blurbBackgroundColor = "none",
  editable = true,
  ...rest
} = Astro.props;

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["blurb", className]}
  colorScheme="default"
  backgroundColor={backgroundColorHex ? "none" : backgroundColor}
  style={backgroundColorHex ? `background-color: ${backgroundColorHex}` : undefined}
  {...htmlAttributes}
>
  <article
    class="looking"
    style={blurbBackgroundColor !== "none"
      ? `background-color: var(--color-bg-${blurbBackgroundColor});`
      : undefined}
  >
    <Text size="lg" alignX="center">
      <Fragment set:html={text} />
    </Text>
  </article>
</CustomSection>

<style>
  .blurb {
    background-color: var(--color-bg-accent);
  }

  .looking {
    border-radius: 5px;
    box-shadow: 4px 4px 8px rgba(0, 0, 0, 0.17);
    margin: 100px auto;
    max-width: 1140px;
    padding: 20px 30px;
  }

  :global(.looking p) {
    font-size: 20px;
    font-weight: 300;
    line-height: 1.5;
    margin: 1em auto;
    padding: 15px 10px;
    text-align: center;
  }

  :global(.looking p span.big-text) {
    font-size: 30px;
    font-weight: 400;
  }

  .looking.bg-surface {
    background-color: var(--color-bg-surface);
  }

  .looking.bg-accent {
    background-color: var(--color-bg-accent);
  }

  .looking.bg-highlight {
    background-color: var(--color-bg-highlight);
  }
  .looking.bg-black {
    background-color: var(--color-bg-black);
  }
  .looking.bg-white {
    background-color: var(--color-bg-white);
  }
  @layer components {
    .blurb .looking p {
      font-size: 20px !important;
      font-weight: 500 !important;
      line-height: 1.5 !important;
      margin: 2em auto !important;
      padding: 15px 10px !important;
      text-align: center !important;
    }

    .looking p span.big-text {
      font-size: 30px !important;
      font-weight: 400 !important;
    }
  }
</style>
