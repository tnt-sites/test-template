---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  image = { source: "", alt: "" },
  heading = "",
  subtext = "",
  buttonSections = [],
  badgeImage = { source: "", alt: "" },
  specialBadge = { source: "", alt: "" },
  figcaption = "",
  borderColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "none",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  borderColor ? `--npem-banner-border: ${borderColor}` : "",
  fontHeadings ? `--npem-banner-font-headings: ${fontHeadings}` : "",
  fontBody ? `--npem-banner-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["npem-banner", className]}
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="npem-banner-content">
    <figure class="npem-banner-figure">
      {
        badgeImage?.source && (
          <span class="npem-banner-badge">
            <Image
              source={badgeImage.source}
              alt={badgeImage.alt || ""}
              rounded={false}
              editable={false}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
            />
          </span>
        )
      }
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption set:html={figcaption} />}
    </figure>

    <div class="npem-banner-bar">
      {
        specialBadge?.source && (
          <span class="npem-banner-special-badge">
            <Image
              source={specialBadge.source}
              alt={specialBadge.alt || ""}
              rounded={false}
              editable={false}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
            />
          </span>
        )
      }
      <div class="npem-banner-bar-inner">
        {heading && <h2 data-prop="heading" set:html={heading} />}
        {subtext && <p class="npem-banner-subtext" data-prop="subtext" set:html={subtext} />}
        {
          buttonSections.length > 0 && (
            <ButtonGroup class="npem-banner-buttons" buttonSections={buttonSections} />
          )
        }
      </div>
    </div>
  </div>
</CustomSection>

<style>
  .npem-banner {
    border-bottom: 6px solid var(--npem-banner-border, var(--color-brand));
    position: relative;
  }

  .npem-banner .npem-banner-figure {
    margin: 0;
    position: relative;
  }

  .npem-banner .npem-banner-figure :global(.image) {
    margin-top: 0;
  }

  .npem-banner .npem-banner-figure :global(img) {
    position: relative;
    width: 100%;
  }

  .npem-banner .npem-banner-badge {
    position: absolute;
    right: 30px;
    top: 60px;
    z-index: 5;
  }

  .npem-banner .npem-banner-badge :global(.image),
  .npem-banner .npem-banner-badge :global(img) {
    margin: 0;
    width: auto;
  }

  .npem-banner .npem-banner-figure figcaption {
    background: rgba(255, 255, 255, 0.8);
    bottom: 80px;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 700;
    left: 25%;
    letter-spacing: 0.065em;
    padding: 5px 20px;
    position: absolute;
    text-transform: uppercase;
  }

  .npem-banner .npem-banner-bar {
    background-color: #fff;
    border-radius: 10px;
    bottom: -100px;
    box-shadow: 1px 3px 3px #d3d3d3;
    left: 50%;
    max-width: 1200px;
    position: absolute;
    transform: translateX(-50%);
    width: 100%;
    z-index: 5;
  }

  .npem-banner .npem-banner-special-badge {
    left: -55px;
    position: absolute;
    top: -45px;
  }

  .npem-banner .npem-banner-special-badge :global(.image),
  .npem-banner .npem-banner-special-badge :global(img) {
    margin: 0;
    width: auto;
  }

  .npem-banner .npem-banner-bar-inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    margin: auto 30px auto auto;
    max-width: 82%;
  }

  .npem-banner .npem-banner-bar h2 {
    color: var(--color-text);
    font-family: var(--npem-banner-font-headings, var(--font-headings));
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: normal;
    margin: 20px 30px 20px 60px;
    text-transform: none;
  }

  .npem-banner .npem-banner-subtext {
    font-family: var(--npem-banner-font-body, var(--font-body));
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 1300px) {
    .npem-banner .npem-banner-content {
      display: flex;
      flex-direction: column;
    }

    .npem-banner .npem-banner-bar {
      bottom: auto;
      margin: 0 auto 20px;
      order: -1;
      padding: 20px;
      position: static;
      text-align: center;
      transform: none;
    }

    .npem-banner .npem-banner-special-badge {
      display: flex;
      justify-content: center;
      left: auto;
      margin: 0 auto 0.75rem;
      position: static;
      top: auto;
      width: 100%;
    }

    .npem-banner .npem-banner-bar-inner {
      margin: 0;
      max-width: none;
    }

    .npem-banner .npem-banner-bar h2 {
      margin: 0;
    }
  }

  @media (max-width: 768px) {
    .npem-banner .npem-banner-figure {
      margin-top: 12.5rem;
    }

    .npem-banner .npem-banner-badge {
      right: 50%;
      top: -160px;
      transform: translateX(50%);
    }

    .npem-banner .npem-banner-figure :global(img) {
      margin: 0 auto;
      max-width: 100%;
    }

    .npem-banner .npem-banner-figure figcaption {
      bottom: 5px;
      left: 5%;
    }

    .npem-banner .npem-banner-bar {
      border-radius: 0;
    }

    .npem-banner .npem-banner-bar h2 {
      font-size: 1.9375rem;
    }
  }
</style>
