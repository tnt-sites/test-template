---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";

interface ListItemImage {
  source?: string;
  alt?: string;
}

interface ListItem {
  headingPrefix?: string;
  headingMain?: string;
  listText?: string;
  alt?: string;
  desktopImage?: string | ListItemImage;
  mobileImage?: string | ListItemImage;
}

const {
  backgroundColor = "base",
  backgroundColorHex = "",
  headingColor = "#fff",
  listTextColor = "#fff",
  checkmarkColor = "#ddca52",
  items = [],
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  headingColor ? `--npem-list-heading-color: ${headingColor}` : "",
  listTextColor ? `--npem-list-text-color: ${listTextColor}` : "",
  checkmarkColor ? `--npem-list-check-color: ${checkmarkColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
function normalizeImage(value: string | ListItemImage | undefined, fallbackAlt = "") {
  if (typeof value === "string") {
    return { source: value, alt: fallbackAlt };
  }

  return {
    source: value?.source ?? "",
    alt: value?.alt ?? fallbackAlt,
  };
}

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  id="lists"
  class:list={["list-section", className]}
  maxContentWidth="none"
  paddingVertical="none"
  paddingHorizontal="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  {
    items.map((item: ListItem, index: number) => {
      const isOdd = index % 2 === 1;
      const desktop = normalizeImage(item.desktopImage, item.alt ?? "");
      const mobile = normalizeImage(item.mobileImage, desktop.alt);
      const desktopSource = desktop.source;
      const desktopAlt = desktop.alt;
      const mobileSource = mobile.source || desktopSource;
      const mobileAlt = mobile.alt || desktopAlt;

      return (
        <section class:list={["lists", isOdd && "odd"]}>
          <div class="flex-ed">
            {
              <div class="personalized">
                <h2>
                  <span>{item.headingPrefix}</span> {item.headingMain}
                </h2>
                <div class="list">
                  <Text
                    editable={false}
                    text={item.listText}
                    data-prop={`items.${index}.listText`}
                  />
                </div>
              </div>
            }

            <div class="image">
              <Image
                source={desktopSource}
                class="desktop-image"
                alt={desktopAlt}
                rounded={false}
                editable={false}
                aspectRatio="none"
                sizes="auto"
                data-prop-src={`items.${index}.desktopImage.source`}
                data-prop-alt={`items.${index}.desktopImage.alt`}
              />
              <Image
                source={mobileSource}
                class="mobile-image"
                alt={mobileAlt}
                rounded={false}
                editable={false}
                aspectRatio="none"
                sizes="auto"
                data-prop-src={`items.${index}.mobileImage.source`}
                data-prop-alt={`items.${index}.mobileImage.alt`}
              />
            </div>
          </div>
        </section>
      );
    })
  }
</CustomSection>

<style>
  .list-section {
    background-color: #54667a;
    box-shadow: 0 3px 6px 0 rgba(0, 0, 0, 0.56);
    padding: 200px 10px 80px;
  }

  .list-section .lists {
    border-bottom: 1px solid #fff;
    margin: 0 auto;
    max-width: 1150px;
    position: relative;
  }

  .list-section .lists:first-of-type {
    border-top: 1px solid #fff;
  }

  .list-section .lists .flex-ed {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
  }

  .list-section .lists .image {
    position: relative;
  }

  .list-section .lists.odd .image {
    order: -1;
  }

  .list-section .lists .image :global(img) {
    box-shadow: 1.6px 2.5px 7px rgba(7, 8, 8, 0.35);
  }

  .list-section .personalized {
    flex: 0 1 544px;
    height: 340px;
    margin: 0;
    max-width: 1040px;
    padding: 40px 0;
    position: relative;
  }

  .list-section .personalized h2 {
    color: var(--npem-list-heading-color, #fff);
    font-family: "Open Sans", serif;
    font-size: clamp(2.2rem, 4vw, 3.125rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    position: relative;
    text-align: center;
  }

  .list-section .personalized h2 span {
    display: block;
    font-family: "Open Sans", sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 5px;
  }

  .list-section .text {
    display: table;
    margin: 20px auto 0;
  }

  /* List text color */
  .list-section .list :global(ul),
  .list-section .list :global(li) {
    color: var(--npem-list-text-color, #fff);
  }

  /* Remove default bullets */
  .list-section .list :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list-section .list :global(li) {
    font-size: 22px;
    margin-bottom: 12px;
    margin-left: 0;
    padding-left: 28px;
    position: relative;
  }

  .list-section .list :global(li::before) {
    color: var(--npem-list-check-color, #ddca52);
    content: "\e832";
    font-family: fontello;
    font-size: 1rem;
    left: 0;
    line-height: inherit;
    position: absolute;
    top: 0;
  }

  .list-section .image {
    flex: 0 1 575px;
  }

  .desktop-image {
    display: block;
  }
  .mobile-image {
    display: none;
  }

  @media (max-width: 1024px) {
    .list-section {
      margin: 0 auto;
      padding: 100px 10px;
    }

    .list-section .lists {
      border: none;
      margin-top: 0;
    }

    .list-section .lists .flex-ed {
      display: block;
      margin-top: 35px;
    }

    .list-section .image {
      margin-top: 20px;
    }

    .list-section .personalized {
      border: 1px solid #fff;
      flex: 0 1 100%;
      height: auto;
      margin: 0 auto;
      padding: 30px 20px 0;
    }

    .list-section .lists.odd .personalized {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .desktop-image {
      display: none;
    }

    .mobile-image {
      display: block;
    }

    .list-section {
      display: block;
      padding-top: 80px;
    }

    .list-section .lists {
      display: block;
      margin: 0 auto;
      padding-top: 20px;
      width: 100%;
    }

    .list-section .lists .image {
      margin: 30px auto;
    }

    .list-section .personalized {
      margin: 30px 20px 0;
      padding: 30px 20px 0;
    }

    .list-section .personalized h2 {
      font-size: 2.25rem;
    }

    .list-section .personalized h2 span {
      font-size: 1.25rem;
    }
  }
</style>
