---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "Invisalign Day",
  preHeading = "Join Us For",
  postHeading = "July 15th",
  coupons = [],
  image = { source: "", alt: "" },
  figcaption = "",
  textPanelBackgroundImage = { source: "", alt: "" },
  sectionBackground = "var(--color-brand)",
  sectionBackgroundHex = "",
  borderBottomColor = "#4f95d0",
  class: className,
  ...rest
} = Astro.props;

const styleVars = [
  `--invis-banner-bg: ${sectionBackgroundHex || sectionBackground}`,
  `--invis-banner-border: ${borderBottomColor}`,
  textPanelBackgroundImage?.source
    ? `--invis-banner-article-bg: url('${textPanelBackgroundImage.source}')`
    : "",
]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["invis-banner", className]}
  paddingVertical="none"
  paddingHorizontal="none"
  backgroundColor="none"
  style={styleVars}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <article>
      <h1>
        {preHeading && <small>{preHeading}</small>}
        {heading}
        {postHeading && <small class="again">{postHeading}</small>}
      </h1>
      {
        Array.isArray(coupons) && coupons.length > 0 && (
          <div class="coupon-row">
            {coupons.map((coupon: any) => (
              <span class="coupon">
                <Image
                  source={coupon?.source}
                  alt={coupon?.alt || ""}
                  rounded={false}
                  editable={true}
                  aspectRatio="none"
                  sizes="auto"
                  widths={[]}
                />
              </span>
            ))}
          </div>
        )
      }
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .invis-banner {
    background: var(--invis-banner-bg, #476682);
    border-bottom: 11px solid var(--invis-banner-border, #4f95d0);
    overflow: hidden;
  }

  .invis-banner :global(.content) {
    max-width: 100%;
    padding: 0;
  }

  .invis-banner .flex-ed {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    margin: 0 auto;
    max-width: 1920px;
    width: 100%;
  }

  .invis-banner article {
    background-image: var(--invis-banner-article-bg, none);
    background-size: cover;
    flex: 1 1 auto;
    padding: 30px 10px;
    text-align: center;
  }

  .invis-banner h1 {
    color: #fff;
    font-family: the-seasons, var(--font-headings);
    font-size: 103px;
    font-weight: 400;
    letter-spacing: 0.05em;
    line-height: 1.1;
    margin: 20px auto;
  }

  .invis-banner h1 small {
    color: #fff;
    display: block;
    font-family: josefin-sans, var(--font-body);
    font-size: 28px;
    letter-spacing: 2.8px;
    text-transform: uppercase;
  }

  .invis-banner h1 .again {
    font-size: 37px;
    letter-spacing: 0;
    text-transform: none;
  }

  .invis-banner .coupon-row {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
  }

  .invis-banner figure {
    flex: 0 1 auto;
    position: relative;
  }

  .invis-banner figure :global(img) {
    margin-left: 0;
  }

  .invis-banner figcaption {
    background: rgba(255, 255, 255, 0.8);
    bottom: 0;
    color: #000;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.15em;
    max-width: 614px;
    padding: 6px 15px;
    position: absolute;
    text-transform: uppercase;
    width: 100%;
  }

  @media (max-width: 1000px) {
    .invis-banner .flex-ed {
      flex-wrap: wrap;
    }

    .invis-banner article {
      flex: 0 1 100%;
    }
  }

  @media (max-width: 880px) {
    .invis-banner h1 {
      font-size: 50px;
      margin-top: 40px;
    }
  }

  @media (max-width: 590px) {
    .invis-banner h1 {
      font-size: 70px;
      line-height: 1.1;
    }

    .invis-banner h1 small {
      font-size: 47px;
    }
  }
</style>
