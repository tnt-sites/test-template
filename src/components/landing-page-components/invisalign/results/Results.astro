---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "Real Results. Real Smiles.",
  images = [],
  backgroundColor = "",
  backgroundColorHex = "var(--color-brand)",
  textColor = "#ffffff",
  class: className,
  ...rest
} = Astro.props;

const resolvedBackground = backgroundColorHex || backgroundColor;

const styleVars = [
  `--invis-results-bg: ${resolvedBackground}`,
  `--invis-results-text: ${textColor}`,
].join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["invis-results", className]}
  paddingVertical="none"
  paddingHorizontal="md"
  backgroundColor="none"
  style={styleVars}
  {...htmlAttributes}
>
  {heading && <h2>{heading}</h2>}
  <div class="flex">
    {
      (Array.isArray(images) ? images : []).map((item: any, index: number) => (
        <div class="result-image">
          <Image
            source={item?.source}
            alt={item?.alt || ""}
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            widths={[]}
            data-prop-src={`images.${index}.source`}
            data-prop-alt={`images.${index}.alt`}
          />
        </div>
      ))
    }
  </div>
</CustomSection>

<style>
  .invis-results {
    background: var(--invis-results-bg, #4f95d0);
    margin: 100px auto;
    max-width: 1260px;
    padding: 100px 20px;
    text-align: center;
  }

  .invis-results h2 {
    color: var(--invis-results-text, #fff);
    font-family: the-seasons, var(--font-headings);
    font-size: 55px;
    margin-top: 0;
    text-align: center;
  }

  .invis-results .flex {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: space-around;
    margin: 0 auto;
    max-width: 1000px;
  }
</style>
