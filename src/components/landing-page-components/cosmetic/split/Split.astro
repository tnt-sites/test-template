---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "",
  paragraphs = [] as string[],
  image = { source: "", alt: "" },
  figcaption = "",
  buttonSections = [],
  reverse = false,
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--cos-accent-color: ${accentColor}` : "",
  headingColor ? `--cos-heading-color: ${headingColor}` : "",
  fontHeadings ? `--cos-font-headings: ${fontHeadings}` : "",
  fontBody ? `--cos-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["cos-split", reverse ? "cos-split--reverse" : "", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="split-inner">
    <article>
      {heading && <h2 set:html={heading} />}
      {paragraphs.map((para: string) => <p set:html={para} />)}
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure>
      {
        image?.source && (
          <Image
            source={image.source}
            alt={image.alt || ""}
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            widths={[]}
            data-prop-src="image.source"
            data-prop-alt="image.alt"
          />
        )
      }
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .cos-split .split-inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: center;
    margin: auto;
    max-width: 1100px;
  }

  /* ── Article ─────────────────────────────────────────────────────────────── */
  .cos-split article {
    flex: 0 1 480px;
    min-width: 260px;
    order: 1;
    text-align: left;
  }

  .cos-split.cos-split--reverse article {
    order: 2;
  }

  .cos-split article h2 {
    color: var(--cos-heading-color, var(--color-heading, #0f0d0d));
    font-family: var(--cos-font-headings, var(--font-headings));
    font-size: clamp(2rem, 4vw, 3.125rem);
    font-weight: 300;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    text-transform: uppercase;
  }

  .cos-split article h2 :global(span) {
    color: var(--cos-accent-color, var(--color-brand, #af8c57));
  }

  .cos-split article p {
    font-family: var(--cos-font-body, var(--font-body));
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  /* ── Figure ──────────────────────────────────────────────────────────────── */
  .cos-split figure {
    flex: 0 1 460px;
    min-width: 240px;
    order: 2;
    position: relative;
  }

  .cos-split.cos-split--reverse figure {
    order: 1;
  }

  .cos-split figure :global(img) {
    display: block;
    width: 100%;
  }

  .cos-split figcaption {
    background: rgba(0, 0, 0, 0.55);
    bottom: 0;
    color: #fff;
    font-size: 0.85rem;
    left: 0;
    padding: 0.4rem 0.75rem;
    position: absolute;
    right: 0;
    text-align: center;
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .cos-split article,
    .cos-split figure {
      flex: none;
      order: unset;
      width: 100%;
    }

    .cos-split article {
      text-align: center;
    }
  }
</style>
