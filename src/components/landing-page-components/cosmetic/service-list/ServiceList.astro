---
import CustomSection from "@builders/custom-section/CustomSection.astro";

interface ServiceItem {
  label: string;
  url: string;
}

const {
  services = [] as ServiceItem[],
  accentColor = "",
  backgroundColor = "accent",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  `--cos-accent-color: ${accentColor || "#af8c57"}`,
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  id="cosmetic-list"
  class:list={["cos-service-list", className]}
  paddingVertical="md"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle}
  {...htmlAttributes}
>
  <div class="list-inner">
    {
      services.map((service: ServiceItem, i: number) => (
        <>
          <a href={service.url} target="_blank" rel="noopener">
            {service.label}
          </a>

          {i < services.length - 1 && (
            <span class="sep" aria-hidden="true">
              •
            </span>
          )}
        </>
      ))
    }
  </div>
</CustomSection>

<style>
  #cosmetic-list {
    background-color: #2f3030;
  }

  .cos-service-list {
    padding: 2rem 1rem;
  }

  .cos-service-list .list-inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  /* links */
  .cos-service-list a {
    color: #fff;
    font:
      normal 20px figtree,
      serif;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .cos-service-list a:hover {
    color: var(--cos-accent-color, #af8c57);
  }

  /* separator */
  .cos-service-list .sep {
    color: var(--cos-accent-color, #af8c57);
    font-size: 2rem;
    line-height: 1;
  }
</style>
