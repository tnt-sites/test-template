---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  heading = "Patients Love Us",
  reviewText = "",
  author = "",
  sliderHeading = "Actual Patient Results",
  sliderSubheading = "Before & After",
  beforeImage = { source: "", alt: "Before" },
  afterImage = { source: "", alt: "After" },
  starColor = "#fcd800",
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  handleColor = "",
  handleArrowColor = "",
  fontHeadings = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const resolveColorValue = (value: unknown): string => {
  if (typeof value !== "string") return "";
  const normalized = value.trim();
  if (!normalized) return "";

  const tokenMap: Record<string, string> = {
    brand: "var(--color-brand)",
    "brand-secondary": "var(--color-brand-secondary)",
    accent: "var(--color-bg-accent)",
    highlight: "var(--color-bg-highlight)",
    base: "var(--color-bg-base)",
    surface: "var(--color-bg-surface)",
    dark: "var(--color-bg-dark)",
    black: "#000",
    white: "var(--color-text-inverse)",
    none: "transparent",
  };

  return tokenMap[normalized] ?? normalized;
};

const resolvedHandleColor = resolveColorValue(handleColor);
const resolvedHandleArrowColor = resolveColorValue(handleArrowColor);

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--cos-accent-color: ${accentColor}` : "",
  headingColor ? `--cos-heading-color: ${headingColor}` : "",
  fontHeadings ? `--cos-font-headings: ${fontHeadings}` : "",
  starColor ? `--cos-star-color: ${starColor}` : "",
  resolvedHandleColor ? `--cos-handle-color: ${resolvedHandleColor}` : "",
  resolvedHandleArrowColor ? `--cos-handle-arrow-color: ${resolvedHandleArrowColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const safeButtonSections = Array.isArray(buttonSections) ? buttonSections : [];

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  id="cos-reviews"
  class:list={["cos-reviews", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <!-- Review quote column -->
    <div class="review-col">
      {heading && <h2 set:html={heading} />}
      <div class="stars" aria-label="5 stars">★★★★★</div>
      {reviewText && <p class="comment">&ldquo;{reviewText}&rdquo;</p>}
      {author && <p class="author">– {author}</p>}
      {safeButtonSections.length > 0 && <ButtonGroup buttonSections={safeButtonSections} />}
    </div>

    <!-- Before/After slider column -->
    <div class="slider-col">
      {
        (sliderHeading || sliderSubheading) && (
          <h2 class="slider-title">
            {sliderHeading && <span class="slider-label">{sliderHeading}</span>}
            {sliderSubheading && <Fragment set:html={sliderSubheading} />}
          </h2>
        )
      }
      <div class="ba-wrapper" aria-label="Before and after comparison slider">
        <div class="ba-images" id="cos-ba-images">
          {
            afterImage?.source && (
              <Image
                source={afterImage.source}
                alt={afterImage.alt || "After"}
                rounded={false}
                editable={true}
                aspectRatio="none"
                sizes="auto"
                widths={[]}
                class="ba-after"
                data-prop-src="afterImage.source"
                data-prop-alt="afterImage.alt"
              />
            )
          }
          {
            beforeImage?.source && (
              <div class="ba-before-clip" id="cos-ba-clip" style="--before-pct:50%">
                <Image
                  source={beforeImage.source}
                  alt={beforeImage.alt || "Before"}
                  rounded={false}
                  editable={true}
                  aspectRatio="none"
                  sizes="auto"
                  widths={[]}
                  class="ba-before"
                  data-prop-src="beforeImage.source"
                  data-prop-alt="beforeImage.alt"
                />
              </div>
            )
          }
          <div
            class="ba-handle"
            id="cos-ba-handle"
            role="slider"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            aria-label="Before/After divider"
            tabindex="0"
          >
            <div class="ba-handle-icon">
              <span class="ba-arrow ba-arrow--left" aria-hidden="true">&#9668;</span>
              <span class="ba-arrow ba-arrow--right" aria-hidden="true">&#9658;</span>
            </div>
          </div>
        </div>
        <input
          type="range"
          class="ba-range"
          min="0"
          max="100"
          value="50"
          aria-label="Slide to compare before and after"
        />
      </div>
    </div>
  </div>
</CustomSection>

<style>
  .cos-reviews .flex-ed {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: center;
    margin: auto;
    max-width: 1300px;
  }

  /* ── Review column ───────────────────────────────────────────────────────── */
  .cos-reviews .review-col {
    flex: 0 1 600px;
    text-align: left;
  }

  .cos-reviews .review-col h2 {
    color: var(--cos-heading-color, var(--color-heading, #0f0d0d));
    font-family: var(--cos-font-headings, var(--font-headings));
    font-size: clamp(2rem, 4vw, 3.125rem);
    font-weight: 300;
    line-height: 1.1;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .cos-reviews .stars {
    color: var(--cos-star-color, #fcd800);
    font-size: 1.6rem;
    letter-spacing: 0.15em;
    margin: 0 0 0.75rem;
  }

  .cos-reviews .comment {
    font-size: 28px;
    margin: 0 0 0.75rem;
  }

  .cos-reviews .author {
    color: var(--cos-accent-color, var(--color-brand, #af8c57));
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0 0 1.25rem;
    text-transform: uppercase;
  }

  /* ── Slider column ───────────────────────────────────────────────────────── */
  .cos-reviews .slider-col {
    flex: 0 1 480px;
    min-width: 280px;
    text-align: center;
  }

  .cos-reviews .slider-title {
    color: var(--cos-heading-color, var(--color-heading, #0f0d0d));
    font-family: var(--cos-font-headings, var(--font-headings));
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    line-height: 1.2;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .cos-reviews .slider-label {
    color: var(--cos-accent-color, var(--color-brand, #af8c57));
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* ── Before/After wrapper ────────────────────────────────────────────────── */
  .cos-reviews .ba-wrapper {
    position: relative;
    user-select: none;
  }

  .cos-reviews .ba-images {
    overflow: visible;
    position: relative;
  }

  .cos-reviews .ba-after :global(img),
  .cos-reviews .ba-before :global(img) {
    display: block;
    height: auto;
    pointer-events: none;
    width: 100%;
  }

  .cos-reviews .ba-after {
    overflow: hidden;
  }

  .cos-reviews .ba-before-clip {
    clip-path: inset(0 calc(100% - var(--before-pct, 50%)) 0 0);
    height: 100%;
    left: 0;
    overflow: hidden;
    position: absolute;
    top: 0;
    width: 100%;
  }

  .cos-reviews .ba-before-clip :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  /* ── Drag handle ─────────────────────────────────────────────────────────── */
  .cos-reviews .ba-handle {
    align-items: center;
    bottom: 0;
    cursor: ew-resize;
    cursor: pointer;
    display: flex;
    height: 100%;
    justify-content: center;
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 3px;
    z-index: 10;
  }

  .cos-reviews .ba-handle::before {
    background: var(--cos-handle-color, var(--cos-accent-color, var(--color-brand, #af8c57)));
    bottom: 0;
    content: "";
    left: 50%;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 2px;
  }

  .cos-reviews .ba-handle-icon {
    align-items: center;
    background: var(--cos-handle-color, var(--cos-accent-color, var(--color-brand, #af8c57)));
    border-radius: 0 0 999px 999px;
    bottom: -1.5rem;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.4);
    display: flex;
    gap: 0.25rem;
    height: 1.5rem;
    justify-content: center;
    position: absolute;
    width: 2.5rem;
    z-index: 11;
  }

  .cos-reviews .ba-arrow {
    color: var(--cos-handle-arrow-color, var(--cos-accent-color, var(--color-brand, #af8c57)));
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    margin-top: 0.15rem;
    min-width: 0.5rem;
    text-align: center;
  }

  /* ── Range input (invisible, overlaid for interaction) ───────────────────── */
  .cos-reviews .ba-range {
    appearance: none;
    bottom: -1.5rem;
    cursor: ew-resize;
    height: calc(100% + 1.5rem);
    left: 0;
    margin: 0;
    opacity: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 20;
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 700px) {
    .cos-reviews .flex-ed {
      flex-direction: column;
    }

    .cos-reviews .review-col,
    .cos-reviews .slider-col {
      flex: none;
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".cos-reviews .ba-wrapper").forEach((wrapper) => {
    const clip = wrapper.querySelector<HTMLElement>("#cos-ba-clip, .ba-before-clip");
    const handle = wrapper.querySelector<HTMLElement>("#cos-ba-handle, .ba-handle");
    const range = wrapper.querySelector<HTMLInputElement>(".ba-range");
    if (!clip || !handle || !range) return;

    const update = (pct: number) => {
      const clamped = Math.min(100, Math.max(0, pct));
      clip.style.setProperty("--before-pct", `${clamped}%`);
      handle.style.left = `${clamped}%`;
      handle.setAttribute("aria-valuenow", String(Math.round(clamped)));
      range.value = String(Math.round(clamped));
    };

    range.addEventListener("input", () => update(Number(range.value)));

    // Keyboard support on the handle
    handle.addEventListener("keydown", (e: KeyboardEvent) => {
      const current = Number(range.value);
      if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
        e.preventDefault();
        update(current - 1);
      } else if (e.key === "ArrowRight" || e.key === "ArrowUp") {
        e.preventDefault();
        update(current + 1);
      }
    });

    // Initialize
    update(50);
  });
</script>
