---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Form from "@forms/form/Form.astro";

const {
  heading = "Request a FREE Smile Makeover <span>Consultation</span>",
  formAction = "",
  formBlocks = [],
  accentColor = "",
  headingColor = "",
  fontHeadings = "",
  backgroundColor = "surface",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--cos-accent-color: ${accentColor}` : "",
  headingColor ? `--cos-heading-color: ${headingColor}` : "",
  fontHeadings ? `--cos-font-headings: ${fontHeadings}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["cos-consultation", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-row-responsive">
    <article>
      {heading && <h2 set:html={heading} />}
    </article>

    <div class="form-container">
      <Form class="cos-form" action={formAction} formBlocks={formBlocks} editable={false} />
    </div>
  </div>
</CustomSection>

<style lang="pcss" is:global>
  /* Layout */

  .cos-consultation .flex-row-responsive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3rem;
    justify-content: center;
    margin: 0 auto;
    max-width: 1300px;
  }

  /* Heading */

  .cos-consultation article {
    flex: 0 1 400px;
  }

  .cos-consultation article h2 {
    color: var(--cos-heading-color, #fff);
    font-family: var(--cos-font-headings, var(--font-headings));
    font-size: clamp(2.5rem, 5vw, 55px);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.1;
    margin: 0;
    text-align: left;
    text-transform: uppercase;
  }

  .cos-consultation article h2 :global(span) {
    color: var(--cos-accent-color, #af8c57);
    display: block;
  }

  /* Form Container */

  .cos-consultation .form-container {
    flex: 1 1 650px;
    padding: 1.5rem;
  }

  /* Form Layout */

  .cos-consultation editable-array,
  .cos-consultation editable-array-item {
    display: contents;
  }

  .cos-consultation .cos-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .cos-consultation .cos-form .input,
  .cos-consultation .cos-form .textarea,
  .cos-consultation .cos-form .submit {
    margin: 0;
  }

  .cos-consultation .cos-form .input:nth-child(1) {
    grid-column: 1;
    grid-row: 1;
  }

  .cos-consultation .cos-form .input:nth-child(2) {
    grid-column: 1;
    grid-row: 2;
  }

  .cos-consultation .cos-form .input:nth-child(3) {
    grid-column: 1;
    grid-row: 3;
  }

  .cos-consultation .cos-form .textarea:nth-child(4) {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .cos-consultation .cos-form .submit:nth-child(5) {
    grid-column: 2;
    grid-row: 3;
  }

  /* Labels */

  .cos-consultation .cos-form .label {
    color: var(--cos-heading-color, #fff);
  }

  /* Inputs */

  .cos-consultation .cos-form .field {
    width: 100%;
    background: #efefef;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    box-shadow: none;
    color: #000;
    font-size: 1rem;
  }

  .cos-consultation .cos-form input.field {
    height: 44px;
    padding: 0 1rem;
    border-radius: 0;
  }

  .cos-consultation .cos-form textarea.field {
    height: 145px;
    padding: 0.75rem 1rem;
    resize: vertical;
        border-radius: 0;
  }

  .cos-consultation .cos-form .field::placeholder {
    color: #000;
  }

  .cos-consultation .cos-form .field:focus {
    outline: 2px solid
      var(--cos-accent-color, var(--color-brand, #af8c57));
    outline-offset: 0;
  }

  /* Button */

  .cos-consultation .cos-form button,
  .cos-consultation .cos-form .submit {
    width: 100%;
    height: 44px;
    margin-top: auto;
    border-radius: 0;
  }

  /* Mobile */

  @media (max-width: 768px) {
    .cos-consultation .flex-row-responsive {
      flex-direction: column;
      gap: 2rem;
    }

    .cos-consultation article {
      flex: none;
      width: 100%;
    }

    .cos-consultation article h2 {
      font-size: 2.25rem;
      text-align: center;
    }

    .cos-consultation .form-container {
      width: 100%;
      padding: 1.25rem;
    }

    .cos-consultation .cos-form {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .cos-consultation .cos-form .input,
    .cos-consultation .cos-form .textarea,
    .cos-consultation .cos-form .submit {
      grid-column: auto !important;
      grid-row: auto !important;
    }

    .cos-consultation .cos-form textarea.field {
      height: 120px;
    }
  }
</style>
