---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  reviewText = "",
  author = "",
  googleLogoImage = { source: "", alt: "Google Reviews" },
  backgroundImage = { source: "", alt: "" },
  starColor = "",
  bracketColor = "",
  googlePanelColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  starColor ? `--cou-star-color: ${starColor}` : "",
  bracketColor ? `--cou-bracket-color: ${bracketColor}` : "",
  googlePanelColor ? `--cou-google-panel-color: ${googlePanelColor}` : "",
  fontHeadings ? `--cou-font-headings: ${fontHeadings}` : "",
  fontBody ? `--cou-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["cou-reviews", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  backgroundImage={backgroundImage}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <!--
    .alt-box provides the decorative corner bracket borders.
    Real <span> elements are used for the squares so their z-index
    sits cleanly below the card without conflicting with ::before/::after.
  -->
  <div class="alt-box">
    <div class="review-card">
      <div class="google-panel">
        <div class="stars" aria-label="5 stars">★★★★★</div>
        {
          googleLogoImage?.source && (
            <Image
              source={googleLogoImage.source}
              alt={googleLogoImage.alt || "Google Reviews"}
              rounded={false}
              editable={true}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
              data-prop-src="googleLogoImage.source"
              data-prop-alt="googleLogoImage.alt"
            />
          )
        }
        <p class="google-label">
          Actual&nbsp;<span class="google-word">Google</span>&nbsp;Review
        </p>
      </div>
      <div class="comment">
        <p class="quote">&ldquo;{reviewText}&rdquo;</p>
        <p class="attribution">- {author}</p>
      </div>
    </div>
  </div>
</CustomSection>

<style>
  .cou-reviews {
    background-size: cover;
  }

  /* ── Outer bracket box ────────────────────────────────────────────────────── */
  .cou-reviews .alt-box {
    margin: 0 auto;
    max-width: 1120px;
    position: relative;
    width: 100%;
  }

  /* Top bracket (three sides) */
  .cou-reviews .alt-box::before {
    border-left: 5px solid var(--cou-bracket-color, var(--color-brand-secondary));
    border-right: 5px solid var(--cou-bracket-color, var(--color-brand-secondary));
    border-top: 5px solid var(--cou-bracket-color, var(--color-brand-secondary));
    content: "";
    height: 20px;
    left: -7px;
    position: absolute;
    right: -7px;
    top: -7px;
    z-index: 5;
  }

  /* Bottom bracket (three sides) */
  .cou-reviews .alt-box::after {
    border-bottom: 5px solid var(--cou-bracket-color, var(--color-brand-secondary));
    border-left: 5px solid var(--cou-bracket-color, var(--color-brand-secondary));
    border-right: 5px solid var(--cou-bracket-color, var(--color-brand-secondary));
    bottom: -7px;
    content: "";
    height: 20px;
    left: -7px;
    position: absolute;
    right: -7px;
    z-index: 5;
  }

  /* ── Review card ─────────────────────────────────────────────────────────── */
  .cou-reviews .review-card {
    align-items: center;
    background: var(--color-bg);
    box-shadow: 1.6px 2.5px 7px rgba(7, 8, 8, 0.15);
    display: flex;
    flex-wrap: nowrap;
    margin: 0 auto;
  }

  /* ── Google panel (left) ─────────────────────────────────────────────────── */
  .cou-reviews .google-panel {
    align-items: center;
    align-self: stretch;
    background: var(--cou-google-panel-color, rgba(203, 116, 40, 0.06));
    border-radius: 8px 0 0 8px;
    display: flex;
    flex: 0 1 225px;
    flex-direction: column;
    justify-content: center;
    padding: 1.5625rem 1.5rem;
    text-align: center;
  }

  .cou-reviews .stars {
    color: var(--cou-star-color, var(--color-star, #febb21));
    font-size: 1.75rem;
    letter-spacing: 0.2em;
  }

  .cou-reviews .google-panel :global(img) {
    margin: 0.9375rem auto;
    max-width: 120px;
  }

  .cou-reviews .google-label {
    color: var(--color-text);
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    line-height: 1.25;
    margin: 0;
    text-transform: uppercase;
  }

  .cou-reviews .google-word {
    color: inherit;
  }

  /* ── Quote (right) ───────────────────────────────────────────────────────── */
  .cou-reviews .comment {
    flex: 1 1 900px;
    padding: 1.875rem 3.125rem 2.5rem;
    text-align: left;
  }

  .cou-reviews .quote {
    color: var(--color-text);
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.2;
    margin: 0 0 0.625rem;
  }

  .cou-reviews .attribution {
    color: var(--color-text-muted);
    float: right;
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    margin: 0.3125rem 0 0;
    text-transform: uppercase;
  }

  /* ── Responsive ───────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .cou-reviews .review-card {
      flex-wrap: wrap;
    }

    .cou-reviews .google-panel {
      border-radius: 8px 8px 0 0;
      flex: 0 0 100%;
      flex-direction: row;
      gap: 1.5rem;
    }

    .cou-reviews .comment {
      padding: 1.5rem 1.25rem;
    }

    .cou-reviews .quote {
      font-size: 1.75rem;
    }

    .cou-reviews .attribution {
      float: none;
    }
  }
</style>
