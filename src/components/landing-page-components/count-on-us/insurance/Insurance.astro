---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";

const {
  blocks = [],
  ruleColor = "",
  headingColor = "",
  headingFontFamily = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  ruleColor ? `--cou-rule-color: ${ruleColor}` : "",
  headingColor ? `--cou-heading-color: ${headingColor}` : "",
  fontHeadings ? `--cou-font-headings: ${fontHeadings}` : "",
  fontBody ? `--cou-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["cou-insurance", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  {
    blocks.map((block: { heading: string; text: string }, i: number) => (
      <div class="block">
        <Heading
          text={block.heading}
          level="h2"
          fontFamily={headingFontFamily}
          data-prop={`$.blocks[${i}].heading`}
          editable={true}
        />
        <p set:html={block.text} />
      </div>
    ))
  }
</CustomSection>

<style>
  .cou-insurance {
    text-align: center;
  }

  .cou-insurance .block {
    margin: 0 auto;
    max-width: 1190px;
    padding: 0.625rem 1.25rem;
    text-align: center;
  }

  .cou-insurance .block + .block {
    margin-top: 2rem;
  }

  /*
   * Heading with horizontal ruled lines on either side.
   * display:flex + ::before/::after flex children create the
   * classic "line — heading — line" layout from the legacy design.
   */
  .cou-insurance h2 {
    align-items: center;
    color: var(--cou-heading-color, var(--color-text));
    display: flex;
    font-family: var(--cou-font-headings, var(--font-headings));
    font-size: 3.4375rem;
    font-weight: 300;
    justify-content: center;
    letter-spacing: normal;
    line-height: 1.1;
    margin: 0.625rem auto -0.9375rem;
    padding: 0.625rem 1.25rem 0.9375rem;
    text-align: center;
  }

  .cou-insurance h2::before,
  .cou-insurance h2::after {
    background-color: var(--cou-rule-color, var(--color-border));
    content: "";
    flex: 1;
    height: 2px;
  }

  .cou-insurance h2::before {
    margin-right: 1.25rem;
  }

  .cou-insurance h2::after {
    margin-left: 1.25rem;
  }

  .cou-insurance p {
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 1.25rem;
    line-height: 1.75;
    margin: 0.625rem auto;
    max-width: 1150px;
    padding: 0.625rem;
  }

  @media (max-width: 1024px) {
    .cou-insurance h2 {
      font-size: 2.5rem;
    }
  }
</style>
