---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";

const {
  headingPrefix = "",
  heading = "",
  headingFontFamily = "",
  listItems = [],
  image = { source: "", alt: "" },
  figcaption = "",
  reverse = false,
  accentColor = "",
  squareColor = "",
  headingColor = "",
  prefixColor = "",
  fontHeadings = "",
  fontBody = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  accentColor ? `--cou-accent-color: ${accentColor}` : "",
  squareColor ? `--cou-square-color: ${squareColor}` : "",
  headingColor ? `--cou-heading-color: ${headingColor}` : "",
  prefixColor ? `--cou-prefix-color: ${prefixColor}` : "",
  fontHeadings ? `--cou-font-headings: ${fontHeadings}` : "",
  fontBody ? `--cou-font-body: ${fontBody}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["cou-split", reverse && "alt", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="inner">
    <!--
      Decorative squares sit at z-index: 0 behind the card (z-index: 1).
      Using real elements instead of pseudo-elements avoids z-index conflicts
      with the card's box-shadow.
    -->
    <span class="sq sq-tl" aria-hidden="true"></span>
    <span class="sq sq-br" aria-hidden="true"></span>

    <div class="card">
      <article>
        <div class="content">
          {headingPrefix && <small class="prefix">{headingPrefix}</small>}
          <Heading
            text={heading}
            level="h2"
            fontFamily={headingFontFamily}
            data-prop="heading"
            editable={true}
          />
          {
            listItems.length > 0 && (
              <ul>
                {listItems.map((item: string) => (
                  <li set:html={item} />
                ))}
              </ul>
            )
          }
        </div>
      </article>
      <figure>
        <Image
          source={image.source}
          alt={image.alt}
          rounded={false}
          editable={true}
          aspectRatio="none"
          sizes="auto"
          data-prop-src="image.source"
          data-prop-alt="image.alt"
        />
        {figcaption && <figcaption>{figcaption}</figcaption>}
      </figure>
    </div>
  </div>
</CustomSection>

<style>
  .cou-split {
    overflow: hidden;
  }

  /* ── Outer wrapper (for decorative squares) ─────────────────────────────── */
  .cou-split .inner {
    margin: 0 auto;
    max-width: 1100px;
    position: relative;
    width: 100%;
  }

  /* ── Decorative corner squares ───────────────────────────────────────────── */
  .cou-split .sq {
    background: var(--cou-square-color, var(--color-bg-surface));
    display: block;
    height: 345px;
    position: absolute;
    width: 420px;
    z-index: 0;
  }

  .cou-split .sq-tl {
    left: -40px;
    top: -80px;
  }

  .cou-split .sq-br {
    bottom: -80px;
    right: -40px;
  }

  /* ── Card ────────────────────────────────────────────────────────────────── */
  .cou-split .card {
    align-items: stretch;
    background: var(--color-bg);
    box-shadow: 5px 4px 13px 5px rgba(1, 1, 1, 0.16);
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    margin: 3.125rem auto;
    position: relative;
    z-index: 1;
  }

  /* ── Alt: image on left ──────────────────────────────────────────────────── */
  .cou-split.alt .card figure {
    order: -1;
  }

  /* ── Article ─────────────────────────────────────────────────────────────── */
  .cou-split article {
    display: flex;
    flex: 0 1 630px;
    flex-direction: column;
    justify-content: center;
    margin: 0.625rem auto;
    padding: 1.5625rem 1.25rem 1.25rem 2.5rem;
    text-align: left;
  }

  .cou-split .prefix {
    color: var(--cou-prefix-color, var(--cou-heading-color, var(--color-text-muted)));
    display: block;
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.625rem;
  }

  .cou-split h2 {
    color: var(--cou-heading-color, var(--color-text));
    font-family: var(--cou-font-headings, var(--font-headings));
    font-size: 3.4375rem;
    font-weight: 300;
    letter-spacing: normal;
    line-height: 1;
    margin: 0.3125rem auto 0.9375rem;
    text-align: left;
  }

  /* ── List ─────────────────────────────────────────────────────────────────── */
  .cou-split ul {
    list-style-type: none;
    padding: 0;
    text-align: left;
  }

  .cou-split ul li {
    color: var(--color-text);
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 1.875rem;
    line-height: 1.1;
    margin: 1.25rem auto;
    padding-left: 2.1875rem;
    position: relative;
  }

  .cou-split ul li::before {
    color: var(--cou-accent-color, var(--color-brand));
    content: "+";
    font-family: var(--cou-font-body, var(--font-body));
    font-size: 1.875rem;
    left: 0;
    position: absolute;
    top: 0.1875rem;
  }

  /* ── Figure ───────────────────────────────────────────────────────────────── */
  .cou-split figure {
    align-self: center;
    flex: 0 1 420px;
    max-width: 420px;
    position: relative;
    width: 100%;
  }

  .cou-split figure .image {
    margin-top: 0;
  }

  .cou-split figure :global(img) {
    width: 100%;
  }

  .cou-split figcaption {
    background: rgba(255, 255, 255, 0.9);
    bottom: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    left: 0;
    letter-spacing: 0.15em;
    padding: 0.625rem;
    position: absolute;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }

  /* ── Responsive ───────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .cou-split .card {
      flex-wrap: wrap;
    }

    .cou-split.alt .card figure {
      order: unset;
    }

    .cou-split figure {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .cou-split figure :global(img) {
      max-width: 700px;
      width: 100%;
    }

    .cou-split article {
      padding: 1.5625rem 1.25rem;
      text-align: center;
    }

    .cou-split h2 {
      font-size: 2.8125rem;
      text-align: center;
    }

    .cou-split ul {
      display: table;
      margin: auto;
    }
  }
</style>
