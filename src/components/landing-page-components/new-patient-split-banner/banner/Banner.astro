---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Text from "@components/building-blocks/core-elements/text/Text.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  subheading = "",
  heading = "",
  text = "",
  textBackgroundImage = { source: "", alt: "" },
  badgeImage = { source: "", alt: "" },
  image = { source: "", alt: "" },
  figcaption = "",
  buttonSections = [],
  fontHeadings = "",
  fontBody = "",
  borderColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const fontStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  fontHeadings ? `--np-font-headings: ${fontHeadings}` : "",
  fontBody ? `--np-font-body: ${fontBody}` : "",
  borderColor ? `--np-border-color: ${borderColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const articleStyle = textBackgroundImage?.source
  ? `--np-text-bg-image: url('${textBackgroundImage.source}')`
  : "";

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["np-banner", className]}
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={fontStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed">
    <article style={articleStyle || undefined}>
      <h1>
        {subheading && <small>{subheading}</small>}
        <span set:html={heading} />
      </h1>
      {text && <Text set:html={text} />}
      {
        badgeImage?.source && (
          <Image
            source={badgeImage.source}
            alt={badgeImage.alt}
            class="badge"
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            widths={[]}
            data-prop-src="badgeImage.source"
            data-prop-alt="badgeImage.alt"
          />
        )
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .np-banner {
    border-bottom: 6px solid var(--np-border-color, var(--color-brand));
    overflow: hidden;
  }

  .np-banner .flex-ed {
    align-items: stretch;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    margin: auto;
    max-width: 1920px;
  }

  .np-banner article {
    background-image: var(--np-text-bg-image, none);
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    flex: 1 0 580px;
    flex-direction: column;
    justify-content: center;
    order: 1;
    padding: 45px 20px;
    text-align: center;
    z-index: 3;
  }

  .np-banner h1 {
    color: #000;
    font-family: var(--np-font-headings, var(--font-headings));
    font-size: 5.375rem;
    font-weight: 400;
    letter-spacing: 0.175em;
    line-height: 1;
    margin: 0;
  }

  .np-banner h1 small {
    color: #000;
    display: block;
    font-family: var(--np-font-body, var(--font-body));
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .np-banner .badge {
    margin: 1.5rem auto 0;
    max-width: 280px;
  }

  .np-banner figure {
    align-self: stretch;
    flex: 0 1 50%;
    order: 2;
    position: relative;
  }

  .np-banner figure .image {
    height: 100%;
    margin-top: 0;
    width: 100%;
  }

  .np-banner figure :global(img) {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .np-banner figcaption {
    background: rgba(255, 255, 255, 0.9);
    bottom: 0;
    color: #000;
    font-size: 0.9375rem;
    font-weight: 700;
    left: 0;
    letter-spacing: 0.2em;
    padding: 12px 20px;
    position: absolute;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .np-banner .flex-ed {
      display: block;
    }

    .np-banner article {
      padding: 20px;
    }

    .np-banner h1 {
      font-size: 3.875rem;
      margin-top: 20px;
    }

    .np-banner figure {
      width: 100%;
    }

    .np-banner figure :global(img) {
      width: 100%;
    }
  }

  @media (max-width: 590px) {
    .np-banner h1 {
      font-size: 4.375rem;
      line-height: 1.3;
    }
  }
</style>
