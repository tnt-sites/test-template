---
import CustomSection from "@builders/custom-section/CustomSection.astro";

const {
  items = [],
  textColor = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  textColor ? `--np-text-color: ${textColor}` : "",
]
  .filter(Boolean)
  .join("; ") || undefined;

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["np-top-bar", className]}
  paddingVertical="xs"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={resolvedBg}
  style={inlineStyle}
  {...htmlAttributes}
>
  <div class="inner">
    {
      items.map((item: string, i: number) => (
        <>
          {i > 0 && (
            <span class="sep" aria-hidden="true">
              •
            </span>
          )}
          <span>{item}</span>
        </>
      ))
    }
  </div>
</CustomSection>

<style>
  .np-top-bar {
    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.2);
    color: var(--np-text-color, inherit);
    z-index: 10;
  }

  .np-top-bar .inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 1.25rem;
    font-weight: 700;
    gap: 0.25rem;
    justify-content: center;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .np-top-bar .sep {
    margin: 0 1.25rem;
  }

  @media (max-width: 768px) {
    .np-top-bar .inner {
      font-size: 1rem;
      letter-spacing: 0;
    }

    .np-top-bar .sep {
      display: none !important;
    }

    .np-top-bar .inner span {
      display: block;
      text-align: center;
      width: 100%;
    }
  }
</style>
