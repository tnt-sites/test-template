---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

const {
  heading = "Hear From Our Patients",
  reviewText = "",
  author = "",
  googleLogoImage = { source: "", alt: "Google Reviews" },
  backgroundImage = { source: "", alt: "" },
  starColor = "#febb21",
  fontHeadings = "",
  backgroundColor = "base",
  backgroundColorHex = "",
  class: className,
  ...rest
} = Astro.props;

const fontStyle = [
  backgroundColorHex ? `background-color: ${backgroundColorHex}` : "",
  fontHeadings ? `--np-font-headings: ${fontHeadings}` : "",
]
  .filter(Boolean)
  .join("; ");

const resolvedBg = backgroundColorHex ? "none" : backgroundColor;
const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["np-reviews", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  style={fontStyle || undefined}
  colorScheme="default"
  backgroundColor={resolvedBg}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  <article>
    {heading && <h2>{heading}</h2>}
    {reviewText && <p>&ldquo;{reviewText}&rdquo;</p>}
    <div class="author">
      {
        googleLogoImage?.source && (
          <span class="google-logo">
            <Image
              source={googleLogoImage.source}
              alt={googleLogoImage.alt || "Google Reviews"}
              rounded={false}
              editable={false}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
            />
          </span>
        )
      }
      <span class="author-info">
        <div class="stars" style={`--star-color: ${starColor}`} aria-label="5 stars">★★★★★</div>
        <span class="author-name">– {author}</span>
      </span>
    </div>
  </article>
</CustomSection>

<style>
  .np-reviews {
    margin: 0 auto;
    text-align: center;
    width: calc(100% - 20px);
  }

  .np-reviews article {
    flex: 0 1 840px;
    margin: 0 auto;
    padding: 0.625rem;
    position: relative;
    z-index: 1;
  }

  .np-reviews h2 {
    color: #fff;
    font-family: var(--np-font-headings, var(--font-headings));
    font-size: 3.125rem;
    font-weight: 400;
    margin: 0 auto 1.25rem;
    text-align: center;
  }

  .np-reviews p {
    color: #fff;
    font-size: 1.875rem;
    line-height: 1.3;
    margin: 0 auto;
    text-align: center;
  }

  .np-reviews .author {
    align-items: center;
    display: flex;
    font-size: 1rem;
    justify-content: center;
    letter-spacing: 0.3em;
    margin-top: 1.25rem;
    text-transform: uppercase;
  }

  .np-reviews .google-logo {
    margin-right: 0.625rem;
  }

  .np-reviews .author-info {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .np-reviews .stars {
    color: var(--star-color, #febb21);
    font-size: 1.75rem;
    letter-spacing: 0.2em;
    line-height: 1;
  }

  .np-reviews .author-name {
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    margin-top: 0.25rem;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .np-reviews h2 {
      text-align: center;
    }

    .np-reviews .author {
      justify-content: center;
    }
  }
</style>
